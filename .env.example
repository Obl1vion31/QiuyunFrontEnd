# Neon 开发分支连接串。不要把真实值提交到 Git。
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 排期页面和接口共用的临时 HTTP Basic Auth 多账号凭据。
# 用户名作为 JSON key，每个人使用不同密码；真实值不得提交到 Git。
OPERATIONS_BASIC_AUTH_USERS='{"owner":"replace-with-owner-password","colleague":"replace-with-colleague-password"}'

# 旧版单账号配置仅用于兼容；配置了 OPERATIONS_BASIC_AUTH_USERS 时会忽略以下两项。
# OPERATIONS_ADMIN_USER=replace-me
# OPERATIONS_ADMIN_PASSWORD=replace-with-a-long-random-password
