# 本机开发只连接上海独立开发库；正式网站继续使用 Vercel 中的 Neon 配置。
APP_ENV=development
DATABASE_URL=postgresql://qiuyun_dev_app:replace-with-development-password@127.0.0.1:15432/qiuyun_dev

# 至少 32 个随机字符，只在服务器和私有环境配置中保存。
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# 本机使用实际端口；Vercel Production 使用固定 HTTPS 域名。
BETTER_AUTH_URL=http://localhost:4321

# 创建聚光应用后配置，仅用于服务端授权；未配置时仍可登记回调地址。
XHS_JUGUANG_APP_ID=
XHS_JUGUANG_APP_SECRET=
