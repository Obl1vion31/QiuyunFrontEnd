---
/** 静态总枢纽：首页数据统一来自 home.ts，首屏由 React Island 激活动效。 */
import ContentTunnel from '../components/ContentTunnel';
import SiteIcons from '../components/SiteIcons.astro';
import QiuyunMark from '../components/QiuyunMark';
import { homeContent } from '../data/home';
import '../styles/home.css';
export const prerender = true;
const { meta, hero, covers, mission, workflow, systems } = homeContent;
const workflowTitle = workflow.title.replace('，', '，|').replace('持续', '|持续').split('|');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={meta.description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1b2b" />
    <link rel="stylesheet" href="/fonts/misans-5.0.0/MiSansVF.css" />
    <title>{meta.title}</title>
    <SiteIcons />
  </head>
  <body>
    <a class="skip-link" href="#workflow-title">跳到工作流</a>
    <main>
      <ContentTunnel client:load covers={covers} stages={workflow.stages} eyebrow={hero.eyebrow}
        title={hero.title} statement={hero.statement} note={hero.note} scrollHint={hero.scrollHint}
        purposeEyebrow={mission.eyebrow} purposeBody={mission.body} boundary={mission.boundary} />
      <div class="lower-content">
        <section class="workflow" aria-labelledby="workflow-title">
          <div class="shell workflow__inner">
            <header class="section-heading">
              <p class="eyebrow">{workflow.eyebrow}</p>
              <h2 id="workflow-title" tabindex="-1">{workflowTitle.map(line => <span>{line}</span>)}</h2>
              <p class="section-intro">{workflow.intro}</p>
            </header>
            <div class="workflow__body">
              <ol class="workflow__track">
                {workflow.stages.map((stage, index) => (
                  <li>
                    <div class="workflow__marker"><span>{String(index + 1).padStart(2, '0')}</span><i aria-hidden="true" /><b>{stage.label}</b></div>
                    <h3>{stage.verb}</h3><p>{stage.description}</p>
                  </li>
                ))}
              </ol>
              <p class="workflow__return"><span aria-hidden="true">↩</span>结果不是终点，它会沿着轨道回到下一次策划。</p>
            </div>
          </div>
        </section>
        <section class="systems" aria-labelledby="systems-title">
          <div class="shell systems__inner">
            <header class="section-heading">
              <p class="eyebrow">{systems.eyebrow}</p><h2 id="systems-title">{systems.title}</h2>
              <p class="section-intro">{systems.intro}</p>
            </header>
            <div class="systems__list">
              {systems.entries.map(entry => (
                <article>
                  <span class="entry-tag">{entry.eyebrow}</span>
                  <div><h3>{entry.title}</h3><p>{entry.summary}</p></div>
                  {entry.href ? <a class="entry-action" href={entry.href}>{entry.cta}<span aria-hidden="true">↗</span></a> : <span class="entry-status">{entry.cta}</span>}
                </article>
              ))}
            </div>
          </div>
        </section>
      </div>
      <footer><div class="shell"><a class="footer-brand" href="/" aria-label="湫云 · 返回首页"><QiuyunMark size={24} surface="tile" /><span>QIUYUN FRONTEND</span></a><span>最后更新 {meta.updatedAt}</span></div></footer>
    </main>
  </body>
</html>
