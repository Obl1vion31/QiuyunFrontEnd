34f}.metric-dot{z-index:5;grid-row:1;align-self:end;justify-self:center;width:6px;height:6px;margin-bottom:8px;border-radius:50%;background:var(--night)}.end-node{z-index:6;grid-row:1;align-self:center;justify-self:end;color:#56615c;font-size:.8rem}.end-node.discarded{color:var(--red);font-size:1rem;font-weight:900}.time-cursor{z-index:4;grid-row:1;width:2px;justify-self:center;background:#24374888;pointer-events:none}.time-cursor.today{background:var(--blue)}.time-cursor.selected{background:#ff6a3d}.time-cursor i{position:absolute;top:2px;padding:1px 4px;border-radius:4px;color:#fff;background:inherit;font-size:.46rem;font-style:normal;transform:translateX(-50%);white-space:nowrap}
