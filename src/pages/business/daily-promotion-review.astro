---
import BusinessViewSwitch from '../../components/BusinessViewSwitch.astro';
import BusinessPromotionSummary from '../../components/BusinessPromotionSummary.astro';
import BusinessPromotionTotals from '../../components/BusinessPromotionTotals.astro';
import BusinessPromotionDetails from '../../components/BusinessPromotionDetails.astro';
import {promotionOverview,promotionTotals,promotionDecisionLabels as decisionLabels} from '../../db/promotion-overview';
import '../../styles/promotion-overview.css';
import BusinessPromotionStageView from '../../components/BusinessPromotionStageView.astro';
import BusinessPromotionToolbar from '../../components/BusinessPromotionToolbar.astro';
import BusinessInspector from '../../components/BusinessInspector.astro';
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessSectionHeader from '../../components/BusinessSectionHeader.astro';
import BusinessPageHeader from '../../components/BusinessPageHeader.astro';
import BusinessPromotionTimeline from '../../components/BusinessPromotionTimeline.astro';
import '../../styles/promotion-pending.css';
import {isPendingPromotionRow} from '../../db/promotion-pending';
import {readPromotionTimeline} from '../../db/promotion-timeline';

import BusinessPromotionPause from '../../components/BusinessPromotionPause.astro';
import { readPromotionContext } from '../../db/promotion-pauses';
import { campaignPauseWindows, campaignWaitWindows, promotionStateOn, dateInWindows, effectivePromotionStatus, firstMissingPromotionDate, promotionLabels, pauseIsActive } from '../../db/promotion-state.mjs';
import { asc, desc, eq } from 'drizzle-orm';
import { getDb } from '../../db/client';
import {
  operationsCategory,
  operationsContent,
  operationsContentSchedule,
  operationsContentVersion,
  operationsPromotionCampaign,
  operationsPromotionDailyMetric,
  operationsPromotionStage,
  operationsPromotionTimelineAudit,
  operationsSubject,
} from '../../db/schema';
import {
  nextDateKey,
  shanghaiDateKey,
} from '../../db/promotion-rules.mjs';

export const prerender = false;

const addDays = (dateKey: string, amount: number) => {
  const date = new Date(`${dateKey}T00:00:00+08:00`);
  date.setUTCDate(date.getUTCDate() + amount);
  return shanghaiDateKey(date);
};
const today = shanghaiDateKey(new Date());
const yesterday = addDays(today, -1);
const activeView = ['history','stage'].includes(Astro.url.searchParams.get('view') ?? '') ? Astro.url.searchParams.get('view')! : 'daily';
const isDateKey = (value: string | null): value is string => Boolean(value && /^\d{4}-\d{2}-\d{2}$/.test(value));
const requestedHistoryFrom = Astro.url.searchParams.get('from');
const requestedHistoryTo = Astro.url.searchParams.get('to');
const historyTo = isDateKey(requestedHistoryTo) && requestedHistoryTo <= today ? requestedHistoryTo : '';
const historyFrom = isDateKey(requestedHistoryFrom) && requestedHistoryFrom <= (historyTo||today)
  ? requestedHistoryFrom
  : '';
const historyQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const historyStatus = Astro.url.searchParams.get('status') ?? '';
const historyMode = Astro.url.searchParams.get('mode') === 'day' ? 'day' : 'post';
const selectedCampaignId = Astro.url.searchParams.get('campaign');
const statusLabels = {...promotionLabels,none:'已转非推广'};
let timelineRows:Awaited<ReturnType<typeof readPromotionTimeline>>=[];
let databaseError = '';
let timelineAudits:(typeof operationsPromotionTimelineAudit.$inferSelect)[]=[];
let promotionContext: Awaited<ReturnType<typeof readPromotionContext>> = { stateChanges: [], pauses: [], targets: [], holds: [], waitRanges: [], campaigns: [], metrics: [] };
let pauseInfo: { active: typeof promotionContext.pauses[number] | null; testing: number; scaling: number; affected: number } = { active: null, testing: 0, scaling: 0, affected: 0 };
const visibleStatus = (campaign: { id: string; currentStatus: string; currentStage: string | null }) => effectivePromotionStatus(campaign.currentStatus, campaign.currentStage, campaign.id, promotionContext);
let campaigns: Array<{
  id: string;
  scheduleId: string;
  startedOn: string;
  initialStage: string;
  endedOn: string | null;
  currentStage: string | null;
  currentStatus: string;
  contentName: string;
  versionNumber: number;
  subjectName: string;
  categoryName: string | null;
  contentId: string;
  platformNoteId: string | null;
}> = [];
let stages: Array<{
  id: string;
  campaignId: string;
  stageType: string;
  startedOn: string;
  endedOn: string | null;
  outcome: string | null;
}> = [];
let metrics: Array<{
  id: string;
  campaignId: string;
  metricDate: string;
  dailyStatus: string;
  stageTypeSnapshot: string;
  spend: string;
  clickRate: string | null;
  platformOpenCount: number;
  actualOpenCount: number;
  platformLeadCount: number;
  actualLeadCount: number;
  reviewDecision: string;
  note: string | null;
}> = [];

const databaseStartedAt = performance.now();
try {
  if (activeView !== 'stage') {
  const database = getDb();
  [campaigns, stages, metrics, promotionContext,timelineAudits] = await Promise.all([database.select({
    id: operationsPromotionCampaign.id,
    scheduleId: operationsPromotionCampaign.scheduleId,
    startedOn: operationsPromotionCampaign.startedOn,
    initialStage: operationsPromotionCampaign.initialStage,
    endedOn: operationsPromotionCampaign.endedOn,
    currentStage: operationsPromotionCampaign.currentStage,
    currentStatus: operationsPromotionCampaign.currentStatus,
    contentName: operationsContentVersion.contentName,
    versionNumber: operationsContentVersion.versionNumber,
    subjectName: operationsSubject.name,
    categoryName: operationsCategory.name,
    contentId: operationsContent.id,
    platformNoteId: operationsContent.platformNoteId,
  }).from(operationsPromotionCampaign)
    .innerJoin(operationsContentSchedule, eq(operationsPromotionCampaign.scheduleId, operationsContentSchedule.id))
    .innerJoin(operationsContentVersion, eq(operationsContentSchedule.contentVersionId, operationsContentVersion.id))
    .innerJoin(operationsContent, eq(operationsContentVersion.contentId, operationsContent.id))
    .innerJoin(operationsSubject, eq(operationsContentVersion.subjectId, operationsSubject.id))
    .leftJoin(operationsCategory, eq(operationsContentVersion.categoryId, operationsCategory.id))
    .orderBy(asc(operationsPromotionCampaign.startedOn), asc(operationsContentVersion.contentName)),
  database.select({
    id: operationsPromotionStage.id,
    campaignId: operationsPromotionStage.campaignId,
    stageType: operationsPromotionStage.stageType,
    startedOn: operationsPromotionStage.startedOn,
    endedOn: operationsPromotionStage.endedOn,
    outcome: operationsPromotionStage.outcome,
  }).from(operationsPromotionStage)
    .innerJoin(operationsPromotionCampaign, eq(operationsPromotionStage.campaignId, operationsPromotionCampaign.id))
    .orderBy(asc(operationsPromotionStage.startedOn)),
  database.select({
    id: operationsPromotionDailyMetric.id,
    campaignId: operationsPromotionDailyMetric.campaignId,
    metricDate: operationsPromotionDailyMetric.metricDate,
    dailyStatus: operationsPromotionDailyMetric.dailyStatus,
    stageTypeSnapshot: operationsPromotionDailyMetric.stageTypeSnapshot,
    spend: operationsPromotionDailyMetric.spend,
    clickRate: operationsPromotionDailyMetric.clickRate,
    platformOpenCount: operationsPromotionDailyMetric.platformOpenCount,
    actualOpenCount: operationsPromotionDailyMetric.actualOpenCount,
    platformLeadCount: operationsPromotionDailyMetric.platformLeadCount,
    actualLeadCount: operationsPromotionDailyMetric.actualLeadCount,
    reviewDecision: operationsPromotionDailyMetric.reviewDecision,
    note: operationsPromotionDailyMetric.note,
  }).from(operationsPromotionDailyMetric)
    .innerJoin(operationsPromotionCampaign, eq(operationsPromotionDailyMetric.campaignId, operationsPromotionCampaign.id))
    .orderBy(asc(operationsPromotionDailyMetric.metricDate)),
  readPromotionContext(database),
  database.select().from(operationsPromotionTimelineAudit).orderBy(desc(operationsPromotionTimelineAudit.createdAt)),
  ]) as [typeof campaigns, typeof stages, typeof metrics, typeof promotionContext,typeof timelineAudits];
  timelineRows=await readPromotionTimeline(database);
  campaigns = campaigns.map(campaign => {
    if (!promotionContext.waitRanges.some(range => range.campaignId === campaign.id)) return campaign;
    const state = promotionStateOn(campaign, promotionContext, today);
    if (!state) return campaign;
    stages = [...stages.filter(stage => stage.campaignId !== campaign.id), ...state.stages.map(stage => ({ ...stage, campaignId: campaign.id, id: `${campaign.id}:${stage.stageType}:${stage.startedOn}` }))];
    return { ...campaign, currentStage: state.currentStage, currentStatus: state.currentStatus, endedOn: state.endedOn };
  });
  const active = promotionContext.pauses.find(pause => pauseIsActive(pause)) ?? null;
  const running = campaigns.filter(campaign => ['testing','scaling'].includes(visibleStatus(campaign)));
  pauseInfo = { active, testing: running.filter(campaign => campaign.currentStage === 'testing').length, scaling: running.filter(campaign => campaign.currentStage === 'scaling').length, affected: active ? promotionContext.targets.filter(target => target.pauseId === active.id).length : running.length };
} } catch (error) {
  console.error('daily promotion review query failed', error);
  databaseError = '推广日度数据暂时不可用。请确认开发库已经执行最新迁移。';
}
Astro.response.headers.set('Server-Timing', `db;dur=${(performance.now() - databaseStartedAt).toFixed(1)}`);

const dateRange = (start: string, end: string) => {
  const dates: string[] = [];
  for (let date = start; date <= end; date = nextDateKey(date)) dates.push(date);
  return dates;
};

const awaitingRows=timelineRows.filter(row=>isPendingPromotionRow(row));
const pendingRows = campaigns.flatMap((campaign) => {
  if (campaign.startedOn > yesterday) return [];
  const campaignMetrics = metrics.filter((metric) => metric.campaignId === campaign.id);
  const windows = [...campaignPauseWindows(campaign, promotionContext), ...campaignWaitWindows(campaign, promotionContext), ...promotionContext.holds.filter(hold => hold.campaignId === campaign.id)];
  const expectedDate = firstMissingPromotionDate(campaignMetrics, campaign.startedOn, windows);
  if (expectedDate > yesterday) return [];
  return dateRange(expectedDate, yesterday).filter(date => !campaignMetrics.some(metric=>metric.metricDate===date)&&!dateInWindows(date, windows) && promotionStateOn(campaign, promotionContext, date)?.currentStage).map((metricDate, index) => ({
    campaign,
    metricDate,
    unlocked: index === 0,
    stageType: index === 0 ? promotionStateOn(campaign, promotionContext, metricDate)?.currentStage : null,
    campaignStatus: promotionStateOn(campaign, promotionContext, metricDate)?.currentStatus,
    blockedBy: expectedDate,
  }));
}).sort((left, right) =>
  left.metricDate.localeCompare(right.metricDate)
  || left.campaign.contentName.localeCompare(right.campaign.contentName, 'zh-CN'));

const overview=promotionOverview({posts:timelineRows,campaigns,stages,metrics,context:promotionContext,today,selected:selectedCampaignId});
const lifecycleRows=overview.filter(row=>!row.closed&&row.latest);
const historyRows=overview.filter(row=>(!historyTo||row.startedOn<=historyTo)&&(!row.endedOn||row.endedOn>=historyFrom)&&(!historyQuery||row.post.contentName.toLocaleLowerCase().includes(historyQuery.toLocaleLowerCase()))&&(!historyStatus||row.status===historyStatus));
const activeHistoryRows=historyRows.filter(row=>!row.closed),endedHistoryRows=historyRows.filter(row=>row.closed);
const templateRows=overview.filter(row=>(activeView==='daily'?lifecycleRows:historyRows).includes(row)||row.key===selectedCampaignId);
const historyDayGroups=[...new Set(historyRows.flatMap(row=>row.metrics).filter(m=>m.metricDate>=historyFrom&&m.metricDate<=(historyTo||yesterday)).map(m=>m.metricDate))].sort().reverse().map(metricDate=>{
 const rows=historyRows.flatMap(entry=>entry.metrics.filter(metric=>metric.metricDate===metricDate).map(metric=>({entry,metric})));
 return {metricDate,rows,totals:promotionTotals(rows.map(r=>r.metric))};
});
const historyHref = (overrides: Record<string, string>) => {
  const params = new URLSearchParams({
    view: 'history',
    mode: historyMode,
    from: historyFrom,
    to: historyTo,
    ...(historyQuery ? { q: historyQuery } : {}),
    ...(historyStatus ? { status: historyStatus } : {}),
    ...overrides,
  });
  return `?${params.toString()}`;
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="填写推广帖日度数据，查看测试与放量生命周期。" />
    <title>Daily Promotion Review · 内容发布控制台</title>
  </head>
  <body>
    <BusinessConsoleFrame active="daily-promotion">
        <BusinessPromotionToolbar stage={activeView==='stage'} />

        <main class="business-console-content">

          {activeView === 'stage' && <BusinessPromotionStageView />}
          {databaseError && <p class="notice" role="alert">{databaseError}</p>}

          {activeView === 'daily' && <>
          <section class="calendar-section" aria-labelledby="calendar-title">
            <BusinessPageHeader title="最新推广生命周期" headingId="calendar-title" contained />
            {lifecycleRows.length===0?<div class="empty-state"><strong>当前没有正在推广的帖子</strong><p>已结束的推广可在历史总览查看。</p></div>:<div class="lifecycle-list">{lifecycleRows.map(entry=><BusinessPromotionSummary entry={entry} daily href={`?campaign=${entry.key}`}/>)}</div>}
          </section>

          <section class="daily-section" id="daily-table" aria-labelledby="daily-title">
            <div class="pending-heading"><BusinessSectionHeader title="待完成复盘" headingId="daily-title" description="按日期顺序完成" contained wrap><Fragment slot="heading-end"><small data-promotion-pending-count>{pendingRows.length + awaitingRows.length}</small><a href="?view=history">点击进入历史总览查看 ↗</a></Fragment><BusinessPromotionPause slot="end" summary={pauseInfo} /></BusinessSectionHeader></div>
            <div class="promotion-pending-content" data-promotion-pending-body>
            <BusinessPromotionTimeline rows={timelineRows}/>
            {!databaseError && pendingRows.length === 0 && awaitingRows.length === 0
              ? <div class="empty-state"><strong>截至昨天已全部完成</strong><p>已填数据保存在历史总览；新的待办会在下一复盘日出现。</p></div>
              : <div class="daily-table-wrap">
                <div class="daily-grid" aria-label="待完成日度推广复盘">
                  {pendingRows.map(({ campaign, metricDate, unlocked, stageType, campaignStatus, blockedBy }) => {
                    const defaultWaiting = campaignStatus === 'waiting_action';
                    const decisionOptions = stageType === 'scaling'
                      ? ['scaling_continue','wait_continue','formal_discarded','ended']
                      : ['test_continue','wait_continue','test_discarded','start_scaling'];
                    return unlocked
                      ? <form class="business-form metric-form review-metric-row" data-metric-form data-current-stage={stageType} data-campaign-status={campaignStatus} data-schedule-id={campaign.scheduleId} data-fingerprint={timelineRows.find(row=>row.scheduleId===campaign.scheduleId)?.fingerprint}>
                          <input type="hidden" name="campaignId" value={campaign.id} />
                          <input type="hidden" name="metricDate" value={metricDate} />
                          <input type="hidden" name="dailyStatus" value={defaultWaiting ? 'waiting_action' : 'active'} />
                          <input type="hidden" name="stageTypeSnapshot" value={stageType} />
                          <header class="review-entry-header">
                           <div class="review-entry-identity"><strong>{campaign.contentName}</strong><small>V{campaign.versionNumber} · {campaign.subjectName}</small></div>
                           <div class="review-note-field">{campaign.platformNoteId?<span>笔记 ID</span>:<label for={`review-note-${campaign.id}`}>笔记 ID</label>}{campaign.platformNoteId?<span class="review-note-value" title={campaign.platformNoteId}>{campaign.platformNoteId}</span>:<><input id={`review-note-${campaign.id}`} aria-label="笔记 ID" name="platformNoteId" data-active-id data-note-id-required pattern="[0-9A-Fa-f]{24}" maxlength="24" required placeholder="首次复盘补填"/><span class="review-note-value" data-paused-note-id hidden>未填写</span></>}</div>
                           <div class="review-entry-date"><span>数据日期</span><time datetime={metricDate}>{metricDate}</time></div>
                           <label class={`stage-cell review-day-state ${defaultWaiting ? 'waiting_action' : stageType}`}><span>当日状态</span><select name="dayAction" aria-label="当日状态"><option value="active">{defaultWaiting?(stageType==='testing'?'测试待定':'推广暂停'):stageType==='scaling'?'放量':'测试'}</option><option value="pause">当日暂停</option></select></label>
                          </header>
                          <div class="review-entry-data">
                          <div class="review-metric-fields" data-active-fields>
                           <div class="review-metric-inputs">
                           <label>消耗<input aria-label="消耗" name="spend" type="number" min="0" step="0.01" placeholder="¥" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           <label>平台开口<input aria-label="平台开口人数" name="platformOpenCount" type="number" min="0" step="1" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           <label>实际开口<input aria-label="实际开口人数" name="actualOpenCount" type="number" min="0" step="1" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           <label>平台留资<input aria-label="平台留资人数" name="platformLeadCount" type="number" min="0" step="1" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           <label>实际留资<input aria-label="实际留资人数" name="actualLeadCount" type="number" min="0" step="1" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           </div>
                          </div>
                          <div class="review-pause-fields" data-pause-fields hidden>
                           <label data-pause-reason>暂停原因<input name="pauseReason" maxlength="2000" disabled/></label><label data-pause-through>暂停至（含当天）<input type="date" name="pauseThrough" value={metricDate} min={metricDate} disabled/></label>
                           <p class="review-draft-preview" data-pause-preview aria-live="polite"/>
                          </div>
                          <div class="review-outcome">
                           <dl class="review-costs" data-active-costs aria-label="自动计算成本"><div class="review-cost"><dt>实际开口成本</dt><dd><output data-open-cost aria-label="实际开口成本">—</output></dd></div><div class="review-cost"><dt>实际留资成本</dt><dd><output data-lead-cost aria-label="实际留资成本">—</output></dd></div></dl>
                           <div class="review-completion"><label class="review-decision" data-active-decision><span>下一步</span><select data-review-decision aria-label="下一步" name="reviewDecision" required><option value="">请选择</option>{decisionOptions.map((decision) => <option value={decision}>{decision === 'wait_continue' ? (stageType === 'testing' ? '测试待定' : '推广暂停') : decisionLabels[decision]}</option>)}</select></label><button type="submit" class="business-action-primary">完成复盘</button></div>
                          </div>
                          </div><p role="alert" data-form-message></p>
                        </form>
                      : <div data-locked-schedule={campaign.scheduleId} class="review-metric-row review-locked-row">
                          <header class="review-entry-header"><div class="review-entry-identity"><strong>{campaign.contentName}</strong><small>V{campaign.versionNumber} · {campaign.subjectName}</small></div><div class="review-entry-date"><span>数据日期</span><time datetime={metricDate}>{metricDate}</time></div><span class="review-state-badge">待前日复盘</span></header>
                          <p class="review-locked-message">请先完成 {blockedBy}，再处理这一天的数据与状态。</p>
                        </div>;
                  })}
                </div>
              </div>}
            </div>
          </section>

          </>}

          {activeView === 'history' && <section class="history-workspace" aria-labelledby="history-title">
            <div class="history-head"><a class="history-back" href="?view=daily">← 返回每日复盘</a>
              <BusinessPageHeader title="推广历史总览" headingId="history-title" />
              <form class="history-filters business-filter" method="get">
                <input type="hidden" name="view" value="history" />
                <input type="hidden" name="mode" value={historyMode} />
                <label><span>开始日期</span><input type="date" name="from" value={historyFrom} max={historyTo||today} /></label>
                <label><span>结束日期</span><input type="date" name="to" value={historyTo} max={today} /></label>
                <label class="history-search"><span>帖子</span><input type="search" name="q" value={historyQuery} placeholder="搜索帖子名称" /></label>
                <label><span>状态</span><select name="status">
                  <option value="">全部状态</option>
                  {Object.entries(statusLabels).map(([value, label]) => <option value={value} selected={historyStatus === value}>{label}</option>)}
                </select></label>
                <button type="submit" class="business-action-primary">查看</button>
                <a href={`?view=history&mode=${historyMode}`}>重置范围</a>
              </form>
            </div>
            <form class="history-mode-switch" method="get" data-history-mode-form>
              <input type="hidden" name="view" value="history"/><input type="hidden" name="from" value={historyFrom}/><input type="hidden" name="to" value={historyTo}/><input type="hidden" name="q" value={historyQuery}/><input type="hidden" name="status" value={historyStatus}/>
              <BusinessViewSwitch label="历史总览粒度" name="mode" value={historyMode} items={[{label:'帖子视角',value:'post'},{label:'日视角',value:'day'}]}/>
            </form>
            <div class="history-layout" data-inspector-host>
              {historyMode==='post'?<div class="history-list">
                {[{key:'unfinished',label:'尚未结束推广',rows:activeHistoryRows},{key:'ended',label:'已结束推广',rows:endedHistoryRows}].map(group=><section class="promotion-history-group" data-history-group={group.key}>
                  <h2>{group.label}<small>{group.rows.length} 篇</small></h2>
                  {group.rows.length?group.rows.map(entry=><BusinessPromotionSummary entry={entry} href={historyHref({campaign:entry.key})}/>):<p class="promotion-group-empty">当前筛选范围内没有{group.key==='ended'?'已结束':'尚未结束'}的帖子。</p>}
                </section>)}
              </div>:<div class="day-history">
                {!historyDayGroups.length&&<div class="empty-state">该范围内没有日度记录。</div>}
                {historyDayGroups.map(group=><section class="day-group" data-day-group={group.metricDate}>
                  <header><h2>{group.metricDate}</h2><span>{group.rows.length} 条记录</span></header><BusinessPromotionTotals totals={group.totals}/>
                  {group.rows.map(({entry,metric})=><article class="promotion-day-row" data-history-row data-history-schedule={entry.scheduleId} data-history-date={group.metricDate} data-metric-id={metric.id}>
                    <header><a data-inspector-key={entry.key} href={historyHref({campaign:entry.key})}><strong>{entry.post.contentName}</strong><span>V{entry.post.versionNumber} · {entry.post.subjectName}</span></a><span class="promotion-status">{metric.dailyStatus!=='active'?(metric.stageTypeSnapshot==='testing'?'测试待定':'推广暂停'):metric.stageTypeSnapshot==='testing'?'测试':'放量'}</span></header>
                    <BusinessPromotionTotals totals={promotionTotals([metric])}/>
                  </article>)}
                </section>)}
              </div>}
              <BusinessInspector class="history-inspector" parameter="campaign" templates data-promotion-inspector />
            </div>
          </section>}
          {activeView==='daily'&&<BusinessInspector parameter="campaign" templates data-inspector-overlay data-promotion-inspector/>}
          {activeView!=='stage'&&templateRows.map(entry=><template data-history-schedule={entry.scheduleId} data-inspector-template={entry.key}><BusinessPromotionDetails entry={entry} context={promotionContext} audits={timelineAudits.filter(a=>a.scheduleId===entry.scheduleId)} closeHref={activeView==='history'?historyHref({campaign:''}):'?view=daily'}/></template>)}
        </main>
    </BusinessConsoleFrame>

    <script>
      import {refreshPromotionSchedule} from '../../scripts/promotion-timeline';
      import {randomRequestKey} from '../../scripts/promotion-timeline';
      import {promotionIntervalPreview} from '../../db/promotion-pending';
      import { getInspector } from '../../scripts/business-inspector';
      import {businessConfirm} from '../../scripts/business-dialog';
      const cleanInspector = (form:HTMLFormElement) => { const pane=form.closest<HTMLElement>('[data-inspector]'); if(pane)getInspector(pane).setClean(); };
      const formatCost = (spend: number, count: number) => count > 0 ? `¥${(spend / count).toFixed(2)}` : '—';
      const initializeDailyForms = () => {
      document.querySelectorAll<HTMLFormElement>('[data-history-mode-form]:not([data-ready])').forEach(form=>{form.dataset.ready='true';form.addEventListener('change',()=>form.requestSubmit());});
      document.querySelectorAll<HTMLFormElement>('[data-metric-form]:not([data-daily-ready])').forEach((form) => {
        const openCost = form.querySelector<HTMLOutputElement>('[data-open-cost]');
        const leadCost = form.querySelector<HTMLOutputElement>('[data-lead-cost]');
        const message = form.querySelector<HTMLElement>('[data-form-message]');
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!openCost || !leadCost || !message || !button) return;
        form.dataset.dailyReady = 'true';
        const requestKey=randomRequestKey();
        const syncPause=()=>{const paused=(form.elements.namedItem('dayAction') as HTMLSelectElement).value==='pause';
          for(const name of ['spend','platformOpenCount','actualOpenCount','platformLeadCount','actualLeadCount','platformNoteId']){const control=form.elements.namedItem(name) as HTMLInputElement|null;if(control){control.disabled=paused;control.required=!paused;}}
          const decision=form.elements.namedItem('reviewDecision') as HTMLSelectElement;decision.required=!paused;decision.disabled=paused;
          for(const selector of ['[data-active-fields]','[data-active-costs]','[data-active-id]','[data-active-decision]']){const host=form.querySelector<HTMLElement>(selector);if(host)host.hidden=paused;}
          const emptyId=form.querySelector<HTMLElement>('[data-paused-note-id]');if(emptyId)emptyId.hidden=!paused;
          const fields=form.querySelector<HTMLElement>('[data-pause-fields]');if(fields)fields.hidden=!paused;
          for(const selector of ['[data-pause-reason]','[data-pause-through]']){const host=form.querySelector<HTMLElement>(selector)!;host.hidden=!paused;host.querySelectorAll<HTMLInputElement>('input').forEach(input=>{input.disabled=!paused;input.required=paused;});}
          const preview=form.querySelector<HTMLElement>('[data-pause-preview]');if(preview)preview.textContent=promotionIntervalPreview(String((form.elements.namedItem('metricDate') as HTMLInputElement).value),String((form.elements.namedItem('pauseThrough') as HTMLInputElement).value),'暂停')??'请选择不早于数据日期的暂停截止日。';
          button.textContent=paused?'保存当日暂停':'完成复盘';
        };
        form.addEventListener('change',syncPause);syncPause();
        const updateCosts = () => {
          const data = new FormData(form);
          const spend = Number(data.get('spend'));
          openCost.textContent = formatCost(spend, Number(data.get('actualOpenCount')));
          leadCost.textContent = formatCost(spend, Number(data.get('actualLeadCount')));
        };
        form.addEventListener('input',()=>{syncPause();form.dataset.dirty='true';document.documentElement.dataset.unsaved='true';updateCosts();});
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const noteId = form.querySelector<HTMLInputElement>('[data-note-id-required]');
          const paused=(form.elements.namedItem('dayAction') as HTMLSelectElement).value==='pause';
          if (noteId&&!paused) {
            if (!/^[0-9a-fA-F]{24}$/.test(noteId.value.trim())) { message.textContent = '笔记 ID 必须是 24 位十六进制字符。'; noteId.focus(); return; }
          }
          button.disabled = true;
          message.textContent = '正在保存…';
          try {
            const data=new FormData(form);
            const response = await fetch(paused?'/api/promotion-timeline':'/api/promotion-daily', {
              method: 'POST',
              body: paused?JSON.stringify({scheduleId:form.dataset.scheduleId,reviewDate:data.get('metricDate'),action:'pause',waitingThrough:data.get('pauseThrough'),reason:data.get('pauseReason'),nextDecision:data.get('reviewDecision')||undefined,requestKey,fingerprint:form.dataset.fingerprint}):data,
              headers: paused?{'Content-Type':'application/json'}:{ Accept: 'application/json' },
            });
            const result = await response.json();
            if (response.ok) {
              delete form.dataset.dirty;await refreshPromotionSchedule(form.dataset.scheduleId!);document.documentElement.dataset.unsaved=String(!!document.querySelector('form[data-dirty=true]'));
              return;
            }
            message.textContent = result.message ?? '保存失败，请重试。';
          } catch {
            message.textContent = '无法连接服务，请稍后重试。';
          } finally {
            button.disabled = false;
          }
        });
      });
      };
      initializeDailyForms();
      document.addEventListener('astro:page-load', initializeDailyForms);
      document.addEventListener('business:promotion-fragment-updated',initializeDailyForms);
      document.addEventListener('business:inspector-render', initializeDailyForms);
      const initializeHistoryEditors = () => {
        document.querySelectorAll<HTMLButtonElement>('[data-edit-trigger]:not([data-history-edit-ready])').forEach((trigger) => {
          const dialog = document.querySelector<HTMLDialogElement>(`[data-edit-dialog="${trigger.dataset.editTrigger}"]`);
          if (!dialog) return;
          trigger.dataset.historyEditReady = 'true';
          trigger.addEventListener('click', () => dialog.showModal());
          dialog.querySelectorAll<HTMLButtonElement>('[data-close-edit]').forEach((button) => button.addEventListener('click', () => dialog.close()));
        });
        document.querySelectorAll<HTMLFormElement>('[data-history-edit-form]:not([data-history-edit-ready])').forEach((form) => {
          const message = form.querySelector<HTMLElement>('[data-edit-message]');
          const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (!message || !submit) return;
          form.dataset.historyEditReady = 'true';
          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const data = new FormData(form);
            const decision = form.querySelector<HTMLSelectElement>('select[name="reviewDecision"]');
            if (decision?.disabled) data.set('reviewDecision', decision.value);
            const metricId = String(data.get('metricId'));
            submit.disabled = true;
            message.textContent = '正在保存修改…';
            try {
              let response = await fetch(`/api/promotion-daily/${metricId}`, { method: 'PATCH', body: data, headers: { Accept: 'application/json' } });
              let result = await response.json();
              if (response.status === 409 && result.correctionRequired) {
                if (!await businessConfirm(`${result.message}\n\n确认后，后续日期会重新回到待填队列。是否继续？`,{title:'确认历史影响',confirmLabel:'确认更正'})) {
                  message.textContent = '已取消修改，原数据未变化。';
                  return;
                }
                data.set('confirmCascade', 'true');
                response = await fetch(`/api/promotion-daily/${metricId}`, { method: 'PATCH', body: data, headers: { Accept: 'application/json' } });
                result = await response.json();
              }
              if (response.ok) { cleanInspector(form); return window.location.reload(); }
              message.textContent = result.message ?? '保存失败，请重试。';
            } catch {
              message.textContent = '无法连接服务，请稍后重试。';
            } finally {
              submit.disabled = false;
            }
          });
        });
      };
      initializeHistoryEditors();
      document.addEventListener('astro:page-load', initializeHistoryEditors);
      document.addEventListener('business:inspector-render', initializeHistoryEditors);
      const initializeCorrections = () => {
      document.querySelectorAll<HTMLFormElement>('[data-note-id-correction]:not([data-correction-ready])').forEach((form) => { form.dataset.correctionReady='true'; form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const oldValue = form.querySelector<HTMLInputElement>('[data-old-note-id]')!.value;
        const newValue = String(new FormData(form).get('platformNoteId') ?? '').trim().toLowerCase();
        if (!await businessConfirm(`旧值：${oldValue}\n新值：${newValue}\n\n该帖子的全部版本与复盘都会同步。`,{title:'更正笔记 ID',confirmLabel:'确认更正',cancelLabel:'继续编辑'})) return;
        const output = form.querySelector<HTMLOutputElement>('output')!; output.textContent = '正在更正…';
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (response.ok) { cleanInspector(form); window.location.reload(); } else output.textContent = result.message ?? '更正失败。';
      }); });
      };
      initializeCorrections();
      document.addEventListener('astro:page-load', initializeCorrections);
      document.addEventListener('business:inspector-render', initializeCorrections);
    </script>
  </body>
</html>

<style>
.calendar-section,.daily-section,.history-workspace{min-width:0;border:1px solid var(--console-line);border-radius:12px;background:var(--console-surface);overflow:clip}.daily-section{margin-top:20px}.empty-state{padding:24px;color:var(--console-muted);font-size:14px}.empty-state p{margin:6px 0 0}.pending-heading small{color:var(--console-muted);font:600 13px var(--console-font)}.pending-heading a,.history-back{color:var(--console-blue);font-size:13px;text-decoration:none}.history-head{padding:20px}.history-back{display:inline-block;margin-bottom:12px}.history-filters{display:flex;align-items:end;flex-wrap:wrap;gap:12px;margin-top:16px}.history-search{flex:1;min-width:180px}.history-filters>a{padding:10px 0}.history-mode-switch{display:flex;padding:0 20px 14px;margin:0;border-bottom:1px solid var(--console-line)}.history-layout{padding:16px}.history-list,.day-history{min-width:0;display:grid;gap:24px}.day-history{gap:16px}.notice{padding:16px;color:var(--console-red)}
@media(max-width:600px){.history-head{padding:14px}.history-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.history-filters label,.history-filters input,.history-filters select{min-width:0;width:100%}.history-search{grid-column:1/-1}.history-layout{padding:12px}.history-mode-switch{padding-inline:14px}}
</style>
