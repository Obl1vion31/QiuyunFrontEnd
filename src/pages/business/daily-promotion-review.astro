---
import BusinessFormDialog from '../../components/BusinessFormDialog.astro';
import BusinessPromotionStageView from '../../components/BusinessPromotionStageView.astro';
import BusinessPromotionToolbar from '../../components/BusinessPromotionToolbar.astro';
import BusinessInspector from '../../components/BusinessInspector.astro';
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessSectionHeader from '../../components/BusinessSectionHeader.astro';
import BusinessPageHeader from '../../components/BusinessPageHeader.astro';
import BusinessPromotionTimeline from '../../components/BusinessPromotionTimeline.astro';
import '../../styles/promotion-pending.css';
import {isPendingPromotionRow} from '../../db/promotion-pending';
import {readPromotionTimeline} from '../../db/promotion-timeline';
import BusinessPromotionWaitRanges from '../../components/BusinessPromotionWaitRanges.astro';
import BusinessPromotionPause from '../../components/BusinessPromotionPause.astro';
import { readPromotionContext } from '../../db/promotion-pauses';
import { campaignPauseWindows, campaignWaitWindows, promotionStateOn, countPromotionDays, dateInWindows, effectivePromotionStatus, firstMissingPromotionDate, promotionLabels, waitingPromotionDays, pauseIsActive } from '../../db/promotion-state.mjs';
import { and, asc, eq, gte, isNull, lte, or } from 'drizzle-orm';
import { getDb } from '../../db/client';
import {
  operationsCategory,
  operationsContent,
  operationsContentSchedule,
  operationsContentVersion,
  operationsPromotionCampaign,
  operationsPromotionDailyMetric,
  operationsPromotionStage,
  operationsSubject,
} from '../../db/schema';
import {
  calculateActualPromotionCosts,
  nextDateKey,
  promotionStageShares,
  shanghaiDateKey,
} from '../../db/promotion-rules.mjs';

export const prerender = false;

const addDays = (dateKey: string, amount: number) => {
  const date = new Date(`${dateKey}T00:00:00+08:00`);
  date.setUTCDate(date.getUTCDate() + amount);
  return shanghaiDateKey(date);
};
const today = shanghaiDateKey(new Date());
const yesterday = addDays(today, -1);
const activeView = ['history','stage'].includes(Astro.url.searchParams.get('view') ?? '') ? Astro.url.searchParams.get('view')! : 'daily';
const isDateKey = (value: string | null): value is string => Boolean(value && /^\d{4}-\d{2}-\d{2}$/.test(value));
const requestedHistoryFrom = Astro.url.searchParams.get('from');
const requestedHistoryTo = Astro.url.searchParams.get('to');
const historyTo = isDateKey(requestedHistoryTo) && requestedHistoryTo < today ? requestedHistoryTo : yesterday;
const historyFrom = isDateKey(requestedHistoryFrom) && requestedHistoryFrom <= historyTo
  ? requestedHistoryFrom
  : '';
const historyQuery = (Astro.url.searchParams.get('q') ?? '').trim();
const historyStatus = Astro.url.searchParams.get('status') ?? '';
const historyMode = Astro.url.searchParams.get('mode') === 'day' ? 'day' : 'post';
const selectedCampaignId = Astro.url.searchParams.get('campaign');
const formatDate = (dateKey: string) => {
  const [, month, day] = dateKey.split('-');
  return `${Number(month)}月${Number(day)}日`;
};
const formatFullDate = (dateKey: string) => {
  const [year, month, day] = dateKey.split('-');
  return `${Number(year)} 年 ${Number(month)} 月 ${Number(day)} 日`;
};
const formatRange = (start: string, end: string | null) =>
  `${formatDate(start)}—${end ? formatDate(end) : '进行中'}`;
const statusLabels = Object.fromEntries(Object.entries(promotionLabels).filter(([key]) => !['none','pending','awaiting_promotion'].includes(key)));
const decisionLabels: Record<string, string> = {
  test_continue: '测试继续',
  test_discarded: '测试淘汰',
  start_scaling: '测试接放量',
  scaling_continue: '放量继续',
  formal_discarded: '放量淘汰',
  ended: '推广周期结束',
  wait_continue: '等待',
};

let timelineRows:Awaited<ReturnType<typeof readPromotionTimeline>>=[];
let databaseError = '';
let promotionContext: Awaited<ReturnType<typeof readPromotionContext>> = { stateChanges: [], pauses: [], targets: [], holds: [], waitRanges: [], campaigns: [], metrics: [] };
let pauseInfo: { active: typeof promotionContext.pauses[number] | null; testing: number; scaling: number; affected: number } = { active: null, testing: 0, scaling: 0, affected: 0 };
const visibleStatus = (campaign: { id: string; currentStatus: string; currentStage: string | null }) => effectivePromotionStatus(campaign.currentStatus, campaign.currentStage, campaign.id, promotionContext);
let campaigns: Array<{
  id: string;
  scheduleId: string;
  startedOn: string;
  initialStage: string;
  endedOn: string | null;
  currentStage: string | null;
  currentStatus: string;
  contentName: string;
  versionNumber: number;
  subjectName: string;
  categoryName: string | null;
  contentId: string;
  platformNoteId: string | null;
}> = [];
let awaitingSchedules: Array<{
  scheduleId: string;
  actualPublishAt: Date | null;
  promotionDeferredThrough: string | null;
  contentName: string;
  versionNumber: number;
  subjectName: string;
  categoryName: string | null;
  contentId: string;
  platformNoteId: string | null;
}> = [];
let stages: Array<{
  id: string;
  campaignId: string;
  stageType: string;
  startedOn: string;
  endedOn: string | null;
  outcome: string | null;
}> = [];
let metrics: Array<{
  id: string;
  campaignId: string;
  metricDate: string;
  dailyStatus: string;
  stageTypeSnapshot: string;
  spend: string;
  clickRate: string | null;
  platformOpenCount: number;
  actualOpenCount: number;
  platformLeadCount: number;
  actualLeadCount: number;
  reviewDecision: string;
  note: string | null;
}> = [];

const databaseStartedAt = performance.now();
try {
  if (activeView !== 'stage') {
  const database = getDb();
  const campaignScope = activeView === 'daily'
    ? undefined
    : and(
        lte(operationsPromotionCampaign.startedOn, historyTo),
        historyFrom ? or(isNull(operationsPromotionCampaign.endedOn), gte(operationsPromotionCampaign.endedOn, historyFrom)) : undefined,

      );
  [campaigns, stages, metrics, awaitingSchedules, promotionContext] = await Promise.all([database.select({
    id: operationsPromotionCampaign.id,
    scheduleId: operationsPromotionCampaign.scheduleId,
    startedOn: operationsPromotionCampaign.startedOn,
    initialStage: operationsPromotionCampaign.initialStage,
    endedOn: operationsPromotionCampaign.endedOn,
    currentStage: operationsPromotionCampaign.currentStage,
    currentStatus: operationsPromotionCampaign.currentStatus,
    contentName: operationsContentVersion.contentName,
    versionNumber: operationsContentVersion.versionNumber,
    subjectName: operationsSubject.name,
    categoryName: operationsCategory.name,
    contentId: operationsContent.id,
    platformNoteId: operationsContent.platformNoteId,
  }).from(operationsPromotionCampaign)
    .innerJoin(operationsContentSchedule, eq(operationsPromotionCampaign.scheduleId, operationsContentSchedule.id))
    .innerJoin(operationsContentVersion, eq(operationsContentSchedule.contentVersionId, operationsContentVersion.id))
    .innerJoin(operationsContent, eq(operationsContentVersion.contentId, operationsContent.id))
    .innerJoin(operationsSubject, eq(operationsContentVersion.subjectId, operationsSubject.id))
    .leftJoin(operationsCategory, eq(operationsContentVersion.categoryId, operationsCategory.id))
    .where(campaignScope)
    .orderBy(asc(operationsPromotionCampaign.startedOn), asc(operationsContentVersion.contentName)),
  database.select({
    id: operationsPromotionStage.id,
    campaignId: operationsPromotionStage.campaignId,
    stageType: operationsPromotionStage.stageType,
    startedOn: operationsPromotionStage.startedOn,
    endedOn: operationsPromotionStage.endedOn,
    outcome: operationsPromotionStage.outcome,
  }).from(operationsPromotionStage)
    .innerJoin(operationsPromotionCampaign, eq(operationsPromotionStage.campaignId, operationsPromotionCampaign.id))
    .where(campaignScope)
    .orderBy(asc(operationsPromotionStage.startedOn)),
  database.select({
    id: operationsPromotionDailyMetric.id,
    campaignId: operationsPromotionDailyMetric.campaignId,
    metricDate: operationsPromotionDailyMetric.metricDate,
    dailyStatus: operationsPromotionDailyMetric.dailyStatus,
    stageTypeSnapshot: operationsPromotionDailyMetric.stageTypeSnapshot,
    spend: operationsPromotionDailyMetric.spend,
    clickRate: operationsPromotionDailyMetric.clickRate,
    platformOpenCount: operationsPromotionDailyMetric.platformOpenCount,
    actualOpenCount: operationsPromotionDailyMetric.actualOpenCount,
    platformLeadCount: operationsPromotionDailyMetric.platformLeadCount,
    actualLeadCount: operationsPromotionDailyMetric.actualLeadCount,
    reviewDecision: operationsPromotionDailyMetric.reviewDecision,
    note: operationsPromotionDailyMetric.note,
  }).from(operationsPromotionDailyMetric)
    .innerJoin(operationsPromotionCampaign, eq(operationsPromotionDailyMetric.campaignId, operationsPromotionCampaign.id))
    .where(activeView === 'history' && historyMode === 'day'
      ? and(campaignScope, lte(operationsPromotionDailyMetric.metricDate, historyTo), historyFrom ? gte(operationsPromotionDailyMetric.metricDate, historyFrom) : undefined)
      : campaignScope)
    .orderBy(asc(operationsPromotionDailyMetric.metricDate)),
  activeView === 'daily' ? database.select({
    scheduleId: operationsContentSchedule.id,
    actualPublishAt: operationsContentSchedule.actualPublishAt,
    promotionDeferredThrough: operationsContentSchedule.promotionDeferredThrough,
    contentName: operationsContentVersion.contentName,
    versionNumber: operationsContentVersion.versionNumber,
    subjectName: operationsSubject.name,
    categoryName: operationsCategory.name,
    contentId: operationsContent.id,
    platformNoteId: operationsContent.platformNoteId,
  }).from(operationsContentSchedule)
    .innerJoin(operationsContentVersion, eq(operationsContentSchedule.contentVersionId, operationsContentVersion.id))
    .innerJoin(operationsContent, eq(operationsContentVersion.contentId, operationsContent.id))
    .innerJoin(operationsSubject, eq(operationsContentVersion.subjectId, operationsSubject.id))
    .leftJoin(operationsCategory, eq(operationsContentVersion.categoryId, operationsCategory.id))
    .where(eq(operationsContentSchedule.promotionStatus, 'awaiting_promotion'))
    .orderBy(asc(operationsContentSchedule.actualPublishAt), asc(operationsContentVersion.contentName)) : Promise.resolve([]),
  readPromotionContext(database),
  ]) as [typeof campaigns, typeof stages, typeof metrics, typeof awaitingSchedules, typeof promotionContext];
  timelineRows=await readPromotionTimeline(database);
  campaigns = campaigns.map(campaign => {
    if (!promotionContext.waitRanges.some(range => range.campaignId === campaign.id)) return campaign;
    const state = promotionStateOn(campaign, promotionContext, today);
    if (!state) return campaign;
    stages = [...stages.filter(stage => stage.campaignId !== campaign.id), ...state.stages.map(stage => ({ ...stage, campaignId: campaign.id, id: `${campaign.id}:${stage.stageType}:${stage.startedOn}` }))];
    return { ...campaign, currentStage: state.currentStage, currentStatus: state.currentStatus, endedOn: state.endedOn };
  });
  const active = promotionContext.pauses.find(pause => pauseIsActive(pause)) ?? null;
  const running = campaigns.filter(campaign => ['testing','scaling'].includes(visibleStatus(campaign)));
  pauseInfo = { active, testing: running.filter(campaign => campaign.currentStage === 'testing').length, scaling: running.filter(campaign => campaign.currentStage === 'scaling').length, affected: active ? promotionContext.targets.filter(target => target.pauseId === active.id).length : running.length };
} } catch (error) {
  console.error('daily promotion review query failed', error);
  databaseError = '推广日度数据暂时不可用。请确认开发库已经执行最新迁移。';
}
Astro.response.headers.set('Server-Timing', `db;dur=${(performance.now() - databaseStartedAt).toFixed(1)}`);

const dateRange = (start: string, end: string) => {
  const dates: string[] = [];
  for (let date = start; date <= end; date = nextDateKey(date)) dates.push(date);
  return dates;
};

const latestFilledDate = metrics.at(-1)?.metricDate ?? null;
const displayedCampaigns = campaigns.filter((campaign) =>
  campaign.endedOn === null
  && campaign.currentStage !== null
  && ['testing', 'scaling', 'waiting_action'].includes(campaign.currentStatus)
  && metrics.some((metric) => metric.campaignId === campaign.id));
const awaitingRows=timelineRows.filter(row=>isPendingPromotionRow(row));
const pendingRows = campaigns.flatMap((campaign) => {
  if (campaign.startedOn > yesterday) return [];
  const campaignMetrics = metrics.filter((metric) => metric.campaignId === campaign.id);
  const windows = [...campaignPauseWindows(campaign, promotionContext), ...campaignWaitWindows(campaign, promotionContext), ...promotionContext.holds.filter(hold => hold.campaignId === campaign.id)];
  const expectedDate = firstMissingPromotionDate(campaignMetrics, campaign.startedOn, windows);
  if (expectedDate > yesterday) return [];
  return dateRange(expectedDate, yesterday).filter(date => !campaignMetrics.some(metric=>metric.metricDate===date)&&!dateInWindows(date, windows) && promotionStateOn(campaign, promotionContext, date)?.currentStage).map((metricDate, index) => ({
    campaign,
    metricDate,
    unlocked: index === 0,
    stageType: index === 0 ? promotionStateOn(campaign, promotionContext, metricDate)?.currentStage : null,
    campaignStatus: promotionStateOn(campaign, promotionContext, metricDate)?.currentStatus,
    blockedBy: expectedDate,
  }));
}).sort((left, right) =>
  left.metricDate.localeCompare(right.metricDate)
  || left.campaign.contentName.localeCompare(right.campaign.contentName, 'zh-CN'));

const historyRows = campaigns.map((campaign) => {
  const campaignStages = stages.filter((stage) => stage.campaignId === campaign.id);
  const campaignMetrics = metrics.filter((metric) => metric.campaignId === campaign.id);
  const lifecycleCutoff = campaignMetrics.at(-1)?.metricDate ?? campaign.startedOn;
  const testingDays = campaignStages
    .filter((stage) => stage.stageType === 'testing')
    .filter((stage) => stage.startedOn <= lifecycleCutoff)
    .reduce((total, stage) => total + countPromotionDays(stage.startedOn, stage.endedOn && stage.endedOn < lifecycleCutoff ? stage.endedOn : lifecycleCutoff, campaignPauseWindows(campaign, promotionContext)), 0);
  const scalingDays = campaignStages
    .filter((stage) => stage.stageType === 'scaling')
    .filter((stage) => stage.startedOn <= lifecycleCutoff)
    .reduce((total, stage) => total + countPromotionDays(stage.startedOn, stage.endedOn && stage.endedOn < lifecycleCutoff ? stage.endedOn : lifecycleCutoff, campaignPauseWindows(campaign, promotionContext)), 0);
  const confirmedWaitingDays = campaignMetrics.filter((metric) => metric.dailyStatus === 'waiting_action').length;
  const waitingDays = waitingPromotionDays(campaign, promotionContext, campaignMetrics.filter(metric => metric.dailyStatus === 'waiting_action').map(metric => metric.metricDate), campaign.startedOn, lifecycleCutoff);
  const firstStage = campaignStages[0];
  const lastStage = campaignStages.at(-1);
  const startedOn = firstStage?.startedOn ?? campaign.startedOn;
  const endedOn = campaign.endedOn ?? lastStage?.endedOn ?? null;
  return {
    campaign,
    stages: campaignStages,
    metrics: campaignMetrics,
    startedOn,
    endedOn,
    testingDays,
    scalingDays,
    waitingDays,
    expectedDays: testingDays + scalingDays + confirmedWaitingDays,
    reviewedDays: campaignMetrics.length,
  };
}).filter((row) => {
  const overlapsRange = row.startedOn <= historyTo && (!row.endedOn || row.endedOn >= historyFrom);
  const matchesQuery = !historyQuery
    || row.campaign.contentName.toLocaleLowerCase().includes(historyQuery.toLocaleLowerCase());
  const matchesStatus = !historyStatus || visibleStatus(row.campaign) === historyStatus;
  return overlapsRange && matchesQuery && matchesStatus;
}).sort((left, right) => {
  const leftActive = ['testing', 'scaling', 'waiting_action'].includes(left.campaign.currentStatus) ? 0 : 1;
  const rightActive = ['testing', 'scaling', 'waiting_action'].includes(right.campaign.currentStatus) ? 0 : 1;
  return leftActive - rightActive || right.startedOn.localeCompare(left.startedOn);
});
const activeHistoryRows = historyRows.filter((row) => ['testing', 'scaling', 'waiting_action'].includes(row.campaign.currentStatus));
const endedHistoryRows = historyRows.filter((row) => !['testing', 'scaling', 'waiting_action'].includes(row.campaign.currentStatus));
const forceOpenEnded = Boolean(historyQuery || historyStatus || (selectedCampaignId && endedHistoryRows.some((row) => row.campaign.id === selectedCampaignId)));
const campaignById = new Map(campaigns.map((campaign) => [campaign.id, campaign]));
const historyDayGroups = [...new Set(metrics
  .filter((metric) => metric.metricDate >= historyFrom && metric.metricDate <= historyTo)
  .filter((metric) => {
    const campaign = campaignById.get(metric.campaignId);
    return campaign
      && (!historyQuery || campaign.contentName.toLocaleLowerCase().includes(historyQuery.toLocaleLowerCase()))
      && (!historyStatus || visibleStatus(campaign) === historyStatus);
  })
  .map((metric) => metric.metricDate))]
  .sort((left, right) => right.localeCompare(left))
  .map((metricDate) => {
    const rows = metrics.filter((metric) => metric.metricDate === metricDate && campaignById.has(metric.campaignId))
      .filter((metric) => {
        const campaign = campaignById.get(metric.campaignId)!;
        return (!historyQuery || campaign.contentName.toLocaleLowerCase().includes(historyQuery.toLocaleLowerCase()))
          && (!historyStatus || visibleStatus(campaign) === historyStatus);
      });
    return {
      metricDate,
      rows,
      spend: rows.reduce((sum, metric) => sum + Number(metric.spend), 0),
      platformOpenCount: rows.reduce((sum, metric) => sum + metric.platformOpenCount, 0),
      actualOpenCount: rows.reduce((sum, metric) => sum + metric.actualOpenCount, 0),
      actualLeadCount: rows.reduce((sum, metric) => sum + metric.actualLeadCount, 0),
    };
  });
const selectedHistoryRow = selectedCampaignId
  ? historyRows.find((row) => row.campaign.id === selectedCampaignId) ?? null
  : null;
const historyHref = (overrides: Record<string, string>) => {
  const params = new URLSearchParams({
    view: 'history',
    mode: historyMode,
    from: historyFrom,
    to: historyTo,
    ...(historyQuery ? { q: historyQuery } : {}),
    ...(historyStatus ? { status: historyStatus } : {}),
    ...overrides,
  });
  return `?${params.toString()}`;
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="填写推广帖日度数据，查看测试与放量生命周期。" />
    <title>Daily Promotion Review · 内容发布控制台</title>
  </head>
  <body>
    <BusinessConsoleFrame active="daily-promotion">
        <BusinessPromotionToolbar stage={activeView==='stage'} />

        <main class="business-console-content">

          {activeView === 'stage' && <BusinessPromotionStageView />}
          {databaseError && <p class="notice" role="alert">{databaseError}</p>}

          {activeView === 'daily' && <>
          <section class="calendar-section" aria-labelledby="calendar-title">
            <BusinessPageHeader title="最新推广生命周期" headingId="calendar-title" contained>
              <p class="lifecycle-meta" slot="meta"><span><i class="legend testing"></i>测试</span><span><i class="legend scaling"></i>放量</span><span class="lifecycle-cutoff">数据截至 {latestFilledDate ? formatFullDate(latestFilledDate) : '尚未填写'}</span></p>
            </BusinessPageHeader>
            {!databaseError && displayedCampaigns.length === 0
              ? <div class="empty-state"><strong>当前没有进行中的推广生命周期</strong><p>已经结束或淘汰的推广内容只保留在历史记录中。</p></div>
              : <div class="lifecycle-list">
                  {displayedCampaigns.map((campaign) => {
                    const lifecycleCutoff = metrics.filter((metric) => metric.campaignId === campaign.id).at(-1)!.metricDate;
                    const campaignStages = stages
                      .filter((stage) => {
                        return stage.campaignId === campaign.id && !(stage.startedOn > lifecycleCutoff);
                      });
                    const stageDetails = campaignStages.map((stage) => {
                      const visibleEnd = stage.endedOn && stage.endedOn < lifecycleCutoff ? stage.endedOn : lifecycleCutoff;
                      const open = !stage.endedOn || stage.endedOn > lifecycleCutoff;
                      return {
                        ...stage,
                        visibleEnd,
                        open,
                        days: countPromotionDays(stage.startedOn, visibleEnd, campaignPauseWindows(campaign, promotionContext)),
                      };
                    });
                    const shares = promotionStageShares(stageDetails.map((stage) => stage.days));
                    const waitingDays = waitingPromotionDays(campaign, promotionContext, metrics.filter(metric => metric.campaignId === campaign.id && metric.dailyStatus === 'waiting_action').map(metric => metric.metricDate), campaign.startedOn, lifecycleCutoff);
                    const currentLabel = statusLabels[visibleStatus(campaign)];
                    return <article class="lifecycle-card" data-lifecycle-schedule={campaign.scheduleId}>
                      <header>
                        <a href={`/business/operations-schedule?view=promotion&promotion=${visibleStatus(campaign)}#${campaign.scheduleId}`}>
                          <strong>{campaign.contentName}</strong>
                          <span>V{campaign.versionNumber} · {campaign.subjectName}{campaign.categoryName ? ` / ${campaign.categoryName}` : ''}</span>
                          <code class="promotion-note-id" title={campaign.platformNoteId||undefined}>{campaign.platformNoteId ? `ID ${campaign.platformNoteId}` : '笔记 ID 待补'}</code>
                        </a>
                        <mark class={`lifecycle-status ${visibleStatus(campaign)}`}>{currentLabel}</mark>
                      </header>
                      <div class="stage-summaries">
                        {stageDetails.map((stage) => <p class={stage.stageType}>
                          <b>{stage.stageType === 'testing' ? '测试' : '放量'} {stage.days} 天{stage.open ? (['promotion_paused','test_pending'].includes(visibleStatus(campaign)) ? ' · 已暂停' : ' · 进行中') : ''}</b>
                          <span>（{formatFullDate(stage.startedOn)}－{formatFullDate(stage.visibleEnd)}）</span>
                        </p>)}
                        {waitingDays > 0 && <p class="waiting_action"><b>待定／暂停 {waitingDays} 天{campaign.currentStatus === 'waiting_action' ? ' · 进行中' : ''}</b><span>不计入测试或放量天数</span></p>}
                      </div>
                      <div class="relative-track" aria-label={`${campaign.contentName}生命周期比例`}>
                        {stageDetails.map((stage, index) => <span
                          class={stage.stageType}
                          style={`width:${shares[index]}%`}
                          title={`${stage.stageType === 'testing' ? '测试' : '放量'} ${stage.days} 天`}
                        ><b>{stage.stageType === 'testing' ? '测试' : '放量'} {Math.round(shares[index] ?? 0)}%</b></span>)}
                      </div>
                    </article>;
                  })}
                </div>}
          </section>



          <section class="daily-section" id="daily-table" aria-labelledby="daily-title">
            <div class="pending-heading"><BusinessSectionHeader title="待完成复盘" headingId="daily-title" description="按日期顺序完成" contained wrap><Fragment slot="heading-end"><small data-promotion-pending-count>{pendingRows.length + awaitingRows.length}</small><a href="?view=history">点击进入历史总览查看 ↗</a></Fragment><BusinessPromotionPause slot="end" summary={pauseInfo} /></BusinessSectionHeader></div>
            <div class="promotion-pending-content" data-promotion-pending-body>
            <BusinessPromotionTimeline rows={timelineRows}/>
            {!databaseError && pendingRows.length === 0 && awaitingRows.length === 0
              ? <div class="empty-state"><strong>截至昨天已全部完成</strong><p>已填数据保存在历史总览；新的待办会在下一复盘日出现。</p></div>
              : <div class="daily-table-wrap">
                <div class="daily-grid" aria-label="待完成日度推广复盘">
                  {pendingRows.map(({ campaign, metricDate, unlocked, stageType, campaignStatus, blockedBy }) => {
                    const defaultWaiting = campaignStatus === 'waiting_action';
                    const decisionOptions = stageType === 'scaling'
                      ? ['scaling_continue','wait_continue','formal_discarded','ended']
                      : ['test_continue','wait_continue','test_discarded','start_scaling'];
                    return unlocked
                      ? <form class="business-form metric-form review-metric-row" data-metric-form data-current-stage={stageType} data-campaign-status={campaignStatus} data-schedule-id={campaign.scheduleId} data-fingerprint={timelineRows.find(row=>row.scheduleId===campaign.scheduleId)?.fingerprint}>
                          <input type="hidden" name="campaignId" value={campaign.id} />
                          <input type="hidden" name="metricDate" value={metricDate} />
                          <input type="hidden" name="dailyStatus" value={defaultWaiting ? 'waiting_action' : 'active'} />
                          <input type="hidden" name="stageTypeSnapshot" value={stageType} />
                          <header class="review-entry-header">
                           <div class="review-entry-identity"><strong>{campaign.contentName}</strong><small>V{campaign.versionNumber} · {campaign.subjectName}{campaign.platformNoteId&&<span class="review-note-id" title={campaign.platformNoteId}> · ID {campaign.platformNoteId}</span>}</small></div>
                           <div class="review-entry-date"><span>数据日期</span><time datetime={metricDate}>{metricDate}</time></div>
                           <label class={`stage-cell review-day-state ${defaultWaiting ? 'waiting_action' : stageType}`}><span>当日状态</span><select name="dayAction" aria-label="当日状态"><option value="active">{defaultWaiting?(stageType==='testing'?'测试待定':'推广暂停'):stageType==='scaling'?'放量':'测试'}</option><option value="pause">当日暂停</option></select></label>
                          </header>
                          <div class="review-metric-fields" data-active-fields>
                           <div class="review-metric-inputs">
                           <label>消耗<input aria-label="消耗" name="spend" type="number" min="0" step="0.01" placeholder="¥" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           <label>平台开口<input aria-label="平台开口人数" name="platformOpenCount" type="number" min="0" step="1" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           <label>实际开口<input aria-label="实际开口人数" name="actualOpenCount" type="number" min="0" step="1" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           <label>平台留资<input aria-label="平台留资人数" name="platformLeadCount" type="number" min="0" step="1" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           <label>实际留资<input aria-label="实际留资人数" name="actualLeadCount" type="number" min="0" step="1" value={defaultWaiting ? 0 : undefined} readonly={defaultWaiting} required /></label>
                           </div>
                           <dl class="review-costs" aria-label="自动计算成本"><div class="review-cost"><dt>实际开口成本</dt><dd><output data-open-cost aria-label="实际开口成本">—</output></dd></div><div class="review-cost"><dt>实际留资成本</dt><dd><output data-lead-cost aria-label="实际留资成本">—</output></dd></div></dl>
                          </div>
                          <div class="review-pause-fields" data-pause-fields hidden>
                           <label data-pause-reason>暂停原因<input name="pauseReason" maxlength="2000" disabled/></label><label data-pause-through>暂停至（含当天）<input type="date" name="pauseThrough" value={metricDate} min={metricDate} disabled/></label>
                           <p class="review-draft-preview" data-pause-preview aria-live="polite"/>
                          </div>
                          <footer class="review-metric-actions">
                           {!campaign.platformNoteId && <label class="review-id-entry" data-active-id><span>笔记 ID</span><input name="platformNoteId" data-note-id-required pattern="[0-9A-Fa-f]{24}" maxlength="24" required placeholder="首次日度复盘填写" /></label>}
                           <div class="review-completion"><label class="review-decision" data-active-decision><span>下一步</span><select data-review-decision aria-label="下一步" name="reviewDecision" required><option value="">请选择</option>{decisionOptions.map((decision) => <option value={decision}>{decision === 'wait_continue' ? (stageType === 'testing' ? '测试待定' : '推广暂停') : decisionLabels[decision]}</option>)}</select></label><button type="submit" class="business-action-primary">完成复盘</button></div><p role="alert" data-form-message></p>
                          </footer>
                        </form>
                      : <div data-locked-schedule={campaign.scheduleId} class="review-metric-row review-locked-row">
                          <header class="review-entry-header"><div class="review-entry-identity"><strong>{campaign.contentName}</strong><small>V{campaign.versionNumber} · {campaign.subjectName}</small></div><div class="review-entry-date"><span>数据日期</span><time datetime={metricDate}>{metricDate}</time></div><span class="review-state-badge">待前日复盘</span></header>
                          <p class="review-locked-message">请先完成 {blockedBy}，再处理这一天的数据与状态。</p>
                        </div>;
                  })}
                </div>
              </div>}
            </div>
          </section>

          </>}

          {activeView === 'history' && <section class="history-workspace" aria-labelledby="history-title">
            <div class="history-head"><a class="history-back" href="?view=daily">← 返回每日复盘</a>
              <BusinessPageHeader title="推广历史总览" headingId="history-title" />
              <form class="history-filters business-filter" method="get">
                <input type="hidden" name="view" value="history" />
                <input type="hidden" name="mode" value={historyMode} />
                <label><span>开始日期</span><input type="date" name="from" value={historyFrom} max={historyTo} /></label>
                <label><span>结束日期</span><input type="date" name="to" value={historyTo} max={yesterday} /></label>
                <label class="history-search"><span>帖子</span><input type="search" name="q" value={historyQuery} placeholder="搜索帖子名称" /></label>
                <label><span>状态</span><select name="status">
                  <option value="">全部状态</option>
                  {Object.entries(statusLabels).map(([value, label]) => <option value={value} selected={historyStatus === value}>{label}</option>)}
                </select></label>
                <button type="submit">查看</button>
                <a href={`?view=history&mode=${historyMode}`}>重置范围</a>
              </form>
            </div>
            <nav class="history-mode-switch" aria-label="历史总览粒度">
              <a class:list={{ active: historyMode === 'post' }} href={historyHref({ mode: 'post', campaign: '' })}>帖子视角</a>
              <a class:list={{ active: historyMode === 'day' }} href={historyHref({ mode: 'day', campaign: '' })}>日视角</a>
            </nav>
          {<BusinessPromotionTimeline history rows={timelineRows.filter(row=>(!historyQuery||row.contentName.toLocaleLowerCase().includes(historyQuery.toLocaleLowerCase()))&&row.publishedOn<=historyTo&&(!row.campaign?.endedOn||row.campaign.endedOn>=historyFrom)&&(!historyStatus||(row.campaign?visibleStatus(row.campaign):row.promotionStatus)===historyStatus))}/>}
            <div class="history-layout" data-inspector-host>
              {historyMode === 'post' ? <div class="history-list" role="table" aria-label="推广历史活动">
                <div class="history-table-head history-record" role="row">
                  <span>帖子</span><span>推广区间</span><span>测试</span><span>放量</span><span>等待</span><span>复盘完成</span><span>状态</span>
                </div>
                {historyRows.length === 0
                  ? <div class="empty-state"><strong>该范围内没有推广活动</strong><p>调整日期、帖子名称或状态筛选。</p></div>
                  : activeHistoryRows.map((row) => {
                      const completion = row.expectedDays > 0
                        ? Math.min(100, Math.round((row.reviewedDays / row.expectedDays) * 100))
                        : 0;
                      return <a
                        class:list={['history-record', { selected: selectedHistoryRow?.campaign.id === row.campaign.id }]}
                        data-history-schedule={row.campaign.scheduleId} data-inspector-key={row.campaign.id} href={historyHref({ campaign: row.campaign.id })}
                        role="row"
                      >
                        <span class="history-identity" role="cell"><strong>{row.campaign.contentName}</strong><small>V{row.campaign.versionNumber} · {row.campaign.subjectName}</small><code class="promotion-note-id" title={row.campaign.platformNoteId||undefined}>{row.campaign.platformNoteId ? `ID ${row.campaign.platformNoteId}` : '笔记 ID 待补'}</code></span>
                        <span role="cell" data-label="推广区间">{formatRange(row.startedOn, row.endedOn)}</span>
                        <span role="cell" data-label="测试"><b>{row.testingDays}</b> 天</span>
                        <span role="cell" data-label="放量"><b>{row.scalingDays}</b> 天</span>
                        <span role="cell" data-label="等待"><b>{row.waitingDays}</b> 天</span>
                        <span class="history-progress" role="cell" data-label="复盘完成"><b>{row.reviewedDays}/{row.expectedDays}</b><i><em style={`width:${completion}%`}></em></i></span>
                        <span role="cell" data-label="状态"><mark class={`history-status ${visibleStatus(row.campaign)}`}>{statusLabels[visibleStatus(row.campaign)]}</mark></span>
                      </a>;
                    })}
                {endedHistoryRows.length > 0 && <details class="ended-campaigns" open={forceOpenEnded}>
                  <summary><span>已结束推广 <small class="ended-expand">点击展开</small><small class="ended-collapse">点击收起</small></span><b>{endedHistoryRows.length} 个活动</b></summary>
                  {endedHistoryRows.map((row) => {
                    const completion = row.expectedDays > 0
                      ? Math.min(100, Math.round((row.reviewedDays / row.expectedDays) * 100)) : 0;
                    return <a class:list={['history-record', { selected: selectedHistoryRow?.campaign.id === row.campaign.id }]}
                      data-history-schedule={row.campaign.scheduleId} data-inspector-key={row.campaign.id} href={historyHref({ campaign: row.campaign.id })} role="row">
                      <span class="history-identity" role="cell"><strong>{row.campaign.contentName}</strong><small>V{row.campaign.versionNumber} · {row.campaign.subjectName}</small><code class="promotion-note-id" title={row.campaign.platformNoteId||undefined}>{row.campaign.platformNoteId ? `ID ${row.campaign.platformNoteId}` : '笔记 ID 待补'}</code></span>
                      <span role="cell" data-label="推广区间">{formatRange(row.startedOn, row.endedOn)}</span>
                      <span role="cell" data-label="测试"><b>{row.testingDays}</b> 天</span>
                      <span role="cell" data-label="放量"><b>{row.scalingDays}</b> 天</span>
                      <span role="cell" data-label="等待"><b>{row.waitingDays}</b> 天</span>
                      <span class="history-progress" role="cell" data-label="复盘完成"><b>{row.reviewedDays}/{row.expectedDays}</b><i><em style={`width:${completion}%`}></em></i></span>
                      <span role="cell" data-label="状态"><mark class={`history-status ${visibleStatus(row.campaign)}`}>{statusLabels[visibleStatus(row.campaign)]}</mark></span>
                    </a>;
                  })}
                </details>}
              </div> : <div class="day-history" aria-label="按日期查看推广历史">
                {historyDayGroups.length === 0
                  ? <div class="empty-state"><strong>该范围内没有日度记录</strong><p>调整日期、帖子名称或状态筛选。</p></div>
                  : historyDayGroups.map((group) => <section class="day-group">
                    <header>
                      <div><h2>{formatFullDate(group.metricDate)}</h2></div>
                      <dl>
                        <div><dt>总消耗</dt><dd>¥{group.spend.toFixed(2)}</dd></div>
                        <div><dt>总开口</dt><dd>{group.platformOpenCount}</dd></div>
                        <div><dt>总实际开口</dt><dd>{group.actualOpenCount}</dd></div>
                        <div><dt>总实际留资</dt><dd>{group.actualLeadCount}</dd></div>
                      </dl>
                    </header>
                    <div class="day-table">
                      <div class="day-row day-row-head"><span>帖子</span><span>阶段 / 下一步</span><span>消耗</span><span>开口</span><span>实际开口</span><span>实际留资</span></div>
                      {group.rows.map((metric) => {
                        const campaign = campaignById.get(metric.campaignId)!;
                        return <a class="day-row" data-history-schedule={campaign.scheduleId} data-history-date={group.metricDate} data-inspector-key={campaign.id} href={historyHref({ mode: 'post', campaign: campaign.id })}>
                          <span class="history-identity"><strong>{campaign.contentName}</strong><small>V{campaign.versionNumber} · {campaign.subjectName}</small></span>
                          <span><mark class={`history-status ${metric.dailyStatus === 'waiting_action' ? 'waiting_action' : metric.stageTypeSnapshot}`}>{metric.dailyStatus === 'waiting_action' ? (metric.stageTypeSnapshot === 'testing' ? '测试待定' : '推广暂停') : metric.stageTypeSnapshot === 'testing' ? '测试期' : '放量期'}</mark><small>{metric.reviewDecision === 'wait_continue' ? (metric.stageTypeSnapshot === 'testing' ? '测试待定' : '推广暂停') : decisionLabels[metric.reviewDecision]}</small></span>
                          <span>¥{Number(metric.spend).toFixed(2)}</span><span>{metric.platformOpenCount}</span><span>{metric.actualOpenCount}</span><span>{metric.actualLeadCount}</span>
                        </a>;
                      })}
                    </div>
                  </section>)}
              </div>}
              <BusinessInspector class="history-inspector" parameter="campaign" templates />
              {historyRows.map(selectedHistoryRow => <template data-history-schedule={selectedHistoryRow.campaign.scheduleId} data-inspector-template={selectedHistoryRow.campaign.id}>
                <header>
                  <div><h2 data-inspector-title>{selectedHistoryRow.campaign.contentName}</h2><p>V{selectedHistoryRow.campaign.versionNumber} · {selectedHistoryRow.campaign.subjectName}</p></div>
                  <a href={historyHref({ campaign: '' })} data-close-inspector aria-label="关闭历史详情">×</a>
                </header>
                <dl class="inspector-summary">
                  <div><dt>笔记 ID</dt><dd><code>{selectedHistoryRow.campaign.platformNoteId ?? '待补'}</code></dd></div>
                  <div><dt>推广区间</dt><dd>{formatRange(selectedHistoryRow.startedOn, selectedHistoryRow.endedOn)}</dd></div>
                  <div><dt>阶段</dt><dd>测试 {selectedHistoryRow.testingDays} 天 · 放量 {selectedHistoryRow.scalingDays} 天 · 等待 {selectedHistoryRow.waitingDays} 天</dd></div>
                  <div><dt>复盘</dt><dd>{selectedHistoryRow.reviewedDays}/{selectedHistoryRow.expectedDays} 天</dd></div>
                  <div><dt>状态</dt><dd>{statusLabels[visibleStatus(selectedHistoryRow.campaign)]}</dd></div>
                </dl>
                {selectedHistoryRow.campaign.platformNoteId && <details class="note-id-correction" data-admin-only><summary>更正笔记 ID</summary><form class="business-form" data-note-id-correction action={`/api/operations-content/${selectedHistoryRow.campaign.contentId}/platform-note-id`}><input type="hidden" name="confirmSharedUpdate" value="true"/><input type="hidden" data-old-note-id value={selectedHistoryRow.campaign.platformNoteId}/><input name="platformNoteId" aria-label="新笔记 ID" pattern="[0-9A-Fa-f]{24}" maxlength="24" required placeholder="新的 24 位笔记 ID"/><button>确认更正</button><output></output></form><p>该帖子的全部版本与复盘都会同步。</p></details>}
                <BusinessPromotionWaitRanges campaigns={[selectedHistoryRow.campaign]} ranges={promotionContext.waitRanges} context={promotionContext} historical={true}/>
                {promotionContext.holds.filter(hold => hold.campaignId === selectedHistoryRow.campaign.id).map(hold => <p class="history-hold">{hold.stageType === 'testing' ? '测试待定' : '推广暂停'} · {formatRange(hold.startedOn, hold.endedOn)}</p>)}
                <div class="stage-history">
                  {selectedHistoryRow.stages.map((stage) => <p class={stage.stageType}>
                    <b>{stage.stageType === 'testing' ? '测试' : '放量'} {countPromotionDays(stage.startedOn, stage.endedOn ?? yesterday, campaignPauseWindows(selectedHistoryRow.campaign, promotionContext))} 天</b>
                    <span>{formatRange(stage.startedOn, stage.endedOn)}</span>
                  </p>)}
                </div>
                <section class="inspector-days" aria-label="逐日复盘明细">
                  <h3>逐日复盘</h3>
                  {selectedHistoryRow.metrics.length === 0
                    ? <div class="inspector-empty">还没有已填写的日度事实。</div>
                    : selectedHistoryRow.metrics.slice().reverse().map((metric) => {
                        const costs = calculateActualPromotionCosts({
                          spend: Number(metric.spend),
                          actualOpenCount: metric.actualOpenCount,
                          actualLeadCount: metric.actualLeadCount,
                        });
                        const decisionOptions = metric.stageTypeSnapshot === 'scaling'
                          ? ['scaling_continue','wait_continue','formal_discarded','ended']
                          : ['test_continue','wait_continue','test_discarded','start_scaling'];
                        return <article class="history-day" data-metric-card={metric.id}>
                          <header><strong>{formatDate(metric.metricDate)}</strong><span>{metric.dailyStatus === 'waiting_action' ? (metric.stageTypeSnapshot === 'testing' ? '测试待定' : '推广暂停') : metric.stageTypeSnapshot === 'testing' ? '测试' : '放量'} · {metric.reviewDecision === 'wait_continue' ? (metric.stageTypeSnapshot === 'testing' ? '测试待定' : '推广暂停') : decisionLabels[metric.reviewDecision]}</span></header>
                          <dl>
                            <div><dt>消耗</dt><dd>¥{Number(metric.spend).toFixed(2)}</dd></div>
                            <div><dt>开口</dt><dd>{metric.platformOpenCount} / {metric.actualOpenCount}</dd></div>
                            <div><dt>留资</dt><dd>{metric.platformLeadCount} / {metric.actualLeadCount}</dd></div>
                            <div><dt>实际开口成本</dt><dd>{costs.actualOpenCost == null ? '—' : `¥${costs.actualOpenCost.toFixed(2)}`}</dd></div>
                            <div><dt>实际留资成本</dt><dd>{costs.actualLeadCost == null ? '—' : `¥${costs.actualLeadCost.toFixed(2)}`}</dd></div>
                          </dl>
                          {metric.note && <p class="history-note">{metric.note}</p>}
                          <button type="button" class="edit-history-button" data-edit-trigger={metric.id}>编辑这一天</button>
                          <BusinessFormDialog class="history-edit-dialog" data-edit-dialog={metric.id} labelledby={`history-edit-${metric.id}`} darkHeader data-form-editor>
                            <form class="business-form" data-history-edit-form>
                              <header class="dialog-head"><div><h3 id={`history-edit-${metric.id}`}>{formatFullDate(metric.metricDate)}</h3><p>{selectedHistoryRow.campaign.contentName} · {metric.stageTypeSnapshot === 'testing' ? '测试期' : '放量期'}</p></div><button type="button" data-close-edit aria-label="关闭">×</button></header>
                              <input type="hidden" name="metricId" value={metric.id} />
                              <input type="hidden" name="dailyStatus" value={metric.dailyStatus} />
                              <input type="hidden" name="stageTypeSnapshot" value={metric.stageTypeSnapshot} />
                              <div class="form-dialog-body"><div class="edit-fields">
                                <p class="edit-system-state"><span>当日状态</span><strong>{metric.dailyStatus === 'waiting_action' ? (metric.stageTypeSnapshot === 'testing' ? '测试待定' : '推广暂停') : metric.stageTypeSnapshot === 'testing' ? '测试' : '放量'}</strong><small>由前一天的“下一步”决定</small></p>
                                <label>消耗<input name="spend" type="number" min="0" step="0.01" value={Number(metric.spend).toFixed(2)} readonly={metric.dailyStatus === 'waiting_action'} required /></label>
                                <label>平台开口<input name="platformOpenCount" type="number" min="0" step="1" value={metric.platformOpenCount} readonly={metric.dailyStatus === 'waiting_action'} required /></label>
                                <label>实际开口<input name="actualOpenCount" type="number" min="0" step="1" value={metric.actualOpenCount} readonly={metric.dailyStatus === 'waiting_action'} required /></label>
                                <label>平台留资<input name="platformLeadCount" type="number" min="0" step="1" value={metric.platformLeadCount} readonly={metric.dailyStatus === 'waiting_action'} required /></label>
                                <label>实际留资<input name="actualLeadCount" type="number" min="0" step="1" value={metric.actualLeadCount} readonly={metric.dailyStatus === 'waiting_action'} required /></label>
                                <label>下一步<select name="reviewDecision" data-history-decision required disabled={Astro.locals.user?.role !== 'admin'}>{decisionOptions.map((decision) => <option value={decision} selected={metric.reviewDecision === decision}>{decision === 'wait_continue' ? (metric.stageTypeSnapshot === 'testing' ? '测试待定' : '推广暂停') : decisionLabels[decision]}</option>)}</select></label>
                                <label class="edit-note">备注<textarea name="note" maxlength="500" rows="3">{metric.note ?? ''}</textarea></label>
                              </div>
                              <p class="edit-impact" data-edit-message role="alert"></p></div>
                              <footer class="dialog-actions"><button type="button" data-close-edit>取消</button><button type="submit">保存修改</button></footer>
                            </form>
                          </BusinessFormDialog>
                        </article>;
                      })}
                </section>
              </template>)}
            </div>
          </section>}
        </main>
    </BusinessConsoleFrame>

    <script>
      import {refreshPromotionSchedule} from '../../scripts/promotion-timeline';
      import {randomRequestKey} from '../../scripts/promotion-timeline';
      import {promotionIntervalPreview} from '../../db/promotion-pending';
      import { getInspector } from '../../scripts/business-inspector';
      import {businessConfirm} from '../../scripts/business-dialog';
      const cleanInspector = (form:HTMLFormElement) => { const pane=form.closest<HTMLElement>('[data-inspector]'); if(pane)getInspector(pane).setClean(); };
      const formatCost = (spend: number, count: number) => count > 0 ? `¥${(spend / count).toFixed(2)}` : '—';
      const initializeDailyForms = () => {
      document.querySelectorAll<HTMLFormElement>('[data-metric-form]:not([data-daily-ready])').forEach((form) => {
        const openCost = form.querySelector<HTMLOutputElement>('[data-open-cost]');
        const leadCost = form.querySelector<HTMLOutputElement>('[data-lead-cost]');
        const message = form.querySelector<HTMLElement>('[data-form-message]');
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!openCost || !leadCost || !message || !button) return;
        form.dataset.dailyReady = 'true';
        const requestKey=randomRequestKey();
        const syncPause=()=>{const paused=(form.elements.namedItem('dayAction') as HTMLSelectElement).value==='pause';
          for(const name of ['spend','platformOpenCount','actualOpenCount','platformLeadCount','actualLeadCount','platformNoteId']){const control=form.elements.namedItem(name) as HTMLInputElement|null;if(control){control.disabled=paused;control.required=!paused;}}
          const decision=form.elements.namedItem('reviewDecision') as HTMLSelectElement;decision.required=!paused;decision.disabled=paused;
          for(const selector of ['[data-active-fields]','[data-active-id]','[data-active-decision]']){const host=form.querySelector<HTMLElement>(selector);if(host)host.hidden=paused;}
          const fields=form.querySelector<HTMLElement>('[data-pause-fields]');if(fields)fields.hidden=!paused;
          for(const selector of ['[data-pause-reason]','[data-pause-through]']){const host=form.querySelector<HTMLElement>(selector)!;host.hidden=!paused;host.querySelectorAll<HTMLInputElement>('input').forEach(input=>{input.disabled=!paused;input.required=paused;});}
          const preview=form.querySelector<HTMLElement>('[data-pause-preview]');if(preview)preview.textContent=promotionIntervalPreview(String((form.elements.namedItem('metricDate') as HTMLInputElement).value),String((form.elements.namedItem('pauseThrough') as HTMLInputElement).value),'暂停')??'请选择不早于数据日期的暂停截止日。';
          button.textContent=paused?'保存当日暂停':'完成复盘';
        };
        form.addEventListener('change',syncPause);syncPause();
        const updateCosts = () => {
          const data = new FormData(form);
          const spend = Number(data.get('spend'));
          openCost.textContent = formatCost(spend, Number(data.get('actualOpenCount')));
          leadCost.textContent = formatCost(spend, Number(data.get('actualLeadCount')));
        };
        form.addEventListener('input',()=>{syncPause();form.dataset.dirty='true';document.documentElement.dataset.unsaved='true';updateCosts();});
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const noteId = form.querySelector<HTMLInputElement>('[data-note-id-required]');
          const paused=(form.elements.namedItem('dayAction') as HTMLSelectElement).value==='pause';
          if (noteId&&!paused) {
            if (!/^[0-9a-fA-F]{24}$/.test(noteId.value.trim())) { message.textContent = '笔记 ID 必须是 24 位十六进制字符。'; noteId.focus(); return; }
          }
          button.disabled = true;
          message.textContent = '正在保存…';
          try {
            const data=new FormData(form);
            const response = await fetch(paused?'/api/promotion-timeline':'/api/promotion-daily', {
              method: 'POST',
              body: paused?JSON.stringify({scheduleId:form.dataset.scheduleId,reviewDate:data.get('metricDate'),action:'pause',waitingThrough:data.get('pauseThrough'),reason:data.get('pauseReason'),nextDecision:data.get('reviewDecision')||undefined,requestKey,fingerprint:form.dataset.fingerprint}):data,
              headers: paused?{'Content-Type':'application/json'}:{ Accept: 'application/json' },
            });
            const result = await response.json();
            if (response.ok) {
              delete form.dataset.dirty;await refreshPromotionSchedule(form.dataset.scheduleId!);document.documentElement.dataset.unsaved=String(!!document.querySelector('form[data-dirty=true]'));
              return;
            }
            message.textContent = result.message ?? '保存失败，请重试。';
          } catch {
            message.textContent = '无法连接服务，请稍后重试。';
          } finally {
            button.disabled = false;
          }
        });
      });
      };
      initializeDailyForms();
      document.addEventListener('astro:page-load', initializeDailyForms);
      document.addEventListener('business:promotion-fragment-updated',initializeDailyForms);
      document.addEventListener('business:inspector-render', initializeDailyForms);
      const initializeHistoryEditors = () => {
        document.querySelectorAll<HTMLButtonElement>('[data-edit-trigger]:not([data-history-edit-ready])').forEach((trigger) => {
          const dialog = document.querySelector<HTMLDialogElement>(`[data-edit-dialog="${trigger.dataset.editTrigger}"]`);
          if (!dialog) return;
          trigger.dataset.historyEditReady = 'true';
          trigger.addEventListener('click', () => dialog.showModal());
          dialog.querySelectorAll<HTMLButtonElement>('[data-close-edit]').forEach((button) => button.addEventListener('click', () => dialog.close()));
        });
        document.querySelectorAll<HTMLFormElement>('[data-history-edit-form]:not([data-history-edit-ready])').forEach((form) => {
          const message = form.querySelector<HTMLElement>('[data-edit-message]');
          const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (!message || !submit) return;
          form.dataset.historyEditReady = 'true';
          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const data = new FormData(form);
            const decision = form.querySelector<HTMLSelectElement>('select[name="reviewDecision"]');
            if (decision?.disabled) data.set('reviewDecision', decision.value);
            const metricId = String(data.get('metricId'));
            submit.disabled = true;
            message.textContent = '正在保存修改…';
            try {
              let response = await fetch(`/api/promotion-daily/${metricId}`, { method: 'PATCH', body: data, headers: { Accept: 'application/json' } });
              let result = await response.json();
              if (response.status === 409 && result.correctionRequired) {
                if (!await businessConfirm(`${result.message}\n\n确认后，后续日期会重新回到待填队列。是否继续？`,{title:'确认历史影响',confirmLabel:'确认更正'})) {
                  message.textContent = '已取消修改，原数据未变化。';
                  return;
                }
                data.set('confirmCascade', 'true');
                response = await fetch(`/api/promotion-daily/${metricId}`, { method: 'PATCH', body: data, headers: { Accept: 'application/json' } });
                result = await response.json();
              }
              if (response.ok) { cleanInspector(form); return window.location.reload(); }
              message.textContent = result.message ?? '保存失败，请重试。';
            } catch {
              message.textContent = '无法连接服务，请稍后重试。';
            } finally {
              submit.disabled = false;
            }
          });
        });
      };
      initializeHistoryEditors();
      document.addEventListener('astro:page-load', initializeHistoryEditors);
      document.addEventListener('business:inspector-render', initializeHistoryEditors);
      const initializeCorrections = () => {
      document.querySelectorAll<HTMLFormElement>('[data-note-id-correction]:not([data-correction-ready])').forEach((form) => { form.dataset.correctionReady='true'; form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const oldValue = form.querySelector<HTMLInputElement>('[data-old-note-id]')!.value;
        const newValue = String(new FormData(form).get('platformNoteId') ?? '').trim().toLowerCase();
        if (!await businessConfirm(`旧值：${oldValue}\n新值：${newValue}\n\n该帖子的全部版本与复盘都会同步。`,{title:'更正笔记 ID',confirmLabel:'确认更正',cancelLabel:'继续编辑'})) return;
        const output = form.querySelector<HTMLOutputElement>('output')!; output.textContent = '正在更正…';
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (response.ok) { cleanInspector(form); window.location.reload(); } else output.textContent = result.message ?? '更正失败。';
      }); });
      };
      initializeCorrections();
      document.addEventListener('astro:page-load', initializeCorrections);
      document.addEventListener('business:inspector-render', initializeCorrections);
    </script>
  </body>
</html>

