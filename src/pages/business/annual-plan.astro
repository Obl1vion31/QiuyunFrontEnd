---
import { asc, eq, inArray } from 'drizzle-orm';
import { deriveAnnualSummary, formatBlockRule } from '../../db/annual-plan-rules.mjs';
import { getDb } from '../../db/client';
import {
  operationsAnnualPlan,
  operationsAnnualPlanBlock,
  operationsAnnualPlanLink,
  operationsAnnualPlanYear,
  operationsCategory,
  operationsSubject,
  operationsSubjectCategory,
} from '../../db/schema';

export const prerender = false;

const now = new Date();
const requestedYear = Number(Astro.url.searchParams.get('year') ?? now.getFullYear());
const selectedYear = Number.isInteger(requestedYear) && requestedYear >= 2000 && requestedYear <= 9999
  ? requestedYear
  : now.getFullYear();
const months = Array.from({ length: 12 }, (_, index) => index + 1);

let databaseError = '';
let yearInfo: { instructions: string | null; updatedAt: Date } | null = null;
let subjects: Array<{ id: string; name: string; sortOrder: number }> = [];
let categoryMappings: Array<{ subjectId: string; id: string; name: string; sortOrder: number }> = [];
let rows: Array<{
  id: string;
  year: number;
  sectionKey: string;
  sectionLabel: string;
  subjectId: string | null;
  subjectName: string | null;
  rowName: string;
  categoryId: string | null;
  categoryName: string | null;
  categorySortOrder: number | null;
  note: string | null;
  sortOrder: number;
  isActive: boolean;
  countsTowardPromotion: boolean;
  currentVersionNumber: number;
  updatedAt: Date;
}> = [];
let blocks: Array<{
  planId: string;
  startMonth: number;
  endMonth: number;
  label: string;
  ruleType: string | null;
  monthlyFrequency: number | null;
  quantityParts: number[] | null;
  note: string | null;
  sortOrder: number;
}> = [];
let links: Array<{ planId: string; label: string; url: string; sortOrder: number }> = [];

try {
  const database = getDb();
  [yearInfo] = await database.select({
    instructions: operationsAnnualPlanYear.instructions,
    updatedAt: operationsAnnualPlanYear.updatedAt,
  }).from(operationsAnnualPlanYear).where(eq(operationsAnnualPlanYear.year, selectedYear)).limit(1);
  subjects = await database.select().from(operationsSubject).orderBy(asc(operationsSubject.sortOrder));
  categoryMappings = await database.select({
    subjectId: operationsSubjectCategory.subjectId,
    id: operationsCategory.id,
    name: operationsCategory.name,
    sortOrder: operationsCategory.sortOrder,
  }).from(operationsSubjectCategory)
    .innerJoin(operationsCategory, eq(operationsSubjectCategory.categoryId, operationsCategory.id))
    .orderBy(asc(operationsSubjectCategory.subjectId), asc(operationsCategory.sortOrder));
  rows = await database.select({
    id: operationsAnnualPlan.id,
    year: operationsAnnualPlan.year,
    sectionKey: operationsAnnualPlan.sectionKey,
    sectionLabel: operationsAnnualPlan.sectionLabel,
    subjectId: operationsAnnualPlan.subjectId,
    subjectName: operationsSubject.name,
    rowName: operationsAnnualPlan.rowName,
    categoryId: operationsAnnualPlan.categoryId,
    categoryName: operationsCategory.name,
    categorySortOrder: operationsCategory.sortOrder,
    note: operationsAnnualPlan.note,
    sortOrder: operationsAnnualPlan.sortOrder,
    isActive: operationsAnnualPlan.isActive,
    countsTowardPromotion: operationsAnnualPlan.countsTowardPromotion,
    currentVersionNumber: operationsAnnualPlan.currentVersionNumber,
    updatedAt: operationsAnnualPlan.updatedAt,
  }).from(operationsAnnualPlan)
    .leftJoin(operationsSubject, eq(operationsAnnualPlan.subjectId, operationsSubject.id))
    .leftJoin(operationsCategory, eq(operationsAnnualPlan.categoryId, operationsCategory.id))
    .where(eq(operationsAnnualPlan.year, selectedYear))
    .orderBy(asc(operationsAnnualPlan.sectionKey), asc(operationsAnnualPlan.sortOrder), asc(operationsAnnualPlan.rowName));
  const rowIds = rows.map((row) => row.id);
  if (rowIds.length) {
    blocks = await database.select({
      planId: operationsAnnualPlanBlock.planId,
      startMonth: operationsAnnualPlanBlock.startMonth,
      endMonth: operationsAnnualPlanBlock.endMonth,
      label: operationsAnnualPlanBlock.label,
      ruleType: operationsAnnualPlanBlock.ruleType,
      monthlyFrequency: operationsAnnualPlanBlock.monthlyFrequency,
      quantityParts: operationsAnnualPlanBlock.quantityParts,
      note: operationsAnnualPlanBlock.note,
      sortOrder: operationsAnnualPlanBlock.sortOrder,
    }).from(operationsAnnualPlanBlock)
      .where(inArray(operationsAnnualPlanBlock.planId, rowIds))
      .orderBy(asc(operationsAnnualPlanBlock.sortOrder));
    links = await database.select({
      planId: operationsAnnualPlanLink.planId,
      label: operationsAnnualPlanLink.label,
      url: operationsAnnualPlanLink.url,
      sortOrder: operationsAnnualPlanLink.sortOrder,
    }).from(operationsAnnualPlanLink)
      .where(inArray(operationsAnnualPlanLink.planId, rowIds))
      .orderBy(asc(operationsAnnualPlanLink.sortOrder));
  }
} catch (error) {
  console.error('annual plan overview query failed', error);
  databaseError = '年度总周期规划数据库尚未就绪。请确认开发库已执行最新迁移。';
}

const subjectOrder = new Map(subjects.map((subject, index) => [subject.id, index + 1]));
const sectionKeys = Array.from(new Set([
  ...subjects.map((subject) => `subject:${subject.id}`),
  ...rows.filter((row) => row.sectionKey !== 'general').map((row) => row.sectionKey),
]));
const sectionInfo = sectionKeys.map((key) => {
  const existing = rows.find((row) => row.sectionKey === key);
  const subject = key.startsWith('subject:') ? subjects.find((item) => item.id === key.slice(8)) : undefined;
  return {
    key,
    label: existing?.sectionLabel ?? (subject ? `${subject.name} 细致规划` : key),
    subjectId: existing?.subjectId ?? subject?.id ?? null,
    sortOrder: subject ? subject.sortOrder : 9999,
    tone: subjectOrder.get(subject?.id ?? '') ?? 4,
  };
}).sort((left, right) => left.sortOrder - right.sortOrder);
const clientRows = rows.filter((row) => row.sectionKey !== 'general').sort((left, right) => (
  (left.categorySortOrder ?? 9999) - (right.categorySortOrder ?? 9999)
  || left.sortOrder - right.sortOrder
  || left.rowName.localeCompare(right.rowName, 'zh-CN')
)).map((row) => ({
  ...row,
  note: row.note ?? '',
  blocks: blocks.filter((block) => block.planId === row.id).map((block) => ({
    ...block,
    note: block.note ?? '',
    ruleLabel: formatBlockRule({
      startMonth: block.startMonth,
      endMonth: block.endMonth,
      ruleType: block.ruleType as 'flexible' | 'fixed' | null,
      monthlyFrequency: block.monthlyFrequency,
      quantityParts: block.quantityParts,
    }),
  })),
  links: links.filter((link) => link.planId === row.id),
}));
const annualSummaries = subjects.map((subject) => ({
  subjectId: subject.id,
  subjectName: subject.name,
  tone: subjectOrder.get(subject.id) ?? 4,
  ...deriveAnnualSummary(clientRows.filter((row) => row.subjectId === subject.id)),
}));
const latestTimestamp = [
  yearInfo?.updatedAt,
  ...rows.map((row) => row.updatedAt),
].filter((value): value is Date => Boolean(value)).sort((left, right) => right.getTime() - left.getTime())[0];
const latestDisplay = latestTimestamp
  ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Shanghai' }).format(latestTimestamp)
  : '尚未保存';
const hrefForYear = (year: number) => `/business/annual-plan?year=${year}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="统一查看总规划和各学科的年度细致规划。" />
    <title>THE PLAN · 年度总周期规划</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="sidebar-brand" href="/"><span>FRONTEND</span><strong>内容发布控制台</strong></a>
        <nav class="module-nav" aria-label="内容发布控制台模块">
          <a class="active" href={`/business/annual-plan?year=${selectedYear}`}><span class="nav-icon">总</span><span><strong>总周期规划</strong><small>THE PLAN</small></span></a>
          <a href="/business/operations-schedule"><span class="nav-icon">排</span><span><strong>排期管理</strong><small>Schedule</small></span></a>
          <span class="planned"><span class="nav-icon">日</span><span><strong>日粒度全量复盘</strong><small>计划中</small></span></span>
          <span class="planned"><span class="nav-icon">阶</span><span><strong>阶段复盘</strong><small>计划中</small></span></span>
          <span class="planned"><span class="nav-icon">报</span><span><strong>报表中心</strong><small>计划中</small></span></span>
        </nav>
        <div class="sidebar-foot"><span>INTERNAL ACCESS</span><a href="/">← 返回总枢纽</a></div>
      </aside>

      <section class="workspace">
        <header class="toolbar">
          <div class="toolbar-title"><span>THE PLAN</span><strong>年度总周期规划</strong></div>
          <div class="year-nav">
            <a href={hrefForYear(selectedYear - 1)} aria-label="上一年">‹</a>
            <strong>{selectedYear}</strong>
            <a href={hrefForYear(selectedYear + 1)} aria-label="下一年">›</a>
          </div>
          <div class="toolbar-actions">
            <button class="quiet-button" type="button" data-edit-year>年度说明</button>
            <button class="primary-action" type="button" data-open-new>新建规划行 <b>＋</b></button>
          </div>
        </header>

        <main>
          <section class="overview-head">
            <div>
              <span class="eyebrow">ONE YEAR / ONE VIEW</span>
              <h1>{selectedYear} 年度总览</h1>
              <p>{yearInfo?.instructions || '纵向浏览总规划与各学科细致规划，横向查看 1—12 月的连续时间块。'}</p>
            </div>
            <div class="updated"><span>最近更新</span><strong>{latestDisplay}</strong></div>
          </section>

          <nav class="section-jumps" aria-label="快速定位">
            <button class="active" type="button" data-filter="all">全部分区</button>
            {sectionInfo.map((section) => <button type="button" data-filter={section.key}>{section.label}</button>)}
            <button type="button" data-show-inactive>显示已停用</button>
          </nav>

          {databaseError && <p class="notice" role="alert">{databaseError}</p>}
          {!databaseError && <section class="summary-shell" aria-labelledby="summary-title">
            <header class="summary-title">
              <div><span>AUTO SUMMARY</span><strong id="summary-title">总规划</strong></div>
              <p>由下方启用的细致规划自动汇总，不需要单独填写。</p>
            </header>
            <div class="summary-scroll">
              <div class="summary-matrix">
                <div class="summary-head summary-subject-head">科目</div>
                <div class="summary-head summary-period-head">周期</div>
                {months.map((month) => <div class:list={['summary-head', 'month-col', { 'quarter-start': [1, 4, 7, 10].includes(month) }]}><strong>{month}</strong><span>月</span></div>)}
                {annualSummaries.map((summary) => [
                  <div class="summary-subject" data-tone={summary.tone}>{summary.subjectName}</div>,
                  <div class="summary-label">发帖周期</div>,
                  <div class="summary-timeline" data-tone={summary.tone}>
                    {months.map((month) => <span class:list={['month-grid', { 'quarter-start': [1, 4, 7, 10].includes(month) }]} style={`grid-column:${month}`} aria-hidden="true"></span>)}
                    {summary.postingSpans.map((span) => <span
                      class="summary-block"
                      style={`grid-column:${span.startMonth}/${span.endMonth + 1}`}
                      title={`${summary.subjectName} 发帖周期：${span.startMonth}—${span.endMonth} 月`}
                      aria-label={`${summary.subjectName} 发帖周期：${span.startMonth}—${span.endMonth} 月`}
                    ></span>)}
                  </div>,
                  <div class="summary-label">推广周期</div>,
                  <div class="summary-timeline" data-tone={summary.tone}>
                    {months.map((month) => <span class:list={['month-grid', { 'quarter-start': [1, 4, 7, 10].includes(month) }]} style={`grid-column:${month}`} aria-hidden="true"></span>)}
                    {summary.promotionSpans.map((span) => <span
                      class="summary-block"
                      style={`grid-column:${span.startMonth}/${span.endMonth + 1}`}
                      title={`${summary.subjectName} 推广周期：${span.startMonth}—${span.endMonth} 月`}
                      aria-label={`${summary.subjectName} 推广周期：${span.startMonth}—${span.endMonth} 月`}
                    ></span>)}
                  </div>,
                ])}
              </div>
            </div>
          </section>}
          {!databaseError && <section class="matrix-shell">
            <div class="plan-matrix">
              <div class="head section-col">规划分区</div>
              <div class="head sop-col">SOP</div>
              <div class="head item-col">规划项目</div>
              {months.map((month) => <div class:list={['head', 'month-col', { 'quarter-start': [1, 4, 7, 10].includes(month) }]}><strong>{month}</strong><span>月</span></div>)}

              {sectionInfo.map((section) => {
                const sectionRows = clientRows.filter((row) => row.sectionKey === section.key);
                return <div class="section-group" data-section={section.key} data-tone={section.tone}>
                  <div class="section-band"><strong>{section.label}</strong><span>{sectionRows.length} 条规划行</span></div>
                  {sectionRows.map((row) => <div class:list={['plan-row', { inactive: !row.isActive }]} data-row-id={row.id} data-inactive={!row.isActive ? 'true' : 'false'}>
                    <div class="section-cell">{row.subjectName ?? section.label}</div>
                    <div class="sop-cell">
                      {row.links.length
                        ? row.links.map((link, index) => <a href={link.url} target="_blank" rel="noreferrer" aria-label={`打开 SOP ${index + 1}`} title={link.label || '打开 SOP'}>↗</a>)
                        : <span>—</span>}
                    </div>
                    <button class="item-cell" type="button" data-inspect-id={row.id} aria-expanded="false" title={`${row.rowName} · V${row.currentVersionNumber}`}>
                      <strong>{row.rowName}</strong>
                      <span class="row-badges">
                        <small>V{row.currentVersionNumber}</small>
                        {!row.isActive && <small class="inactive-badge">已停用</small>}
                      </span>
                    </button>
                    <div class="timeline">
                      {months.map((month) => <span class:list={['month-grid', { 'quarter-start': [1, 4, 7, 10].includes(month) }]} style={`grid-column:${month}`} aria-hidden="true"></span>)}
                      {row.blocks.map((block) => <button
                        class:list={['time-block', block.ruleType ?? 'plain']}
                        style={`grid-column:${block.startMonth}/${block.endMonth + 1}`}
                        type="button"
                        data-inspect-id={row.id}
                        aria-expanded="false"
                        title={`${block.label} · ${block.startMonth}—${block.endMonth} 月${block.ruleLabel ? ` · ${block.ruleLabel}` : ''}${block.note ? `：${block.note}` : ''}`}
                        aria-label={`${row.rowName}，${block.label}，${block.startMonth}—${block.endMonth} 月${block.ruleLabel ? `，${block.ruleLabel}` : ''}`}
                      >
                        {block.ruleLabel && <strong>{block.ruleLabel}</strong>}
                      </button>)}
                    </div>
                  </div>)}
                  {sectionRows.length === 0 && <div class="section-empty">
                    <span>这个分区还没有规划行</span>
                    <button type="button" data-new-section={section.key}>在此新建</button>
                  </div>}
                </div>;
              })}
            </div>
          </section>}
        </main>
      </section>
    </div>

    <aside class="inspector" data-inspector aria-labelledby="inspector-title" hidden>
      <header class="inspector-top">
        <div><span>PLAN INSPECTOR</span><small>年度规划详情</small></div>
        <button type="button" data-close-inspector aria-label="关闭规划详情">×</button>
      </header>
      <div class="inspector-body">
        <div class="inspector-identity">
          <p data-section-label></p>
          <h2 id="inspector-title" data-row-name></h2>
          <p class="relation-line" data-relation></p>
          <div class="status-line">
            <span class="version-chip" data-version>V0</span>
            <span class="status-chip" data-status></span>
            <span class="status-chip promotion-chip" data-promotion></span>
          </div>
        </div>
        <section class="inspector-section timeline-section">
          <header><span>YEAR TRACK</span><strong>年度时间轨道</strong></header>
          <div class="mini-months" aria-hidden="true">
            {months.map((month) => <span class:list={{ 'quarter-start': [1, 4, 7, 10].includes(month) }}>{month}</span>)}
          </div>
          <div class="mini-timeline" data-mini-timeline></div>
        </section>
        <section class="inspector-section">
          <header><span>TIME BLOCKS</span><strong>时间块</strong></header>
          <div class="block-list" data-block-list></div>
        </section>
        <section class="inspector-section">
          <header><span>REFERENCE</span><strong>SOP / 帖集链接</strong></header>
          <div class="link-list" data-link-list></div>
        </section>
        <section class="inspector-section note-section">
          <header><span>NOTE</span><strong>规划备注</strong></header>
          <p data-note></p>
        </section>
        <section class="inspector-section history-section">
          <header><span>VERSION HISTORY</span><strong>版本历史</strong></header>
          <button class="history-button" type="button" data-load-history>查看全部版本</button>
          <div class="history-list" data-history-list></div>
        </section>
      </div>
      <footer><button class="primary-action inspector-edit" type="button" data-edit-row>编辑规划行 →</button></footer>
    </aside>

    <dialog id="row-dialog">
      <form id="row-form">
        <header class="dialog-head"><div><span>ANNUAL PLAN ROW</span><h2 data-dialog-title>新建规划行</h2></div><button type="button" data-close-row aria-label="关闭">×</button></header>
        <input type="hidden" name="planId" />
        <input type="hidden" name="expectedVersionNumber" value="1" />
        <input type="hidden" name="subjectId" />
        <input type="hidden" name="sectionKey" />
        <input type="hidden" name="sectionLabel" />
        <div class="form-content">
          <div class="form-grid">
            <label>所属分区<select name="sectionChoice" required>
              {sectionInfo.map((section) => <option value={section.key}>{section.label}</option>)}
            </select></label>
            <label>规划项目名称<input name="rowName" maxlength="200" required placeholder="例如：TMUA 发帖周期" /></label>
            <label>帖子分类（可选）<select name="categoryId"><option value="">不关联分类</option></select></label>
            <label class="check-label"><input name="isActive" type="checkbox" checked /> <span><b>参与本年度规划</b><small>关闭后默认隐藏，不参与总规划汇总，但保留历史。</small></span></label>
            <label class="check-label"><input name="countsTowardPromotion" type="checkbox" /> <span><b>计入推广周期</b><small>该规划行覆盖的月份会进入自动推广周期。</small></span></label>
            <label class="wide">行备注<textarea name="note" rows="2" maxlength="1000"></textarea></label>
          </div>

          <section class="editor-section">
            <header><div><span>TIME BLOCKS</span><h3>时间块</h3></div><button class="quiet-button" type="button" data-add-block>添加时间块</button></header>
            <p>先确定月份范围；阶段说明可以留空；数量规则只能选择一种。同一规划行内的时间块不能重叠。</p>
            <div data-block-rows></div>
          </section>
          <section class="editor-section">
            <header><div><span>REFERENCE LINKS</span><h3>SOP 链接</h3></div><button class="quiet-button" type="button" data-add-link>添加链接</button></header>
            <div data-link-rows></div>
          </section>
          <label class="change-summary">本次调整说明 <b>*</b><textarea name="changeSummary" rows="2" maxlength="500" required></textarea></label>
          <p class="form-message" role="alert"></p>
        </div>
        <footer class="dialog-actions"><button class="quiet-button" type="button" data-close-row>取消</button><button class="save-button" type="submit">保存规划行 →</button></footer>
      </form>
    </dialog>

    <dialog id="year-dialog">
      <form id="year-form">
        <header class="dialog-head"><div><span>YEAR NOTE</span><h2>{selectedYear} 年规划说明</h2></div><button type="button" data-close-year aria-label="关闭">×</button></header>
        <div class="year-form-body">
          <label>规划说明<textarea name="instructions" rows="8" maxlength="3000">{yearInfo?.instructions ?? ''}</textarea></label>
          <p role="alert"></p>
        </div>
        <footer class="dialog-actions"><button class="quiet-button" type="button" data-close-year>取消</button><button class="save-button" type="submit">保存说明 →</button></footer>
      </form>
    </dialog>

    <script is:inline define:vars={{ clientRows, categoryMappings, sectionInfo, selectedYear }}>
      // @ts-ignore Astro 会在客户端脚本前注入 define:vars。
      const rows = clientRows;
      const categories = categoryMappings;
      const sections = sectionInfo;
      const rowDialog = document.querySelector('#row-dialog');
      const rowForm = document.querySelector('#row-form');
      const yearDialog = document.querySelector('#year-dialog');
      const inspector = document.querySelector('[data-inspector]');
      const blockRows = rowForm.querySelector('[data-block-rows]');
      const linkRows = rowForm.querySelector('[data-link-rows]');
      let activeRow = null;
      let inspectorTrigger = null;
      let dirty = false;
      let activeSectionFilter = 'all';
      let showInactive = false;

      const field = (name) => rowForm.elements.namedItem(name);
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[character]);
      const sectionByKey = (key) => sections.find((section) => section.key === key);
      const applySection = (key, selectedCategory = '') => {
        const section = sectionByKey(key) ?? sections[0];
        field('sectionKey').value = section.key;
        field('sectionLabel').value = section.label;
        field('subjectId').value = section.subjectId ?? '';
        const select = field('categoryId');
        const matching = categories.filter((category) => category.subjectId === section.subjectId);
        select.replaceChildren(new Option('不关联分类', ''), ...matching.map((category) => new Option(category.name, category.id)));
        select.disabled = !section.subjectId;
        if ([...select.options].some((option) => option.value === selectedCategory)) select.value = selectedCategory;
      };
      const addBlock = (block = {}) => {
        const node = document.createElement('div');
        node.className = 'block-row';
        node.innerHTML = `
          <div class="block-range">
            <label><span>开始月份</span><select data-start>${Array.from({ length: 12 }, (_, index) => `<option value="${index + 1}" ${block.startMonth === index + 1 ? 'selected' : ''}>${index + 1} 月</option>`).join('')}</select></label>
            <span>至</span>
            <label><span>结束月份</span><select data-end>${Array.from({ length: 12 }, (_, index) => `<option value="${index + 1}" ${block.endMonth === index + 1 ? 'selected' : ''}>${index + 1} 月</option>`).join('')}</select></label>
          </div>
          <label class="block-stage"><span>阶段说明（可选）</span><input data-label maxlength="200" placeholder="留空则使用规划项目名称" value="${escapeHtml(block.label)}"></label>
          <div class="rule-editor">
            <label><span>数量规则</span><select data-rule>
              <option value="" ${block.ruleType == null ? 'selected' : ''}>数量待确认</option>
              <option value="flexible" ${block.ruleType === 'flexible' ? 'selected' : ''}>弹性频次</option>
              <option value="fixed" ${block.ruleType === 'fixed' ? 'selected' : ''}>硬性组合</option>
            </select></label>
            <label data-rule-value><span data-value-label></span><input data-value inputmode="numeric" value="${block.ruleType === 'flexible' ? block.monthlyFrequency ?? '' : block.ruleType === 'fixed' ? (block.quantityParts ?? []).join(' + ') : ''}"></label>
            <output data-rule-preview></output>
          </div>
          <label class="block-note"><span>简短说明（可选）</span><input data-note maxlength="500" value="${escapeHtml(block.note)}"></label>
          <button class="remove-row" type="button" aria-label="删除时间块">×</button>`;
        const syncRule = () => {
          const rule = node.querySelector('[data-rule]').value;
          const valueWrap = node.querySelector('[data-rule-value]');
          const input = node.querySelector('[data-value]');
          const preview = node.querySelector('[data-rule-preview]');
          valueWrap.hidden = !rule;
          node.querySelector('[data-value-label]').textContent = rule === 'flexible' ? '每月默认篇数' : '数量组合';
          input.placeholder = rule === 'flexible' ? '例如 2' : '例如 3 + 3 + 4';
          const duration = Number(node.querySelector('[data-end]').value) - Number(node.querySelector('[data-start]').value) + 1;
          preview.textContent = rule === 'flexible' && Number(input.value) > 0 ? `预览：${Number(input.value)}×${Math.max(duration, 0)}` : '';
        };
        node.querySelector('[data-rule]').addEventListener('change', syncRule);
        node.querySelector('[data-value]').addEventListener('input', syncRule);
        node.querySelector('[data-start]').addEventListener('change', syncRule);
        node.querySelector('[data-end]').addEventListener('change', syncRule);
        node.querySelector('.remove-row').addEventListener('click', () => { node.remove(); dirty = true; });
        blockRows.append(node);
        syncRule();
      };
      const addLink = (link = {}) => {
        const node = document.createElement('div');
        node.className = 'link-row';
        node.innerHTML = `<input data-link-url type="url" aria-label="SOP 链接" placeholder="https://…" value="${escapeHtml(link.url)}">
          <button type="button" aria-label="删除链接">×</button>`;
        node.querySelector('button').addEventListener('click', () => { node.remove(); dirty = true; });
        linkRows.append(node);
      };
      const openRow = (row = null, sectionKey = null) => {
        activeRow = row;
        rowForm.reset();
        blockRows.replaceChildren();
        linkRows.replaceChildren();
        const key = row?.sectionKey ?? sectionKey ?? sections[0]?.key;
        field('sectionChoice').value = key;
        applySection(key, row?.categoryId ?? '');
        field('planId').value = row?.id ?? '';
        field('expectedVersionNumber').value = row?.currentVersionNumber ?? 0;
        field('rowName').value = row?.rowName ?? '';
        field('isActive').checked = row?.isActive ?? true;
        field('countsTowardPromotion').checked = row?.countsTowardPromotion ?? false;
        field('note').value = row?.note ?? '';
        rowForm.querySelector('[data-dialog-title]').textContent = row ? `编辑 ${row.rowName} · V${row.currentVersionNumber}` : '新建规划行';
        (row?.blocks ?? []).forEach(addBlock);
        (row?.links ?? []).forEach(addLink);
        if (!(row?.blocks?.length)) addBlock({ startMonth: 1, endMonth: 1 });
        if (!(row?.links?.length)) addLink();
        rowForm.querySelector('.form-message').textContent = '';
        dirty = false;
        rowDialog.showModal();
        field('rowName').focus();
      };
      const closeRow = () => {
        if (dirty && !window.confirm('有尚未保存的修改，确定关闭吗？')) return;
        dirty = false;
        rowDialog.close();
      };
      const collectRow = () => ({
        year: selectedYear,
        sectionKey: field('sectionKey').value,
        sectionLabel: field('sectionLabel').value,
        subjectId: field('subjectId').value || null,
        rowName: field('rowName').value.trim(),
        categoryId: field('categoryId').value || null,
        note: field('note').value.trim() || null,
        sortOrder: categories.find((category) => category.id === field('categoryId').value)?.sortOrder ?? activeRow?.sortOrder ?? 9999,
        isActive: field('isActive').checked,
        countsTowardPromotion: field('countsTowardPromotion').checked,
        blocks: [...blockRows.querySelectorAll('.block-row')].map((node, index) => {
          const ruleType = node.querySelector('[data-rule]').value || null;
          const raw = node.querySelector('[data-value]').value.trim();
          return {
            startMonth: Number(node.querySelector('[data-start]').value),
            endMonth: Number(node.querySelector('[data-end]').value),
            label: node.querySelector('[data-label]').value.trim() || field('rowName').value.trim(),
            ruleType,
            monthlyFrequency: ruleType === 'flexible' ? Number(raw) : null,
            quantityParts: ruleType === 'fixed' ? raw.split('+').map((part) => Number(part.trim())) : null,
            note: node.querySelector('[data-note]').value.trim() || null,
            sortOrder: index,
          };
        }),
        links: [...linkRows.querySelectorAll('.link-row')].flatMap((node, index) => {
          const url = node.querySelector('[data-link-url]').value.trim();
          return url ? [{ label: 'SOP', url, sortOrder: index }] : [];
        }),
        changeSummary: field('changeSummary').value.trim(),
        expectedVersionNumber: Number(field('expectedVersionNumber').value),
      });
      const setText = (selector, value) => {
        const node = inspector.querySelector(selector);
        if (node) node.textContent = value || '—';
      };
      const setSelectedRow = (rowId = null) => {
        document.querySelectorAll('[data-row-id]').forEach((rowNode) => {
          rowNode.classList.toggle('selected', rowNode.dataset.rowId === rowId);
        });
        document.querySelectorAll('[data-inspect-id]').forEach((button) => {
          button.setAttribute('aria-expanded', button.dataset.inspectId === rowId ? 'true' : 'false');
        });
      };
      const renderMiniTimeline = (row) => {
        const timeline = inspector.querySelector('[data-mini-timeline]');
        timeline.replaceChildren();
        for (let month = 1; month <= 12; month += 1) {
          const grid = document.createElement('span');
          grid.className = `mini-grid${[1, 4, 7, 10].includes(month) ? ' quarter-start' : ''}`;
          grid.style.gridColumn = month;
          grid.setAttribute('aria-hidden', 'true');
          timeline.append(grid);
        }
        row.blocks.forEach((block) => {
          const item = document.createElement('span');
          item.className = `mini-block ${block.ruleType ?? 'plain'}`;
          item.style.gridColumn = `${block.startMonth}/${block.endMonth + 1}`;
          item.title = `${block.startMonth}—${block.endMonth} 月 · ${block.ruleLabel === '?' ? '数量待确认' : block.ruleLabel}`;
          timeline.append(item);
        });
      };
      const openInspector = (row, trigger) => {
        if (!row) return;
        activeRow = row;
        inspectorTrigger = trigger ?? inspectorTrigger;
        const section = sectionByKey(row.sectionKey);
        inspector.dataset.tone = section?.tone ?? 0;
        setText('[data-version]', `V${row.currentVersionNumber}`);
        setText('[data-section-label]', row.sectionLabel);
        setText('[data-row-name]', row.rowName);
        setText('[data-relation]', [row.subjectName, row.categoryName].filter(Boolean).join(' / ') || '通用规划行');
        setText('[data-status]', row.isActive ? '启用' : '已停用');
        setText('[data-promotion]', row.countsTowardPromotion ? '计入推广周期' : '不计入推广周期');
        setText('[data-note]', row.note || '暂无备注');
        renderMiniTimeline(row);
        const blockList = inspector.querySelector('[data-block-list]');
        blockList.replaceChildren(...row.blocks.map((block) => {
          const article = document.createElement('article');
          article.className = `block-detail ${block.ruleType ?? 'plain'}`;
          const ruleDetail = block.ruleLabel === '?' ? '数量待确认' : block.ruleLabel;
          article.innerHTML = `<div class="block-primary"><div class="block-name"><b title="${escapeHtml(block.label)}">${escapeHtml(block.label)}</b><span>${escapeHtml(ruleDetail || '仅规划月份')}</span></div><strong>${block.startMonth}—${block.endMonth} 月</strong></div>${block.note ? `<small class="block-secondary">${escapeHtml(block.note)}</small>` : ''}`;
          return article;
        }));
        if (row.blocks.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'inspector-empty';
          empty.textContent = '尚未设置时间块。';
          blockList.append(empty);
        }
        const linkList = inspector.querySelector('[data-link-list]');
        linkList.replaceChildren(...row.links.map((link) => {
          const anchor = document.createElement('a');
          anchor.href = link.url; anchor.target = '_blank'; anchor.rel = 'noreferrer';
          anchor.textContent = `${link.label} ↗`;
          return anchor;
        }));
        if (row.links.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'inspector-empty';
          empty.textContent = '尚未添加 SOP 或帖集链接。';
          linkList.append(empty);
        }
        inspector.querySelector('[data-history-list]').replaceChildren();
        setSelectedRow(row.id);
        inspector.hidden = false;
        requestAnimationFrame(() => {
          inspector.classList.add('open');
          inspector.querySelector('[data-close-inspector]').focus({ preventScroll: true });
        });
      };
      const closeInspector = () => {
        inspector.classList.remove('open');
        setSelectedRow();
        const returnTarget = inspectorTrigger;
        inspectorTrigger = null;
        setTimeout(() => {
          inspector.hidden = true;
          returnTarget?.focus({ preventScroll: true });
        }, 180);
      };

      document.querySelectorAll('[data-open-new]').forEach((button) => button.addEventListener('click', () => openRow()));
      document.querySelectorAll('[data-new-section]').forEach((button) => button.addEventListener('click', () => openRow(null, button.dataset.newSection)));
      document.querySelectorAll('[data-inspect-id]').forEach((button) => button.addEventListener('click', () => openInspector(rows.find((row) => row.id === button.dataset.inspectId), button)));
      document.querySelector('[data-close-inspector]').addEventListener('click', closeInspector);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !inspector.hidden && !rowDialog.open && !yearDialog.open) closeInspector();
      });
      document.querySelector('[data-edit-row]').addEventListener('click', () => openRow(activeRow));
      document.querySelectorAll('[data-close-row]').forEach((button) => button.addEventListener('click', closeRow));
      rowDialog.addEventListener('cancel', (event) => { event.preventDefault(); closeRow(); });
      rowForm.addEventListener('input', () => { dirty = true; });
      field('sectionChoice').addEventListener('change', () => applySection(field('sectionChoice').value));
      rowForm.querySelector('[data-add-block]').addEventListener('click', () => { addBlock({ startMonth: 1, endMonth: 1 }); dirty = true; });
      rowForm.querySelector('[data-add-link]').addEventListener('click', () => { addLink(); dirty = true; });
      rowForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const message = rowForm.querySelector('.form-message');
        const submit = rowForm.querySelector('[type="submit"]');
        const payload = collectRow();
        message.textContent = '';
        submit.disabled = true;
        submit.textContent = '正在保存…';
        try {
          const response = await fetch(activeRow ? `/api/operations-annual-plans/${activeRow.id}` : '/api/operations-annual-plans', {
            method: activeRow ? 'PATCH' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await response.json();
          if (response.ok) { dirty = false; window.location.reload(); return; }
          message.textContent = result.message ?? '保存失败，请检查填写内容。';
          if (result.fields?.blocks) message.textContent += ` ${result.fields.blocks.join('；')}`;
        } catch {
          message.textContent = '无法连接服务，请稍后重试。';
        } finally {
          submit.disabled = false;
          submit.textContent = '保存规划行 →';
        }
      });

      const applyMatrixVisibility = () => {
        document.querySelectorAll('[data-section]').forEach((section) => {
          section.hidden = activeSectionFilter !== 'all' && section.dataset.section !== activeSectionFilter;
        });
        document.querySelectorAll('[data-inactive="true"]').forEach((row) => {
          row.hidden = !showInactive;
        });
      };
      document.querySelectorAll('[data-filter]').forEach((button) => button.addEventListener('click', () => {
        activeSectionFilter = button.dataset.filter;
        document.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('active', item === button));
        applyMatrixVisibility();
      }));
      document.querySelector('[data-show-inactive]').addEventListener('click', (event) => {
        showInactive = !showInactive;
        event.currentTarget.classList.toggle('active', showInactive);
        event.currentTarget.textContent = showInactive ? '隐藏已停用' : '显示已停用';
        applyMatrixVisibility();
      });
      applyMatrixVisibility();
      document.querySelector('[data-load-history]').addEventListener('click', async () => {
        const target = inspector.querySelector('[data-history-list]');
        target.textContent = '正在读取…';
        const response = await fetch(`/api/operations-annual-plans/${activeRow.id}/versions`);
        const result = await response.json();
        if (!response.ok) { target.textContent = result.message ?? '读取失败。'; return; }
        target.replaceChildren(...result.versions.map((version) => {
          const article = document.createElement('article');
          article.innerHTML = `<div><strong>V${version.versionNumber}</strong><span>${new Date(version.createdAt).toLocaleString('zh-CN')}</span></div><p>${escapeHtml(version.changeSummary)}</p><small>${escapeHtml(version.changedByLabel)} · ${version.diffSummary.map(escapeHtml).join('；')}</small>`;
          const view = document.createElement('button');
          view.type = 'button';
          view.textContent = '查看版本内容';
          view.addEventListener('click', async () => {
            const existing = article.querySelector('.snapshot-view');
            if (existing) { existing.remove(); return; }
            view.disabled = true;
            view.textContent = '正在读取…';
            try {
              const response = await fetch(`/api/operations-annual-plans/${activeRow.id}/versions/${version.versionNumber}`);
              const detail = await response.json();
              if (!response.ok) { window.alert(detail.message ?? '历史版本读取失败。'); return; }
              const snapshot = detail.version.snapshot;
              const panel = document.createElement('div');
              panel.className = 'snapshot-view';
              const title = document.createElement('strong');
              title.textContent = `${snapshot.row.sectionLabel} / ${snapshot.row.rowName}`;
              const relation = document.createElement('p');
              relation.textContent = [snapshot.row.subjectName, snapshot.row.categoryName].filter(Boolean).join(' / ') || '通用规划行';
              const blockTitle = document.createElement('b');
              blockTitle.textContent = '时间块';
              const blockList = document.createElement('ul');
              snapshot.blocks.forEach((block) => {
                const item = document.createElement('li');
                const rule = block.ruleType === 'flexible'
                  ? `${block.monthlyFrequency}×${block.endMonth - block.startMonth + 1}`
                  : block.ruleType === 'fixed' ? block.quantityParts.join('+') : '数量待确认';
                item.textContent = `${block.startMonth}—${block.endMonth} 月 · ${block.label}${rule ? ` [${rule}]` : ''}${block.note ? ` · ${block.note}` : ''}`;
                blockList.append(item);
              });
              const linkTitle = document.createElement('b');
              linkTitle.textContent = '链接';
              const linkList = document.createElement('ul');
              snapshot.links.forEach((link) => {
                const item = document.createElement('li');
                const anchor = document.createElement('a');
                anchor.href = link.url;
                anchor.target = '_blank';
                anchor.rel = 'noreferrer';
                anchor.textContent = link.label;
                item.append(anchor);
                linkList.append(item);
              });
              panel.append(title, relation, blockTitle, blockList, linkTitle, linkList);
              article.append(panel);
            } finally {
              view.disabled = false;
              view.textContent = '查看版本内容';
            }
          });
          article.append(view);
          if (version.versionNumber !== activeRow.currentVersionNumber) {
            const restore = document.createElement('button');
            restore.type = 'button'; restore.textContent = '恢复为新版本';
            restore.addEventListener('click', async () => {
              if (!window.confirm(`将 V${version.versionNumber} 恢复为新的当前版本？`)) return;
              const response = await fetch(`/api/operations-annual-plans/${activeRow.id}/restore`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ versionNumber: version.versionNumber, expectedVersionNumber: activeRow.currentVersionNumber }),
              });
              const result = await response.json();
              if (response.ok) window.location.reload();
              else window.alert(result.message ?? '恢复失败。');
            });
            article.append(restore);
          }
          return article;
        }));
      });

      const yearForm = document.querySelector('#year-form');
      document.querySelector('[data-edit-year]').addEventListener('click', () => yearDialog.showModal());
      document.querySelectorAll('[data-close-year]').forEach((button) => button.addEventListener('click', () => yearDialog.close()));
      yearForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const message = yearForm.querySelector('p');
        const response = await fetch(`/api/operations-annual-plans/year/${selectedYear}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ instructions: yearForm.elements.instructions.value.trim() || null }),
        });
        const result = await response.json();
        if (response.ok) window.location.reload();
        else message.textContent = result.message ?? '保存失败。';
      });
    </script>
  </body>
</html>

