section.annual-version-history time,section.annual-version-history small{color:var(--console-muted);font-size:var(--console-caption);line-height:var(--console-caption-leading);font-variant-numeric:tabular-nums}
section.annual-version-history p{margin:8px 0;font-size:var(--console-text);line-height:var(--console-text-leading)}
section.annual-version-history [role=alert]{color:#913c35}
section.annual-version-history button{min-height:32px;border:1px solid var(--console-line);border-radius:6px;padding:5px 9px;color:var(--console-ink);background:var(--console-surface);font:500 var(--console-text)/var(--console-text-leading) var(--console-font);cursor:pointer}
section.annual-version-history button:hover{background:var(--console-surface-subtle)}
section.annual-version-history button:focus-visible,div.annual-section-empty button:focus-visible{outline:2px solid var(--console-blue);outline-offset:2px}
section.annual-version-history .snapshot-view{display:block;overflow-wrap:anywhere}
section.annual-version-history .snapshot-view strong{font-size:var(--console-emphasis);line-height:var(--console-text-leading)}
section.annual-version-history .snapshot-view p,section.annual-version-history .snapshot-view ul,section.annual-version-history .snapshot-view a{font-size:var(--console-text);line-height:var(--console-text-leading)}
</style>

<style>.taxonomy-field{display:grid;align-content:start;gap:6px}.taxonomy-field>label{display:grid;gap:6px}.taxonomy-field-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:36px}.taxonomy-field-heading>.quiet-button{min-height:36px;padding:4px 10px}.taxonomy-field-heading>label{margin:0}.taxonomy-field [data-taxonomy-editor]{display:grid;gap:8px;padding:12px;border:1px solid var(--console-line);border-radius:8px;background:var(--console-surface)}.taxonomy-field [hidden]{display:none!important}.taxonomy-field small{font:400 12px/20px var(--console-font);color:var(--console-muted)}</style>
