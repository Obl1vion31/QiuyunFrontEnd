---
import {effectiveBusinessPermissions} from '../../auth/business-permissions';
import BusinessPendingChanges from '../../components/BusinessPendingChanges.astro';
import BusinessFormDialog from '../../components/BusinessFormDialog.astro';
import { businessDateTime } from '../../scripts/business-date';
import BusinessInspector from '../../components/BusinessInspector.astro';
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessConsoleToolbar from '../../components/BusinessConsoleToolbar.astro';
import BusinessToolbarActions from '../../components/BusinessToolbarActions.astro';
import BusinessToolbarPeriodNav from '../../components/BusinessToolbarPeriodNav.astro';
import BusinessPageHeader from '../../components/BusinessPageHeader.astro';
import { asc, eq, inArray } from 'drizzle-orm';
import { deriveAnnualSummary, normalizeBlock, formatSlotRange, blockBackground, blockPromotionLabel } from '../../db/annual-plan-rules.mjs';
import { getDb } from '../../db/client';
import {
  operationsAnnualPlan,
  operationsAnnualPlanBlock,
  operationsAnnualPlanLink,
  operationsAnnualPlanYear,
  operationsCategory,
  operationsSubject,
  operationsSubjectCategory,
} from '../../db/schema';

export const prerender = false;
const permissions=Astro.locals.businessPermissions=await effectiveBusinessPermissions(getDb(),Astro.locals.user!);

const now = new Date();
const requestedYear = Number(Astro.url.searchParams.get('year') ?? now.getFullYear());
const selectedYear = Number.isInteger(requestedYear) && requestedYear >= 2000 && requestedYear <= 9999
  ? requestedYear
  : now.getFullYear();
const months = Array.from({ length: 12 }, (_, index) => index + 1);

let databaseError = '';
let yearInfo: { instructions: string | null; updatedAt: Date } | null = null;
let subjects: Array<{ id: string; name: string; sortOrder: number }> = [];
let categoryMappings: Array<{ subjectId: string; id: string; name: string; sortOrder: number }> = [];
let rows: Array<{
  id: string;
  year: number;
  sectionKey: string;
  sectionLabel: string;
  subjectId: string | null;
  subjectName: string | null;
  rowName: string;
  categoryId: string | null;
  categoryName: string | null;
  categorySortOrder: number | null;
  note: string | null;
  sortOrder: number;
  isActive: boolean;
  countsTowardPromotion: boolean;
  currentVersionNumber: number;
  updatedAt: Date;
}> = [];
let blocks: Array<{
  planId: string;
  startSlot: number | null;
  endSlot: number | null;
  promotionRanges: Array<{ startSlot: number; endSlot: number }> | null;
  startMonth: number;
  endMonth: number;
  label: string;
  ruleType: string | null;
  monthlyFrequency: number | null;
  quantityParts: number[] | null;
  note: string | null;
  sortOrder: number;
}> = [];
let links: Array<{ planId: string; label: string; url: string; sortOrder: number }> = [];

const databaseStartedAt = performance.now();
try {
  const database = getDb();
  const [yearRows, subjectRows, mappingRows, planRows] = await Promise.all([database.select({
    instructions: operationsAnnualPlanYear.instructions,
    updatedAt: operationsAnnualPlanYear.updatedAt,
  }).from(operationsAnnualPlanYear).where(eq(operationsAnnualPlanYear.year, selectedYear)).limit(1),
  database.select().from(operationsSubject).orderBy(asc(operationsSubject.sortOrder)),
  database.select({
    subjectId: operationsSubjectCategory.subjectId,
    id: operationsCategory.id,
    name: operationsCategory.name,
    sortOrder: operationsCategory.sortOrder,
  }).from(operationsSubjectCategory)
    .innerJoin(operationsCategory, eq(operationsSubjectCategory.categoryId, operationsCategory.id))
    .orderBy(asc(operationsSubjectCategory.subjectId), asc(operationsCategory.sortOrder)),
  database.select({
    id: operationsAnnualPlan.id,
    year: operationsAnnualPlan.year,
    sectionKey: operationsAnnualPlan.sectionKey,
    sectionLabel: operationsAnnualPlan.sectionLabel,
    subjectId: operationsAnnualPlan.subjectId,
    subjectName: operationsSubject.name,
    rowName: operationsAnnualPlan.rowName,
    categoryId: operationsAnnualPlan.categoryId,
    categoryName: operationsCategory.name,
    categorySortOrder: operationsCategory.sortOrder,
    note: operationsAnnualPlan.note,
    sortOrder: operationsAnnualPlan.sortOrder,
    isActive: operationsAnnualPlan.isActive,
    countsTowardPromotion: operationsAnnualPlan.countsTowardPromotion,
    currentVersionNumber: operationsAnnualPlan.currentVersionNumber,
    updatedAt: operationsAnnualPlan.updatedAt,
  }).from(operationsAnnualPlan)
    .leftJoin(operationsSubject, eq(operationsAnnualPlan.subjectId, operationsSubject.id))
    .leftJoin(operationsCategory, eq(operationsAnnualPlan.categoryId, operationsCategory.id))
    .where(eq(operationsAnnualPlan.year, selectedYear))
    .orderBy(asc(operationsAnnualPlan.sectionKey), asc(operationsAnnualPlan.sortOrder), asc(operationsAnnualPlan.rowName)),
  ]);
  [yearInfo] = yearRows;
  subjects = subjectRows;
  categoryMappings = mappingRows;
  rows = planRows;
  const rowIds = rows.map((row) => row.id);
  if (rowIds.length) {
    [blocks, links] = await Promise.all([database.select({
      planId: operationsAnnualPlanBlock.planId,
      startSlot: operationsAnnualPlanBlock.startSlot,
      endSlot: operationsAnnualPlanBlock.endSlot,
      promotionRanges: operationsAnnualPlanBlock.promotionRanges,
      startMonth: operationsAnnualPlanBlock.startMonth,
      endMonth: operationsAnnualPlanBlock.endMonth,
      label: operationsAnnualPlanBlock.label,
      ruleType: operationsAnnualPlanBlock.ruleType,
      monthlyFrequency: operationsAnnualPlanBlock.monthlyFrequency,
      quantityParts: operationsAnnualPlanBlock.quantityParts,
      note: operationsAnnualPlanBlock.note,
      sortOrder: operationsAnnualPlanBlock.sortOrder,
    }).from(operationsAnnualPlanBlock)
      .where(inArray(operationsAnnualPlanBlock.planId, rowIds))
      .orderBy(asc(operationsAnnualPlanBlock.sortOrder)),
    database.select({
      planId: operationsAnnualPlanLink.planId,
      label: operationsAnnualPlanLink.label,
      url: operationsAnnualPlanLink.url,
      sortOrder: operationsAnnualPlanLink.sortOrder,
    }).from(operationsAnnualPlanLink)
      .where(inArray(operationsAnnualPlanLink.planId, rowIds))
      .orderBy(asc(operationsAnnualPlanLink.sortOrder)),
    ]);
  }
} catch (error) {
  console.error('annual plan overview query failed', error);
  databaseError = '年度总周期规划数据库尚未就绪。请确认开发库已执行最新迁移。';
}
Astro.response.headers.set('Server-Timing', `db;dur=${(performance.now() - databaseStartedAt).toFixed(1)}`);

const subjectOrder = new Map(subjects.map((subject, index) => [subject.id, index + 1]));
const sectionKeys = Array.from(new Set([
  ...subjects.map((subject) => `subject:${subject.id}`),
  ...rows.filter((row) => row.sectionKey !== 'general').map((row) => row.sectionKey),
]));
const sectionInfo = sectionKeys.map((key) => {
  const existing = rows.find((row) => row.sectionKey === key);
  const subject = key.startsWith('subject:') ? subjects.find((item) => item.id === key.slice(8)) : undefined;
  return {
    key,
    label: existing?.sectionLabel ?? (subject ? `${subject.name} 细致规划` : key),
    subjectId: existing?.subjectId ?? subject?.id ?? null,
    sortOrder: subject ? subject.sortOrder : 9999,
    tone: subjectOrder.get(subject?.id ?? '') ?? 4,
  };
}).sort((left, right) => left.sortOrder - right.sortOrder);
const clientRows = rows.filter((row) => row.sectionKey !== 'general').sort((left, right) => (
  (left.categorySortOrder ?? 9999) - (right.categorySortOrder ?? 9999)
  || left.sortOrder - right.sortOrder
  || left.rowName.localeCompare(right.rowName, 'zh-CN')
)).map((row) => ({
  ...row,
  note: row.note ?? '',
  blocks: blocks.filter((block) => block.planId === row.id).map((block) => normalizeBlock({
    ...block, ruleType: block.ruleType as 'flexible' | 'fixed' | null,
  }, row.countsTowardPromotion)).sort((a, b) => a.startSlot - b.startSlot),
  links: links.filter((link) => link.planId === row.id),
}));
const annualSummaries = subjects.map((subject) => ({
  subjectId: subject.id,
  subjectName: subject.name,
  tone: subjectOrder.get(subject.id) ?? 4,
  ...deriveAnnualSummary(clientRows.filter((row) => row.subjectId === subject.id)),
}));
const latestTimestamp = [
  yearInfo?.updatedAt,
  ...rows.map((row) => row.updatedAt),
].filter((value): value is Date => Boolean(value)).sort((left, right) => right.getTime() - left.getTime())[0];
const latestDisplay = latestTimestamp
  ? businessDateTime(latestTimestamp)
  : '尚未保存';
const hrefForYear = (year: number) => `/business/annual-plan?year=${year}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="统一查看总规划和各学科的年度细致规划。" />
    <title>THE PLAN · 年度总周期规划</title>
  </head>
  <body>
    <BusinessConsoleFrame active="annual-plan">
        <BusinessConsoleToolbar title="总周期规划" subtitle={`${selectedYear} 年度规划`}>
          <BusinessToolbarPeriodNav slot="center" previousHref={hrefForYear(selectedYear - 1)} nextHref={hrefForYear(selectedYear + 1)} label={`${selectedYear}`} />
          <BusinessToolbarActions slot="end">
            <button class="quiet-button" type="button" data-copy-year data-business-operation="annual.copy" hidden={permissions['annual.copy']==='disabled'}><span class="copy-label-full">复制年度</span><span class="copy-label-mobile">复制</span></button>
            <button class="quiet-button toolbar-action-secondary" type="button" data-edit-year data-business-operation="annual.instructions" hidden={permissions['annual.instructions']==='disabled'}>年度说明</button>
            <button class="primary-action" type="button" data-open-new data-business-operation="annual.create" hidden={permissions['annual.create']==='disabled'}>新建规划行 <b>＋</b></button>
          </BusinessToolbarActions>
        </BusinessConsoleToolbar>

        <main class="business-console-content">
<BusinessPendingChanges module="annual"/>
          <BusinessPageHeader title={`${selectedYear} 年度总览`} description={yearInfo?.instructions || undefined}>
            <div class="updated" slot="meta"><span>最近更新</span><strong>{latestDisplay}</strong></div>
          </BusinessPageHeader>

          <nav class="section-jumps" aria-label="快速定位">
            <button class="active" type="button" data-filter="all">全部分区</button>
            {sectionInfo.map((section) => <button type="button" data-filter={section.key}>{section.label}</button>)}
            <button type="button" data-show-inactive>显示已停用</button>
          </nav>

          <div class="plan-legend" aria-label="周期颜色说明"><span><i class="legend-paid"></i>付费推广</span><span><i class="legend-organic"></i>自然流／观察</span><small>每月分前后两半 · 点击时间条查看完整备注</small></div>
          {databaseError && <p class="notice" role="alert">{databaseError}</p>}
          {!databaseError && <section class="summary-shell" aria-labelledby="summary-title">
            <header class="summary-title">
              <div><strong id="summary-title">总规划</strong></div>
              <p>按启用的细致规划汇总</p>
            </header>
            <div class="summary-scroll">
              <div class="summary-matrix">
                <div class="summary-head summary-subject-head">科目</div>
                <div class="summary-head summary-period-head">周期</div>
                {months.map((month) => <div class:list={['summary-head', 'month-col', { 'quarter-start': [1, 4, 7, 10].includes(month) }]}><strong>{month}</strong><span>月</span></div>)}
                {annualSummaries.map((summary) => [
                  <div class="summary-subject" data-tone={summary.tone}>{summary.subjectName}</div>,
                  <div class="summary-label">内容流动周期</div>,
                  <div class="summary-timeline" data-tone={summary.tone}>
                    {months.map((month) => <span class:list={['month-grid', { 'quarter-start': [1, 4, 7, 10].includes(month) }]} style={`grid-column:${month * 2 - 1}/span 2`} aria-hidden="true"></span>)}
                    {summary.postingSpans.map((span) => <span
                      class="summary-block"
                      style={`grid-column:${span.startSlot}/${span.endSlot + 1};background:${blockBackground(span)}`}
                      title={`${summary.subjectName} 内容流动周期：${formatSlotRange(span)}`}
                      aria-label={`${summary.subjectName} 内容流动周期：${formatSlotRange(span)}`}
                    ></span>)}
                  </div>,
                  <div class="summary-label">付费推广周期</div>,
                  <div class="summary-timeline" data-tone={summary.tone}>
                    {months.map((month) => <span class:list={['month-grid', { 'quarter-start': [1, 4, 7, 10].includes(month) }]} style={`grid-column:${month * 2 - 1}/span 2`} aria-hidden="true"></span>)}
                    {summary.promotionSpans.map((span) => <span
                      class="summary-block paid"
                      style={`grid-column:${span.startSlot}/${span.endSlot + 1}`}
                      title={`${summary.subjectName} 付费推广周期：${formatSlotRange(span)}`}
                      aria-label={`${summary.subjectName} 付费推广周期：${formatSlotRange(span)}`}
                    ></span>)}
                  </div>,
                ])}
              </div>
            </div>
          </section>}
          {!databaseError && <section class="matrix-shell">
            <div class="plan-matrix">
              <div class="head section-col">规划分区</div>
              <div class="head sop-col">SOP</div>
              <div class="head item-col">规划项目</div>
              {months.map((month) => <div class:list={['head', 'month-col', { 'quarter-start': [1, 4, 7, 10].includes(month) }]}><strong>{month}</strong><span>月</span></div>)}

              {sectionInfo.map((section) => {
                const sectionRows = clientRows.filter((row) => row.sectionKey === section.key);
                return <div class="section-group" data-section={section.key} data-tone={section.tone}>
                  <div class="section-band"><strong>{section.label}</strong><span>{sectionRows.length} 条规划行</span></div>
                  {sectionRows.map((row) => <div class:list={['plan-row', { inactive: !row.isActive }]} data-row-id={row.id} data-inactive={!row.isActive ? 'true' : 'false'}>
                    <div class="section-cell">{row.subjectName ?? section.label}</div>
                    <div class="sop-cell">
                      {row.links.length
                        ? row.links.map((link, index) => <a href={link.url} target="_blank" rel="noreferrer" aria-label={`打开 SOP ${index + 1}`} title={link.label || '打开 SOP'}>↗</a>)
                        : <span>—</span>}
                    </div>
                    <button class="item-cell" type="button" data-inspect-id={row.id} aria-expanded="false" title={`${row.rowName} · V${row.currentVersionNumber}`}>
                      <strong>{row.rowName}</strong>
                      <span class="row-badges">
                        <small>V{row.currentVersionNumber}</small>
                        {!row.isActive && <small class="inactive-badge">已停用</small>}
                      </span>
                    </button>
                    <div class="timeline">
                      {months.map((month) => <span class:list={['month-grid', { 'quarter-start': [1, 4, 7, 10].includes(month) }]} style={`grid-column:${month * 2 - 1}/span 2`} aria-hidden="true"></span>)}
                      {row.blocks.map((block) => <button
                        class:list={['time-block', { paid: blockPromotionLabel(block) === '全程付费推广', mixed: blockPromotionLabel(block) === '部分付费推广' }]}
                        style={`grid-column:${block.startSlot}/${block.endSlot + 1};background:${blockBackground(block)}`}
                        type="button" data-inspect-id={row.id} aria-expanded="false"
                        title={`${formatSlotRange(block)} · ${blockPromotionLabel(block)}${block.note ? `：${block.note}` : ''}`}
                        aria-label={`${row.rowName}，${formatSlotRange(block)}，${blockPromotionLabel(block)}，${block.note || '暂无备注'}`}
                      ><strong>{block.note}</strong></button>)}
                    </div>
                  </div>)}
                  {sectionRows.length === 0 && <div class="section-empty annual-section-empty">
                    <span>这个分区还没有规划行</span>
                    <button type="button" data-new-section={section.key} data-business-operation="annual.create" hidden={permissions['annual.create']==='disabled'}>在此新建</button>
                  </div>}
                </div>;
              })}
            </div>
          </section>}
        </main>

    <BusinessInspector class="inspector" label="年度规划详情" parameter="row" data-inspector-overlay>
      <header class="inspector-top">
        <div><h2 id="inspector-title" data-row-name></h2></div>
        <button type="button" data-close-inspector aria-label="关闭规划详情">×</button>
      </header>
      <div class="inspector-body">
        <div class="inspector-identity">
          <p data-section-label></p>
          <p class="relation-line" data-relation></p>
          <div class="status-line">
            <span class="version-chip" data-version>V0</span>
            <span class="status-chip" data-status></span>
            <span class="status-chip promotion-chip" data-promotion></span>
          </div>
        </div>
        <section class="inspector-section timeline-section">
          <header><strong>年度时间轨道</strong></header>
          <div class="mini-months" aria-hidden="true">
            {months.map((month) => <span class:list={{ 'quarter-start': [1, 4, 7, 10].includes(month) }}>{month}</span>)}
          </div>
          <div class="mini-timeline" data-mini-timeline></div>
        </section>
        <section class="inspector-section">
          <header><strong>时间块</strong></header>
          <div class="block-list" data-block-list></div>
        </section>
        <section class="inspector-section">
          <header><strong>SOP / 帖集链接</strong></header>
          <div class="link-list" data-link-list></div>
        </section>
        <section class="inspector-section note-section">
          <header><strong>规划备注</strong></header>
          <p data-note></p>
        </section>
        <section class="inspector-section history-section annual-version-history">
          <header><strong>版本历史</strong></header>
          <button class="history-button" type="button" data-load-history>查看全部版本</button>
          <div class="history-list" data-history-list></div>
        </section>
      </div>
      <footer class="business-inspector-actions"><button class="business-action-primary inspector-edit" type="button" data-edit-row data-business-operation="annual.edit annual.toggle" data-business-any hidden={permissions['annual.edit']==='disabled'&&permissions['annual.toggle']==='disabled'}>编辑规划行 →</button></footer>
    </BusinessInspector>
    </BusinessConsoleFrame>

    <BusinessFormDialog id="row-dialog" labelledby="row-dialog-title" width={1080} darkHeader data-form-editor>
      <form id="row-form" class="business-form">
        <header class="dialog-head"><div><h2 id="row-dialog-title" data-dialog-title>新建规划行</h2></div><button type="button" data-close-row aria-label="关闭">×</button></header>
        <input type="hidden" name="planId" />
        <input type="hidden" name="expectedVersionNumber" value="1" />
        <input type="hidden" name="subjectId" />
        <input type="hidden" name="sectionKey" />
        <input type="hidden" name="sectionLabel" />
        <div class="form-content form-dialog-body">
          <div class="form-grid business-field-grid">
            <label class="business-field-wide">规划项目名称<input name="rowName" maxlength="200" required placeholder="例如：TMUA 小班课、TMUA 一对一" /></label>
            <div class="taxonomy-field"><div class="taxonomy-field-heading"><label for="annual-section-choice">所属分区</label>{Astro.locals.user?.role==='admin'&&<button type="button" class="quiet-button" data-open-taxonomy="subject">新建学科</button>}</div><select id="annual-section-choice" name="sectionChoice" required>{sectionInfo.map(section=><option value={section.key}>{section.label}</option>)}</select>{Astro.locals.user?.role==='admin'&&<><div data-taxonomy-editor="subject" hidden><label>学科名称<input data-taxonomy-name maxlength="80"/></label><small>创建后可在整个工作台使用。</small><div class="business-action-group"><button type="button" class="business-action-secondary" data-create-taxonomy="subject">创建学科</button><button type="button" class="quiet-button" data-cancel-taxonomy>取消</button></div><output role="status"/></div></>}</div>
            <div class="taxonomy-field"><div class="taxonomy-field-heading"><label for="annual-category-choice">帖子分类（可选）</label>{Astro.locals.user?.role==='admin'&&<button type="button" class="quiet-button" data-open-taxonomy="category">新建分类</button>}</div><select id="annual-category-choice" name="categoryId"><option value="">不关联分类</option></select>{Astro.locals.user?.role==='admin'&&<><div data-taxonomy-editor="category" hidden><label>分类名称<input data-taxonomy-name maxlength="80"/></label><small>关联当前学科，创建后可在整个工作台使用。</small><div class="business-action-group"><button type="button" class="business-action-secondary" data-create-taxonomy="category">创建分类</button><button type="button" class="quiet-button" data-cancel-taxonomy>取消</button></div><output role="status"/></div></>}</div>
            <label class="check-label business-field-wide"><input name="isActive" type="checkbox" checked /> <span><b>参与本年度规划</b><small>关闭后默认隐藏，不参与总规划汇总，但保留历史。</small></span></label>
            <label class="wide">行备注<textarea name="note" rows="2" maxlength="1000"></textarea></label>
          </div>

          <section class="editor-section">
            <header><div><h3>时间块</h3></div><button class="quiet-button" type="button" data-add-block>添加时间块</button></header>
            <p>同一规划行的周期不能重叠。</p>
            <div data-block-rows></div>
          </section>
          <section class="editor-section">
            <header><div><h3>SOP 链接</h3></div><button class="quiet-button" type="button" data-add-link>添加链接</button></header>
            <div data-link-rows></div>
          </section>
          <label class="change-summary">本次调整说明（可选）<textarea name="changeSummary" rows="2" maxlength="500"></textarea></label>
          <p class="form-message" role="alert"></p>
        </div>
        <footer class="dialog-actions"><button class="quiet-button" type="button" data-close-row>取消</button><button class="save-button" type="submit">保存规划行 →</button></footer>
      </form>
    </BusinessFormDialog>

    <BusinessFormDialog id="year-dialog" labelledby="year-dialog-title" width={680} darkHeader>
      <form id="year-form" class="business-form">
        <header class="dialog-head"><div><h2 id="year-dialog-title">{selectedYear} 年规划说明</h2></div><button type="button" data-close-year aria-label="关闭">×</button></header>
        <div class="year-form-body form-dialog-body">
          <label>规划说明<textarea name="instructions" rows="8" maxlength="3000">{yearInfo?.instructions ?? ''}</textarea></label>
          <p role="alert"></p>
        </div>
        <footer class="dialog-actions"><button class="quiet-button" type="button" data-close-year>取消</button><button class="save-button" type="submit">保存说明 →</button></footer>
      </form>
    </BusinessFormDialog>

    <BusinessFormDialog id="copy-dialog" labelledby="copy-dialog-title" width={480} darkHeader>
      <form id="copy-form" class="business-form">
        <header class="dialog-head"><h2 id="copy-dialog-title">复制年度规划</h2><button type="button" data-close-copy aria-label="关闭">×</button></header>
        <div class="year-form-body form-dialog-body">
          <p>将规划行、周期、推广区间、备注与 SOP 复制到空白年度。复制后可以独立修改。</p>
          <label>来源年度<input name="sourceYear" type="number" min="2000" max="9999" required value={clientRows.length ? selectedYear : Math.max(2000, selectedYear - 1)} /></label>
          <label>目标年度<input name="targetYear" type="number" min="2000" max="9999" required value={clientRows.length ? Math.min(selectedYear + 1, 9999) : selectedYear} /></label>
          <p class="form-message" role="alert"></p>
        </div>
        <footer class="dialog-actions"><button class="quiet-button" type="button" data-close-copy>取消</button><button class="save-button" type="submit">复制年度 →</button></footer>
      </form>
    </BusinessFormDialog>
    <script is:inline id="annual-data" type="application/json" set:html={JSON.stringify({ rows: clientRows, categories: categoryMappings, sections: sectionInfo, selectedYear }).replaceAll('<', '\\u003c')} />
