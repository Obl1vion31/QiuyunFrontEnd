.meeting-ledger-main{min-width:1060px;table-layout:fixed}.meeting-ledger-main th:nth-child(1){width:175px}.meeting-ledger-main th:nth-child(2){width:195px}.meeting-ledger-main th:nth-child(3){width:140px}.meeting-ledger-main th:nth-child(5){width:90px}.meeting-ledger-main th:nth-child(6){width:230px}.meeting-ledger-main :is(th,td){white-space:nowrap;padding:12px 10px}.meeting-ledger-muted{color:var(--console-muted);font-size:12px}.meeting-name-cell{display:flex;align-items:center;gap:5px;max-width:100%}.meeting-name-cell .meeting-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.meeting-name-cell>span,.meeting-row-action{flex:none}.meeting-row-action{margin-left:7px;font-size:12px}
.meeting-ledger-main button{display:inline-block;margin:0 0 0 8px}.meeting-pdf-archive{display:inline-flex;flex-wrap:wrap;align-items:center;gap:6px 10px;max-width:280px;font:400 12px/20px var(--console-font)}.meeting-pdf-archive a{color:var(--console-blue);text-decoration:none}.meeting-pdf-archive button{margin:0;padding:0;border:0;background:none;color:var(--console-blue);font:inherit;cursor:pointer}.meeting-pdf-archive output:empty{display:none}.meeting-pdf-archive output{font:inherit;color:var(--console-muted)}.meeting-pdf-archive details span{display:block;max-width:270px;overflow-wrap:anywhere;white-space:normal}.meeting-pdf-archive summary{cursor:pointer;color:var(--console-muted)}
.meeting-version-menu{position:relative;font:400 13px/22px var(--console-font)}.meeting-version-menu summary{cursor:pointer;color:var(--console-muted)}.meeting-version-menu>div{position:absolute;z-index:10;min-width:170px;padding:10px;border:1px solid var(--console-line);border-radius:8px;background:#fff;box-shadow:0 6px 16px #21314b10;display:grid;gap:6px}.version-nav .meeting-pdf-archive{margin-left:auto}
</style>

<style is:global>
