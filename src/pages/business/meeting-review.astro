---
import {meetingEffectiveOn,meetingArrangementsExpired,latestValidMeetingVersion,meetingVersionDraft} from '../../db/meeting-version-rules';
import BusinessViewSwitch from '../../components/BusinessViewSwitch.astro';
import BusinessMeetingDiscussion from '../../components/BusinessMeetingDiscussion';
import MeetingPdfArchive from '../../components/MeetingPdfArchive';
import BusinessDateTimeFields from '../../components/BusinessDateTimeFields.astro';
import { and,desc, eq, ne, sql } from 'drizzle-orm';
import BusinessFormDialog from '../../components/BusinessFormDialog.astro';
import BusinessSectionHeader from '../../components/BusinessSectionHeader.astro';
import { businessDateTime } from '../../scripts/business-date';
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessConsoleToolbar from '../../components/BusinessConsoleToolbar.astro';
import BusinessToolbarActions from '../../components/BusinessToolbarActions.astro';
import {readWeeklyPostDetails,type WeeklyPostReference} from '../../db/meeting-note-ids';
import BusinessPromotionSnapshot from '../../components/BusinessPromotionSnapshot.astro';
import BusinessMeetingSnapshot from '../../components/BusinessMeetingSnapshot.astro';
import { getDb } from '../../db/client';
import BusinessWeeklyMeeting from '../../components/BusinessWeeklyMeeting';
import {readWeeklyDraftStates,type WeeklyMaterial} from '../../db/meeting-weekly-material';
import { readMeetingMaterial } from '../../db/meeting-snapshots';
import type { StageSnapshot } from '../../db/promotion-stage-reviews';
import { nextDateKey, previousDateKey, shanghaiDateKey } from '../../db/promotion-rules.mjs';
import { operationsReviewMeeting as meetingsTable, operationsReviewMeetingVersion as versionsTable, operationsPromotionStageReviewVersion as stageVersions, operationsReviewActionItem as issuesTable, operationsMeetingAttachment as attachmentsTable, type WeeklyMeetingDraft } from '../../db/schema';
export const prerender = false;
const now = new Date(), today = shanghaiDateKey(now);
let meetings: Array<typeof meetingsTable.$inferSelect> = [], versions: Array<typeof versionsTable.$inferSelect> = [], stageSnapshots: Array<typeof stageVersions.$inferSelect> = [], openIssues: Array<typeof issuesTable.$inferSelect> = [], images: Array<{ id: string; name: string }> = [];
let selected: typeof meetingsTable.$inferSelect | undefined;
let historicalVersions:Array<{meetingId:string;versionNumber:number;changeSummary:string;createdAt:Date;stage:string|null;id:string;pdfStatus:string|null;invalidatedAt:Date|null}>=[];
let material: Awaited<ReturnType<typeof readMeetingMaterial>> = { activity: [], candidates: [] };
let error = '';
let noteIds:Record<string,string|null>={};
let postReferences:Record<string,WeeklyPostReference>={};
let weeklyDraftMaterial:WeeklyMaterial|undefined;
let pdfFiles:Array<{id:string;name:string;meetingVersionId:string|null;source:string}>=[];
try {
  const db = getDb();
  meetings = await db.select().from(meetingsTable).orderBy(desc(meetingsTable.meetingAt));
  const requested=Astro.url.searchParams.get('meeting');selected=meetings.find(m=>m.id===requested);if(!selected&&requested&&/^[0-9a-f-]{36}$/i.test(requested))[selected]=await db.select().from(meetingsTable).where(eq(meetingsTable.id,requested));
  pdfFiles=await db.select({id:attachmentsTable.id,name:attachmentsTable.name,meetingVersionId:attachmentsTable.meetingVersionId,source:attachmentsTable.source}).from(attachmentsTable).where(eq(attachmentsTable.mimeType,'application/pdf'));
  if(!selected)historicalVersions=await db.select({id:versionsTable.id,pdfStatus:versionsTable.pdfStatus,invalidatedAt:versionsTable.invalidatedAt,meetingId:versionsTable.meetingId,versionNumber:versionsTable.versionNumber,changeSummary:versionsTable.changeSummary,createdAt:versionsTable.createdAt,stage:sql<string>`${versionsTable.snapshot}->>'finalizationStage'`}).from(versionsTable).orderBy(desc(versionsTable.createdAt),desc(versionsTable.versionNumber));
  if (selected) [versions, stageSnapshots, openIssues, images, material] = await Promise.all([
    db.select().from(versionsTable).where(eq(versionsTable.meetingId, selected.id)).orderBy(desc(versionsTable.versionNumber)),
    db.select().from(stageVersions).orderBy(desc(stageVersions.createdAt)),
    db.select().from(issuesTable).where(ne(issuesTable.status, 'resolved')),
    db.select({ id: attachmentsTable.id, name: attachmentsTable.name }).from(attachmentsTable).where(and(eq(attachmentsTable.meetingId, selected.id),ne(attachmentsTable.mimeType,'application/pdf'))),
    readMeetingMaterial(db, selected),
  ]);
  if(selected?.draftSnapshot.schemaVersion===4){
    const cached=selected.draftSnapshot.materialSnapshot as unknown as WeeklyMaterial|undefined;
    if(cached&&(selected.status==='draft'||Astro.url.searchParams.get('edit')==='1'))weeklyDraftMaterial=await readWeeklyDraftStates(db,cached);
    ({noteIds,postReferences}=await readWeeklyPostDetails(db,{promotions:[...(cached?.promotions??[]),...versions.flatMap(v=>(v.snapshot as any)?.generated?.promotions??[])],nonPromotions:[...(cached?.nonPromotions??[]),...versions.flatMap(v=>(v.snapshot as any)?.generated?.nonPromotions??[])],pending:cached?.pending}));
  }
} catch (e) { console.error('meeting review query failed', e); error = '例会数据暂时不可用，请稍后重试。'; }
const selectedVersion = versions.find(v => String(v.versionNumber) === Astro.url.searchParams.get('version')) ?? latestValidMeetingVersion(versions);
const discussionMode=!!selectedVersion&&(selectedVersion.snapshot as any).schemaVersion===4&&selected?.status==='completed';
const canEdit=discussionMode&&!selectedVersion?.invalidatedAt&&selectedVersion?.id===latestValidMeetingVersion(versions)?.id;
const effectiveOn=selected?meetingEffectiveOn(selected,versions):nextDateKey(today),arrangementsExpired=meetingArrangementsExpired(effectiveOn,now);
const discussionDraft=selectedVersion?meetingVersionDraft(selectedVersion.snapshot,selected?.draftSnapshot):undefined;
if(discussionDraft&&selectedVersion)discussionDraft.promotionDecisions={...discussionDraft.promotionDecisions,...Object.fromEntries(((selectedVersion.snapshot as any).generated?.meetingDecisions??[]).map((d:any)=>[d.campaignId,d.action==='restart_testing'?'restart_testing':d.targetStatus]))};
const editing = selected?.status === 'draft';
const rollbackVersions=versions.filter(v=>!v.invalidatedAt&&v.versionNumber>(selectedVersion?.versionNumber??Infinity));
const rollback=selectedVersion&&!canEdit?{allowed:!selectedVersion.invalidatedAt&&!arrangementsExpired&&rollbackVersions.length>0,versions:rollbackVersions.map(v=>v.versionNumber),arrangements:new Set(versions.filter(v=>!v.invalidatedAt).flatMap(v=>((v.snapshot as any).generated?.meetingDecisions??[]).map((d:any)=>d.id))).size,reason:selectedVersion.invalidatedAt?'此版本已失效':undefined}:undefined;
const previousMeeting = meetings.find(m => m.status === 'completed' && (!selected || m.meetingAt < selected.meetingAt));
const draft: WeeklyMeetingDraft = { schemaVersion: 3, coreConclusion: '', nextAction: '', promotionInputs: {}, issues: [], nonPromotionSelections: [], situation: '', strategy: '', temporaryNotes: '', temporaryLinks: [], promotionSnapshotIds: [], attachmentIds: [], ...(selected?.draftSnapshot ?? {}) };
const isWeeklyV4=draft.schemaVersion===4;
if (!selected?.draftSnapshot?.issues?.length && selected?.status === 'draft' && selected.draftSnapshot.workflowVersion!==5) draft.issues = openIssues.map(i => ({ id: i.id, problem: i.problem, conclusion: '', status: i.status as 'pending'|'validating'|'paused' }));
const selectedKeys = new Set(draft.nonPromotionSelections.map(s => `${s.scheduleId}:${s.checkpointType}`));
const refs = stageSnapshots.filter(s => draft.promotionSnapshotIds?.includes(s.id));
const promotionRows = [...new Map<string, { campaignId: string; contentName: string; versionNumber: number }>([...material.activity.map(a => [a.campaignId, a] as const), ...refs.flatMap(ref => (ref.snapshot as unknown as StageSnapshot).rows.map(row => [row.campaignId, row] as const))]).values()];
const previousSnapshot = previousMeeting ? await getDb().select().from(versionsTable).where(eq(versionsTable.meetingId, previousMeeting.id)).orderBy(desc(versionsTable.versionNumber)).limit(1).then(r => r[0]?.snapshot as any) : null;
const dateTime = businessDateTime(now).replace(' ','T');
const requestedFrom=Astro.url.searchParams.get('from'),requestedTo=Astro.url.searchParams.get('to');
const defaultEnd=requestedTo&&/^\d{4}-\d{2}-\d{2}$/.test(requestedTo)&&requestedTo<today?requestedTo:previousDateKey(today);
const latestCompletedWeekly=meetings.filter(m=>m.status==='completed'&&m.meetingType==='weekly').sort((a,b)=>b.periodEnd.localeCompare(a.periodEnd))[0];
const defaultStart=requestedFrom&&/^\d{4}-\d{2}-\d{2}$/.test(requestedFrom)&&requestedFrom<=defaultEnd?requestedFrom:latestCompletedWeekly?new Date(Date.parse(`${latestCompletedWeekly.periodEnd}T00:00:00Z`)+86400000).toISOString().slice(0,10):new Date(Date.parse(`${defaultEnd}T00:00:00Z`)-6*86400000).toISOString().slice(0,10);

---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{selected?.name??'例会总览'} · 内容发布控制台</title></head><body>
<BusinessConsoleFrame active="meeting-review">
  <BusinessConsoleToolbar layout="title" title={selected?.name??'例会总览'} subtitle={selected ? `${selected.meetingType==='monthly'?'月例会':'周例会'} · ${editing?'编辑草稿':`${(selectedVersion?.snapshot as any)?.finalizationStage==='pre'?'会前':(selectedVersion?.snapshot as any)?.finalizationStage==='post'?'会后':'已定稿'} V${selectedVersion?.versionNumber??0}`}` : '周例会、月例会与结论归档'}><BusinessToolbarActions slot="end">{selected?<a class="secondary" href="/business/meeting-review">返回例会总览</a>:<button data-open-create class="secondary">新建例会</button>}</BusinessToolbarActions></BusinessConsoleToolbar>
  <main class="business-console-content">{selectedVersion&&<header class="meeting-print-heading"><h1>{selected?.name}</h1><p>{selected?.periodStart}—{selected?.periodEnd} · V{selectedVersion.versionNumber} · {(selectedVersion.snapshot as any).finalizationStage==='post'?'会后定稿':'会前定稿'}</p></header>}{error && <p role="alert">{error}</p>}
    {!selected&&<section class="ledger"><BusinessSectionHeader title="例会记录"/><div class="meeting-ledger-scroll"><table class="meeting-ledger meeting-ledger-main"><thead><tr><th>会议日期</th><th>复盘区间</th><th>周期</th><th>会议与版本</th><th>版本备注</th><th>PDF归档</th></tr></thead><tbody>{meetings.map(m=>{const current=historicalVersions.find(v=>v.meetingId===m.id&&v.versionNumber===m.currentVersionNumber&&!v.invalidatedAt);return <tr><td>{businessDateTime(m.meetingAt)} <span class="meeting-ledger-muted">{m.meetingType==='monthly'?'月例会':'周例会'}</span></td><td>{m.periodStart}—{m.periodEnd}</td><td>{m.periodStart.slice(0,4)} M{Number(m.periodStart.slice(5,7))}{m.meetingType==='weekly'?` Week${Math.ceil(Number(m.periodStart.slice(8,10))/7)}`:''}</td><td><div class="meeting-name-cell"><a class="meeting-name" title={m.name} href={`?meeting=${m.id}`}>{m.name}</a><span>（{m.status==='draft'?'草稿':`V${m.currentVersionNumber}`}）</span>{m.status==='completed'&&m.draftSnapshot.finalizationStage==='pre'&&<a class="meeting-row-action" href={`?meeting=${m.id}`}>进入讨论</a>}</div></td><td>{current?.stage==='pre'?'会前定稿':current?.stage==='post'?'会后定稿':m.status==='draft'?'草稿':'历史定稿'}{m.status==='draft'&&<button type="button" data-delete-one={m.id} data-admin-only>删除草稿</button>}</td><td>{current?.stage==='post'?<MeetingPdfArchive client:load meetingId={m.id} versionId={current.id} status={current.pdfStatus} files={pdfFiles.filter(f=>f.meetingVersionId===current.id)}/>:<span class="meeting-ledger-muted">会后可归档</span>}</td></tr>})}{!meetings.length&&<tr><td colspan="6">暂无例会记录，可新建周例会或月例会。</td></tr>}</tbody></table></div><p role="alert" data-meeting-delete-message hidden/></section>}
    {selected && <>{versions.length>0&&<div class="version-nav"><strong>V{selectedVersion?.versionNumber} · {(selectedVersion?.snapshot as any)?.finalizationStage==='pre'?'会前定稿':'会后定稿'}{selectedVersion?.invalidatedAt?' · 已回溯失效':''}</strong><details class="meeting-version-menu"><summary>历史版本</summary><div>{versions.map(v=><a href={`?meeting=${selected!.id}&version=${v.versionNumber}`} aria-current={!editing&&v.id===selectedVersion?.id?'page':undefined}>V{v.versionNumber} · {(v.snapshot as any).finalizationStage==='pre'?'会前':'会后'}{v.invalidatedAt?' · 已失效':''}</a>)}</div></details>{discussionMode&&<BusinessViewSwitch label="版本模式" name="meeting-mode" value="read" data-meeting-mode items={[{label:'只读模式',value:'read'},{label:'编辑模式',value:'edit',disabled:!canEdit,title:!canEdit?'历史版本仅可查看':undefined}]}/>}</div>}
    {discussionMode?<BusinessMeetingDiscussion client:load snapshot={{...selectedVersion!.snapshot,versionNumber:selectedVersion!.versionNumber}} draft={discussionDraft} sourceVersionId={selectedVersion!.id} meeting={{id:selected.id,updatedAt:selected.updatedAt.toISOString(),currentVersionNumber:selected.currentVersionNumber}} postReferences={postReferences} canEdit={canEdit} effectiveOn={effectiveOn} expired={arrangementsExpired} rollback={rollback}/>:!editing && selectedVersion ? <BusinessMeetingSnapshot snapshot={selectedVersion.snapshot} postReferences={postReferences}/> : isWeeklyV4&&selected.draftSnapshot.materialSnapshot?<BusinessWeeklyMeeting client:load meeting={{id:selected.id,name:selected.name,periodStart:selected.periodStart,periodEnd:selected.periodEnd,updatedAt:selected.updatedAt.toISOString(),status:selected.status,currentVersionNumber:selected.currentVersionNumber,meetingType:selected.meetingType}} draft={draft} noteIds={noteIds} postReferences={postReferences} material={weeklyDraftMaterial??selected.draftSnapshot.materialSnapshot as unknown as WeeklyMaterial} images={images} carriedIssueIds={openIssues.filter(i=>i.createdMeetingId!==selected.id).map(i=>i.id)} effectiveOn={nextDateKey(today)} previousAction={previousSnapshot?.draft?.nextAction} previousName={previousMeeting?.name}/>: <form data-report class="report business-form">
      <nav class="section-nav"><a href="#activity">本周动向</a><a href="#promotion">推广快照</a><a href="#non-promotion">非推广快照</a><a href="#temporary">临时事项</a><a href="#conclusions">结论与进展</a></nav>
      <section id="activity" class="paper"><h2>本周动向</h2><p class="activity-counts">测试 {material.activity.filter(row => row.testingDays > 0).length} 篇 · 放量 {material.activity.filter(row => row.scalingDays > 0).length} 篇</p><p class="hint">缺失投放数据请到日度复盘补齐。</p><div class="activity-list">{material.activity.map(row => <p><strong>{row.contentName} V{row.versionNumber}</strong><span>测试 {row.testingDays} 天 · 放量 {row.scalingDays} 天 · 开口 {row.total.actualOpenCount} · 留资 {row.total.actualLeadCount}</span></p>)}{!material.activity.length && <p class="hint">该时间段暂无已录入的投放内容。</p>}</div><div class="writing-grid business-field-grid"><label>整体情况<textarea name="situation" rows="4">{draft.situation}</textarea></label><label>整体策略<textarea name="strategy" rows="4">{draft.strategy}</textarea></label></div></section>
      <section id="promotion" class="paper"><h2>推广阶段复盘快照</h2><p class="hint">引用已保存的具体版本。需要新快照时，先到<a href="/business/daily-promotion-review?view=stage">阶段复盘</a>保存。</p><details class="picker"><summary>选择快照（{draft.promotionSnapshotIds?.length ?? 0} 已选）</summary>{stageSnapshots.map(ref => { const snapshot = ref.snapshot as unknown as StageSnapshot; return <label class="check"><input type="checkbox" data-stage-ref value={ref.id} checked={draft.promotionSnapshotIds?.includes(ref.id)}/><span>{snapshot.name} · V{ref.versionNumber}<small>{snapshot.periodStart}—{snapshot.periodEnd}</small></span></label>; })}{!stageSnapshots.length && <p class="hint">还没有可引用的快照。</p>}</details><button type="button" data-refresh-preview class="secondary">保存选择并更新预览</button>
        {refs.map(ref => <BusinessPromotionSnapshot snapshot={ref.snapshot as unknown as StageSnapshot} versionNumber={ref.versionNumber}/>)}
        <h3>例会手动补充</h3>{promotionRows.map(row => { const input = draft.promotionInputs[row.campaignId]; return <article class="manual-promotion" data-promotion-id={row.campaignId}><strong>{row.contentName} V{row.versionNumber}</strong><label>点击率（%）<input type="number" min="0" max="100" step="0.01" name={`clickRate:${row.campaignId}`} value={input?.clickRate ?? ''} placeholder="手动补充"/></label><label>当前情况<textarea rows="2" name={`currentSituation:${row.campaignId}`}>{input?.currentSituation}</textarea></label><label>正在执行<textarea rows="2" name={`activeAction:${row.campaignId}`}>{input?.activeAction}</textarea></label></article>; })}
      </section>
      <section id="non-promotion" class="paper"><h2>非推广复盘快照</h2><p class="hint">定稿保留所选节点当时的指标、同类基准和结论。</p><label>搜索帖子<input type="search" data-candidate-search placeholder="帖子名称、学科或分类"/></label>
        {['本周推荐','其他可选'].map((label, index) => <details open={index === 0} class="picker"><summary>{label}</summary>{material.candidates.filter(r => r.recommended === (index === 0)).map(row => <label class="check" data-candidate-text={`${row.contentName} ${row.subjectName} ${row.categoryName ?? ''}`}><input type="checkbox" data-non-promotion-selection data-schedule-id={row.scheduleId} data-checkpoint-type={row.checkpointType} checked={selectedKeys.has(`${row.scheduleId}:${row.checkpointType}`)}/><span><strong>{row.contentName} V{row.versionNumber} · {row.checkpointType === 'day_7' ? '首轮' : '二轮'}</strong><small>{row.subjectName} / {row.categoryName ?? '临时帖'} · 提醒日 {row.dueOn} · 已复盘 {row.priorReviewCount} 次</small>{row.review ? <small>点击率 {row.review.clickRateSnapshot}% · 3 秒阅读率 {row.review.threeSecondReadRateSnapshot}% · {row.review.conclusion || '结论未填写'}</small> : <small>指标待补</small>}</span></label>)}</details>)}
      </section>
      <section id="temporary" class="paper"><h2>临时事项快照</h2><label>临时内容与表达重点<textarea name="temporaryNotes" rows="5">{draft.temporaryNotes}</textarea></label><label>相关链接（每行一个，可写“名称 | https://…”）<textarea name="temporaryLinks" rows="3">{draft.temporaryLinks?.map(l => `${l.label} | ${l.url}`).join('\n')}</textarea></label><div class="upload-zone" data-paste-images tabindex="0" aria-label="可粘贴图片"><label>上传图片，也可在此处粘贴图片<input type="file" accept="image/png,image/jpeg,image/webp" multiple data-upload-images/></label><p class="hint">每张最多 3 MB，支持 PNG、JPEG、WebP。定稿保存所选图片。</p><output data-upload-output></output></div><div class="images" data-images>{images.map(image => <label class="image-choice"><input type="checkbox" data-attachment-id value={image.id} checked={draft.attachmentIds?.includes(image.id)}/><img src={`/api/meeting-attachments/${image.id}`} alt={image.name} loading="lazy"/><span>{image.name}</span></label>)}</div></section>
      <section id="conclusions" class="paper"><h2>本周结论与事项进展</h2>{previousSnapshot?.draft?.nextAction && <details><summary>上期关键行动 · {previousMeeting?.name}</summary><p class="writing">{previousSnapshot.draft.nextAction}</p></details>}<div class="writing-grid business-field-grid"><label>本周结论<textarea name="coreConclusion" rows="4">{draft.coreConclusion}</textarea></label><label>下一步关键行动<textarea name="nextAction" rows="4">{draft.nextAction}</textarea></label></div><h3>上期遗留事项进展、本期待决定／待解决事项</h3><div data-issues class="issues">{draft.issues.map((issue, index) => <article data-issue data-id={issue.id ?? ''}><label>问题<input name={`issueProblem:${index}`} value={issue.problem}/></label><label>本周进展 / 结论<textarea rows="2" name={`issueConclusion:${index}`}>{issue.conclusion}</textarea></label><label>状态<select name={`issueStatus:${index}`}>{[['pending','待处理'],['validating','验证中'],['resolved','已解决'],['paused','暂缓']].map(([value,label]) => <option value={value} selected={issue.status === value}>{label}</option>)}</select></label></article>)}</div><button type="button" class="secondary" data-add-issue>＋ 新增问题</button></section>
      <footer class="report-actions"><output data-output role="status"></output><button type="button" class="secondary" data-save>保存草稿</button><button type="button" class="primary" data-finalize>{selected.status === 'completed' ? `发布 V${selected.currentVersionNumber + 1} 修订` : '定稿 V0'}</button></footer>
    </form>}</>}
  {!selected&&meetings.some(m=>m.status==='completed')&&<details class="ledger meeting-history-overview"><summary>历史版本 <span>· 点击查看</span></summary>{meetings.filter(m=>m.status==='completed').map(m=><details class="meeting-history"><summary>{m.name} · {m.meetingType==='monthly'?'月例会':'周例会'}（{historicalVersions.filter(v=>v.meetingId===m.id).length} 版）</summary><div class="meeting-ledger-scroll"><table class="meeting-ledger"><thead><tr><th>版本</th><th>阶段</th><th>定稿时间</th><th>版本备注</th><th>PDF归档</th></tr></thead><tbody>{historicalVersions.filter(v=>v.meetingId===m.id).map(v=><tr><td><a href={`?meeting=${m.id}&version=${v.versionNumber}`}>V{v.versionNumber}</a></td><td>{v.stage==='pre'?'会前':v.stage==='post'?'会后':'历史定稿'}</td><td>{businessDateTime(v.createdAt)}</td><td>{v.changeSummary}{v.invalidatedAt?' · 已回溯失效':''}</td><td>{v.stage==='post'&&<MeetingPdfArchive client:load meetingId={m.id} versionId={v.id} status={v.pdfStatus} files={pdfFiles.filter(f=>f.meetingVersionId===v.id)}/>}</td></tr>)}</tbody></table></div></details>)}</details>}

  </main>
</BusinessConsoleFrame>
<BusinessFormDialog data-create labelledby="create-meeting-title" width={520}><form class="business-form" data-loading-label="正在创建…"><header class="dialog-head"><h2 id="create-meeting-title">新建例会</h2><button type="button" data-close aria-label="关闭">×</button></header><div class="form-dialog-body meeting-create-fields"><label>例会类型<select name="meetingType"><option value="weekly">周例会</option><option value="monthly">月例会</option></select></label><BusinessDateTimeFields name="meetingAt" dateName="meetingDate" timeName="meetingTime" dateLabel="会议日期" timeLabel="会议时间" label="会议时间" value={dateTime} required/><div class="writing-grid business-field-grid"><label>开始日<input type="date" name="periodStart" value={defaultStart} required/></label><label>结束日<input type="date" name="periodEnd" value={defaultEnd} max={previousDateKey(today)} required/></label></div><label>标题（留空自动生成）<input name="name" maxlength="120"/></label></div><footer class="dialog-actions"><output role="status"></output><button class="primary">创建空白模板</button></footer></form></BusinessFormDialog>
<template data-issue-template><article data-issue><label>问题<input data-field="issueProblem"/></label><label>本周进展 / 结论<textarea rows="2" data-field="issueConclusion"></textarea></label><label>状态<select data-field="issueStatus"><option value="pending">待处理</option><option value="validating">验证中</option><option value="resolved">已解决</option><option value="paused">暂缓</option></select></label></article></template>
<script is:inline data-astro-rerun define:vars={{ selectedId: selected?.id ?? null, initialDraft: draft, initialUpdatedAt: selected?.updatedAt.toISOString() ?? null, weeklyStart:defaultStart }}>
(() => {
  const report=document.querySelector('[data-report]'), out=document.querySelector('[data-output]'); let expectedUpdatedAt=initialUpdatedAt; let saving=false;
  const collect=()=>{const values=new FormData(report);const draft={...initialDraft,schemaVersion:3};for(const key of ['coreConclusion','nextAction','situation','strategy','temporaryNotes'])draft[key]=values.get(key)||'';draft.temporaryLinks=String(values.get('temporaryLinks')||'').split('\n').filter(l=>l.trim()).map(line=>{const index=line.indexOf('|');return index<0?{label:'',url:line.trim()}:{label:line.slice(0,index).trim(),url:line.slice(index+1).trim()}});draft.promotionSnapshotIds=[...document.querySelectorAll('[data-stage-ref]:checked')].map(n=>n.value);draft.attachmentIds=[...document.querySelectorAll('[data-attachment-id]:checked')].map(n=>n.value);draft.nonPromotionSelections=[...document.querySelectorAll('[data-non-promotion-selection]:checked')].map(n=>({scheduleId:n.dataset.scheduleId,checkpointType:n.dataset.checkpointType}));draft.promotionInputs={...draft.promotionInputs};document.querySelectorAll('[data-promotion-id]').forEach(n=>{const id=n.dataset.promotionId;draft.promotionInputs[id]={clickRate:values.get(`clickRate:${id}`)?Number(values.get(`clickRate:${id}`)):null,recordedThrough:'',currentSituation:values.get(`currentSituation:${id}`)||'',activeAction:values.get(`activeAction:${id}`)||''}});draft.issues=[...document.querySelectorAll('[data-issue]')].map((n,i)=>({id:n.dataset.id||undefined,problem:values.get(`issueProblem:${i}`)||'',conclusion:values.get(`issueConclusion:${i}`)||'',status:values.get(`issueStatus:${i}`)||'pending'})).filter(i=>i.problem.trim());return draft;};
  const update=async(action,reload=false)=>{if(!selectedId||!report||saving)return false;if(!report.reportValidity())return false;saving=true;out.textContent='正在保存…';try{const response=await fetch(`/api/meeting-reviews/${selectedId}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,draft:collect(),expectedUpdatedAt,changeSummary:action==='finalize'?'例会复盘定稿':''})});const result=await response.json();if(!response.ok){out.textContent=result.message||'保存失败';return false}expectedUpdatedAt=result.updatedAt;document.documentElement.dataset.unsaved='false';out.textContent='草稿已保存';if(action==='finalize')location.assign(`?meeting=${selectedId}&version=${result.versionNumber}`);else if(reload)location.reload();return true;}catch{out.textContent='连接失败，输入已保留。';return false}finally{saving=false}};
  document.querySelectorAll('[data-save]').forEach(b=>b.addEventListener('click',()=>update('save')));document.querySelector('[data-refresh-preview]')?.addEventListener('click',()=>update('save',true));document.querySelector('[data-finalize]')?.addEventListener('click',async()=>{if(await window.businessConfirm('将保存本次引用的快照、指标、图片和结论为不可变版本。',{title:'例会复盘定稿',confirmLabel:'确认定稿',cancelLabel:'继续编辑'}))await update('finalize')});report?.addEventListener('submit',e=>e.preventDefault());report?.addEventListener('input',()=>document.documentElement.dataset.unsaved='true');
  document.querySelector('[data-candidate-search]')?.addEventListener('input',e=>{const query=e.target.value.trim().toLowerCase();document.querySelectorAll('[data-candidate-text]').forEach(row=>row.hidden=Boolean(query)&&!row.dataset.candidateText.toLowerCase().includes(query))});
  document.querySelector('[data-add-issue]')?.addEventListener('click',()=>{const list=document.querySelector('[data-issues]');const index=list.children.length;const node=document.querySelector('[data-issue-template]').content.cloneNode(true);node.querySelectorAll('[data-field]').forEach(input=>input.name=`${input.dataset.field}:${index}`);list.append(node);document.documentElement.dataset.unsaved='true'});
  const create=document.querySelector('[data-create]');document.querySelector('[data-open-create]')?.addEventListener('click',()=>create.showModal());document.querySelector('[data-close]')?.addEventListener('click',()=>create.close());const createForm=create.querySelector('form');let manualRange=false;createForm.querySelectorAll('[name=periodStart],[name=periodEnd]').forEach(input=>input.addEventListener('input',()=>manualRange=true));const updateCreateRange=()=>{if(manualRange)return;const date=createForm.querySelector('[name=meetingDate]').value;if(!date)return;const end=createForm.querySelector('[name=periodEnd]'),start=createForm.querySelector('[name=periodStart]'),previous=new Date(Date.parse(date+'T00:00:00Z')-86400000).toISOString().slice(0,10);end.value=previous<end.max?previous:end.max;start.value=createForm.querySelector('[name=meetingType]').value==='monthly'?end.value.slice(0,7)+'-01':weeklyStart<=end.value?weeklyStart:new Date(Date.parse(end.value+'T00:00:00Z')-6*86400000).toISOString().slice(0,10);};createForm.querySelector('[name=meetingType]').addEventListener('change',updateCreateRange);createForm.querySelector('[name=meetingDate]').addEventListener('change',updateCreateRange);let creating=false;
  createForm.addEventListener('submit',async e=>{
    e.preventDefault();if(creating||!createForm.reportValidity())return;
    const output=createForm.querySelector('output'),button=createForm.querySelector('.primary');
    creating=true;button.disabled=true;output.textContent='正在创建…';
    try{
      const response=await fetch('/api/meeting-reviews',{method:'POST',body:new FormData(createForm)});
      const result=await response.json().catch(()=>null);
      if(!response.ok){output.textContent=result?.message||`创建失败（${response.status}），输入已保留，请稍后重试。`;return;}
      if(!result?.id){output.textContent='创建结果未能确认，请先返回例会总览核对。';return;}
      location.assign(`?meeting=${result.id}`);
    }catch{output.textContent='连接失败，输入已保留；重试前请先核对例会总览。';}
    finally{creating=false;button.disabled=false;}
  });
  let deleting=false;const deleteDrafts=async ids=>{
    if(deleting||!ids.length||!await window.businessConfirm(`确认删除 ${ids.length} 份草稿？删除后无法恢复。`,{title:'删除例会草稿',confirmLabel:'确认删除',cancelLabel:'取消'}))return;
    const message=document.querySelector('[data-meeting-delete-message]'),buttons=[...document.querySelectorAll('[data-delete-selected],[data-delete-one]')];deleting=true;message.hidden=true;buttons.forEach(button=>button.disabled=true);
    try{const response=await fetch('/api/meeting-reviews',{method:'DELETE',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids})});const result=await response.json();if(!response.ok){message.textContent=result.message||'删除失败，请重试。';message.hidden=false;return}if(!ids.includes(selectedId)){for(const id of ids)document.querySelector(`[data-delete-one="${CSS.escape(id)}"]`)?.closest('tr')?.remove();if(!document.querySelector('.draft-selector'))document.querySelector('[data-delete-selected]')?.setAttribute('hidden','');return;}document.documentElement.dataset.unsaved='false';location.assign('/business/meeting-review');}
    catch{message.textContent='连接失败，草稿已保留，请重试。';message.hidden=false;}finally{deleting=false;buttons.forEach(button=>button.disabled=false);}
  };document.querySelector('[data-delete-selected]')?.addEventListener('click',()=>deleteDrafts([...document.querySelectorAll('.draft-selector:checked')].map(n=>n.value)));document.querySelectorAll('[data-delete-one]').forEach(b=>b.addEventListener('click',()=>deleteDrafts([b.dataset.deleteOne])));
  let uploading=false;const upload=async files=>{if(uploading)return;uploading=true;const output=document.querySelector('[data-upload-output]');try{for(const file of files){if(file.size>3145728){output.textContent='每张图片最多 3 MB。';continue}output.textContent='正在上传图片…';const form=new FormData();form.set('meetingId',selectedId);form.set('image',file);const response=await fetch('/api/meeting-attachments',{method:'POST',body:form});const result=await response.json();if(!response.ok){output.textContent=result.message||'上传失败';continue}const label=document.createElement('label');label.className='image-choice';const checkbox=document.createElement('input');checkbox.type='checkbox';checkbox.checked=true;checkbox.dataset.attachmentId='';checkbox.value=result.id;const img=document.createElement('img');img.src=`/api/meeting-attachments/${result.id}`;img.alt=result.name;const text=document.createElement('span');text.textContent=result.name;label.append(checkbox,img,text);document.querySelector('[data-images]').append(label);document.documentElement.dataset.unsaved='true';output.textContent='图片已上传，请保存草稿或定稿。';}}catch{output.textContent='上传失败，请重试。'}finally{uploading=false}};document.querySelector('[data-upload-images]')?.addEventListener('change',e=>upload([...e.target.files]));document.querySelector('[data-paste-images]')?.addEventListener('paste',e=>{const files=[...e.clipboardData.items].filter(i=>i.kind==='file'&&i.type.startsWith('image/')).map(i=>i.getAsFile()).filter(Boolean);if(files.length){e.preventDefault();upload(files)}});
})();
</script></body></html>
<style>
*{box-sizing:border-box}button{cursor:pointer;font:500 var(--console-caption) var(--console-font)}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,.upload-zone:focus-visible{outline:2px solid #315fd6;outline-offset:2px}.primary,.secondary{padding:10px 12px;border:0;border-radius:8px}.primary{background:#315fd6;color:#fff}.secondary{background:#e3e8e4;color:#26352d}.ledger>header{display:flex;flex-wrap:wrap;gap:12px;align-items:baseline;justify-content:space-between}.ledger h1{font-size:1rem;margin:0}.ledger p,.hint{color:#68736d;font-size:var(--console-caption);line-height:1.65}.meeting-list{display:flex;gap:10px;overflow:auto;margin:12px 0}.meeting-list article{min-width:250px;max-width:360px;display:flex;align-items:center;gap:9px;padding:12px;border:1px solid #c9d1cc;border-radius:10px;background:#f7f8f5}.meeting-list article.active{background:#e8edff;border-color:#9bb0ea}.meeting-list a{flex:1;display:grid;gap:5px;color:inherit;text-decoration:none;font-size:.75rem}.meeting-list small{font-size:var(--console-caption);color:#68736d}.meeting-list input{width:16px}.meeting-list button{border:0;background:none;color:#9a3e32}.version-nav{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin:20px 0;font-size:.75rem}.version-nav a{padding:7px 9px;border:1px solid #c9d1cc;border-radius:6px;color:#315fd6;background:#f7f8f5;text-decoration:none}.version-nav a[aria-current]{background:#dce5ff}.report{display:grid;gap:16px}.section-nav{position:sticky;top:72px;z-index:8;display:flex;gap:5px;overflow:auto;padding:8px;border:1px solid #c9d1cc;border-radius:10px;background:#f7f8f5}.section-nav a{padding:7px 9px;white-space:nowrap;color:#47534c;text-decoration:none;font-size:var(--console-caption)}.paper{min-width:0;scroll-margin-top:140px;padding:22px;border:1px solid #c9d1cc;border-radius:12px;background:#fff}.paper h2{margin:0 0 16px;font-size:1rem}.paper h3{font-size:.8rem;margin-top:20px}.writing-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}label{display:grid;gap:5px;font-size:var(--console-caption);color:#68736d}textarea,input,select{min-width:0;width:100%;padding:9px;border:1px solid #b9c3bd;border-radius:7px;background:#fbfcfa;color:#17211c;font:inherit;resize:vertical}.activity-list p{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;padding:9px 0;border-bottom:1px solid #e1e5e2;font-size:.75rem}.activity-list span{font-size:var(--console-caption);color:#68736d}.picker{margin:14px 0;border:1px solid #d5dcd7;border-radius:8px;padding:12px}.picker summary{font-size:.75rem;cursor:pointer}.check{display:flex;align-items:start;gap:10px;padding:12px 0;border-top:1px solid #e1e5e2}.check>input{width:16px;flex:none}.check>span{display:grid;gap:6px;font-size:.75rem}.check small{font-size:var(--console-caption);line-height:1.5}.check[hidden]{display:none}.manual-promotion{display:grid;grid-template-columns:1fr 100px 1fr 1fr;align-items:center;gap:12px;padding:14px 0;border-top:1px solid #d5dcd7;font-size:var(--console-caption)}.paper>:global(.promotion-snapshot){margin-top:16px}.paper>label{margin:12px 0}.upload-zone{padding:14px;border:1px dashed #aeb8b2;border-radius:9px;background:#f2f5f2}.images{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:14px}.images :global(.image-choice){display:grid;grid-template-columns:20px 1fr;gap:8px;padding:10px;border:1px solid #d5dcd7;border-radius:8px;font-size:var(--console-caption)}.images :global(img){max-width:100%;max-height:220px;object-fit:contain}.images :global(input){width:16px}.images :global(span){grid-column:2;overflow-wrap:anywhere}.issues{display:grid;gap:10px;margin:14px 0}.issues :global(article){display:grid;grid-template-columns:1fr 1.2fr 120px;gap:12px;padding:14px;border:1px solid #d5dcd7;border-radius:8px}.report-actions{position:sticky;bottom:14px;z-index:9;display:flex;align-items:center;justify-content:end;gap:10px;padding:12px;border:1px solid #c9d1cc;border-radius:10px;background:#f7f8f5}.report-actions output{margin-right:auto;font-size:var(--console-caption);color:#4e6b5b}.writing{white-space:pre-wrap;font-size:.75rem;line-height:1.6}output{font-size:var(--console-caption);color:#924b2a}@media(max-width:900px){.section-nav{top:62px}.report-actions{bottom:76px}.manual-promotion{grid-template-columns:1fr 100px}.manual-promotion label:nth-last-child(-n+2){grid-column:1/-1}}@media(max-width:600px){.paper{padding:16px}.writing-grid{grid-template-columns:1fr}.issues :global(article){grid-template-columns:1fr}.images{grid-template-columns:1fr}.version-nav strong{flex-basis:100%}}
</style>

