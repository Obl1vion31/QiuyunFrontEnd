---
import { asc, desc, eq, ne } from 'drizzle-orm';
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessConsoleToolbar from '../../components/BusinessConsoleToolbar.astro';
import BusinessToolbarActions from '../../components/BusinessToolbarActions.astro';
import BusinessToolbarContext from '../../components/BusinessToolbarContext.astro';
import BusinessToolbarSegmented from '../../components/BusinessToolbarSegmented.astro';
import { getDb } from '../../db/client';
import { addDays, automaticMeetingName, classifySchedule, shanghaiKey, sumPromotionMetrics } from '../../db/meeting-review-rules.mjs';
import {
  operationsCategory, operationsContentSchedule, operationsContentVersion, operationsNonPromotionReview,
  operationsPromotionCampaign, operationsPromotionDailyMetric, operationsReviewActionItem,
  operationsReviewMeeting, operationsReviewMeetingVersion, operationsSubject,
} from '../../db/schema';

export const prerender = false;
const now = new Date();
const today = shanghaiKey(now);
const displayMode = Astro.url.searchParams.get('display') === 'table' ? 'table' : 'blocks';
const inputDateTime = (value: Date) => new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).format(value).replace(' ', 'T');
const dateLabel = (key: string) => key.replaceAll('-', '.');
const dateTimeLabel = (value: Date | null) => value ? new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(value) : '尚未实发';
const money = (value: number | null) => value == null ? '—' : `¥${value.toFixed(2)}`;

let loadError = '';
let meetings: Array<typeof operationsReviewMeeting.$inferSelect> = [];
let versions: Array<typeof operationsReviewMeetingVersion.$inferSelect> = [];
let schedules: Array<any> = [];
let campaigns: Array<any> = [];
let dailyMetrics: Array<any> = [];
let nonPromotionReviews: Array<typeof operationsNonPromotionReview.$inferSelect> = [];
let openIssues: Array<typeof operationsReviewActionItem.$inferSelect> = [];
const startedAt = performance.now();
try {
  const db = getDb();
  [meetings, versions, schedules, campaigns, dailyMetrics, nonPromotionReviews, openIssues] = await Promise.all([
    db.select().from(operationsReviewMeeting).orderBy(desc(operationsReviewMeeting.meetingAt)),
    db.select().from(operationsReviewMeetingVersion).orderBy(desc(operationsReviewMeetingVersion.versionNumber)),
    db.select({
      id: operationsContentSchedule.id, versionId: operationsContentVersion.id, contentId: operationsContentVersion.contentId,
      versionNumber: operationsContentVersion.versionNumber, sourceVersionId: operationsContentVersion.sourceVersionId,
      contentName: operationsContentVersion.contentName, subjectName: operationsSubject.name, categoryName: operationsCategory.name,
      projectDocUrl: operationsContentVersion.projectDocUrl, syncToMoments: operationsContentSchedule.syncToMoments,
      isPromoted: operationsContentSchedule.isPromoted, promotionStatus: operationsContentSchedule.promotionStatus,
      plannedPublishAt: operationsContentSchedule.plannedPublishAt, actualPublishAt: operationsContentSchedule.actualPublishAt,
      delayReason: operationsContentSchedule.delayReason,
    }).from(operationsContentSchedule)
      .innerJoin(operationsContentVersion, eq(operationsContentSchedule.contentVersionId, operationsContentVersion.id))
      .innerJoin(operationsSubject, eq(operationsContentVersion.subjectId, operationsSubject.id))
      .leftJoin(operationsCategory, eq(operationsContentVersion.categoryId, operationsCategory.id))
      .orderBy(asc(operationsContentSchedule.plannedPublishAt)),
    db.select().from(operationsPromotionCampaign).orderBy(asc(operationsPromotionCampaign.startedOn)),
    db.select().from(operationsPromotionDailyMetric).orderBy(asc(operationsPromotionDailyMetric.metricDate)),
    db.select().from(operationsNonPromotionReview).orderBy(desc(operationsNonPromotionReview.reviewedAt)),
    db.select().from(operationsReviewActionItem).where(ne(operationsReviewActionItem.status, 'resolved')).orderBy(desc(operationsReviewActionItem.updatedAt)),
  ]);
} catch (error) {
  console.error('meeting review query failed', error);
  loadError = '周度复盘数据暂时不可用。请检查开发库和最新迁移。';
}
Astro.response.headers.set('Server-Timing', `db;dur=${(performance.now() - startedAt).toFixed(1)}`);

const selectedId = Astro.url.searchParams.get('meeting') || meetings[0]?.id;
const selected = meetings.find((meeting) => meeting.id === selectedId);
const previous = selected ? meetings.find((meeting) => meeting.status === 'completed' && meeting.meetingAt < selected.meetingAt) : undefined;
const suggestedStart = meetings.find((meeting) => meeting.status === 'completed') ? addDays(meetings.find((meeting) => meeting.status === 'completed')!.periodEnd, 1) : '';
const suggestedEnd = addDays(today, -1);
const rangeStart = selected?.periodStart ?? suggestedStart;
const rangeEnd = selected?.periodEnd ?? suggestedEnd;
const plannedRows = selected ? schedules.filter((row) => { const key = shanghaiKey(row.plannedPublishAt); return key >= rangeStart && key <= rangeEnd; }) : [];
const extraRows = selected ? schedules.filter((row) => { if (!row.actualPublishAt) return false; const actual = shanghaiKey(row.actualPublishAt); const planned = shanghaiKey(row.plannedPublishAt); return actual >= rangeStart && actual <= rangeEnd && (planned < rangeStart || planned > rangeEnd); }) : [];
const planRows = plannedRows.map((row) => ({ ...row, alignmentStatus: classifySchedule(row.plannedPublishAt, row.actualPublishAt) }));
const alignmentCounts = { published: planRows.filter((row) => row.alignmentStatus === 'published').length, delayed: planRows.filter((row) => row.alignmentStatus === 'delayed').length, unpublished: planRows.filter((row) => row.alignmentStatus === 'unpublished').length, extra: extraRows.length };

const promotionRows = selected ? campaigns.flatMap((campaign) => {
  const metrics = dailyMetrics.filter((metric) => metric.campaignId === campaign.id && metric.metricDate >= rangeStart && metric.metricDate <= rangeEnd);
  if (!metrics.length) return [];
  const schedule = schedules.find((row) => row.id === campaign.scheduleId);
  if (!schedule) return [];
  const testing = metrics.filter((metric) => metric.stageTypeSnapshot === 'testing');
  const scaling = metrics.filter((metric) => metric.stageTypeSnapshot === 'scaling');
  const input = selected.draftSnapshot?.promotionInputs?.[campaign.id] ?? { clickRate: null, recordedThrough: rangeEnd, currentSituation: '', activeAction: '' };
  const previousSnapshot = previous ? versions.find((version) => version.meetingId === previous.id && version.versionNumber === previous.currentVersionNumber)?.snapshot as any : null;
  const baselineRow = previousSnapshot?.generated?.promotions?.find((row: any) => row.contentId === schedule.contentId) ?? null;
  const baseline = baselineRow ? { ...baselineRow, input: previousSnapshot?.draft?.promotionInputs?.[baselineRow.campaignId] } : null;
  return [{ campaign, schedule, metrics, total: sumPromotionMetrics(metrics), testing: sumPromotionMetrics(testing), scaling: sumPromotionMetrics(scaling), testingDates: testing.map((metric) => metric.metricDate), scalingDates: scaling.map((metric) => metric.metricDate), input, baseline }];
}) : [];

const reviewByScheduleCheckpoint = new Map(nonPromotionReviews.map((review) => [`${review.scheduleId}:${review.checkpointType}`, review]));
const nonPromotionItems = selected ? schedules.filter((row) => !row.isPromoted && row.actualPublishAt).flatMap((row) => [7, 15].flatMap((days) => {
  const dueOn = addDays(shanghaiKey(row.actualPublishAt), days);
  const review = reviewByScheduleCheckpoint.get(`${row.id}:day_${days}`);
  const inRange = dueOn >= rangeStart && dueOn <= rangeEnd;
  const overdue = dueOn < rangeStart && !review;
  return inRange || overdue ? [{ row, days, dueOn, review, overdue }] : [];
})) : [];

const defaultIssues = selected ? openIssues.map((issue) => ({ id: issue.id, problem: issue.problem, conclusion: '', status: issue.status as 'pending'|'validating'|'paused' })) : [];
const draft = selected ? {
  ...selected.draftSnapshot,
  issues: selected.draftSnapshot?.issues?.length ? selected.draftSnapshot.issues : defaultIssues,
} : null;
const generated = selected ? {
  meeting: { id: selected.id, periodStart: selected.periodStart, periodEnd: selected.periodEnd },
  alignment: planRows.map((row) => ({ id: row.id, contentName: row.contentName, versionNumber: row.versionNumber, plannedPublishAt: row.plannedPublishAt.toISOString(), actualPublishAt: row.actualPublishAt?.toISOString() ?? null, status: row.alignmentStatus })),
  extras: extraRows.map((row) => ({ id: row.id, contentName: row.contentName, versionNumber: row.versionNumber, plannedPublishAt: row.plannedPublishAt.toISOString(), actualPublishAt: row.actualPublishAt?.toISOString() ?? null })),
  promotions: promotionRows.map((row) => ({ campaignId: row.campaign.id, contentId: row.schedule.contentId, versionId: row.schedule.versionId, contentName: row.schedule.contentName, versionNumber: row.schedule.versionNumber, total: row.total, testing: row.testing, scaling: row.scaling, testingDates: row.testingDates, scalingDates: row.scalingDates })),
  nonPromotions: nonPromotionItems.map((item) => ({ scheduleId: item.row.id, contentName: item.row.contentName, checkpoint: item.days, dueOn: item.dueOn, overdue: item.overdue, review: item.review ?? null })),
} : null;
const summary = selected ? { planned: planRows.length, ...alignmentCounts, spend: promotionRows.reduce((sum, row) => sum + row.total.spend, 0), opens: promotionRows.reduce((sum, row) => sum + row.total.actualOpenCount, 0), leads: promotionRows.reduce((sum, row) => sum + row.total.actualLeadCount, 0), nonPromotionDue: nonPromotionItems.length, nonPromotionDone: nonPromotionItems.filter((item) => item.review).length, issues: draft?.issues.length ?? 0 } : null;
const versionList = selected ? versions.filter((version) => version.meetingId === selected.id) : [];
const serializedDraft = JSON.stringify(draft).replaceAll('<', '\\u003c');
const serializedGenerated = JSON.stringify(generated).replaceAll('<', '\\u003c');
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>例会总复盘 · 内容发布控制台</title></head><body>
<BusinessConsoleFrame active="meeting-review">
  <BusinessConsoleToolbar title="例会总复盘" subtitle={selected ? `${dateLabel(selected.periodStart)}—${dateLabel(selected.periodEnd)} · ${selected.status === 'completed' ? `V${selected.currentVersionNumber} 已定稿` : '草稿'}` : '周度会议与结论归档'}>
    <BusinessToolbarContext slot="center" text={selected?.name || '例会总览'} />
    <BusinessToolbarActions slot="end">{meetings.some((meeting) => meeting.status === 'draft') && <button class="danger-secondary" data-delete-selected disabled>批量删除</button>}<button class="secondary" data-open-create>新建周会</button>{selected && <button class="primary" data-save>保存草稿</button>}</BusinessToolbarActions>
  </BusinessConsoleToolbar>
  <main>
    {loadError && <p class="notice error">{loadError}</p>}
    <section class="meeting-overview"><header><div><span>MEETING LEDGER</span><h1>例会总览</h1></div><p>日期区间由会议决定，不限定自然周。草稿可单条或批量删除，已定稿版本永久保留。</p></header><div class="meeting-list">{meetings.length ? meetings.map((meeting) => <div class:list={['meeting-entry',{active:meeting.id===selectedId}]}>{meeting.status==='draft'?<input class="draft-selector" type="checkbox" value={meeting.id} aria-label={`选择草稿：${meeting.name}`}/>:<span class="version-lock" aria-label="已定稿">◇</span>}<a href={`?meeting=${meeting.id}&display=${displayMode}`}><time>{meeting.periodStart}<br/>{meeting.periodEnd}</time><span><strong>{meeting.name}</strong><small>{new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',dateStyle:'medium'}).format(meeting.meetingAt)}</small></span><b>{meeting.status==='completed'?`V${meeting.currentVersionNumber}`:'草稿'}</b></a>{meeting.status==='draft'&&<button type="button" class="delete-one" data-delete-one={meeting.id} aria-label={`删除草稿：${meeting.name}`}>×</button>}</div>) : <p class="empty">还没有周度业务复盘。</p>}</div></section>
    {selected && draft && summary && <form class="report" data-report>
      <section class="report-title"><div><span>WEEKLY BUSINESS REVIEW</span><h2>{selected.name}</h2><p>{dateLabel(selected.periodStart)} → {dateLabel(selected.periodEnd)} · 会议 {dateTimeLabel(selected.meetingAt)}</p></div><div class="version-stack">{versionList.map((version)=><span>V{version.versionNumber}<small>{new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',month:'numeric',day:'numeric'}).format(version.createdAt)}</small></span>)}</div></section>
      <nav class="section-nav"><a href="#overview">本周总览</a><a href="#alignment">计划对齐</a><a href="#strategy">策略复盘</a><a href="#issues">事项进度</a></nav>
      <section id="overview" class="paper-section"><header><span>本周总览</span><h3>先看偏差，再定下周动作</h3></header><div class="metrics-strip"><div><small>计划</small><strong>{summary.planned}</strong><em>按时 {summary.published} · 延期 {summary.delayed}</em></div><div><small>未发 / 额外</small><strong>{summary.unpublished}<i> / {summary.extra}</i></strong><em>需解释排期偏差</em></div><div><small>推广消耗</small><strong>¥{summary.spend.toFixed(0)}</strong><em>开口 {summary.opens} · 留资 {summary.leads}</em></div><div><small>非推广到期</small><strong>{summary.nonPromotionDone}<i> / {summary.nonPromotionDue}</i></strong><em>已复盘 / 应复盘</em></div></div><div class="writing-grid"><label><span>本周核心结论</span><textarea name="coreConclusion" rows="4">{draft.coreConclusion}</textarea></label><label><span>下周关键行动</span><textarea name="nextAction" rows="4">{draft.nextAction}</textarea></label></div></section>
      <section id="alignment" class="paper-section"><header><span>计划表对齐</span><h3>应发与实发</h3><div class="legend"><i class="ok"></i>已发 <i class="late"></i>延期 <i class="miss"></i>未发</div></header><div class="alignment-table"><div class="tr th"><span>计划日期</span><span>内容</span><span>版本</span><span>实发</span><span>结果</span></div>{planRows.map((row)=><div class="tr"><time>{dateTimeLabel(row.plannedPublishAt)}</time><span><strong>{row.contentName}</strong><small>{row.subjectName} / {row.categoryName || '未分类'}{row.syncToMoments?' · 同步朋友圈':''}</small></span><b>V{row.versionNumber}</b><time>{dateTimeLabel(row.actualPublishAt)}</time><em class={row.alignmentStatus}>{row.alignmentStatus==='published'?'已发':row.alignmentStatus==='delayed'?'延期':'未发'}</em></div>)}{!planRows.length&&<p class="empty">该区间没有应发排期。</p>}</div>{extraRows.length>0&&<details><summary>额外实发 {extraRows.length} 条</summary>{extraRows.map((row)=><p>{dateTimeLabel(row.actualPublishAt)} · {row.contentName} V{row.versionNumber}</p>)}</details>}</section>
      <section id="strategy" class="paper-section strategy"><header><span>策略复盘</span><h3>推广区间复盘</h3><BusinessToolbarSegmented label="策略视图" items={[{label:'Block',href:`?meeting=${selected.id}&display=blocks#strategy`,active:displayMode==='blocks'},{label:'表格',href:`?meeting=${selected.id}&display=table#strategy`,active:displayMode==='table'}]}/></header>
        {displayMode==='blocks'?<div class="strategy-blocks">{promotionRows.map((row)=><article class="strategy-block" data-promotion-id={row.campaign.id}><header><div><span>{row.schedule.subjectName} / {row.schedule.categoryName||'未分类'} · V{row.schedule.versionNumber}</span><h4>{row.schedule.contentName}</h4></div><b class:list={[row.testing.days&&row.scaling.days?'mixed':row.scaling.days?'scaling':'testing']}>{row.testing.days&&row.scaling.days?'测试 → 放量':row.scaling.days?'放量':'测试'}</b></header><div class="hero-numbers"><label><span>点击率</span><input type="number" min="0" max="100" step="0.01" name={`clickRate:${row.campaign.id}`} value={row.input.clickRate??''} placeholder="待录入"/><small>{row.baseline?.input?.clickRate!=null?`上期 ${row.baseline.input.clickRate}%`:'暂无可比周期'}</small></label><div><span>实际开口成本</span><strong>{money(row.total.openCost)}</strong><small>{row.total.actualOpenCount} 人</small></div><div><span>实际留资成本</span><strong>{money(row.total.leadCost)}</strong><small>{row.total.actualLeadCount} 人</small></div></div><div class="block-writing"><label><span>当前情况</span><textarea rows="2" name={`currentSituation:${row.campaign.id}`}>{row.input.currentSituation}</textarea></label><label><span>正在执行</span><textarea rows="2" name={`activeAction:${row.campaign.id}`}>{row.input.activeAction}</textarea></label></div><button type="button" class="inspect" data-inspect={row.campaign.id}>查看测试 / 放量细节 ↗</button></article>)}{!promotionRows.length&&<p class="empty">该区间没有已录入的推广日度事实。</p>}</div>:<div class="promotion-table"><div class="ptr head"><span>内容</span><span>消耗</span><span>点击率</span><span>开口成本</span><span>留资成本</span><span>当前情况</span><span>正在执行</span></div>{promotionRows.map((row)=><div class="ptr" data-promotion-id={row.campaign.id}><span><strong>{row.schedule.contentName}</strong><small>V{row.schedule.versionNumber} · {row.testing.days&&row.scaling.days?'测试→放量':row.scaling.days?'放量':'测试'}</small></span><b>{money(row.total.spend)}</b><input type="number" min="0" max="100" step="0.01" name={`clickRate:${row.campaign.id}`} value={row.input.clickRate??''}/><b>{money(row.total.openCost)}</b><b>{money(row.total.leadCost)}</b><textarea rows="2" name={`currentSituation:${row.campaign.id}`}>{row.input.currentSituation}</textarea><textarea rows="2" name={`activeAction:${row.campaign.id}`}>{row.input.activeAction}</textarea></div>)}</div>}
        <div class="non-promotion"><header><span>非推广到期复盘</span><strong>{nonPromotionItems.filter((item)=>item.review).length}/{nonPromotionItems.length} 已完成</strong></header>{nonPromotionItems.map((item)=><article class:list={{overdue:item.overdue}}><div><span>{item.row.subjectName} / {item.row.categoryName||'未分类'} · T+{item.days}</span><h4>{item.row.contentName}</h4><small>到期 {item.dueOn}</small></div>{item.review?<><dl><div><dt>点击率</dt><dd>{Number(item.review.clickRateSnapshot).toFixed(2)}%</dd></div><div><dt>3 秒阅读率</dt><dd>{Number(item.review.threeSecondReadRateSnapshot).toFixed(2)}%</dd></div></dl><p>{item.review.conclusion}</p></>:<a href="/business/non-promotion-review">去完成复盘 →</a>}</article>)}{!nonPromotionItems.length&&<p class="empty">该区间没有到期或遗留节点。</p>}</div>
      </section>
      <section id="issues" class="paper-section"><header><span>每周待验证 / 待解决</span><h3>历史未结事项与本周新问题</h3><button type="button" class="add-issue" data-add-issue>＋ 新增问题</button></header><div class="issues" data-issues>{draft.issues.map((issue,index)=><article data-issue data-id={issue.id||''}><label><span>问题</span><input name={`issueProblem:${index}`} value={issue.problem}/></label><label><span>本周进展 / 结论</span><textarea rows="2" name={`issueConclusion:${index}`}>{issue.conclusion}</textarea></label><label><span>状态</span><select name={`issueStatus:${index}`}><option value="pending" selected={issue.status==='pending'}>待处理</option><option value="validating" selected={issue.status==='validating'}>验证中</option><option value="resolved" selected={issue.status==='resolved'}>已解决</option><option value="paused" selected={issue.status==='paused'}>暂缓</option></select></label></article>)}</div></section>
      <footer class="report-actions"><output data-output></output><button type="button" class="secondary" data-save>保存草稿</button><button type="button" class="finalize" data-finalize>{selected.status==='completed'?`发布 V${selected.currentVersionNumber+1} 修订`:'定稿 V0'}</button></footer>
    </form>}
  </main>
</BusinessConsoleFrame>
<dialog data-create><form data-previous-end={meetings.find((meeting) => meeting.status === 'completed')?.periodEnd || ''}><header><h2>新建周度业务复盘</h2><button type="button" data-close>×</button></header><label><span>会议时间</span><input type="datetime-local" name="meetingAt" value={inputDateTime(now)} required/></label><div class="dates"><label><span>开始日</span><input type="date" name="periodStart" value={suggestedStart} required/></label><label><span>结束日</span><input type="date" name="periodEnd" value={suggestedEnd} required/></label></div><label><span>标题（可留空自动生成）</span><input name="name" data-name placeholder={suggestedStart?automaticMeetingName(suggestedStart,suggestedEnd):'选择区间后自动生成'}/></label><output></output><button class="primary">创建并生成数据</button></form></dialog>
{promotionRows.map((row)=><dialog class="inspector" data-inspector={row.campaign.id}><header><div><span>PROMOTION DETAIL</span><h2>{row.schedule.contentName} · V{row.schedule.versionNumber}</h2></div><button type="button" data-close>×</button></header><div class="stage-detail"><section class="testing"><h3>测试期 <small>{row.testingDates[0]||'—'} — {row.testingDates.at(-1)||'—'}</small></h3><dl><div><dt>消耗</dt><dd>{money(row.testing.spend)}</dd></div><div><dt>开口成本</dt><dd>{money(row.testing.openCost)}</dd></div><div><dt>留资成本</dt><dd>{money(row.testing.leadCost)}</dd></div></dl></section><section class="scaling"><h3>放量期 <small>{row.scalingDates[0]||'—'} — {row.scalingDates.at(-1)||'—'}</small></h3><dl><div><dt>消耗</dt><dd>{money(row.scaling.spend)}</dd></div><div><dt>开口成本</dt><dd>{money(row.scaling.openCost)}</dd></div><div><dt>留资成本</dt><dd>{money(row.scaling.leadCost)}</dd></div></dl></section></div><div class="daily-detail"><h3>日度事实</h3>{row.metrics.map((metric)=><p><time>{metric.metricDate}</time><span>{metric.stageTypeSnapshot==='testing'?'测试':'放量'}</span><b>{money(Number(metric.spend))}</b><small>开口 {metric.actualOpenCount} · 留资 {metric.actualLeadCount}</small></p>)}</div></dialog>)}
<script is:inline define:vars={{ selectedId, serializedDraft, serializedGenerated }}>
const draft=serializedDraft?JSON.parse(serializedDraft):null;const generated=serializedGenerated?JSON.parse(serializedGenerated):null;const report=document.querySelector('[data-report]');const output=document.querySelector('[data-output]');
const collect=()=>{if(!report||!draft)return draft;draft.coreConclusion=report.elements.coreConclusion?.value||'';draft.nextAction=report.elements.nextAction?.value||'';document.querySelectorAll('[data-promotion-id]').forEach(node=>{const id=node.dataset.promotionId;const root=document.querySelector(`[data-promotion-id="${id}"]`);if(!id||!root)return;draft.promotionInputs[id]={clickRate:root.querySelector(`[name="clickRate:${id}"]`)?.value?Number(root.querySelector(`[name="clickRate:${id}"]`).value):null,recordedThrough:generated?.meeting?.periodEnd||'',currentSituation:root.querySelector(`[name="currentSituation:${id}"]`)?.value||'',activeAction:root.querySelector(`[name="activeAction:${id}"]`)?.value||''};});draft.issues=[...document.querySelectorAll('[data-issue]')].map((node,index)=>({id:node.dataset.id||undefined,problem:node.querySelector(`[name="issueProblem:${index}"]`)?.value||'',conclusion:node.querySelector(`[name="issueConclusion:${index}"]`)?.value||'',status:node.querySelector(`[name="issueStatus:${index}"]`)?.value||'pending'})).filter(item=>item.problem.trim());return draft};
const update=async(action)=>{if(!selectedId)return false;output.textContent='正在保存…';const response=await fetch(`/api/meeting-reviews/${selectedId}`,{method:'PATCH',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({action,draft:collect(),generated,changeSummary:action==='finalize'?'周度业务复盘定稿':''})});const result=await response.json();if(!response.ok){output.textContent=result.message||'保存失败';return false}if(action==='finalize')location.reload();else output.textContent='草稿已保存';document.documentElement.dataset.unsaved='false';return true};document.querySelectorAll('[data-save]').forEach(button=>button.addEventListener('click',()=>update('save')));document.querySelector('[data-finalize]')?.addEventListener('click',()=>{if(confirm('定稿后当前数据将作为不可变版本保存，确认继续吗？'))update('finalize')});report?.addEventListener('input',()=>{document.documentElement.dataset.unsaved='true'});document.querySelectorAll('a[href*="display="]').forEach(link=>link.addEventListener('click',async event=>{if(!document.documentElement.dataset.unsaved)return;event.preventDefault();if(await update('save'))location.assign(link.href)}));
const create=document.querySelector('[data-create]');document.querySelector('[data-open-create]')?.addEventListener('click',()=>create?.showModal());document.querySelectorAll('[data-close]').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));create?.querySelector('form')?.addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget;const out=form.querySelector('output');const previousEnd=form.dataset.previousEnd;const start=form.elements.periodStart.value;if(previousEnd){const expected=new Date(`${previousEnd}T00:00:00Z`);expected.setUTCDate(expected.getUTCDate()+1);const expectedKey=expected.toISOString().slice(0,10);if(start!==expectedKey){const gap=Math.round((new Date(`${start}T00:00:00Z`)-expected)/86400000);const message=gap>0?`与上一份已定稿周报之间留空 ${gap} 天。`:`与上一份已定稿周报重叠 ${Math.abs(gap)} 天。`;if(!confirm(`${message}仍然创建吗？`))return}}const response=await fetch('/api/meeting-reviews',{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}});const result=await response.json();if(!response.ok){out.textContent=result.message||'创建失败';return}location.assign(`/business/meeting-review?meeting=${result.id}`)});
document.querySelector('[data-add-issue]')?.addEventListener('click',()=>{collect();draft.issues.push({problem:'',conclusion:'',status:'pending'});const list=document.querySelector('[data-issues]');const index=list.children.length;list.insertAdjacentHTML('beforeend',`<article data-issue data-id=""><label><span>问题</span><input name="issueProblem:${index}"></label><label><span>本周进展 / 结论</span><textarea rows="2" name="issueConclusion:${index}"></textarea></label><label><span>状态</span><select name="issueStatus:${index}"><option value="pending">待处理</option><option value="validating">验证中</option><option value="resolved">已解决</option><option value="paused">暂缓</option></select></label></article>`)});document.querySelectorAll('[data-inspect]').forEach(button=>button.addEventListener('click',()=>document.querySelector(`[data-inspector="${button.dataset.inspect}"]`)?.showModal()));
const selectedDraftIds=()=>[...document.querySelectorAll('.draft-selector:checked')].map(input=>input.value);const batchButton=document.querySelector('[data-delete-selected]');const syncBatchButton=()=>{if(batchButton){const count=selectedDraftIds().length;batchButton.disabled=!count;batchButton.textContent=count?`删除草稿 (${count})`:'批量删除'}};document.querySelectorAll('.draft-selector').forEach(input=>input.addEventListener('change',syncBatchButton));const deleteDrafts=async ids=>{if(!ids.length||!confirm(`确认删除 ${ids.length} 份草稿吗？该操作无法撤销。`))return;const response=await fetch('/api/meeting-reviews',{method:'DELETE',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({ids})});const result=await response.json();if(!response.ok){alert(result.message||'删除失败');return}location.assign('/business/meeting-review')};batchButton?.addEventListener('click',()=>deleteDrafts(selectedDraftIds()));document.querySelectorAll('[data-delete-one]').forEach(button=>button.addEventListener('click',()=>deleteDrafts([button.dataset.deleteOne])));
</script>
