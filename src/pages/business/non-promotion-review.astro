---
import BusinessConsoleFonts from '../../components/BusinessConsoleFonts.astro';
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessConsoleToolbar from '../../components/BusinessConsoleToolbar.astro';
import BusinessToolbarSegmented from '../../components/BusinessToolbarSegmented.astro';
import BusinessToolbarSummary from '../../components/BusinessToolbarSummary.astro';
import '../../styles/non-promotion-table.css';
import MetricCell from '../../components/MetricCell.astro';
import BusinessNonPromotionTableHead from '../../components/BusinessNonPromotionTableHead.astro';
import {nonPromotionGroupLabel} from '../../db/non-promotion-groups';
import BusinessInspector from '../../components/BusinessInspector.astro';
import BusinessViewSwitch from '../../components/BusinessViewSwitch.astro';
import { businessDateTime } from '../../scripts/business-date';
import { readNonPromotionReview } from '../../db/non-promotion-read-model';
import { shanghaiDateKey } from '../../db/stage-review-rules.mjs';

export const prerender = false;
const databaseStartedAt=performance.now();
const {subjects, checkpointEvents, today, names, loadError, selectedSubject, categoryOptions, selectedCategory, rows, pending, activeView, grouped, viewHref, tableRows, selected, baseHref, categoryGroups, selectedGroup } = await readNonPromotionReview(Astro.url);
Astro.response.headers.set('Server-Timing',`db;dur=${(performance.now()-databaseStartedAt).toFixed(1)}`);
const metricPresentation=(value:number|null,benchmark:number|null)=>{const delta=value==null||benchmark==null?null:value-benchmark;return {delta,state:delta==null||Math.abs(delta)<.01?'neutral' as const:delta>0?'positive' as const:'negative' as const};};
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>非推广复盘 · 内容发布控制台</title><BusinessConsoleFonts /></head><body>
<BusinessConsoleFrame active="non-promotion-review">
  <BusinessConsoleToolbar title="非推广复盘" subtitle="同学科、同分类、同节点比较" mobilePriority="center">
    <BusinessToolbarSegmented slot="center" label="非推广复盘视图" items={[
      {label:'待复盘',href:viewHref('pending'),active:activeView==='pending'},
      {label:'已复盘',href:viewHref('history'),active:activeView==='history'},
      {label:'不复盘',href:viewHref('skipped'),active:activeView==='skipped'},
    ]}/>
    <div slot="end" class="review-summary"><BusinessToolbarSummary label="待复盘" value={pending.length} compact/><BusinessToolbarSummary label="已复盘" value={rows.reduce((count,row)=>count+row.completed.length,0)} compact/></div>
  </BusinessConsoleToolbar>
  <main class="business-console-content">
    {loadError && <div class="error-banner" role="alert">{loadError}</div>}
    <div class="review-controls">
    <form class="review-filters business-filter" method="get" data-review-filters aria-label="复盘筛选">
      <input type="hidden" name="view" value={activeView}/>
      <label>学科<select name="subject"><option value="">全部学科</option>{subjects.map(subject=><option value={subject.id} selected={subject.id===selectedSubject}>{subject.name}</option>)}</select></label>
      <label>帖子分类<select name="category" disabled={!selectedSubject}><option value="">{selectedSubject?'全部分类':'请先选择学科'}</option>{categoryOptions.map(category=><option value={category.id} selected={category.id===selectedCategory}>{category.name}</option>)}</select></label>
      {activeView === 'history' && <input type="hidden" name="group" value={grouped?'1':'0'}/>}
      {(selectedSubject||selectedCategory)&&<a href={`?view=${activeView}`}>清除筛选</a>}
    </form>
    {activeView==='history' && <div class="review-display"><span>展示方式</span><BusinessViewSwitch label="复盘展示方式" name="review-display" value={grouped?'1':'0'} items={[{label:'分类均值查看',value:'1'},{label:'历史数据总览',value:'0'}]} data-review-display/></div>}
    </div>
    <section class="review-workspace" data-inspector-host>
      <div class="table-pane"><div class="table-scroll" role="region" aria-label="非推广复盘表格" tabindex="0"><div class="review-table" role="table" data-view={activeView} data-grouped={String(grouped)} data-category={selectedGroup??''} data-nonpromotion-results={activeView==='history'||undefined}>
        <div data-flat-head hidden={grouped}><BusinessNonPromotionTableHead skipped={activeView==='skipped'}/></div>
        <div data-category-overview hidden={!grouped}>
          <div class="category-grid category-group-head" aria-hidden="true"><span>帖子分类</span><span>轮次</span><span>样本</span><span>点击率</span><span>3 秒阅读率</span><span>明细</span></div>
          {categoryGroups.map(group=><details class="review-category-group" data-category-details data-category-group={group.key} data-category-label={group.label} open={selectedGroup===group.key}>
            <summary class="category-grid category-summary-row"><strong class="category-name" title={group.label}>{group.label}</strong>{group.rounds.map((round,index)=><><span class="category-round" style={`grid-column:2;grid-row:${index+1}`}>{round.type==='day_7'?'首轮':'二轮'}</span><span class="category-sample" style={`grid-column:3;grid-row:${index+1}`} data-category-count={round.type}>{round.count} 篇</span><strong class="category-rate" style={`grid-column:4;grid-row:${index+1}`} data-category-click={round.type}>{round.click==null?'—':`${round.click.toFixed(2)}%`}</strong><strong class="category-rate" style={`grid-column:5;grid-row:${index+1}`} data-category-read={round.type}>{round.read==null?'—':`${round.read.toFixed(2)}%`}</strong></>)}<span class="category-detail-link"><span class="when-closed">查看</span><span class="when-open">收起</span><svg width="14" height="14" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></span></summary>
            <div class="category-detail-body" data-disclosure-body><BusinessNonPromotionTableHead/><div data-category-records={group.key}></div></div>
          </details>)}
        </div><div data-review-body hidden={grouped}>
        {rows.filter(row=>tableRows.some(item=>item.row.id===row.id)).map(row=>({id:row.id, row, items:tableRows.filter(item=>item.row.id===row.id)})).map(group => <div class="review-record-container" role="rowgroup" data-review-group={group.id}>
        {group.items.map((item) => {
          const clickValue=item.metric?Number(item.metric.clickRate):null;const readValue=item.metric?Number(item.metric.threeSecondReadRate):null;
          const click=metricPresentation(clickValue,item.click.mean);const read=metricPresentation(readValue,item.read.mean);
          return <div class:list={['review-row',{selected:selected?.key===item.key}]} role="row" tabindex="0" data-inspector-key={item.key} data-category-key={`${item.row.subjectId}:${item.row.categoryId??'temporary'}`} data-collaboration-observe={`schedule:${item.row.id}:non:${item.checkpoint.type}`} data-schedule-id={item.row.id} data-checkpoint={item.checkpoint.type} data-row-href={viewHref(activeView,item.key)} data-date={shanghaiDateKey(item.row.actualPublishAt)} data-click={clickValue??''} data-read={readValue??''} aria-label={`打开${item.row.contentName}${names[item.checkpoint.type]}复盘`}>
            <span role="cell" aria-colindex="1" data-review-common data-label="实验日期" class="date-cell" title={`发布日期：${shanghaiDateKey(item.row.actualPublishAt)}；应复盘日期：${item.dueOn}`}>
              <span class="review-date-range"><time datetime={shanghaiDateKey(item.row.actualPublishAt)} aria-label={`发布日期 ${shanghaiDateKey(item.row.actualPublishAt)}`}>{shanghaiDateKey(item.row.actualPublishAt)}</time><span><span class="review-date-separator" aria-hidden="true">至 </span><time datetime={item.dueOn} aria-label={`应复盘日期 ${item.dueOn}`}>{item.dueOn}</time></span></span>
            </span>
            <span role="cell" aria-colindex="2" data-review-common data-label="帖子" class:list={['post-cell',{'review-common-repeat':false}]}  title={`${item.row.contentName}${item.row.platformNoteId?`\n笔记 ID：${item.row.platformNoteId}`:''}`}>
              <span class="review-post-title"><button type="button" class="review-title-button" data-inspector-trigger aria-label={'查看详情：'+item.row.contentName+' V'+item.row.versionNumber+' '+names[item.checkpoint.type]+'复盘'}><strong>{item.row.contentName}</strong></button><small>V{item.row.versionNumber}</small></span><small class="review-post-category">{nonPromotionGroupLabel(item.row.subjectName,item.row.categoryName)}</small>
            </span>
            <span role="cell" aria-colindex="3" data-label="节点"><mark class:list={{overdue:activeView==='pending'&&item.dueOn<today}}>{names[item.checkpoint.type]}</mark></span>
            {activeView==='skipped'?<span role="cell" aria-colindex="4" class="review-reason" data-label="不复盘原因">{item.event?.reason||'—'}</span>:<><span role="cell" aria-colindex="4" data-label="点击率" class="metric"><MetricCell value={clickValue} benchmark={item.click.mean} round={activeView==='history'?names[item.checkpoint.type]:undefined} delta={click.delta} sampleSize={item.click.count} state={click.state}/></span>
            <span role="cell" aria-colindex="5" data-label="3 秒阅读率" class="metric"><MetricCell value={readValue} benchmark={item.read.mean} round={activeView==='history'?names[item.checkpoint.type]:undefined} delta={read.delta} sampleSize={item.read.count} state={read.state}/></span>
            </>}
             <span role="cell" aria-colindex={activeView==='skipped'?5:6} class="review-action-cell" data-label="操作"><button type="button" class="review-entry-button" data-collaboration-action data-inspector-trigger aria-label={(activeView==='pending'?'点击录入':'查看详情')+'：'+item.row.contentName+' V'+item.row.versionNumber+' '+names[item.checkpoint.type]+'复盘'}>{activeView==='pending'?'点击录入':'查看详情'}</button></span>
           </div>;
        })}

        </div>)}
        </div>
      </div></div>
        {!tableRows.length&&<div class="review-empty"><strong>{activeView==='pending'?'当前没有待复盘节点':activeView==='skipped'?'当前没有跳过的节点':'还没有复盘历史'}</strong></div>}
      </div>
      <BusinessInspector class="inspector" parameter="row" templates />
      {tableRows.map(selected => <template data-inspector-template={selected.key}>
        <header><div><span>{names[selected.checkpoint.type]}复盘</span><h1 data-inspector-title>{selected.row.contentName}</h1><p>{selected.row.subjectName} / {selected.row.categoryName||'临时帖'} · V{selected.row.versionNumber}</p></div><a href={baseHref} data-close-inspector aria-label="关闭详情">×</a></header>
        <section class="identity-panel review-resources" aria-label="帖子资料">
          <dl>
            <div><dt>项目文档</dt><dd>{selected.row.projectDocUrl?<a href={selected.row.projectDocUrl} target="_blank" rel="noopener noreferrer">打开项目文档 ↗</a>:<span class="resource-missing">未登记</span>}</dd></div>
            <div><dt>小红书帖子</dt><dd>{selected.row.publicationUrl?<a href={selected.row.publicationUrl} target="_blank" rel="noopener noreferrer">打开小红书帖子 ↗</a>:<span class="resource-missing">未登记</span>}</dd></div>
            <div><dt>应发时间</dt><dd>{businessDateTime(selected.row.plannedPublishAt)}</dd></div>
            <div><dt>实际发布时间</dt><dd>{businessDateTime(selected.row.actualPublishAt)}</dd></div>
          </dl>
          <a class="review-schedule-link" href={'/business/operations-schedule?'+new URLSearchParams({month:businessDateTime(selected.row.plannedPublishAt).slice(0,7),row:selected.row.id})} target="_blank" rel="noopener noreferrer">查看排期详情 ↗</a>
          <label>小红书笔记 ID</label>{selected.row.platformNoteId?<div class="full-id"><code>{selected.row.platformNoteId}</code><button type="button" data-copy-id={selected.row.platformNoteId}>复制</button></div>:<p>{activeView==='skipped'?'跳过节点无需填写笔记 ID。':'首次保存复盘时必须补填。'}</p>}
        </section>
        {selected.row.platformNoteId&&<details class="correction" data-admin-only><summary>更正笔记 ID</summary><form class="business-form" data-id-correction action={`/api/operations-content/${selected.row.contentId}/platform-note-id`}><input type="hidden" name="confirmSharedUpdate" value="true"/><label>旧值<input value={selected.row.platformNoteId} readonly/></label><label>新值<input name="platformNoteId" pattern="[0-9A-Fa-f]{24}" maxlength="24" required/></label><p>确认后，该帖子的全部版本与复盘都会同步。</p><output></output><button type="submit">确认更正</button></form></details>}
        {activeView!=='skipped'&&<form class="review-form business-form" data-review-form data-collaboration-resource={`schedule:${selected.row.id}:non:${selected.checkpoint.type}`} data-collaboration-label={`${selected.row.contentName} · ${names[selected.checkpoint.type]}`} data-success-href={viewHref('history')}>
          {selected.historical&&<p class="hint">历史口径 · 原始数据只读保留</p>}
          <fieldset disabled={selected.historical} style="border:0;padding:0;margin:0;min-width:0;width:100%;box-sizing:border-box;display:grid;gap:14px">
          <input type="hidden" name="fingerprint" value={selected.fingerprint}/>
          <input type="hidden" name="scheduleId" value={selected.row.id}/><input type="hidden" name="checkpointType" value={selected.checkpoint.type}/>
          {!selected.row.platformNoteId&&<label>小红书笔记 ID<input name="platformNoteId" pattern="[0-9A-Fa-f]{24}" maxlength="24" autocomplete="off" required placeholder="24 位十六进制 ID"/></label>}
          <label>数据截至<input type="date" name="recordedThrough" min={selected.window.min} max={selected.window.max} value={selected.metric?.recordedThrough??selected.window.defaultValue} required/></label>
          <label>点击率<div class="rate"><input type="number" min="0" max="100" step="0.0001" name="clickRate" value={selected.metric?.clickRate??''} required/><b>%</b></div></label>
          <label>3 秒阅读率<div class="rate"><input type="number" min="0" max="100" step="0.0001" name="threeSecondReadRate" value={selected.metric?.threeSecondReadRate??''} required/><b>%</b></div></label>
          <label>复盘结论（选填）<textarea name="conclusion">{selected.review?.conclusion||''}</textarea></label><output role="status"></output><button type="submit" class="business-action-primary">{selected.review?'保存修改':`完成${names[selected.checkpoint.type]}复盘`}</button></fieldset>
        </form>}
        {!selected.review&&<details class="checkpoint-action" open={activeView==='skipped'}>
          <summary>{activeView==='skipped'?'不复盘记录与恢复':'这次不复盘'}</summary>
          {activeView==='skipped'&&<p>{selected.event?.reason}<small>{selected.event?.changedByLabel} · {selected.event && shanghaiDateKey(selected.event.createdAt)}</small></p>}
          <form data-checkpoint-form data-collaboration-resource={`schedule:${selected.row.id}:non:${selected.checkpoint.type}`} data-collaboration-label={selected.row.contentName} class="review-form business-form" data-success-href={viewHref(activeView==='skipped'?'pending':'skipped')}>
            <input type="hidden" name="scheduleId" value={selected.row.id}/><input type="hidden" name="checkpointType" value={selected.checkpoint.type}/><input type="hidden" name="action" value={activeView==='skipped'?'restore':'skip'}/><input type="hidden" name="expectedEventId" value={selected.event?.id||''}/>
            <input type="hidden" name="expectedEvents" value={JSON.stringify(Object.fromEntries(['day_7','day_15'].map(type=>[type,checkpointEvents.get(`${selected.row.id}:${type}`)?.id??null])))}/>
            <label>处理范围<select name="scope"><option value="checkpoint">仅本次复盘</option><option value="schedule">该篇全部未完成复盘</option></select></label>
            <label>{activeView==='skipped'?'恢复说明':'不复盘原因'}<textarea name="reason" maxlength="500" required placeholder={activeView==='skipped'?'数据已恢复，可以补录':'例如：平台数据无法获取'}></textarea></label>
            <output role="alert"></output><button type="submit" class="business-action-primary">{activeView==='skipped'?'恢复为待复盘':'确认此节点不复盘'}</button>
          </form>
        </details>}
      </template>)}
    </section>
  </main>
</BusinessConsoleFrame>
<script>import '../../scripts/non-promotion-review';</script>

</body></html>






<style is:global>
:root{font-family:var(--console-font);color:var(--console-ink);background:var(--console-canvas)}*{box-sizing:border-box}body{margin:0}.error-banner{margin-bottom:12px;padding:12px;border-radius:8px;color:#923c26;background:#ffe5dc;font-size:var(--console-caption)}.note-id{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-variant-numeric:tabular-nums}.note-id{overflow:hidden;color:#77827c;font-size:var(--console-caption);text-overflow:ellipsis;white-space:nowrap}.note-id.missing{font-family:inherit}.inspector>header{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;gap:12px;padding:18px;border-bottom:1px solid var(--console-line);background:#fafbf9f2;backdrop-filter:blur(10px)}.inspector header span{color:var(--console-blue);font-size:var(--console-caption);font-weight:500}.inspector h1{margin:3px 0;font-size:1rem}.inspector header p,.identity-panel p{margin:0;color:var(--console-muted);font-size:var(--console-caption)}.inspector header>a{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;color:var(--console-ink);background:#e6eae7;font-size:1.1rem;text-decoration:none}.identity-panel,.correction{padding:15px 18px;border-bottom:1px solid var(--console-line)}.identity-panel>label,.correction summary{color:var(--console-muted);font-size:var(--console-caption);font-weight:500}.full-id{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:7px}.full-id code{font-size:var(--console-caption)}.full-id button,.correction button{border:1px solid #aeb8b2;border-radius:6px;padding:6px 9px;background:#fff;font-size:var(--console-caption);font-weight:500;cursor:pointer}.correction summary{cursor:pointer}.correction form,.review-form{display:grid;gap:12px}.correction form{margin-top:12px}.correction p{margin:0;color:#795129;font-size:var(--console-caption)}.review-form{padding:18px}.review-form label,.correction label{display:grid;gap:5px;color:var(--console-muted);font-size:var(--console-caption);font-weight:500}.review-form input,.review-form textarea,.correction input{width:100%;border:1px solid #abb5af;border-radius:7px;padding:9px;color:var(--console-ink);background:#fff;font:400 var(--console-caption) var(--console-font)}.review-form textarea{min-height:110px;resize:vertical}.rate{display:grid;grid-template-columns:1fr 32px;align-items:center;border:1px solid #abb5af;border-radius:7px;background:#fff}.rate input{border:0}.rate b{text-align:center}.review-form output[role=status]{color:var(--console-muted)}.review-form output[role=alert],.correction output{color:#963f29;font-size:var(--console-caption)}.review-form>button{height:40px;border:0;border-radius:8px;color:#fff;background:var(--console-blue);font-weight:500;cursor:pointer}.review-form>button:disabled{opacity:.55}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
.review-summary{display:flex;align-items:center;gap:15px;color:#68736d;font-size:var(--console-caption);white-space:nowrap}.review-summary span{display:flex;align-items:baseline;gap:5px}.review-summary b{color:#27342d;font:500 13px var(--console-font);font-variant-numeric:tabular-nums}[aria-sort="ascending"] i,[aria-sort="descending"] i{opacity:1}@media(max-width:900px){.review-summary{display:none}}
.checkpoint-action{margin:0 18px 18px;border-top:1px solid var(--console-line);padding-top:14px}.checkpoint-action summary{cursor:pointer;font-size:13px;font-weight:500}.checkpoint-action>p{font-size:13px;line-height:1.5;white-space:pre-wrap}.checkpoint-action small{display:block;color:var(--console-muted);font-size:var(--console-caption)}.checkpoint-action .review-form{padding:14px 0 0}
.review-controls{display:flex;align-items:end;justify-content:space-between;flex-wrap:wrap;gap:16px 24px;margin-bottom:16px}
.review-filters{display:flex;align-items:end;flex-wrap:wrap;gap:12px;min-width:0;margin:0}
.review-filters>label,.review-display{display:grid;gap:6px;margin:0;color:var(--console-ink);font:500 var(--console-text)/var(--console-text-leading) var(--console-font)}
.review-filters select{width:160px;max-width:100%;height:var(--console-control-compact);min-width:0;margin:0;border:1px solid #abb5af;border-radius:var(--console-control-radius);padding:6px 10px;color:var(--console-ink);background:#fff;font:400 var(--console-text)/var(--console-text-leading) var(--console-font)}
.review-filters label:has(select[name="category"]) select{width:clamp(204px,20vw,280px)}
.review-filters a{display:flex;align-items:center;height:var(--console-control-compact);padding:0 8px;color:var(--console-blue);font-size:var(--console-caption)}
.review-filters select:focus-visible{outline:2px solid var(--console-blue);outline-offset:2px}
.review-workspace{min-height:0;border:1px solid var(--console-line);border-radius:10px;background:var(--console-surface)}
.review-empty{padding:32px 16px;text-align:center;font:400 var(--console-text)/var(--console-text-leading) var(--console-font)}
.review-workspace .review-form label{font-size:var(--console-text);line-height:var(--console-text-leading);color:var(--console-ink);font-weight:500}.review-workspace .review-form :is(input,textarea){min-height:var(--console-control-height);font:400 var(--console-text)/var(--console-text-leading) var(--console-font)}
.review-workspace .rate{height:var(--console-control-height)}.review-workspace .rate input{min-height:0;height:calc(var(--console-control-height) - 2px)}.review-workspace .rate b,.review-workspace .review-form>button{font:500 var(--console-text)/var(--console-text-leading) var(--console-font)}
@media(max-width:700px){.review-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%;gap:12px}.review-filters>label{min-width:0}.review-filters select,.review-filters label:has(select[name="category"]) select{width:100%}.review-display{width:100%}}
.review-resources dl{display:grid;gap:10px;margin:0;font:400 13px/20px var(--console-font)}
.review-resources dl>div{display:grid;grid-template-columns:84px minmax(0,1fr);gap:8px;align-items:baseline}
.review-resources dt{color:var(--console-muted)}.review-resources dd{min-width:0;margin:0;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.review-resources a{color:var(--console-blue);text-decoration:none}.review-resources a:hover{text-decoration:underline;text-underline-offset:3px}
.review-resources .resource-missing{color:var(--console-muted)}
.review-resources .review-schedule-link{display:inline-block;margin:12px 0 16px;font:400 13px/20px var(--console-font)}
.review-resources>label{display:block}.review-resources>p{margin-top:6px}
@media(max-width:480px){.review-filters{grid-template-columns:1fr}.review-controls{gap:16px}.review-display .business-view-switch{max-width:100%}}
</style>
