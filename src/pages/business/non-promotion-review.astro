---
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessConsoleToolbar from '../../components/BusinessConsoleToolbar.astro';
import BusinessToolbarSegmented from '../../components/BusinessToolbarSegmented.astro';
import BusinessToolbarSummary from '../../components/BusinessToolbarSummary.astro';
import MetricCell from '../../components/MetricCell.astro';
import BusinessInspector from '../../components/BusinessInspector.astro';
import BusinessViewSwitch from '../../components/BusinessViewSwitch.astro';
import { readNonPromotionReview } from '../../db/non-promotion-read-model';
import { shanghaiDateKey } from '../../db/stage-review-rules.mjs';
import { subjects } from '../../db/taxonomy';
export const prerender = false;
const databaseStartedAt=performance.now();
const { today, names, loadError, latestPolicy, selectedSubject, categoryOptions, selectedCategory, rows, pending, activeView, selectedRound, grouped, viewHref, tableRows, selected, baseHref } = await readNonPromotionReview(Astro.url);
Astro.response.headers.set('Server-Timing',`db;dur=${(performance.now()-databaseStartedAt).toFixed(1)}`);
const metricPresentation=(value:number|null,benchmark:number|null)=>{const delta=value==null||benchmark==null?null:value-benchmark;return {delta,state:delta==null||Math.abs(delta)<.01?'neutral' as const:delta>0?'positive' as const:'negative' as const};};
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>非推广复盘 · 内容发布控制台</title></head><body>
<BusinessConsoleFrame active="non-promotion-review">
  <BusinessConsoleToolbar title="非推广复盘" subtitle="同学科、同分类、同节点比较" mobilePriority="center">
    <BusinessToolbarSegmented slot="center" label="非推广复盘视图" items={[
      {label:'待复盘',href:viewHref('pending'),active:activeView==='pending'},
      {label:'已复盘',href:viewHref('history'),active:activeView==='history'},
      {label:'不复盘',href:viewHref('skipped'),active:activeView==='skipped'},
    ]}/>
    <div slot="end" class="review-summary"><BusinessToolbarSummary label="待复盘" value={pending.length} compact/><BusinessToolbarSummary label="已复盘" value={rows.reduce((count,row)=>count+row.completed.length,0)} compact/></div>
  </BusinessConsoleToolbar>
  <main class="business-console-content">
    {loadError && <div class="error-banner" role="alert">{loadError}</div>}
    <div class="review-controls">
    <form class="review-filters business-filter" method="get" data-review-filters aria-label="复盘筛选">
      <input type="hidden" name="view" value={activeView}/>
      <label>学科<select name="subject"><option value="">全部学科</option>{subjects.map(subject=><option value={subject.id} selected={subject.id===selectedSubject}>{subject.name}</option>)}</select></label>
      <label>帖子分类<select name="category" disabled={!selectedSubject}><option value="">{selectedSubject?'全部分类':'请先选择学科'}</option>{categoryOptions.map(category=><option value={category.id} selected={category.id===selectedCategory}>{latestPolicy.get(category.id)?.displayName||category.name}</option>)}</select></label>
      {activeView === 'history' && <><label>复盘轮次<select name="checkpoint"><option value="">全部轮次</option><option value="day_7" selected={selectedRound==='day_7'}>首轮</option><option value="day_15" selected={selectedRound==='day_15'}>二轮</option></select></label><input type="hidden" name="group" value={grouped?'1':'0'}/></>}
      {(selectedSubject||selectedCategory)&&<a href={`?view=${activeView}`}>清除筛选</a>}
    </form>
    {activeView==='history' && <div class="review-display"><span>展示方式</span><BusinessViewSwitch label="复盘展示方式" name="review-display" value={grouped?'1':'0'} items={[{label:'按帖子分组',value:'1'},{label:'不分组',value:'0'}]} data-review-display/></div>}
    </div>
    <section class="review-workspace" data-inspector-host>
      <div class="table-pane"><div class="table-scroll" role="region" aria-label="非推广复盘表格" tabindex="0"><div class="review-table" role="table" data-grouped={String(grouped)}>
        <div class="review-row table-head" role="row"><span role="columnheader" aria-sort="descending"><button type="button" data-sort="date">实验日期 <i aria-hidden="true">↓</i></button></span><span role="columnheader">帖子</span><span role="columnheader">分类</span><span role="columnheader">节点</span><span role="columnheader" aria-sort="none"><button type="button" data-sort="click" disabled={grouped&&!selectedRound}>点击率 <i aria-hidden="true">↕</i></button></span><span role="columnheader" aria-sort="none"><button type="button" data-sort="read" disabled={grouped&&!selectedRound}>3 秒阅读率 <i aria-hidden="true">↕</i></button></span></div>
        <div data-review-body>
        {rows.filter(row=>tableRows.some(item=>item.row.id===row.id)).map(row=>({id:row.id, row, items:tableRows.filter(item=>item.row.id===row.id)})).map(group => <div class:list={{'review-post-group':grouped}} role="rowgroup" data-review-group={group.id}>
        {group.items.map(item => {
          const clickValue=item.metric?Number(item.metric.clickRate):null;const readValue=item.metric?Number(item.metric.threeSecondReadRate):null;
          const click=metricPresentation(clickValue,item.click.mean);const read=metricPresentation(readValue,item.read.mean);
          return <div class:list={['review-row',{selected:selected?.key===item.key}]} role="row" tabindex="0" data-inspector-key={item.key} data-schedule-id={item.row.id} data-checkpoint={item.checkpoint.type} data-row-href={viewHref(activeView,item.key)} data-date={shanghaiDateKey(item.row.actualPublishAt)} data-click={clickValue??''} data-read={readValue??''} aria-label={`打开${item.row.contentName}${names[item.checkpoint.type]}复盘`}>
            <span role="cell" data-label="实验日期" class="date-cell">{shanghaiDateKey(item.row.actualPublishAt)}</span>
            <span role="cell" data-label="帖子" class="post-cell" title={`${item.row.contentName}${item.row.platformNoteId?`\n笔记 ID：${item.row.platformNoteId}`:''}`}>
              <span class="review-post-title">{item.row.projectDocUrl?<a href={item.row.projectDocUrl} target="_blank" rel="noreferrer"><strong>{item.row.contentName}</strong><i aria-hidden="true">↗</i></a>:<strong>{item.row.contentName}</strong>}<small>V{item.row.versionNumber}</small></span>
              {!item.row.projectDocUrl&&<small>项目文档待补</small>}
            </span>
            <span role="cell" data-label="分类">{item.row.subjectName} / {item.row.categoryName||'临时帖'}</span>
            <span role="cell" data-label="节点"><mark class:list={{overdue:activeView==='pending'&&item.dueOn<today}}>{names[item.checkpoint.type]}</mark></span>
            <span role="cell" data-label="点击率" class="metric"><MetricCell value={clickValue} benchmark={item.click.mean} round={activeView==='history'?names[item.checkpoint.type]:undefined} delta={click.delta} sampleSize={item.click.count} state={click.state}/></span>
            <span role="cell" data-label="3 秒阅读率" class="metric"><MetricCell value={readValue} benchmark={item.read.mean} round={activeView==='history'?names[item.checkpoint.type]:undefined} delta={read.delta} sampleSize={item.read.count} state={read.state}/></span>
          </div>;
        })}
          {activeView==='history' && !selectedRound && ['day_7','day_15'].filter(type=>!group.items.some(item=>item.checkpoint.type===type)).map(type=><div class="review-row missing-round" role="row" data-review-placeholder data-checkpoint={type} hidden={!grouped}>
            <span role="cell" class="date-cell">{shanghaiDateKey(group.row.actualPublishAt)}</span><span role="cell" class="post-cell"><strong>{group.row.contentName}</strong><small>V{group.row.versionNumber}</small></span><span role="cell">{group.row.subjectName} / {group.row.categoryName||'临时帖'}</span><span role="cell"><mark>{names[type]}</mark></span><span role="cell" class="metric">暂无已复盘数据</span><span role="cell" class="metric">—</span>
          </div>)}
        </div>)}
        </div>
      </div></div>
        {!tableRows.length&&<div class="review-empty"><strong>{activeView==='pending'?'当前没有待复盘节点':activeView==='skipped'?'当前没有跳过的节点':'还没有复盘历史'}</strong></div>}
      </div>
      <BusinessInspector class="inspector" parameter="row" templates />
      {tableRows.map(selected => <template data-inspector-template={selected.key}>
        <header><div><span>{names[selected.checkpoint.type]}复盘</span><h1 data-inspector-title>{selected.row.contentName}</h1><p>{selected.row.subjectName} / {selected.row.categoryName||'临时帖'} · V{selected.row.versionNumber}</p></div><a href={baseHref} data-close-inspector aria-label="关闭详情">×</a></header>
        <section class="identity-panel"><label>小红书笔记 ID</label>{selected.row.platformNoteId?<div class="full-id"><code>{selected.row.platformNoteId}</code><button type="button" data-copy-id={selected.row.platformNoteId}>复制</button></div>:<p>{activeView==='skipped'?'跳过节点无需填写笔记 ID。':'首次保存复盘时必须补填。'}</p>}</section>
        {selected.row.platformNoteId&&<details class="correction" data-admin-only><summary>更正笔记 ID</summary><form class="business-form" data-id-correction action={`/api/operations-content/${selected.row.contentId}/platform-note-id`}><input type="hidden" name="confirmSharedUpdate" value="true"/><label>旧值<input value={selected.row.platformNoteId} readonly/></label><label>新值<input name="platformNoteId" pattern="[0-9A-Fa-f]{24}" maxlength="24" required/></label><p>确认后，该帖子的全部版本与复盘都会同步。</p><output></output><button type="submit">确认更正</button></form></details>}
        {activeView!=='skipped'&&<form class="review-form business-form" data-review-form data-success-href={viewHref('history')}>
          <input type="hidden" name="scheduleId" value={selected.row.id}/><input type="hidden" name="checkpointType" value={selected.checkpoint.type}/>
          {!selected.row.platformNoteId&&<label>小红书笔记 ID<input name="platformNoteId" pattern="[0-9A-Fa-f]{24}" maxlength="24" autocomplete="off" required placeholder="24 位十六进制 ID"/></label>}
          <label>数据截至<input type="date" name="recordedThrough" value={selected.metric?.recordedThrough||selected.dueOn} required/></label>
          <label>点击率<div class="rate"><input type="number" min="0" max="100" step="0.0001" name="clickRate" value={selected.metric?.clickRate??''} required/><b>%</b></div></label>
          <label>3 秒阅读率<div class="rate"><input type="number" min="0" max="100" step="0.0001" name="threeSecondReadRate" value={selected.metric?.threeSecondReadRate??''} required/><b>%</b></div></label>
          <label>复盘结论（选填）<textarea name="conclusion">{selected.review?.conclusion||''}</textarea></label><output role="alert"></output><button type="submit">{selected.review?'保存修改':`完成${names[selected.checkpoint.type]}复盘`}</button>
        </form>}
        {!selected.review&&<details class="checkpoint-action" open={activeView==='skipped'}>
          <summary>{activeView==='skipped'?'不复盘记录与恢复':'这次不复盘'}</summary>
          {activeView==='skipped'&&<p>{selected.event?.reason}<small>{selected.event?.changedByLabel} · {selected.event && shanghaiDateKey(selected.event.createdAt)}</small></p>}
          <form data-checkpoint-form class="review-form business-form" data-success-href={viewHref(activeView==='skipped'?'pending':'skipped')}>
            <input type="hidden" name="scheduleId" value={selected.row.id}/><input type="hidden" name="checkpointType" value={selected.checkpoint.type}/><input type="hidden" name="action" value={activeView==='skipped'?'restore':'skip'}/><input type="hidden" name="expectedEventId" value={selected.event?.id||''}/>
            <label>{activeView==='skipped'?'恢复说明':'不复盘原因'}<textarea name="reason" maxlength="500" required placeholder={activeView==='skipped'?'数据已恢复，可以补录':'例如：平台数据无法获取'}></textarea></label>
            <output role="alert"></output><button type="submit">{activeView==='skipped'?'恢复为待复盘':'确认此节点不复盘'}</button>
          </form>
        </details>}
      </template>)}
    </section>
  </main>
</BusinessConsoleFrame>
<script>import '../../scripts/non-promotion-review';</script>
<style is:global>
:root{font-family:Inter,"PingFang SC","Microsoft YaHei",sans-serif;color:var(--console-ink);background:#e9ece8}*{box-sizing:border-box}body{margin:0}.error-banner{margin-bottom:12px;padding:12px;border-radius:8px;color:#923c26;background:#ffe5dc;font-size:var(--console-caption)}.note-id{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-variant-numeric:tabular-nums}.note-id{overflow:hidden;color:#77827c;font-size:var(--console-caption);text-overflow:ellipsis;white-space:nowrap}.note-id.missing{font-family:inherit}.inspector>header{position:sticky;top:0;z-index:2;display:flex;justify-content:space-between;gap:12px;padding:18px;border-bottom:1px solid var(--console-line);background:#fafbf9f2;backdrop-filter:blur(10px)}.inspector header span{color:var(--console-blue);font-size:var(--console-caption);font-weight:850}.inspector h1{margin:3px 0;font-size:1rem}.inspector header p,.identity-panel p{margin:0;color:var(--console-muted);font-size:var(--console-caption)}.inspector header>a{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;color:var(--console-ink);background:#e6eae7;font-size:1.1rem;text-decoration:none}.identity-panel,.correction{padding:15px 18px;border-bottom:1px solid var(--console-line)}.identity-panel>label,.correction summary{color:var(--console-muted);font-size:var(--console-caption);font-weight:800}.full-id{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:7px}.full-id code{font-size:var(--console-caption)}.full-id button,.correction button{border:1px solid #aeb8b2;border-radius:6px;padding:6px 9px;background:#fff;font-size:var(--console-caption);font-weight:800;cursor:pointer}.correction summary{cursor:pointer}.correction form,.review-form{display:grid;gap:12px}.correction form{margin-top:12px}.correction p{margin:0;color:#795129;font-size:var(--console-caption)}.review-form{padding:18px}.review-form label,.correction label{display:grid;gap:5px;color:var(--console-muted);font-size:var(--console-caption);font-weight:750}.review-form input,.review-form textarea,.correction input{width:100%;border:1px solid #abb5af;border-radius:7px;padding:9px;color:var(--console-ink);background:#fff;font:650 var(--console-caption) system-ui}.review-form textarea{min-height:110px;resize:vertical}.rate{display:grid;grid-template-columns:1fr 32px;align-items:center;border:1px solid #abb5af;border-radius:7px;background:#fff}.rate input{border:0}.rate b{text-align:center}.review-form output,.correction output{color:#963f29;font-size:var(--console-caption)}.review-form>button{height:40px;border:0;border-radius:8px;color:#fff;background:var(--console-blue);font-weight:850;cursor:pointer}.review-form>button:disabled{opacity:.55}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
<style is:global>
.review-summary{display:flex;align-items:center;gap:15px;color:#68736d;font-size:11px;white-space:nowrap}.review-summary span{display:flex;align-items:baseline;gap:5px}.review-summary b{color:#27342d;font:750 13px ui-monospace,SFMono-Regular,Consolas,monospace}[aria-sort="ascending"] i,[aria-sort="descending"] i{opacity:1}@media(max-width:900px){.review-summary{display:none}}
</style>
</body></html>

<style is:global>
.checkpoint-action{margin:0 18px 18px;border-top:1px solid var(--console-line);padding-top:14px}.checkpoint-action summary{cursor:pointer;font-size:13px;font-weight:700}.checkpoint-action>p{font-size:13px;line-height:1.5;white-space:pre-wrap}.checkpoint-action small{display:block;color:var(--console-muted);font-size:11px}.checkpoint-action .review-form{padding:14px 0 0}
</style>

<style is:global>
</style>

<style is:global>
.review-controls{display:flex;align-items:end;justify-content:space-between;flex-wrap:wrap;gap:16px 24px;margin-bottom:16px}
.review-filters{display:flex;align-items:end;flex-wrap:wrap;gap:12px;min-width:0;margin:0}
.review-filters>label,.review-display{display:grid;gap:6px;margin:0;color:var(--console-ink);font:600 var(--console-text)/var(--console-text-leading) var(--console-font)}
.review-filters select{width:160px;max-width:100%;height:var(--console-control-compact);min-width:0;margin:0;border:1px solid #abb5af;border-radius:var(--console-control-radius);padding:6px 10px;color:var(--console-ink);background:#fff;font:400 var(--console-text)/var(--console-text-leading) var(--console-font)}
.review-filters a{display:flex;align-items:center;height:var(--console-control-compact);padding:0 8px;color:var(--console-blue);font-size:var(--console-caption)}
.review-filters select:focus-visible{outline:2px solid var(--console-blue);outline-offset:2px}
.review-workspace{min-height:0;border:1px solid var(--console-line);border-radius:10px;background:var(--console-surface)}
.table-pane{min-width:0}.table-scroll{overflow:auto;outline:none}.table-scroll:focus-visible{box-shadow:inset 0 0 0 2px var(--console-blue)}
.review-table{width:100%;min-width:960px}
.review-row{display:grid;grid-template-columns:104px minmax(220px,1.4fr) minmax(132px,.8fr) 72px minmax(184px,1fr) minmax(184px,1fr);align-items:center;min-height:60px;border-bottom:1px solid #dde2df;color:var(--console-ink);background:#fff;font:400 var(--console-text)/var(--console-text-leading) var(--console-font)}
.review-row>span{min-width:0;padding:8px 12px}
.table-head{position:sticky;top:0;z-index:2;min-height:42px;color:#53615a;background:#edf1ee;font-size:var(--console-caption);line-height:var(--console-caption-leading);font-weight:650}
.table-head>span:nth-last-child(-n+2){text-align:right}.table-head button{display:inline-flex;align-items:center;gap:5px;margin:0;padding:0;border:0;color:inherit;background:none;font:inherit;cursor:pointer}.table-head>span:nth-last-child(-n+2) button{float:right}.table-head i{opacity:.5;font-size:10px;font-style:normal}.table-head button:hover i,.table-head button:focus-visible i,[aria-sort="ascending"] i,[aria-sort="descending"] i{opacity:1}.table-head button:focus-visible{outline:2px solid var(--console-blue);outline-offset:4px}
.review-row:not(.table-head):hover,.review-row.selected{background:#f5f7f5}.review-row.selected{box-shadow:inset 3px 0 var(--console-blue)}.review-row:focus-visible{outline:2px solid var(--console-blue);outline-offset:-2px}
.date-cell{font-variant-numeric:tabular-nums}
.post-cell{display:grid;gap:3px}.review-post-title{display:flex;align-items:baseline;gap:8px;min-width:0}.post-cell a{display:flex;align-items:center;gap:5px;min-width:0;color:inherit;text-decoration:none}.post-cell a:hover strong{text-decoration:underline}.post-cell a i{flex:none;color:var(--console-muted);font-size:var(--console-caption);font-style:normal}.post-cell strong{min-width:0;overflow:hidden;color:var(--console-ink);font-size:var(--console-emphasis);line-height:var(--console-text-leading);font-weight:650;text-overflow:ellipsis;white-space:nowrap}.post-cell small{color:var(--console-muted);font-size:var(--console-caption);line-height:var(--console-caption-leading)}.review-post-title small{flex:none}
.review-row mark{display:inline-block;padding:2px 6px;border:1px solid #d9dfdb;border-radius:5px;color:#53615a;background:#f2f4f2;font-size:var(--console-caption);font-weight:600;line-height:var(--console-caption-leading);white-space:nowrap}.review-row mark.overdue{border-color:#ead8d0;color:#8d5b47;background:#faf3ef}
.review-row .metric{text-align:right}.review-row[hidden]{display:none}.review-post-group{border-bottom:1px solid var(--console-line)}.review-row.missing-round{color:var(--console-muted);font-size:var(--console-caption)}.review-table button:disabled{cursor:default;opacity:.6}
.review-empty{padding:32px 16px;text-align:center;font:400 var(--console-text)/var(--console-text-leading) var(--console-font)}
.review-workspace .review-form label{font-size:var(--console-text);line-height:var(--console-text-leading);color:var(--console-ink);font-weight:600}.review-workspace .review-form :is(input,textarea){min-height:var(--console-control-height);font:400 var(--console-text)/var(--console-text-leading) var(--console-font)}
.review-workspace .rate{height:var(--console-control-height)}.review-workspace .rate input{min-height:0;height:calc(var(--console-control-height) - 2px)}.review-workspace .rate b,.review-workspace .review-form>button{font:600 var(--console-text)/var(--console-text-leading) var(--console-font)}
@media(max-width:700px){.review-filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%;gap:12px}.review-filters>label{min-width:0}.review-filters select{width:100%}.review-display{width:100%}}
</style>
