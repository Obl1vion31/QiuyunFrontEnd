---
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessConsoleToolbar from '../../components/BusinessConsoleToolbar.astro';
import BusinessConsoleFonts from '../../components/BusinessConsoleFonts.astro';
import BusinessInspector from '../../components/BusinessInspector.astro';
import BusinessViewSwitch from '../../components/BusinessViewSwitch.astro';
import SalesTrialForms from '../../components/SalesTrialForms.astro';
import SiteIcons from '../../components/SiteIcons.astro';
import { isStatView, salesPath, salesToday, salesView, sources, stages, views, viewRole } from '../../sales-trial/model';
import { filtersFrom } from '../../sales-trial/store';
import '../../styles/sales-trial.css';

const query = Astro.url.searchParams;
const view = salesView(query.get('view'));
const ledger = view === 'ledger';
const queue = view === 'queue';
const statistics = isStatView(view);
const filters = filtersFrom(query);
const title = views[view];
const config = { view, account: Astro.locals.user!.id };
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title} · 湫云</title>
  <SiteIcons /><BusinessConsoleFonts />
</head>
<body class:list={['sales-trial', { 'sales-stat-view': statistics }]}>
<BusinessConsoleFrame active="schedule" salesView={view}>
  <BusinessConsoleToolbar title={title} subtitle="个人试用 · 记录保存在当前浏览器" layout={statistics ? 'balanced' : 'title'} mobilePriority={statistics ? 'both' : 'end'}>
    {statistics && <div slot="center" transition:persist="sales-stat-views">
      <BusinessViewSwitch label="统计视角" name="statsView" value={view} data-preview-stat-switch items={[
        { label: '本月发生', value: 'monthly' }, { label: '同批新增', value: 'cohort' }, { label: '按帖复盘', value: 'posts' },
      ]} />
    </div>}
    <div slot="end" class="sales-toolbar-actions">
      {ledger && <button class="sales-control-button sales-control-primary" type="button" data-sales-sheet="create" disabled>登记微信</button>}
      {statistics && <form method="get" action={salesPath} class="business-filter sales-stat-filters" data-sales-stat-filter>
        <input type="hidden" name="view" value={view} />
        {filters.post && <input type="hidden" name="post" value={filters.post} />}
        <label for="sales-stat-month">{view === 'monthly' ? '统计月' : '新增月份'}</label>
        <select id="sales-stat-month" name="month" data-sales-month>
          <option value={salesToday().slice(0, 7)}>本月</option>
        </select>
        <button type="submit" class="sales-control-button">查看</button>
      </form>}
    </div>
  </BusinessConsoleToolbar>
  <main class="business-console-content sales-trial-content">
    <p data-sales-receipt class="sales-receipt" role="status" hidden></p>
    <p class="sales-storage-error" data-sales-storage-error role="alert" hidden></p>
    <noscript><p class="sales-storage-error">请启用浏览器脚本后打开销售工作台。</p></noscript>
    {statistics ? <section class="sales-stat-section" data-sales-stats aria-live="polite"></section> : <>
      <section class="sales-list-context">
        <div><h1>{queue ? '来源核对' : '我的客户'}</h1><span class="sales-context-count" data-list-count></span></div>
        {queue && <span class="sales-meta" data-queue-count></span>}
      </section>
      <form class="business-filter sales-filters" method="dialog" data-sales-list-filter>
        <label class="sales-filter-search">搜索<input type="search" name="q" value={filters.q} placeholder={queue ? '微信名、微信号或来源' : '微信名或微信号'} maxlength="100" /></label>
        <label>添加月份<select name="month" data-sales-month><option value="">全部月份</option></select></label>
        {ledger && <label>跟进进度<select name="stage"><option value="">全部进度</option>{Object.entries(stages).map(([key, label]) => <option value={key} selected={filters.stage === key}>{label}</option>)}</select></label>}
        {queue && <label>来源状态<select name="source">
          {Object.entries(sources).map(([key,label]) => <option value={key} selected={(filters.source || 'pending') === key}>{label}</option>)}
          <option value="all" selected={filters.source === 'all'}>全部状态</option>
        </select></label>}
        <div class="sales-filter-actions">
          <button class="sales-control-button" type="submit">查看</button>
          <button type="button" class="sales-text-action" data-sales-clear hidden>清除</button>
        </div>
      </form>
      <div class="sales-data-surface">
        <div class="sales-table-wrap" data-sales-table>
          <table class:list={['sales-table', queue ? 'sales-queue-table' : 'sales-ledger-table']}>
            <colgroup><col class="sales-col-contact"/><col class="sales-col-time"/><col/>
              <col class={queue ? 'sales-col-source' : 'sales-col-progress'}/><col class="sales-col-action"/>
            </colgroup>
            <thead><tr>
              <th scope="col">微信名 / 微信号</th><th scope="col">添加时间</th><th scope="col">咨询方向与内容</th>
              {queue ? <><th scope="col">来源状态</th><th scope="col">操作</th></> :
                <><th scope="col">跟进进度</th><th scope="col">成交</th></>}
            </tr></thead>
            <tbody data-sales-rows></tbody>
          </table>
        </div>
      </div>
      {ledger && <BusinessInspector modal id="sales-trial-inspector" parameter="record" label="客户详情"/>}
    </>}
  </main>
  {(ledger || queue) && <SalesTrialForms role={viewRole(view)} />}
</BusinessConsoleFrame>
<script type="application/json" id="sales-trial-config" is:inline set:html={JSON.stringify(config).replace(/</g, '\\u003c')}></script>
<script>import '../../sales-trial/client';</script>
</body>
</html>
