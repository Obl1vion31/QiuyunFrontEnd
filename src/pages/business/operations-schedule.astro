---
import { asc, desc, eq } from 'drizzle-orm';
import { getDb } from '../../db/client';
import { operationsContentSchedule, operationsContentVersion } from '../../db/schema';
import { delayThresholdMs, promotionStatuses, revisionTypeValues } from '../../db/validation';

export const prerender = false;

const promotionLabels = { none: '非推广', pending: '待推广', testing: '测试中', scaling: '放量中', ended: '已结束', discarded: '测试淘汰' };
const completionLabels = { pending: '待发布', on_time: '按时发布', delayed: '延期发布' };
const revisionTypeLabels = { cover: '封面', title: '标题', body: '正文', cta: 'CTA', audience: '受众', format: '内容形式', other: '其他' };
const selectedView = Astro.url.searchParams.get('view') === 'promotion' ? 'promotion' : 'schedule';
const selectedDisplay = Astro.url.searchParams.get('display') === 'calendar' ? 'calendar' : 'ledger';
const now = new Date();
const dateParts = (date: Date) => Object.fromEntries(new Intl.DateTimeFormat('en', {
  timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
}).formatToParts(date).map((part) => [part.type, part.value]));
const monthKey = (date: Date) => { const part = dateParts(date); return `${part.year}-${part.month}`; };
const dayKey = (date: Date) => { const part = dateParts(date); return `${part.year}-${part.month}-${part.day}`; };
const inputDateTime = (date: Date | null) => {
  if (!date) return '';
  const part = dateParts(date);
  return `${part.year}-${part.month}-${part.day}T${part.hour}:${part.minute}`;
};
const displayDateTime = (date: Date | null) => {
  if (!date) return '尚未实发';
  const part = dateParts(date);
  return `${part.month}月${part.day}日 ${part.hour}:${part.minute}`;
};
const currentMonth = monthKey(now);
const requestedMonth = Astro.url.searchParams.get('month') ?? currentMonth;
const selectedMonth = /^\d{4}-\d{2}$/.test(requestedMonth) ? requestedMonth : currentMonth;
const [selectedYear, selectedMonthNumber] = selectedMonth.split('-').map(Number);
const previousMonth = new Date(Date.UTC(selectedYear, selectedMonthNumber - 2, 1)).toISOString().slice(0, 7);
const nextMonth = new Date(Date.UTC(selectedYear, selectedMonthNumber, 1)).toISOString().slice(0, 7);
const hrefFor = (changes: Record<string, string>) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  Object.entries(changes).forEach(([key, value]) => params.set(key, value));
  return `?${params.toString()}`;
};

let databaseError = '';
let rows: Array<{
  id: string; versionId: string; contentId: string; versionNumber: number; sourceVersionId: string | null;
  workType: string; contentName: string; contentType: string; revisionTypes: string[] | null;
  revisionSummary: string | null; revisionGoal: string | null; projectDocName: string | null; projectDocUrl: string | null;
  syncToMoments: boolean; promotionStatus: string; plannedPublishAt: Date; actualPublishAt: Date | null;
  completionStatus: string; delayReason: string | null;
}> = [];
try {
  rows = await getDb().select({
    id: operationsContentSchedule.id,
    versionId: operationsContentVersion.id,
    contentId: operationsContentVersion.contentId,
    versionNumber: operationsContentVersion.versionNumber,
    sourceVersionId: operationsContentVersion.sourceVersionId,
    workType: operationsContentVersion.workType,
    contentName: operationsContentVersion.contentName,
    contentType: operationsContentVersion.contentType,
    revisionTypes: operationsContentVersion.revisionTypes,
    revisionSummary: operationsContentVersion.revisionSummary,
    revisionGoal: operationsContentVersion.revisionGoal,
    projectDocName: operationsContentVersion.projectDocName,
    projectDocUrl: operationsContentVersion.projectDocUrl,
    syncToMoments: operationsContentSchedule.syncToMoments,
    promotionStatus: operationsContentSchedule.promotionStatus,
    plannedPublishAt: operationsContentSchedule.plannedPublishAt,
    actualPublishAt: operationsContentSchedule.actualPublishAt,
    completionStatus: operationsContentSchedule.completionStatus,
    delayReason: operationsContentSchedule.delayReason,
  }).from(operationsContentSchedule)
    .innerJoin(operationsContentVersion, eq(operationsContentSchedule.contentVersionId, operationsContentVersion.id))
    .orderBy(asc(operationsContentSchedule.plannedPublishAt), desc(operationsContentSchedule.createdAt));
} catch (error) {
  console.error('operations schedule query failed', error);
  databaseError = '数据库暂时不可用。请检查开发库连接和最新迁移后重试。';
}

const isOverdue = (row: typeof rows[number]) => !row.actualPublishAt && now.getTime() - row.plannedPublishAt.getTime() > delayThresholdMs;
const monthRows = rows.filter((row) => monthKey(row.plannedPublishAt) === selectedMonth);
const promotionRows = rows.filter((row) => ['testing', 'scaling'].includes(row.promotionStatus));
const activeRows = selectedView === 'promotion' ? promotionRows : monthRows;
const summary = {
  total: monthRows.length,
  pending: monthRows.filter((row) => !row.actualPublishAt).length,
  overdue: monthRows.filter(isOverdue).length,
  published: monthRows.filter((row) => row.actualPublishAt).length,
  revisions: monthRows.filter((row) => row.workType === 'revision').length,
  testing: promotionRows.filter((row) => row.promotionStatus === 'testing').length,
  scaling: promotionRows.filter((row) => row.promotionStatus === 'scaling').length,
};
const daysInMonth = new Date(Date.UTC(selectedYear, selectedMonthNumber, 0)).getUTCDate();
const firstWeekday = new Date(Date.UTC(selectedYear, selectedMonthNumber - 1, 1)).getUTCDay();
const calendarCells = Array.from({ length: Math.ceil((firstWeekday + daysInMonth) / 7) * 7 }, (_, index) => {
  const day = index - firstWeekday + 1;
  const valid = day >= 1 && day <= daysInMonth;
  const key = valid ? `${selectedMonth}-${String(day).padStart(2, '0')}` : '';
  return { day, key, valid, rows: valid ? monthRows.filter((row) => dayKey(row.plannedPublishAt) === key) : [] };
});
const clientRows = rows.map((row) => {
  const child = rows.find((candidate) => candidate.sourceVersionId === row.versionId);
  const source = row.sourceVersionId ? rows.find((candidate) => candidate.versionId === row.sourceVersionId) : undefined;
  return {
    ...row,
    plannedPublishAt: inputDateTime(row.plannedPublishAt),
    actualPublishAt: inputDateTime(row.actualPublishAt),
    projectDocName: row.projectDocName ?? '',
    projectDocUrl: row.projectDocUrl ?? '',
    delayReason: row.delayReason ?? '',
    revisionSummary: row.revisionSummary ?? '',
    revisionGoal: row.revisionGoal ?? '',
    sourceScheduleId: row.id,
    nextVersionNumber: Math.max(...rows.filter((candidate) => candidate.contentId === row.contentId).map((candidate) => candidate.versionNumber), row.versionNumber) + 1,
    childVersionNumber: child?.versionNumber ?? null,
    sourceVersionNumber: source?.versionNumber ?? null,
  };
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="管理新做帖、改帖版本和运营内容发布排期。" />
    <title>内容发布控制台 · 排期管理</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">FRONTEND <span>／ CONTENT OPS</span></a>
      <span class="access">INTERNAL ACCESS</span>
    </header>

    <main>
      <section class="intro">
        <div>
          <p class="eyebrow">CONTENT PUBLISHING CONSOLE</p>
          <h1>排期管理</h1>
          <p>新做帖从 V0 开始；内容需要调整时，从原版本派生改帖并保留完整记录。</p>
        </div>
        <button class="primary-action" type="button" data-open-new>
          <span>新做帖</span><b aria-hidden="true">＋</b>
        </button>
      </section>

      {databaseError && <p class="notice notice--error" role="alert">{databaseError}</p>}

      <nav class="context-bar" aria-label="排期主视图">
        <div class="bar-title"><span>当前模块</span><strong>内容排期</strong></div>
        <div class="segmented">
          <a class:list={{ active: selectedView === 'promotion' }} href={hrefFor({ view: 'promotion' })}>
            推广中 <span>{promotionRows.length}</span>
          </a>
          <a class:list={{ active: selectedView === 'schedule' }} href={hrefFor({ view: 'schedule' })}>
            当月排期 <span>{monthRows.length}</span>
          </a>
        </div>
        <p>日粒度复盘、阶段复盘、数据填报与报表中心按 Phase 03 计划后续建设。</p>
      </nav>

      {selectedView === 'schedule' && <section class="month-controls" aria-label="月份与显示方式">
        <div class="month-nav">
          <a href={hrefFor({ month: previousMonth })} aria-label="上个月">←</a>
          <strong>{selectedMonth}</strong>
          <a href={hrefFor({ month: nextMonth })} aria-label="下个月">→</a>
          <a class="today-link" href={hrefFor({ month: currentMonth })}>本月</a>
        </div>
        <div class="display-switch">
          <a class:list={{ active: selectedDisplay === 'ledger' }} href={hrefFor({ display: 'ledger' })}>台账</a>
          <a class:list={{ active: selectedDisplay === 'calendar' }} href={hrefFor({ display: 'calendar' })}>月历</a>
        </div>
      </section>}

      <section class="summary" aria-label="状态汇总">
        {selectedView === 'promotion' ? <>
          <div><span>测试中</span><strong>{summary.testing}</strong></div>
          <div class="signal"><span>放量中</span><strong>{summary.scaling}</strong></div>
        </> : <>
          <div><span>本月内容</span><strong>{summary.total}</strong></div>
          <div class="signal"><span>本月改帖</span><strong>{summary.revisions}</strong></div>
          <div><span>待发布</span><strong>{summary.pending}</strong></div>
          <div class="attention"><span>逾期未发</span><strong>{summary.overdue}</strong></div>
          <div><span>已实发</span><strong>{summary.published}</strong></div>
        </>}
      </section>

      {selectedView === 'promotion' && <section class="promotion-board" aria-label="当前推广内容">
        {(['testing', 'scaling'] as const).map((status) => <div class:list={['promotion-lane', { 'lane-scaling': status === 'scaling' }]}>
          <header><div><span>{status === 'testing' ? 'TESTING' : 'SCALING'}</span><h2>{promotionLabels[status]}</h2></div><strong>{promotionRows.filter((row) => row.promotionStatus === status).length}</strong></header>
          <div class="lane-list">
            {promotionRows.filter((row) => row.promotionStatus === status).map((row) => {
              const child = rows.find((candidate) => candidate.sourceVersionId === row.versionId);
              return <article>
                <div class="time-mark"><span>应发</span><strong>{displayDateTime(row.plannedPublishAt)}</strong><small>{row.actualPublishAt ? `实发 ${displayDateTime(row.actualPublishAt)}` : isOverdue(row) ? '逾期未发' : '等待实发'}</small></div>
                <div class="content-mark">
                  <div class="version-line"><span class="version-chip">V{row.versionNumber}</span><span>{row.workType === 'revision' ? '改帖' : '新做帖'}</span>{child && <span>已派生 V{child.versionNumber}</span>}</div>
                  <h3>{row.contentName}</h3><p>{row.contentType}</p>
                </div>
                <div class="row-actions"><button type="button" class="edit-button" data-edit-id={row.id}>编辑排期</button>{child ? <span class="derived-label">已有 V{child.versionNumber}</span> : <button type="button" class="revise-button" data-revise-id={row.id}>改帖</button>}</div>
                <div class="doc-mark">{row.projectDocUrl ? <a href={row.projectDocUrl} target="_blank" rel="noreferrer">{row.projectDocName || '打开项目文档'} ↗</a> : <span>项目文档待补</span>}</div>
              </article>;
            })}
            {!promotionRows.some((row) => row.promotionStatus === status) && <p class="empty-lane">当前没有{promotionLabels[status]}的内容。</p>}
          </div>
        </div>)}
      </section>}

      {selectedView === 'schedule' && selectedDisplay === 'ledger' && <section>
        <div class="table-wrap">
          <table>
            <thead><tr><th>发布时间</th><th>版本与内容</th><th>推广阶段</th><th>完成情况</th><th>项目文档</th><th>操作</th></tr></thead>
            <tbody>
              {activeRows.map((row, index) => {
                const newDay = index === 0 || dayKey(activeRows[index - 1].plannedPublishAt) !== dayKey(row.plannedPublishAt);
                const child = rows.find((candidate) => candidate.sourceVersionId === row.versionId);
                const source = row.sourceVersionId ? rows.find((candidate) => candidate.versionId === row.sourceVersionId) : undefined;
                return <>
                  {newDay && <tr class="day-divider"><th colspan="6">{dayKey(row.plannedPublishAt)}{dayKey(row.plannedPublishAt) === dayKey(now) && <span>今天</span>}</th></tr>}
                  <tr class:list={{ overdue: isOverdue(row) }}>
                    <td><strong>{displayDateTime(row.plannedPublishAt)}</strong><small>{row.actualPublishAt ? `实发 ${displayDateTime(row.actualPublishAt)}` : isOverdue(row) ? '逾期未发' : '等待实发'}</small></td>
                    <td>
                      <div class="version-line"><span class="version-chip">V{row.versionNumber}</span><span>{row.workType === 'revision' ? '改帖' : '新做帖'}</span>{source && <span>来源 V{source.versionNumber}</span>}{child && <span>已派生 V{child.versionNumber}</span>}</div>
                      <strong>{row.contentName}</strong><small>{row.contentType}{row.syncToMoments ? ' · 同步朋友圈' : ''}</small>
                      {row.revisionGoal && <small class="revision-note">目标：{row.revisionGoal}</small>}
                    </td>
                    <td><span class={`tag promotion-${row.promotionStatus}`}>{promotionLabels[row.promotionStatus as keyof typeof promotionLabels] ?? row.promotionStatus}</span></td>
                    <td><span class={`completion completion-${isOverdue(row) ? 'overdue' : row.completionStatus}`}>{isOverdue(row) ? '逾期未发' : completionLabels[row.completionStatus as keyof typeof completionLabels] ?? '待发布'}</span>{row.delayReason && <small>{row.delayReason}</small>}</td>
                    <td>{row.projectDocUrl ? <a href={row.projectDocUrl} target="_blank" rel="noreferrer">{row.projectDocName || '打开文档'} ↗</a> : <span class="missing">待补链接</span>}</td>
                    <td><div class="row-actions"><button type="button" class="edit-button" data-edit-id={row.id}>编辑</button>{child ? <span class="derived-label">已有 V{child.versionNumber}</span> : <button type="button" class="revise-button" data-revise-id={row.id}>改帖</button>}</div></td>
                  </tr>
                </>;
              })}
            </tbody>
          </table>
          {!databaseError && activeRows.length === 0 && <div class="empty"><strong>这个月还没有排期</strong><p>点击“新做帖”，建立第一条 V0 内容。</p></div>}
        </div>
      </section>}

      {selectedView === 'schedule' && selectedDisplay === 'calendar' && <section class="calendar" aria-label={`${selectedMonth} 月历`}>
        <div class="weekdays">{['日','一','二','三','四','五','六'].map((day) => <span>{day}</span>)}</div>
        <div class="calendar-grid">
          {calendarCells.map((cell) => <div class:list={['calendar-day', { outside: !cell.valid, today: cell.key === dayKey(now) }]}>
            {cell.valid && <><strong class="day-number">{cell.day}</strong><div class="calendar-items">
              {cell.rows.map((row) => <button type="button" data-edit-id={row.id} class:list={['calendar-item', `promotion-${row.promotionStatus}`, { overdue: isOverdue(row) }]}>
                <time>{displayDateTime(row.plannedPublishAt).split(' ')[1]}</time><span><b>V{row.versionNumber}</b> {row.contentName}</span>
              </button>)}
            </div></>}
          </div>)}
        </div>
      </section>}
    </main>

    <dialog id="schedule-dialog" aria-labelledby="dialog-title">
      <form id="schedule-form" action="/api/operations-content" method="post" novalidate>
        <header class="dialog-head">
          <div><span id="dialog-context">NEW CONTENT</span><h2 id="dialog-title">新做帖</h2></div>
          <div class="dialog-head-actions"><span class="dialog-version">V0</span><button type="button" class="close-button" data-close aria-label="关闭">×</button></div>
        </header>
        <input type="hidden" name="recordId" />
        <input type="hidden" name="sourceScheduleId" />
        <section class="source-preview" data-source-preview hidden></section>
        <div class="form-grid">
          <div class="field field-wide"><label for="contentName">内容名称 <b>*</b></label><input id="contentName" name="contentName" maxlength="200" required /><small data-error="contentName"></small></div>
          <div class="field"><label for="contentType">内容类型 <b>*</b></label><input id="contentType" name="contentType" list="content-types" maxlength="100" required /><datalist id="content-types"><option value="小红书图文"></option><option value="朋友圈"></option><option value="视频"></option><option value="活动物料"></option></datalist><small data-error="contentType"></small></div>
          <div class="field"><label for="promotionStatus">推广状态 <b>*</b></label><select id="promotionStatus" name="promotionStatus" required>{promotionStatuses.map((status) => <option value={status}>{promotionLabels[status]}</option>)}</select><small data-error="promotionStatus"></small><em data-promotion-help></em></div>

          <fieldset class="revision-fields field-wide" data-revision-only hidden>
            <legend>本次改帖</legend>
            <div class="field"><label>改动类型 <b>*</b></label><div class="check-grid">{revisionTypeValues.map((type) => <label><input type="checkbox" name="revisionTypes" value={type} /> {revisionTypeLabels[type]}</label>)}</div><small data-error="revisionTypes"></small></div>
            <div class="field"><label for="revisionSummary">具体改动说明 <b>*</b></label><textarea id="revisionSummary" name="revisionSummary" rows="3" maxlength="1000"></textarea><small data-error="revisionSummary"></small></div>
            <div class="field"><label for="revisionGoal">本次修改目标 <b>*</b></label><textarea id="revisionGoal" name="revisionGoal" rows="2" maxlength="500"></textarea><small data-error="revisionGoal"></small></div>
          </fieldset>

          <div class="field"><label for="plannedPublishAt">应发时间 <b>*</b></label><input id="plannedPublishAt" name="plannedPublishAt" type="datetime-local" required /><small data-error="plannedPublishAt"></small></div>
          <div class="field"><label for="actualPublishAt">实发时间</label><input id="actualPublishAt" name="actualPublishAt" type="datetime-local" /><small data-error="actualPublishAt"></small></div>
          <div class="field"><label>完成情况</label><output class="status-preview" id="completion-preview">待发布</output></div>
          <div class="field check-field"><label><input type="checkbox" name="syncToMoments" /> 同步朋友圈</label></div>
          <div class="field field-wide"><label for="projectDocName">项目文档名称 <b>*</b></label><input id="projectDocName" name="projectDocName" maxlength="500" required /><small data-error="projectDocName"></small></div>
          <div class="field field-wide"><label for="projectDocUrl">项目文档链接 <b>*</b></label><input id="projectDocUrl" name="projectDocUrl" type="url" placeholder="https://" required /><small data-error="projectDocUrl"></small></div>
          <div class="field field-wide delay-field" hidden><label for="delayReason">延期原因 <b>*</b></label><textarea id="delayReason" name="delayReason" rows="3" maxlength="500"></textarea><small data-error="delayReason"></small><em>实发严格超过应发 12 小时时必须填写。</em></div>
        </div>
        <p class="form-message" role="alert"></p>
        <footer class="dialog-actions"><button type="button" class="secondary-action" data-close>取消</button><button type="submit" class="save-button">保存新做帖 <span aria-hidden="true">→</span></button></footer>
      </form>
    </dialog>

    <script is:inline define:vars={{ clientRows }}>
      const rows = clientRows;
      const dialog = document.querySelector('#schedule-dialog');
      const form = document.querySelector('#schedule-form');
      const title = document.querySelector('#dialog-title');
      const context = document.querySelector('#dialog-context');
      const version = document.querySelector('.dialog-version');
      const revisionOnly = document.querySelector('[data-revision-only]');
      const sourcePreview = document.querySelector('[data-source-preview]');
      const promotionHelp = document.querySelector('[data-promotion-help]');
      const delayField = document.querySelector('.delay-field');
      const completionPreview = document.querySelector('#completion-preview');
      const message = document.querySelector('.form-message');
      const submitButton = form.querySelector('button[type="submit"]');
      let dirty = false;
      let mode = 'new';
      let activeRecord;

      const field = (name) => form.elements.namedItem(name);
      const needsDelayReason = () => {
        const planned = field('plannedPublishAt').value;
        const actual = field('actualPublishAt').value;
        if (!planned || !actual) return false;
        return new Date(`${actual}:00+08:00`).getTime() - new Date(`${planned}:00+08:00`).getTime() > 12 * 60 * 60 * 1000;
      };
      const updateCompletionPreview = () => {
        const planned = field('plannedPublishAt').value;
        const actual = field('actualPublishAt').value;
        if (!actual) {
          const overdue = Boolean(planned) && Date.now() - new Date(`${planned}:00+08:00`).getTime() > 12 * 60 * 60 * 1000;
          completionPreview.value = overdue ? '逾期未发' : '待发布';
          completionPreview.className = `status-preview ${overdue ? 'completion-overdue' : ''}`;
          return;
        }
        const delayed = needsDelayReason();
        completionPreview.value = delayed ? '延期发布' : '按时发布';
        completionPreview.className = `status-preview ${delayed ? 'completion-delayed' : ''}`;
      };
      const updateDelayField = () => {
        const required = needsDelayReason();
        delayField.hidden = !required;
        field('delayReason').required = required;
        updateCompletionPreview();
      };
      const clearErrors = () => {
        message.textContent = '';
        form.querySelectorAll('[data-error]').forEach((node) => node.textContent = '');
        form.querySelectorAll('[aria-invalid="true"]').forEach((node) => node.removeAttribute('aria-invalid'));
      };
      const setRecordValues = (record) => {
        for (const [name, value] of Object.entries(record)) {
          const control = form.elements.namedItem(name);
          if (control instanceof HTMLInputElement && control.type === 'checkbox') control.checked = Boolean(value);
          else if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement) control.value = String(value ?? '');
        }
      };
      const openForm = (nextMode, record) => {
        form.reset();
        clearErrors();
        mode = nextMode;
        activeRecord = record;
        revisionOnly.hidden = nextMode !== 'revision';
        sourcePreview.hidden = nextMode !== 'revision';
        field('promotionStatus').disabled = false;
        promotionHelp.textContent = '';
        form.querySelectorAll('input[name="revisionTypes"]').forEach((input) => { input.checked = false; });

        if (nextMode === 'new') {
          title.textContent = '新做帖';
          context.textContent = 'NEW CONTENT';
          version.textContent = 'V0';
          submitButton.innerHTML = '保存新做帖 <span aria-hidden="true">→</span>';
          field('promotionStatus').value = 'none';
        } else if (nextMode === 'edit') {
          title.textContent = '编辑排期';
          context.textContent = 'SCHEDULE DETAILS';
          version.textContent = `V${record.versionNumber}`;
          submitButton.innerHTML = '保存排期 <span aria-hidden="true">→</span>';
          setRecordValues(record);
          field('recordId').value = record.id;
        } else {
          title.textContent = '创建改帖';
          context.textContent = 'REVISION';
          version.textContent = `V${record.versionNumber} → V${record.nextVersionNumber}`;
          submitButton.innerHTML = `创建 V${record.nextVersionNumber} <span aria-hidden="true">→</span>`;
          setRecordValues(record);
          field('sourceScheduleId').value = record.id;
          field('plannedPublishAt').value = '';
          field('actualPublishAt').value = '';
          field('delayReason').value = '';
          field('promotionStatus').value = 'pending';
          field('promotionStatus').disabled = true;
          promotionHelp.textContent = '改帖将以“待推广”开始。';
          const closing = record.promotionStatus === 'testing' ? '测试淘汰' : record.promotionStatus === 'scaling' ? '已结束' : '保持当前状态';
          sourcePreview.replaceChildren();
          const sourceTitle = document.createElement('strong');
          const sourceStatus = document.createElement('span');
          sourceTitle.textContent = `来源 V${record.versionNumber} · ${record.contentName}`;
          sourceStatus.textContent = `保存后来源版本：${closing}`;
          sourcePreview.append(sourceTitle, sourceStatus);
        }
        updateDelayField();
        dirty = false;
        dialog.showModal();
        field('contentName').focus();
      };
      const closeForm = () => {
        if (dirty && !window.confirm('有尚未保存的修改，确定关闭吗？')) return;
        dirty = false;
        dialog.close();
      };
      document.querySelector('[data-open-new]')?.addEventListener('click', () => openForm('new'));
      document.querySelectorAll('[data-edit-id]').forEach((button) => button.addEventListener('click', () => openForm('edit', rows.find((row) => row.id === button.dataset.editId))));
      document.querySelectorAll('[data-revise-id]').forEach((button) => button.addEventListener('click', () => openForm('revision', rows.find((row) => row.id === button.dataset.reviseId))));
      document.querySelectorAll('[data-close]').forEach((button) => button.addEventListener('click', closeForm));
      dialog.addEventListener('cancel', (event) => { event.preventDefault(); closeForm(); });
      form.addEventListener('input', () => { dirty = true; updateDelayField(); });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearErrors();
        updateDelayField();
        submitButton.disabled = true;
        const originalLabel = submitButton.innerHTML;
        submitButton.textContent = '正在保存…';
        if (mode === 'revision') field('promotionStatus').disabled = false;
        const body = new FormData(form);
        if (mode === 'revision') field('promotionStatus').disabled = true;
        const endpoint = mode === 'edit'
          ? `/api/operations-content/${activeRecord.id}`
          : mode === 'revision'
            ? `/api/operations-content/versions/${activeRecord.versionId}/revisions`
            : '/api/operations-content';
        try {
          const response = await fetch(endpoint, {
            method: mode === 'edit' ? 'PATCH' : 'POST',
            body,
            headers: { Accept: 'application/json' },
          });
          const result = await response.json();
          if (response.ok) { dirty = false; window.location.reload(); return; }
          message.textContent = result.message ?? '保存失败，请重试。';
          for (const [name, errors] of Object.entries(result.fields ?? {})) {
            const error = form.querySelector(`[data-error="${name}"]`);
            const control = form.elements.namedItem(name);
            if (error) error.textContent = errors[0] ?? '';
            if (control instanceof HTMLElement) control.setAttribute('aria-invalid', 'true');
          }
          form.querySelector('[aria-invalid="true"]')?.focus();
        } catch {
          message.textContent = '无法连接服务，请稍后重试。';
        } finally {
          submitButton.disabled = false;
          submitButton.innerHTML = originalLabel;
        }
      });
    </script>
  </body>
</html>

