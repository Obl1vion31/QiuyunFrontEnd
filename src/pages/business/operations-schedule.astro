---
import BusinessInspector from '../../components/BusinessInspector.astro';
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessConsoleToolbar from '../../components/BusinessConsoleToolbar.astro';
import BusinessToolbarActions from '../../components/BusinessToolbarActions.astro';
import BusinessToolbarPeriodNav from '../../components/BusinessToolbarPeriodNav.astro';
import BusinessToolbarSegmented from '../../components/BusinessToolbarSegmented.astro';
import { asc, desc, eq } from 'drizzle-orm';
import { getDb } from '../../db/client';
import {
  operationsCategory,
  operationsCategoryPolicyVersion,
  operationsContentSchedule,
  operationsContentVersion,
  operationsSubject,
} from '../../db/schema';
import { readPromotionContext } from '../../db/promotion-pauses';
import { effectivePromotionStatus, promotionLabels, type PromotionContext } from '../../db/promotion-state.mjs';
import { operationsPromotionCampaign } from '../../db/schema';
import { postCategories, subjectCategoryMappings, subjects } from '../../db/taxonomy';
import { readReservations } from '../../db/publication-workflow';
import { publicationLabels,publicationState } from '../../db/publication-rules.mjs';
import { teamScheduleNotifications } from '../../db/schedule-workflow';
import { isDelayed, completionStatus } from '../../db/schedule-rules.mjs';

export const prerender = false;

const completionLabels = { pending: '待发布', on_time: '按时发布', delayed: '延期发布' };
const selectedView = Astro.url.searchParams.get('view') === 'promotion' ? 'promotion' : 'schedule';
const selectedDisplay = Astro.url.searchParams.get('display') === 'calendar' && !['overdue','approvals','reasons','reservation_approvals','publication_due'].includes(Astro.url.searchParams.get('status') ?? '') ? 'calendar' : 'ledger';
const requestedStatus = Astro.url.searchParams.get('status');
const selectedStatus = ['pending', 'overdue', 'published', 'approvals', 'reasons','reservation_approvals','publication_due'].includes(requestedStatus ?? '') ? requestedStatus : 'all';
const requestedPromotion = Astro.url.searchParams.get('promotion');
const selectedPromotion = ['testing', 'scaling', 'test_pending', 'promotion_paused', 'awaiting_promotion', 'ended', 'test_discarded', 'formal_discarded'].includes(requestedPromotion ?? '') ? requestedPromotion : 'all';
const now = new Date();
const dateParts = (date: Date) => Object.fromEntries(new Intl.DateTimeFormat('en', {
  timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
}).formatToParts(date).map((part) => [part.type, part.value]));
const monthKey = (date: Date) => { const part = dateParts(date); return `${part.year}-${part.month}`; };
const dayKey = (date: Date) => { const part = dateParts(date); return `${part.year}-${part.month}-${part.day}`; };
const inputDateTime = (date: Date | null) => {
  if (!date) return '';
  const part = dateParts(date);
  return `${part.year}-${part.month}-${part.day}T${part.hour}:${part.minute}`;
};
const displayDateTime = (date: Date | null) => {
  if (!date) return '尚未实发';
  const part = dateParts(date);
  return `${part.month}月${part.day}日 ${part.hour}:${part.minute}`;
};
const currentMonth = monthKey(now);
const requestedMonth = Astro.url.searchParams.get('month') ?? currentMonth;
const requestedMonthMatch = /^(\d{4})-(\d{2})$/.exec(requestedMonth);
const requestedMonthNumber = Number(requestedMonthMatch?.[2]);
const selectedMonth = requestedMonthMatch
  && Number(requestedMonthMatch[1]) >= 2000
  && Number(requestedMonthMatch[1]) <= 2099
  && requestedMonthNumber >= 1
  && requestedMonthNumber <= 12
  ? requestedMonth
  : currentMonth;
const [selectedYear, selectedMonthNumber] = selectedMonth.split('-').map(Number);
const previousMonth = new Date(Date.UTC(selectedYear, selectedMonthNumber - 2, 1)).toISOString().slice(0, 7);
const nextMonth = new Date(Date.UTC(selectedYear, selectedMonthNumber, 1)).toISOString().slice(0, 7);
const hrefFor = (changes: Record<string, string>) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  Object.entries(changes).forEach(([key, value]) => value ? params.set(key, value) : params.delete(key));
  return `?${params.toString()}`;
};
const monthPickerParams = Array.from(Astro.url.searchParams.entries())
  .filter(([name]) => name !== 'month')
  .map(([name, value]) => ({ name, value }));
const monthPicker = {
  name: 'month',
  value: selectedMonth,
  label: '选择要查看的排期年月',
  min: '2000-01',
  max: '2099-12',
  preservedParams: monthPickerParams,
};

let notifications: Awaited<ReturnType<typeof teamScheduleNotifications>> | undefined;
let databaseError = '';
let promotionContext: PromotionContext = { pauses: [], targets: [], holds: [] };
let campaignRows: Array<typeof operationsPromotionCampaign.$inferSelect> = [];
const rowStatus = (row: { id: string; promotionStatus: string }) => {
  const campaign = campaignRows.find(c => c.scheduleId === row.id);
  return effectivePromotionStatus(row.promotionStatus, campaign?.currentStage ?? null, campaign?.id ?? null, promotionContext);
};
let bookings:Awaited<ReturnType<typeof readReservations>>=[];
const bookingFor=(id:string)=>bookings.find(row=>row.scheduleId===id);
const publishingState=(row:typeof rows[number])=>publicationState(row,bookingFor(row.id),now);
let categoryPolicies: Array<typeof operationsCategoryPolicyVersion.$inferSelect> = [];
let rows: Array<{
  id: string; versionId: string; contentId: string; versionNumber: number; sourceVersionId: string | null;
  workType: string; contentName: string; subjectId: string; subjectName: string; categoryId: string | null; categoryName: string | null;
  revisionSummary: string | null; projectDocUrl: string | null;
  syncToMoments: boolean; isPromoted: boolean; promotionStatus: string; plannedPublishAt: Date; actualPublishAt: Date | null;
  completionStatus: string; delayReason: string | null; planRevision: number; publicationUrl:string|null;publicationRevision:number;
}> = [];
const databaseStartedAt = performance.now();
try {
  const database = getDb();
  [rows, categoryPolicies, notifications, campaignRows, promotionContext,bookings] = await Promise.all([database.select({
    id: operationsContentSchedule.id,
    versionId: operationsContentVersion.id,
    contentId: operationsContentVersion.contentId,
    versionNumber: operationsContentVersion.versionNumber,
    sourceVersionId: operationsContentVersion.sourceVersionId,
    workType: operationsContentVersion.workType,
    contentName: operationsContentVersion.contentName,
    subjectId: operationsContentVersion.subjectId,
    subjectName: operationsSubject.name,
    categoryId: operationsContentVersion.categoryId,
    categoryName: operationsCategory.name,
    revisionSummary: operationsContentVersion.revisionSummary,
    projectDocUrl: operationsContentVersion.projectDocUrl,
    syncToMoments: operationsContentSchedule.syncToMoments,
    isPromoted: operationsContentSchedule.isPromoted,
    promotionStatus: operationsContentSchedule.promotionStatus,
    plannedPublishAt: operationsContentSchedule.plannedPublishAt,
    planRevision: operationsContentSchedule.planRevision,
    actualPublishAt: operationsContentSchedule.actualPublishAt,
    publicationUrl:operationsContentSchedule.publicationUrl,publicationRevision:operationsContentSchedule.publicationRevision,
    completionStatus: operationsContentSchedule.completionStatus,
    delayReason: operationsContentSchedule.delayReason,
  }).from(operationsContentSchedule)
    .innerJoin(operationsContentVersion, eq(operationsContentSchedule.contentVersionId, operationsContentVersion.id))
    .innerJoin(operationsSubject, eq(operationsContentVersion.subjectId, operationsSubject.id))
    .leftJoin(operationsCategory, eq(operationsContentVersion.categoryId, operationsCategory.id))
    .orderBy(asc(operationsContentSchedule.plannedPublishAt), desc(operationsContentSchedule.createdAt)),
  database.select().from(operationsCategoryPolicyVersion)
    .orderBy(asc(operationsCategoryPolicyVersion.categoryId), desc(operationsCategoryPolicyVersion.versionNumber)),
  teamScheduleNotifications(database),
  database.select().from(operationsPromotionCampaign).orderBy(desc(operationsPromotionCampaign.startedOn)),
  readPromotionContext(database),
  readReservations(database),
  ]) as [typeof rows, typeof categoryPolicies, Awaited<ReturnType<typeof teamScheduleNotifications>>, typeof campaignRows, typeof promotionContext,typeof bookings];
} catch (error) {
  console.error('operations schedule query failed', error);
  databaseError = '数据库暂时不可用。请检查开发库连接和最新迁移后重试。';
}
Astro.response.headers.set('Server-Timing', `db;dur=${(performance.now() - databaseStartedAt).toFixed(1)}`);

const isOverdue = (row: typeof rows[number]) => !row.actualPublishAt && isDelayed(row.plannedPublishAt, now);
const monthRows = rows.filter((row) => monthKey(row.plannedPublishAt) === selectedMonth);
const promotionRows = rows.filter((row) => ['testing', 'scaling'].includes(rowStatus(row)));
const activeRows = selectedView === 'promotion'
  ? (selectedPromotion === 'all' ? promotionRows : rows.filter(row => row.isPromoted && rowStatus(row) === selectedPromotion))
  : ['overdue','approvals','reasons','reservation_approvals','publication_due'].includes(selectedStatus ?? '')
    ? rows.filter(row => selectedStatus === 'overdue' ? isOverdue(row)
      : selectedStatus === 'approvals' ? notifications?.approvalScheduleIds.includes(row.id)
      : selectedStatus==='reservation_approvals'?notifications?.reservationApprovalIds.includes(row.id)
      : selectedStatus==='publication_due'?notifications?.publicationDueIds.includes(row.id): notifications?.missingReasonIds.includes(row.id))
    : monthRows.filter((row) => {
      if (selectedStatus === 'pending') return !row.actualPublishAt;
      if (selectedStatus === 'overdue') return isOverdue(row);
      if (selectedStatus === 'published') return Boolean(row.actualPublishAt);
      return true;
    });
const summary = {
  total: monthRows.length,
  pending: monthRows.filter((row) => !row.actualPublishAt).length,
  overdue: rows.filter(isOverdue).length,
  published: monthRows.filter((row) => row.actualPublishAt).length,
  revisions: monthRows.filter((row) => row.workType === 'revision').length,
  testing: promotionRows.filter((row) => rowStatus(row) === 'testing').length,
  scaling: promotionRows.filter((row) => rowStatus(row) === 'scaling').length,
};
const daysInMonth = new Date(Date.UTC(selectedYear, selectedMonthNumber, 0)).getUTCDate();
const firstWeekday = new Date(Date.UTC(selectedYear, selectedMonthNumber - 1, 1)).getUTCDay();
const calendarCells = Array.from({ length: Math.ceil((firstWeekday + daysInMonth) / 7) * 7 }, (_, index) => {
  const day = index - firstWeekday + 1;
  const valid = day >= 1 && day <= daysInMonth;
  const key = valid ? `${selectedMonth}-${String(day).padStart(2, '0')}` : '';
  return { day, key, valid, rows: valid ? monthRows.filter((row) => dayKey(row.plannedPublishAt) === key) : [] };
});
const clientRows = rows.map((row) => {
  const child = rows.find((candidate) => candidate.sourceVersionId === row.versionId);
  const source = row.sourceVersionId ? rows.find((candidate) => candidate.versionId === row.sourceVersionId) : undefined;
  return {
    ...row,
    publicationState:publishingState(row),publicationLabel:publicationLabels[publishingState(row)],reservationAt:inputDateTime(bookingFor(row.id)?.scheduledPublishAt??null),
    plannedPublishAt: inputDateTime(row.plannedPublishAt),
    actualPublishAt: inputDateTime(row.actualPublishAt),
    projectDocUrl: row.projectDocUrl ?? '',
    delayReason: row.delayReason ?? '',
    revisionSummary: row.revisionSummary ?? '',
    promotionLabel: promotionLabels[rowStatus(row)] ?? row.promotionStatus,
    completionLabel: isOverdue(row) ? '逾期未发' : completionLabels[completionStatus(row.plannedPublishAt,row.actualPublishAt)] ?? '待发布',
    plannedDisplay: displayDateTime(row.plannedPublishAt),
    actualDisplay: row.actualPublishAt ? displayDateTime(row.actualPublishAt) : '尚未实发',
    sourceScheduleId: row.id,
    nextVersionNumber: Math.max(...rows.filter((candidate) => candidate.contentId === row.contentId).map((candidate) => candidate.versionNumber), row.versionNumber) + 1,
    childVersionNumber: child?.versionNumber ?? null,
    sourceVersionNumber: source?.versionNumber ?? null,
  };
});
const actorRole = Astro.locals.user?.role;
const requestedRow = Astro.url.searchParams.get('row') || Astro.url.hash.slice(1);
const queueView = ['overdue','approvals','reasons','reservation_approvals','publication_due'].includes(selectedStatus ?? '');
const queueLabel = selectedStatus==='reservation_approvals'?'预约发送待审核':selectedStatus==='publication_due'?'预约到点待确认':selectedStatus === 'overdue' ? '全部延期未发' : selectedStatus === 'approvals' ? '待审批排期' : '待补延期理由';
const todayKey = dayKey(now);
const currentPolicies = new Map<string, typeof categoryPolicies[number]>();
for (const policy of categoryPolicies) {
  if (policy.effectiveOn <= todayKey && !currentPolicies.has(policy.categoryId)) currentPolicies.set(policy.categoryId, policy);
}
const clientCategories = subjectCategoryMappings.flatMap((mapping) => {
  const category = postCategories.find((candidate) => candidate.id === mapping.categoryId)!;
  const policy = currentPolicies.get(mapping.categoryId);
  if (policy && !policy.isSelectable) return [];
  return [{
    subjectId: mapping.subjectId,
    id: category.id,
    name: policy?.displayName ?? category.name,
    defaultIsPromoted: policy?.defaultIsPromoted ?? false,
  }];
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="管理新做帖、改帖版本和运营内容发布排期。" />
    <title>内容发布控制台 · 排期管理</title>
  </head>
  <body>
    <BusinessConsoleFrame active="schedule">
        <BusinessConsoleToolbar title="排期管理" subtitle={selectedView === 'promotion' ? '推广中视角' : queueView ? queueLabel : `${selectedMonth} 当月排期`}>
          {selectedView === 'schedule' && !queueView && <BusinessToolbarPeriodNav slot="center" previousHref={hrefFor({ month: previousMonth })} nextHref={hrefFor({ month: nextMonth })} label={`${selectedMonth.replace('-', ' 年 ')} 月`} todayHref={hrefFor({ month: currentMonth })} todayLabel="本月" monthPicker={monthPicker} />}
          <BusinessToolbarActions slot="end">
            <BusinessToolbarSegmented label="显示方式" items={[
              { label: '台账', href: hrefFor({ display: 'ledger' }), active: selectedDisplay === 'ledger' || selectedView === 'promotion' },
              { label: '月历', href: hrefFor({ view: 'schedule', display: 'calendar', status: '', promotion: '' }), active: selectedDisplay === 'calendar' && selectedView === 'schedule' },
            ]} />
            <button class="filter-button toolbar-action-secondary" type="button" disabled title="更多筛选将在数据维度确认后开放">筛选</button>
            <button class="primary-action" type="button" data-open-new><span>新做帖</span><b aria-hidden="true">＋</b></button>
          </BusinessToolbarActions>
        </BusinessConsoleToolbar>

        <main class="workspace-main business-console-content">
          {databaseError && <p class="notice notice--error" role="alert">{databaseError}</p>}

          {selectedView === 'schedule' && !queueView && <div class="mobile-period-nav">
            <BusinessToolbarPeriodNav previousHref={hrefFor({ month: previousMonth })} nextHref={hrefFor({ month: nextMonth })} label={`${selectedMonth.replace('-', ' 年 ')} 月`} todayHref={hrefFor({ month: currentMonth })} todayLabel="本月" monthPicker={monthPicker} />
          </div>}

          <nav class="status-strip" aria-label="排期状态视角">
            <a class:list={{ active: selectedView === 'schedule' && selectedStatus === 'all' }} href={hrefFor({ view: 'schedule', status: '', promotion: '', display: 'ledger' })}>
              <span>本月内容</span><strong>{summary.total}</strong>
            </a>
            <a class:list={{ active: selectedView === 'schedule' && selectedStatus === 'pending' }} href={hrefFor({ view: 'schedule', status: 'pending', promotion: '', display: 'ledger' })}>
              <span>待发布</span><strong>{summary.pending}</strong>
            </a>
            <a class:list={['promotion-summary', { active: selectedView === 'promotion' && selectedPromotion === 'all' }]} href={hrefFor({ view: 'promotion', status: '', promotion: '', display: 'ledger' })}>
              <span>推广进行中</span><strong>{promotionRows.length}</strong><small>测试 {summary.testing} · 放量 {summary.scaling}</small>
            </a>
            <a class:list={['testing-summary', { active: selectedView === 'promotion' && selectedPromotion === 'testing' }]} href={hrefFor({ view: 'promotion', status: '', promotion: 'testing', display: 'ledger' })}>
              <span>测试中</span><strong>{summary.testing}</strong>
            </a>
            <a class:list={['scaling-summary', { active: selectedView === 'promotion' && selectedPromotion === 'scaling' }]} href={hrefFor({ view: 'promotion', status: '', promotion: 'scaling', display: 'ledger' })}>
              <span>放量中</span><strong>{summary.scaling}</strong>
            </a>
            <a class:list={['attention-summary', { active: selectedView === 'schedule' && selectedStatus === 'overdue' }]} href={hrefFor({ view: 'schedule', status: 'overdue', promotion: '', display: 'ledger' })}>
              <span>全部延期未发</span><strong>{summary.overdue}</strong>
            </a>
            <a class:list={{ active: selectedView === 'schedule' && selectedStatus === 'published' }} href={hrefFor({ view: 'schedule', status: 'published', promotion: '', display: 'ledger' })}>
              <span>已发布</span><strong>{summary.published}</strong>
            </a>
          </nav>
          <nav class="workflow-queue-nav" aria-label="排期待办队列">
            <a href={hrefFor({view:'schedule',status:'reasons',display:'ledger'})}>待补延期理由 <b>{notifications?.missingReasons ?? '—'}</b></a>
            <a href={hrefFor({view:'schedule',status:'approvals',display:'ledger'})}>{actorRole==='admin'?'待审批':'改期申请'} <b>{notifications?.pendingApprovals ?? '—'}</b></a>
            <a href={hrefFor({view:'schedule',status:'reservation_approvals',display:'ledger'})}>预约待审 <b>{notifications?.reservationApprovals??'—'}</b></a>
            <a href={hrefFor({view:'schedule',status:'publication_due',display:'ledger'})}>到点待确认 <b>{notifications?.publicationDue??'—'}</b></a>
            {queueView&&<span>{queueLabel} · 跨月份显示</span>}
          </nav>

          <div class="content-layout">
            <section class="content-stage">
              {(selectedDisplay === 'ledger' || selectedView === 'promotion') && <div class="table-wrap">
          <table>
            <thead><tr><th>应发时间</th><th>版本</th><th>内容</th><th>推广阶段</th><th>发布状态</th><th>文档</th></tr></thead>
            <tbody>
              {activeRows.map((row, index) => {
                const newDay = index === 0 || dayKey(activeRows[index - 1].plannedPublishAt) !== dayKey(row.plannedPublishAt);
                const child = rows.find((candidate) => candidate.sourceVersionId === row.versionId);
                const source = row.sourceVersionId ? rows.find((candidate) => candidate.versionId === row.sourceVersionId) : undefined;
                return <>
                  {newDay && <tr class="day-divider"><th colspan="6"><span class="timeline-dot"></span><strong>{dayKey(row.plannedPublishAt)}</strong>{dayKey(row.plannedPublishAt) === dayKey(now) && <b>今天</b>}<small>{activeRows.filter((candidate) => dayKey(candidate.plannedPublishAt) === dayKey(row.plannedPublishAt)).length} 条</small></th></tr>}
                  <tr class:list={['schedule-row', { overdue: isOverdue(row) }]} data-inspect-id={row.id} tabindex="0">
                    <td class="time-cell"><strong>{displayDateTime(row.plannedPublishAt).split(' ')[1]}</strong><small>{row.actualPublishAt ? `实发 ${displayDateTime(row.actualPublishAt).split(' ')[1]}` : '尚未实发'}</small></td>
                    <td><span class="version-chip">V{row.versionNumber}</span><small>{row.workType === 'revision' ? '改帖' : '新做帖'}</small></td>
                    <td class="content-cell"><strong>{row.contentName}</strong><small>{row.subjectName}{row.categoryName ? ` / ${row.categoryName}` : ''}{row.syncToMoments ? ' · 同步朋友圈' : ''}{source ? ` · 来源 V${source.versionNumber}` : ''}{child ? ` · 已派生 V${child.versionNumber}` : ''}</small></td>
                    <td><span class={`tag promotion-${rowStatus(row)}`}>{promotionLabels[rowStatus(row)] ?? row.promotionStatus}</span></td>
                    <td><span class={`completion completion-${isOverdue(row) ? 'overdue' : row.completionStatus}`}>{isOverdue(row) ? '逾期未发' : completionLabels[completionStatus(row.plannedPublishAt,row.actualPublishAt)] ?? '待发布'}</span>{publishingState(row)!=='unpublished'&&<small class="publication-state-label" data-publication-row-state={row.id}>{publicationLabels[publishingState(row)]}</small>}</td>
                    <td>{row.projectDocUrl ? <a class="doc-link" href={row.projectDocUrl} target="_blank" rel="noreferrer" aria-label="打开项目文档">↗</a> : <span class="missing">待登记</span>}</td>
                  </tr>
                </>;
              })}
            </tbody>
          </table>
          {!databaseError && activeRows.length === 0 && <div class="empty"><strong>当前视角没有内容</strong><p>切换状态视角，或点击“新做帖”建立一条 V0 内容。</p></div>}
        </div>
              }

      {selectedView === 'schedule' && selectedDisplay === 'calendar' && <section class="calendar" aria-label={`${selectedMonth} 月历`}>
        <div class="weekdays">{['日','一','二','三','四','五','六'].map((day) => <span>{day}</span>)}</div>
        <div class="calendar-grid">
          {calendarCells.map((cell) => <div class:list={['calendar-day', { outside: !cell.valid, today: cell.key === dayKey(now) }]}>
            {cell.valid && <><strong class="day-number">{cell.day}</strong><div class="calendar-items">
              {cell.rows.map((row) => <button type="button" data-inspect-id={row.id} class:list={['calendar-item', `promotion-${rowStatus(row)}`, { overdue: isOverdue(row) }]}>
                <time>{displayDateTime(row.plannedPublishAt).split(' ')[1]}</time><span><b>V{row.versionNumber}</b> {row.contentName}</span>
              </button>)}
            </div></>}
          </div>)}
        </div>
      </section>}
            </section>

            <BusinessInspector class="inspector" parameter="row" label="帖子详情">
              <header><div><span data-inspector-version>V0</span><small data-inspector-kind>新做帖</small></div><button type="button" data-close-inspector aria-label="关闭详情">×</button></header>
              <div class="inspector-body">
                <section class="inspector-title"><p data-inspector-category></p><h2 data-inspector-name></h2></section>
                <dl class="detail-list">
                  <div><dt>推广状态</dt><dd data-inspector-promotion></dd></div>
                  <div><dt>应发时间</dt><dd data-inspector-planned></dd></div>
                  <div><dt>实发时间</dt><dd data-inspector-actual></dd></div>
                  <div><dt>发布登记</dt><dd data-inspector-publication-state></dd></div>
                  <div><dt>发布状态</dt><dd data-inspector-completion></dd></div>
                </dl>
                <section class="inspector-section"><span>版本关系</span><div class="version-path" data-inspector-path></div></section>
                <section class="inspector-section" data-inspector-revision-section><span>本次改帖</span><strong>具体改动说明</strong><p data-inspector-revision-summary></p></section>
                <section class="inspector-section"><span>项目文档</span><a data-inspector-doc target="_blank" rel="noreferrer">打开项目文档 ↗</a></section>
                <section class="inspector-section"><span>小红书帖子</span><a data-inspector-post target="_blank" rel="noreferrer">尚未补充帖子链接</a></section>
                <section class="inspector-section schedule-workflow-panel" data-schedule-workflow aria-label="延期与改期"><p>选中帖子后读取延期与审批记录。</p></section>
                <section class="inspector-danger"><span>更多操作</span><button type="button" data-inspector-delete data-admin-only>删除这条排期</button><small role="alert" data-inspector-delete-error></small></section>
              </div>
              <footer class="inspector-actions"><button type="button" class="save-button publication-action" data-inspector-publication>发布登记</button><div><button type="button" class="secondary-action" data-inspector-edit>编辑排期</button><button type="button" class="secondary-action" data-inspector-revise>创建改帖</button></div><span data-inspector-derived hidden></span></footer>
            </BusinessInspector>
          </div>
        </main>
    </BusinessConsoleFrame>

    <dialog id="schedule-dialog" aria-labelledby="dialog-title">
      <form id="schedule-form" action="/api/operations-content" method="post" novalidate>
        <header class="dialog-head">
          <div><span id="dialog-context">新建内容</span><h2 id="dialog-title">新做帖</h2></div>
          <div class="dialog-head-actions"><span class="dialog-version">V0</span><button type="button" class="close-button" data-close aria-label="关闭">×</button></div>
        </header>
        <input type="hidden" name="recordId" /><input type="hidden" name="expectedPlanRevision" />
        <input type="hidden" name="sourceScheduleId" />
        <section class="source-preview" data-source-preview hidden></section>
        <div class="form-grid">
          <div class="field field-wide"><label for="contentName">内容名称 <b>*</b></label><input id="contentName" name="contentName" maxlength="200" required /><small data-error="contentName"></small></div>
          <div class="field"><label for="subjectId">学科 <b>*</b></label><select id="subjectId" name="subjectId" required><option value="">请选择学科</option>{subjects.map((subject) => <option value={subject.id}>{subject.name}</option>)}</select><small data-error="subjectId"></small></div>
          <div class="field"><label for="categoryId">帖子分类 <b data-category-required>*</b></label><select id="categoryId" name="categoryId" required disabled><option value="">请先选择学科</option></select><small data-error="categoryId"></small><em data-category-help></em></div>
          <div class="field promotion-field">
            <label class="promotion-toggle"><input type="checkbox" name="isPromoted" /> <span><strong>推广帖</strong><small>实发后进入待开始推广</small></span></label>
            <input id="promotionStatus" name="promotionStatus" type="hidden" value="none" />
            <output class="promotion-preview" data-promotion-preview>非推广</output>
            <small data-error="isPromoted"></small><em data-promotion-help></em>
          </div>
          <div class="field field-wide usage-change-field" hidden><label for="usageChangeReason">改为非推广的原因 <b>*</b></label><textarea id="usageChangeReason" name="usageChangeReason" rows="3" maxlength="500" placeholder="说明从何时起不再推广，以及本次用途调整原因"></textarea><small data-error="usageChangeReason"></small><em>已有 Campaign、阶段和日度事实会保留；仍开放的推广阶段将在确认后结束。</em></div>

          <fieldset class="revision-fields field-wide" data-revision-only hidden>
            <legend>本次改帖</legend>
            <div class="field revision-summary-field"><label for="revisionSummary">具体改动说明 <b>*</b></label><textarea id="revisionSummary" name="revisionSummary" rows="5" maxlength="1000"></textarea><small data-error="revisionSummary"></small>
              <div class="revision-example" aria-label="填写示例">
                <strong>填写示例</strong>
                <ol>
                  <li><b>本次修改的具体内容：</b>说明改动了封面、标题、正文或引导语等哪些部分。</li>
                  <li><b>改动原因及希望达到的效果：</b>说明为什么修改，以及希望改善的阅读、理解或咨询效果。</li>
                </ol>
              </div>
            </div>
          </fieldset>

          <div class="field"><label for="plannedPublishAt">应发时间 <b>*</b></label><input id="plannedPublishAt" name="plannedPublishAt" type="datetime-local" required /><small data-error="plannedPublishAt"></small></div>
          <div class="field field-wide" data-plan-change-reason hidden><label for="planChangeReason">改期理由 <b>*</b></label><textarea id="planChangeReason" name="planChangeReason" rows="2" maxlength="500"></textarea><small data-error="planChangeReason"></small></div>
          <div class="field check-field"><label><input type="checkbox" name="syncToMoments" /> 同步朋友圈</label></div>
          <div class="field field-wide"><label for="projectDocUrl">项目文档链接（选填）</label><input id="projectDocUrl" name="projectDocUrl" type="url" placeholder="可在实发登记时补充" /><small data-error="projectDocUrl"></small></div>
        </div>
        <p class="form-message" role="alert"></p>
        <footer class="dialog-actions"><button type="button" class="secondary-action" data-close>取消</button><button type="submit" class="save-button">保存新做帖 <span aria-hidden="true">→</span></button></footer>
      </form>
    </dialog>

    <dialog id="publication-dialog" aria-labelledby="publication-title">
      <form id="publication-form" novalidate>
        <header class="dialog-head"><div><span>PUBLICATION RECORD</span><h2 id="publication-title">实发登记</h2></div><button type="button" class="close-button" data-close-publication aria-label="关闭">×</button></header>
        <input type="hidden" name="plannedPublishAt" />
        <div class="publication-context"><strong data-publication-name></strong><span data-publication-planned></span></div>
        <div class="form-grid">
          <input type="hidden" name="expectedPublicationRevision"/><input type="hidden" name="requestKey"/>
          <div class="field field-wide"><label for="publicationMode">发布方式</label><select id="publicationMode" name="publicationMode"><option value="sent">已发送</option><option value="scheduled">预约发送（定时发布）</option></select></div>
          <div class="field field-wide" data-reservation-fields hidden><label for="scheduledPublishAt">预约发送时间 <b>*</b></label><input id="scheduledPublishAt" name="scheduledPublishAt" type="datetime-local" disabled/><small data-publication-error="scheduledPublishAt"></small><p class="publication-hint">提交后由管理员审核。到点后请补充帖子链接并确认实际发送时间。</p></div>
          <div class="field" data-sent-fields><label for="publicationActualPublishAt">实发时间 <b>*</b></label><input id="publicationActualPublishAt" name="actualPublishAt" type="datetime-local" required/><small data-publication-error="actualPublishAt"></small><label class="time-correction-toggle" data-correction-toggle hidden><input type="checkbox" name="correctTime"/>更正已有实发时间</label></div>
          <div class="field" data-sent-fields><label>完成情况</label><output class="status-preview" data-publication-status>待登记</output></div>
          <div class="field field-wide" data-sent-fields><label for="publicationUrl">小红书帖子链接 <b>*</b></label><input id="publicationUrl" name="publicationUrl" type="url" required placeholder="小红书帖子长链接或分享短链接"/><small data-publication-error="publicationUrl"></small></div>
          <div class="field field-wide" data-sent-fields><label for="publicationProjectDocUrl">项目文档链接 <b>*</b></label><input id="publicationProjectDocUrl" name="projectDocUrl" type="url" placeholder="https://" required/></div>
          <div class="field field-wide" data-time-correction hidden><label for="publicationCorrectionReason">实发时间更正原因 <b>*</b></label><textarea id="publicationCorrectionReason" name="correctionReason" maxlength="500" disabled></textarea><small data-publication-error="correctionReason"></small></div>
          <section class="field field-wide delay-field" data-publication-delay><strong>逐日延期理由</strong><p data-publication-delay-status role="status"></p><div data-publication-delay-days></div><input type="hidden" name="dailyReasons" value="[]"/><input type="hidden" name="expectedPlanRevision"/></section>
        </div>
        <p class="form-message" data-publication-message role="alert"></p>
        <footer class="dialog-actions"><button type="button" class="secondary-action" data-close-publication>取消</button><button type="submit" class="save-button">保存实发登记 <span aria-hidden="true">→</span></button></footer>
      </form>
    </dialog>

    <script is:inline data-astro-rerun define:vars={{ clientRows, clientCategories, actorRole, requestedRow }}>
      const rows = clientRows;
      const categories = clientCategories;
      const dialog = document.querySelector('#schedule-dialog');
      const form = document.querySelector('#schedule-form');
      const title = document.querySelector('#dialog-title');
      const context = document.querySelector('#dialog-context');
      const version = document.querySelector('.dialog-version');
      const revisionOnly = document.querySelector('[data-revision-only]');
      const sourcePreview = document.querySelector('[data-source-preview]');
      const promotionHelp = document.querySelector('[data-promotion-help]');
      const promotionPreview = document.querySelector('[data-promotion-preview]');
      const usageChangeField = document.querySelector('.usage-change-field');
      const categoryHelp = document.querySelector('[data-category-help]');
      const categoryRequired = document.querySelector('[data-category-required]');
      const message = document.querySelector('.form-message');
      const submitButton = form.querySelector('button[type="submit"]');
      const inspector = document.querySelector('[data-inspector]');
      const inspectorEdit = document.querySelector('[data-inspector-edit]');
      const inspectorRevise = document.querySelector('[data-inspector-revise]');
      const inspectorDerived = document.querySelector('[data-inspector-derived]');
      const inspectorPublication = document.querySelector('[data-inspector-publication]');
      const inspectorDelete = document.querySelector('[data-inspector-delete]');
      const inspectorDeleteError = document.querySelector('[data-inspector-delete-error]');
      const publicationDialog = document.querySelector('#publication-dialog');
      const publicationForm = document.querySelector('#publication-form');
      let dirty = false;
      let mode = 'new';
      let activeRecord;

      const field = (name) => form.elements.namedItem(name);
      const setInspectorText = (selector, value) => {
        const node = inspector.querySelector(selector);
        if (node) node.textContent = value || '—';
      };
      const fillInspector = (record) => {
        if (!record) return;
        activeRecord = record;
        inspector.dataset.selectedId = record.id;
        setInspectorText('[data-inspector-version]', `V${record.versionNumber}`);
        setInspectorText('[data-inspector-kind]', record.workType === 'revision' ? '改帖' : '新做帖');
        setInspectorText('[data-inspector-category]', record.categoryName ? `${record.subjectName} / ${record.categoryName}` : record.subjectName);
        setInspectorText('[data-inspector-name]', record.contentName);
        setInspectorText('[data-inspector-promotion]', record.promotionLabel);
        setInspectorText('[data-inspector-planned]', record.plannedDisplay);
        setInspectorText('[data-inspector-actual]', record.actualDisplay);
        setInspectorText('[data-inspector-completion]', record.completionLabel);
        setInspectorText('[data-inspector-revision-summary]', record.revisionSummary);
        const revisionSection = inspector.querySelector('[data-inspector-revision-section]');
        revisionSection.hidden = record.workType !== 'revision';
        const path = inspector.querySelector('[data-inspector-path]');
        path.replaceChildren();
        const versions = record.sourceVersionNumber == null
          ? [`V${record.versionNumber}`]
          : [`V${record.sourceVersionNumber}`, `V${record.versionNumber}`];
        if (record.childVersionNumber != null) versions.push(`V${record.childVersionNumber}`);
        versions.forEach((label, index) => {
          const chip = document.createElement('span');
          chip.textContent = label;
          path.append(chip);
          if (index < versions.length - 1) path.append(document.createTextNode('→'));
        });
        const doc = inspector.querySelector('[data-inspector-doc]');
        if (record.projectDocUrl) {
          doc.href = record.projectDocUrl;
          doc.textContent = '打开项目文档 ↗';
          doc.removeAttribute('aria-disabled');
        } else {
          doc.removeAttribute('href');
          doc.textContent = '项目文档待补';
          doc.setAttribute('aria-disabled', 'true');
        }
        inspectorRevise.hidden = record.childVersionNumber != null;
        inspectorDerived.hidden = record.childVersionNumber == null;
        inspectorDerived.textContent = record.childVersionNumber == null ? '' : `已派生 V${record.childVersionNumber}`;
        inspectorPublication.textContent = record.actualPublishAt ? '查看／补充发布登记' : record.publicationState==='needs_confirmation'?'确认实发并补链':'发布登记';
        setInspectorText('[data-inspector-publication-state]',record.publicationLabel);
        const post=inspector.querySelector('[data-inspector-post]');
        if(record.publicationUrl){post.href=record.publicationUrl;post.textContent='打开小红书帖子 ↗';}else{post.removeAttribute('href');post.textContent='尚未补充帖子链接';}
        inspectorDeleteError.textContent = '';
        document.dispatchEvent(new CustomEvent('business:schedule-selected', { detail: record }));
      };
      inspector.addEventListener('business:inspector-render-record', event => fillInspector(rows.find(row => row.id === event.detail.id)));
      const openInspector = record => {
        if (!record) return;
        const trigger = document.querySelector(`[data-inspect-id="${CSS.escape(record.id)}"]`);
        if (!inspector.dataset.inspectorReady) inspector.dataset.selectedId = record.id;
        inspector.dispatchEvent(new CustomEvent('business:inspector-select', {detail:{id:record.id,trigger}}));
      };
      const updatePromotionPreview = () => {
        const promoted = field('isPromoted').checked;
        const actual = mode === 'edit' ? activeRecord?.actualPublishAt : null;
        const changingToNonPromotion = mode === 'edit' && activeRecord?.isPromoted && !promoted;
        usageChangeField.hidden = !changingToNonPromotion;
        field('usageChangeReason').required = changingToNonPromotion;
        if (!promoted) {
          field('promotionStatus').value = 'none';
          promotionPreview.textContent = '非推广';
          return;
        }
        if (!actual) {
          field('promotionStatus').value = 'pending';
          promotionPreview.textContent = '待推广 · 尚未实发';
          return;
        }
        if (
          mode === 'new'
          || mode === 'revision'
          || !activeRecord?.actualPublishAt
          || !activeRecord?.isPromoted
        ) {
          field('promotionStatus').value = 'awaiting_promotion';
          promotionPreview.textContent = '待开始推广 · 实发后在每日复盘确认测试';
          return;
        }
        field('promotionStatus').value = activeRecord.promotionStatus;
        promotionPreview.textContent = activeRecord.promotionLabel;
      };
      const clearErrors = () => {
        message.textContent = '';
        form.querySelectorAll('[data-error]').forEach((node) => node.textContent = '');
        form.querySelectorAll('[aria-invalid="true"]').forEach((node) => node.removeAttribute('aria-invalid'));
      };
      const updateCategoryOptions = (selectedValue = '') => {
        const subjectId = field('subjectId').value;
        const categorySelect = field('categoryId');
        const matching = categories.filter((category) => category.subjectId === subjectId);
        categorySelect.replaceChildren();
        const prompt = document.createElement('option');
        prompt.value = '';
        prompt.textContent = matching.length ? '请选择帖子分类' : '请先选择学科';
        categorySelect.append(prompt);
        matching.forEach((category) => {
          const option = document.createElement('option');
          option.value = category.id;
          option.textContent = category.name;
          categorySelect.append(option);
        });
        categorySelect.disabled = matching.length === 0;
        categorySelect.required = matching.length > 0;
        categoryRequired.hidden = matching.length === 0;
        categoryHelp.textContent = '';
        categorySelect.value = matching.some((category) => category.id === selectedValue) ? selectedValue : '';
      };
      const applyCategoryPromotionDefault = () => {
        if (mode !== 'new') return;
        const category = categories.find((candidate) => candidate.subjectId === field('subjectId').value && candidate.id === field('categoryId').value);
        if (!category) return;
        field('isPromoted').checked = Boolean(category.defaultIsPromoted);
        updatePromotionPreview();
      };
      const setRecordValues = (record) => {
        field('subjectId').value = record.subjectId ?? '';
        updateCategoryOptions(record.categoryId ?? '');
        for (const [name, value] of Object.entries(record)) {
          const control = form.elements.namedItem(name);
          if (control instanceof HTMLInputElement && control.type === 'checkbox') control.checked = Boolean(value);
          else if (control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement) control.value = String(value ?? '');
        }
      };
      const openForm = (nextMode, record) => {
        form.reset();
        clearErrors();
        mode = nextMode;
        activeRecord = record;
        revisionOnly.hidden = nextMode !== 'revision';
        sourcePreview.hidden = nextMode !== 'revision';
        field('promotionStatus').disabled = false;
        promotionHelp.textContent = '';
        updateCategoryOptions();

        if (nextMode === 'new') {
          title.textContent = '新做帖';
          context.textContent = '新建内容';
          version.textContent = 'V0';
          submitButton.innerHTML = '保存新做帖 <span aria-hidden="true">→</span>';
          field('promotionStatus').value = 'none';
          field('isPromoted').checked = false;
        } else if (nextMode === 'edit') {
          title.textContent = '编辑排期';
          context.textContent = '排期详情';
          version.textContent = `V${record.versionNumber}`;
          submitButton.innerHTML = '保存排期 <span aria-hidden="true">→</span>';
          setRecordValues(record);
          field('recordId').value = record.id;
        } else {
          title.textContent = '创建改帖';
          context.textContent = '创建改帖';
          version.textContent = `V${record.versionNumber} → V${record.nextVersionNumber}`;
          submitButton.innerHTML = `创建 V${record.nextVersionNumber} <span aria-hidden="true">→</span>`;
          setRecordValues(record);
          field('sourceScheduleId').value = record.id;
          field('plannedPublishAt').value = '';
          field('promotionStatus').value = 'pending';
          field('promotionStatus').disabled = true;
          promotionHelp.textContent = '改帖将以“待推广”开始。';
          const closing = record.promotionStatus === 'testing' ? '测试淘汰' : record.promotionStatus === 'scaling' ? '放量淘汰' : '保持当前状态';
          sourcePreview.replaceChildren();
          const sourceTitle = document.createElement('strong');
          const sourceStatus = document.createElement('span');
          sourceTitle.textContent = `来源 V${record.versionNumber} · ${record.contentName}`;
          sourceStatus.textContent = `保存后来源版本：${closing}`;
          sourcePreview.append(sourceTitle, sourceStatus);
        }
        field('plannedPublishAt').readOnly = nextMode === 'edit' && actorRole === 'employee';
        field('expectedPlanRevision').value = record?.planRevision ?? '';
        const planReason = document.querySelector('[data-plan-change-reason]');
        planReason.hidden = true; field('planChangeReason').required = false;
        if (nextMode === 'edit' && actorRole === 'employee') promotionHelp.textContent = '修改应发时间请在帖子详情中提交改期申请。';
        updatePromotionPreview();
        dirty = false;
        dialog.showModal();
        field('contentName').focus();
      };
      const closeForm = () => {
        if (dirty && !window.confirm('有尚未保存的修改，确定关闭吗？')) return;
        dirty = false;
        dialog.close();
      };
      document.querySelector('[data-open-new]')?.addEventListener('click', () => openForm('new'));
      document.querySelectorAll('[data-inspect-id]').forEach((node) => {
        const inspect = () => openInspector(rows.find((row) => row.id === node.dataset.inspectId));
        node.addEventListener('click', inspect);
        node.addEventListener('keydown', (event) => {
          if (event.target !== node) return;
          if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); inspect(); }
        });
      });
      inspectorDelete?.addEventListener('click', async () => {
        const record = activeRecord;
        const error = inspectorDeleteError;
        if (!record || !window.confirm(`确定删除“${record.contentName}”的排期吗？\n删除后无法恢复。`)) return;
        if (error) error.textContent = '';
        try {
          const response = await fetch(`/api/operations-content/${record.id}`, {
            method: 'DELETE',
            headers: { Accept: 'application/json' },
          });
          const result = await response.json();
          if (response.ok) { window.location.reload(); return; }
          if (error) error.textContent = result.message ?? '删除失败，请重试。';
        } catch {
          if (error) error.textContent = '无法连接服务，请稍后重试。';
        }
      });
      const publicationControl = (name) => publicationForm.elements.namedItem(name);
      const publicationStatus = document.querySelector('[data-publication-status]');
      const publicationMessage = document.querySelector('[data-publication-message]');
      let publicationDirty=false;
      const updatePublicationStatus = () => {
        const planned = publicationControl('plannedPublishAt').value;
        const actual = publicationControl('actualPublishAt').value;
        const delayed = Boolean(planned && actual) && new Date(`${actual}:00+08:00`).getTime() - new Date(`${planned}:00+08:00`).getTime() >= 8 * 60 * 60 * 1000;
        publicationStatus.value = actual ? delayed ? '延期发布' : '按时发布' : '待登记';
        publicationStatus.className = `status-preview ${delayed ? 'completion-delayed' : ''}`;
      };
      const updatePublicationMode = () => {
        const scheduled=publicationControl('publicationMode').value==='scheduled';
        const correcting=Boolean(activeRecord?.actualPublishAt)&&actorRole==='admin'&&publicationControl('correctTime').checked;
        document.querySelector('[data-reservation-fields]').hidden=!scheduled;
        publicationControl('scheduledPublishAt').disabled=!scheduled;publicationControl('scheduledPublishAt').required=scheduled;
        document.querySelectorAll('[data-sent-fields]').forEach(node=>node.hidden=scheduled);
        const actual=publicationControl('actualPublishAt');actual.disabled=scheduled||Boolean(activeRecord?.actualPublishAt)&&!correcting;actual.required=!actual.disabled;
        for(const name of ['publicationUrl','projectDocUrl']){publicationControl(name).disabled=scheduled;publicationControl(name).required=!scheduled&&(name==='publicationUrl'||!activeRecord?.actualPublishAt);}
        document.querySelector('[data-time-correction]').hidden=scheduled||!correcting;
        publicationControl('correctionReason').disabled=scheduled||!correcting;publicationControl('correctionReason').required=!scheduled&&correcting;
        document.querySelector('[data-correction-toggle]').hidden=scheduled||!activeRecord?.actualPublishAt||actorRole!=='admin';
        document.querySelector('[data-publication-delay]').hidden=scheduled;
        publicationForm.querySelector('button[type=submit]').textContent=scheduled?(actorRole==='admin'?'确认预约':'提交预约审核'):'保存已发送登记';
        updatePublicationStatus();
      };
      const openPublication = (record) => {
        if (!record) return;
        activeRecord=record;publicationForm.reset();publicationDirty=false;
        publicationMessage.textContent='';document.querySelectorAll('[data-publication-error]').forEach(node=>node.textContent='');
        document.querySelector('#publication-title').textContent=record.actualPublishAt?'查看／补充发布登记':'发布登记';
        document.querySelector('[data-publication-name]').textContent=record.contentName;
        document.querySelector('[data-publication-planned]').textContent=`应发 ${record.plannedDisplay}`;
        publicationControl('plannedPublishAt').value=record.plannedPublishAt;
        publicationControl('actualPublishAt').value=record.actualPublishAt||'';
        publicationControl('projectDocUrl').value=record.projectDocUrl||'';publicationControl('publicationUrl').value=record.publicationUrl||'';
        publicationControl('expectedPlanRevision').value=record.planRevision;publicationControl('expectedPublicationRevision').value=record.publicationRevision;
        publicationControl('requestKey').value=crypto.randomUUID();publicationControl('scheduledPublishAt').value=record.reservationAt||'';
        publicationControl('publicationMode').querySelector('[value=scheduled]').disabled=Boolean(record.actualPublishAt);
        publicationControl('publicationMode').value=!record.actualPublishAt&&['scheduled','awaiting_approval'].includes(record.publicationState)?'scheduled':'sent';
        updatePublicationMode();publicationDialog.showModal();
        publicationControl(publicationControl('publicationMode').value==='scheduled'?'scheduledPublishAt':'publicationUrl').focus();
        document.dispatchEvent(new CustomEvent('business:publication-opened',{detail:record}));
      };
      const closePublication=()=>{if(publicationDirty&&!confirm('有尚未保存的发布登记，确定放弃吗？'))return;publicationDirty=false;document.documentElement.dataset.unsaved='false';publicationDialog.close();};
      inspectorPublication?.addEventListener('click', () => openPublication(activeRecord));
      document.querySelectorAll('[data-close-publication]').forEach((button) => button.addEventListener('click', closePublication));
      publicationDialog.addEventListener('cancel', (event) => { event.preventDefault(); closePublication(); });
      publicationForm.addEventListener('input',()=>{publicationDirty=true;document.documentElement.dataset.unsaved='true';updatePublicationStatus();});
      publicationControl('publicationMode').addEventListener('change',updatePublicationMode);publicationControl('correctTime').addEventListener('change',updatePublicationMode);
      publicationForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const scheduled=publicationControl('publicationMode').value==='scheduled';
        publicationMessage.textContent=scheduled?'正在提交预约…':'正在保存实发登记…';
        const submit = publicationForm.querySelector('button[type="submit"]');
        submit.disabled = true;
        const body = new FormData(publicationForm);
        try {
          let response = await fetch(`/api/operations-content/${activeRecord.id}/${scheduled?'publication-reservations':'publication'}`, { method: scheduled?'POST':'PATCH', body, headers: { Accept: 'application/json' } });
          let result = await response.json();
          if (response.status === 409 && result.resetRequired) {
            const impact = result.impact ?? {};
            if (window.confirm(`更正实发时间会永久删除 ${impact.campaigns ?? 0} 个推广活动和 ${impact.dailyMetrics ?? 0} 条日度事实，并从新日期重新进入待开始推广。确定继续吗？`)) {
              body.set('confirmPromotionReset', '1');
              response = await fetch(`/api/operations-content/${activeRecord.id}/publication`, { method: 'PATCH', body, headers: { Accept: 'application/json' } });
              result = await response.json();
            }
          }
          if (response.ok) { publicationDirty=false;document.documentElement.dataset.unsaved='false';window.location.reload(); return; }
          publicationMessage.textContent = result.message ?? '保存失败，请重试。';
          for (const [name, errors] of Object.entries(result.fields ?? {})) {
            const error = publicationForm.querySelector(`[data-publication-error="${name}"]`);
            if (error) error.textContent = errors[0] ?? '';
          }
        } catch { publicationMessage.textContent = '无法连接服务，请稍后重试。'; }
        finally { submit.disabled = false; }
      });
      inspectorEdit?.addEventListener('click', () => openForm('edit', activeRecord));
      inspectorRevise?.addEventListener('click', () => openForm('revision', activeRecord));
      document.querySelectorAll('[data-close]').forEach((button) => button.addEventListener('click', closeForm));
      dialog.addEventListener('cancel', (event) => { event.preventDefault(); closeForm(); });
      form.addEventListener('input', () => {
        dirty = true; document.documentElement.dataset.unsaved = 'true'; updatePromotionPreview();
        const changed = mode === 'edit' && actorRole === 'admin' && field('plannedPublishAt').value !== activeRecord?.plannedPublishAt;
        document.querySelector('[data-plan-change-reason]').hidden = !changed; field('planChangeReason').required = changed;
      });
      field('subjectId').addEventListener('change', () => updateCategoryOptions());
      field('categoryId').addEventListener('change', applyCategoryPromotionDefault);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearErrors();
        submitButton.disabled = true;
        const originalLabel = submitButton.innerHTML;
        submitButton.textContent = '正在保存…';
        if (mode === 'revision') field('promotionStatus').disabled = false;
        const body = new FormData(form);
        if (mode === 'revision') field('promotionStatus').disabled = true;
        const endpoint = mode === 'edit'
          ? `/api/operations-content/${activeRecord.id}`
          : mode === 'revision'
            ? `/api/operations-content/versions/${activeRecord.versionId}/revisions`
            : '/api/operations-content';
        try {
          let response = await fetch(endpoint, {
            method: mode === 'edit' ? 'PATCH' : 'POST',
            body,
            headers: { Accept: 'application/json' },
          });
          let result = await response.json();
          if (response.status === 409 && result.resetRequired) {
            const impact = result.impact ?? {};
            const confirmed = window.confirm(
              result.preserveHistory
                ? `改为非推广会结束仍开放的推广阶段。${impact.campaigns ?? 0} 个推广活动和 ${impact.dailyMetrics ?? 0} 条日度数据都会保留，未来进入非推广 7 / 15 天复盘。确定继续吗？`
                : `修改实发日期会永久删除 ${impact.campaigns ?? 0} 个推广活动和 ${impact.dailyMetrics ?? 0} 条日度数据，并从新日期重新进入待开始推广。确定继续吗？`,
            );
            if (confirmed) {
              body.set('confirmPromotionReset', '1');
              response = await fetch(endpoint, {
                method: 'PATCH',
                body,
                headers: { Accept: 'application/json' },
              });
              result = await response.json();
            }
          }
          if (response.ok) { dirty = false; document.documentElement.dataset.unsaved = 'false'; window.location.reload(); return; }
          message.textContent = result.message ?? '保存失败，请重试。';
          for (const [name, errors] of Object.entries(result.fields ?? {})) {
            const error = form.querySelector(`[data-error="${name}"]`);
            const control = form.elements.namedItem(name);
            if (error) error.textContent = errors[0] ?? '';
            if (control instanceof HTMLElement) control.setAttribute('aria-invalid', 'true');
          }
          form.querySelector('[aria-invalid="true"]')?.focus();
        } catch {
          message.textContent = '无法连接服务，请稍后重试。';
        } finally {
          submitButton.disabled = false;
          submitButton.innerHTML = originalLabel;
        }
      });
