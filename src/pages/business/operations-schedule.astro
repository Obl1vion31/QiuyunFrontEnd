---
import {scheduleWriteVersion} from '../../db/schedule-write-version';
import BusinessContentRoleFields from '../../components/BusinessContentRoleFields.astro';
import {readMonthlyCalendar} from '../../db/monthly-plan-links';
import MonthlyCalendarPlan from '../../components/MonthlyCalendarPlan.astro';
import MonthlyArrangementPanel from '../../components/MonthlyArrangementPanel.astro';
import {readArrangement} from '../../db/monthly-arrangement';
import MonthlyScheduleFields from '../../components/MonthlyScheduleFields.astro';
import {effectiveBusinessPermissions} from '../../auth/business-permissions';
import BusinessPendingChanges from '../../components/BusinessPendingChanges.astro';
import BusinessScheduleApprovals from '../../components/BusinessScheduleApprovals.astro';
import BusinessDateTimeFields from '../../components/BusinessDateTimeFields.astro';
import BusinessInspector from '../../components/BusinessInspector.astro';
import BusinessResourceLinks from '../../components/BusinessResourceLinks.astro';
import BusinessFormSheet from '../../components/BusinessFormSheet.astro';
import BusinessSheet from '../../components/BusinessSheet.astro';
import '../../styles/schedule-panel.css';
import BusinessConsoleFonts from '../../components/BusinessConsoleFonts.astro';
import {operationsContent} from '../../db/schema';
import BusinessReviewDateAdd from '../../components/BusinessReviewDateAdd.astro';
import BusinessOperationFields from '../../components/BusinessOperationFields.astro';
import BusinessNonPromotionPlanFields from '../../components/BusinessNonPromotionPlanFields.astro';
import SiteIcons from '../../components/SiteIcons.astro';
import BusinessConsoleFrame from '../../components/BusinessConsoleFrame.astro';
import BusinessConsoleToolbar from '../../components/BusinessConsoleToolbar.astro';
import BusinessToolbarActions from '../../components/BusinessToolbarActions.astro';
import BusinessToolbarPeriodNav from '../../components/BusinessToolbarPeriodNav.astro';
import BusinessToolbarSegmented from '../../components/BusinessToolbarSegmented.astro';
import { asc, desc, eq,isNull } from 'drizzle-orm';
import { getDb } from '../../db/client';
import {
  operationsCategory,
  operationsContentSchedule,
  operationsContentVersion,
  operationsSubject,
} from '../../db/schema';
import { readPromotionContext } from '../../db/promotion-pauses';
import { effectivePromotionStatus, promotionLabels, type PromotionContext } from '../../db/promotion-state.mjs';
import { operationsPromotionCampaign } from '../../db/schema';
import {readTaxonomy} from '../../db/taxonomy-store';
const {postCategories,subjectCategoryMappings,subjects}=await readTaxonomy(getDb());
import { publicationLabels,publicationState,mayKeepEmptyPublicationLink } from '../../db/publication-rules.mjs';
import { teamScheduleNotifications } from '../../db/schedule-workflow';
import { businessDateTime } from '../../scripts/business-date';
import { completionStatus, needsRegistration, requiresPlanApproval, delayThresholdMs, publicationDelayLabel } from '../../db/schedule-rules.mjs';

export const prerender = false;
const permissions=Astro.locals.businessPermissions=await effectiveBusinessPermissions(getDb(),Astro.locals.user!);

const completionLabels = { pending: '待发布', on_time: '按时发布', delayed: '延期发布' };
const selectedView = Astro.url.searchParams.get('view') === 'promotion' ? 'promotion' : 'schedule';
const selectedDisplay = Astro.url.searchParams.get('display') === 'ledger' || selectedView === 'promotion' || ['overdue','approvals','reasons'].includes(Astro.url.searchParams.get('status') ?? '') ? 'ledger' : 'calendar';
if (['reservation_approvals','publication_due','cancelled'].includes(Astro.url.searchParams.get('status') ?? '')) {
  const target = new URL(Astro.url); target.searchParams.delete('status'); target.searchParams.delete('display');if(Astro.url.searchParams.get('status')==='cancelled')target.searchParams.delete('row');
  return Astro.redirect(target.pathname + target.search, 302);
}
const requestedStatus = Astro.url.searchParams.get('status');
const selectedStatus = ['pending', 'overdue', 'published', 'approvals', 'reasons'].includes(requestedStatus ?? '') ? requestedStatus : 'all';
const requestedPromotion = Astro.url.searchParams.get('promotion');
const selectedPromotion = ['testing', 'test_paused', 'scaling', 'scaling_paused', 'test_pending', 'promotion_paused', 'awaiting_promotion', 'ended', 'test_discarded', 'formal_discarded'].includes(requestedPromotion ?? '') ? requestedPromotion : 'all';
const now = new Date();
const dateParts = (date: Date) => Object.fromEntries(new Intl.DateTimeFormat('en', {
  timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
}).formatToParts(date).map((part) => [part.type, part.value]));
const monthKey = (date: Date) => { const part = dateParts(date); return `${part.year}-${part.month}`; };
const dayKey = (date: Date) => { const part = dateParts(date); return `${part.year}-${part.month}-${part.day}`; };
const inputDateTime = (date: Date | null) => {
  if (!date) return '';
  const part = dateParts(date);
  return `${part.year}-${part.month}-${part.day}T${part.hour}:${part.minute}`;
};
const displayDateTime = (date: Date | null) => {
  if (!date) return '尚未登记';
  return businessDateTime(date);
};
const currentMonth = monthKey(now);
const requestedMonth = Astro.url.searchParams.get('month') ?? currentMonth;
const requestedMonthMatch = /^(\d{4})-(\d{2})$/.exec(requestedMonth);
const requestedMonthNumber = Number(requestedMonthMatch?.[2]);
const selectedMonth = requestedMonthMatch
  && Number(requestedMonthMatch[1]) >= 2000
  && Number(requestedMonthMatch[1]) <= 2099
  && requestedMonthNumber >= 1
  && requestedMonthNumber <= 12
  ? requestedMonth
  : currentMonth;
const calendarMonthlyPlan=selectedView==='schedule'&&selectedDisplay==='calendar'&&selectedStatus!=='approvals'?await readMonthlyCalendar(getDb(),selectedMonth):null;
const arrangementState=await readArrangement(getDb(),selectedMonth);
const monthCanCreate=arrangementState.stage!=='closed';
const [selectedYear, selectedMonthNumber] = selectedMonth.split('-').map(Number);
const previousMonth = new Date(Date.UTC(selectedYear, selectedMonthNumber - 2, 1)).toISOString().slice(0, 7);
const nextMonth = new Date(Date.UTC(selectedYear, selectedMonthNumber, 1)).toISOString().slice(0, 7);
const hrefFor = (changes: Record<string, string>) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  Object.entries(changes).forEach(([key, value]) => value ? params.set(key, value) : params.delete(key));
  return `?${params.toString()}`;
};
const monthPickerParams = Array.from(Astro.url.searchParams.entries())
  .filter(([name]) => name !== 'month')
  .map(([name, value]) => ({ name, value }));
const monthPicker = {
  name: 'month',
  value: selectedMonth,
  label: '选择要查看的排期年月',
  min: '2000-01',
  max: '2099-12',
  preservedParams: monthPickerParams,
};

let notifications: Awaited<ReturnType<typeof teamScheduleNotifications>> | undefined;
let databaseError = '';
let promotionContext: PromotionContext = { pauses: [], targets: [], holds: [] };
let campaignRows: Array<typeof operationsPromotionCampaign.$inferSelect> = [];
const rowStatus = (row: { id: string; promotionStatus: string }) => {
  const campaign = campaignRows.find(c => c.scheduleId === row.id);
  return effectivePromotionStatus(row.promotionStatus, campaign?.currentStage ?? null, campaign?.id ?? null, promotionContext);
};
const publishingState=(row:typeof rows[number])=>publicationState(row);
let rows: Array<{
  id: string; writeVersion:string; versionId: string; contentId: string; versionNumber: number; sourceVersionId: string | null;
  workType: string; contentName: string; subjectId: string; subjectName: string; categoryId: string | null; categoryName: string | null;
  contentRole:import('../../db/content-roles').ContentRole|null;operationType:import('../../db/operation-types').OperationType|null; revisionSummary: string | null; projectDocUrl: string | null;
  syncToMoments: boolean; isPromoted: boolean; promotionStatus: string; plannedPublishAt: Date; actualPublishAt: Date | null;
  completionStatus: string; planRevision: number; delayThresholdHours:number; publicationUrl:string|null;publicationRevision:number;
}> = [];
const databaseStartedAt = performance.now();
try {
  const database = getDb();
  [rows, notifications, campaignRows, promotionContext] = await Promise.all([database.select({
    id: operationsContentSchedule.id,writeVersion:scheduleWriteVersion,
    versionId: operationsContentVersion.id,
    contentId: operationsContentVersion.contentId,contentRole:operationsContent.contentRole,operationType:operationsContent.operationType,
    versionNumber: operationsContentVersion.versionNumber,
    sourceVersionId: operationsContentVersion.sourceVersionId,
    workType: operationsContentVersion.workType,
    contentName: operationsContentVersion.contentName,
    subjectId: operationsContentVersion.subjectId,
    subjectName: operationsSubject.name,
    categoryId: operationsContentVersion.categoryId,
    categoryName: operationsCategory.name,
    revisionSummary: operationsContentVersion.revisionSummary,
    projectDocUrl: operationsContentVersion.projectDocUrl,
    syncToMoments: operationsContentSchedule.syncToMoments,
    isPromoted: operationsContentSchedule.isPromoted,
    promotionStatus: operationsContentSchedule.promotionStatus,
    plannedPublishAt: operationsContentSchedule.plannedPublishAt,
    planRevision: operationsContentSchedule.planRevision,
    delayThresholdHours: operationsContentSchedule.delayThresholdHours,
    actualPublishAt: operationsContentSchedule.actualPublishAt,
    publicationUrl:operationsContentSchedule.publicationUrl,publicationRevision:operationsContentSchedule.publicationRevision,
    completionStatus: operationsContentSchedule.completionStatus,
  }).from(operationsContentSchedule)
    .innerJoin(operationsContentVersion, eq(operationsContentSchedule.contentVersionId, operationsContentVersion.id))
    .innerJoin(operationsContent,eq(operationsContentVersion.contentId,operationsContent.id)).innerJoin(operationsSubject, eq(operationsContentVersion.subjectId, operationsSubject.id))
    .leftJoin(operationsCategory, eq(operationsContentVersion.categoryId, operationsCategory.id))
    .where(isNull(operationsContentSchedule.cancelledAt))
    .orderBy(asc(operationsContentSchedule.plannedPublishAt), desc(operationsContentSchedule.createdAt)),
  teamScheduleNotifications(database),
  database.select().from(operationsPromotionCampaign).orderBy(desc(operationsPromotionCampaign.startedOn)),
  readPromotionContext(database),
  ]) as [typeof rows, Awaited<ReturnType<typeof teamScheduleNotifications>>, typeof campaignRows, typeof promotionContext ];
} catch (error) {
  console.error('operations schedule query failed', error);
  databaseError = '数据库暂时不可用。请检查开发库连接和最新迁移后重试。';
}
Astro.response.headers.set('Server-Timing', `db;dur=${(performance.now() - databaseStartedAt).toFixed(1)}`);

const isOverdue = (row: typeof rows[number]) => needsRegistration(row, now);
const monthRows = rows.filter((row) => monthKey(row.plannedPublishAt) === selectedMonth);
const promotionRows = rows.filter((row) => ['testing', 'scaling'].includes(rowStatus(row)));
const activeRows = selectedView === 'promotion'
  ? (selectedPromotion === 'all' ? promotionRows : rows.filter(row => row.isPromoted && rowStatus(row) === selectedPromotion))
  : ['overdue','approvals','reasons'].includes(selectedStatus ?? '')
    ? rows.filter(row => selectedStatus === 'overdue' ? isOverdue(row)
      : selectedStatus === 'approvals' ? notifications?.approvalScheduleIds.includes(row.id)
      : notifications?.missingReasonIds.includes(row.id))
    : monthRows.filter((row) => {
      if (selectedStatus === 'pending') return !row.actualPublishAt;
      if (selectedStatus === 'overdue') return isOverdue(row);
      if (selectedStatus === 'published') return Boolean(row.actualPublishAt);
      return true;
    });
const summary = {
  total: monthRows.length,
  pending: monthRows.filter((row) => !row.actualPublishAt).length,
  overdue: rows.filter(isOverdue).length,
  published: monthRows.filter((row) => row.actualPublishAt).length,
  revisions: monthRows.filter((row) => row.workType === 'revision').length,
  testing: promotionRows.filter((row) => rowStatus(row) === 'testing').length,
  scaling: promotionRows.filter((row) => rowStatus(row) === 'scaling').length,
};
const daysInMonth = new Date(Date.UTC(selectedYear, selectedMonthNumber, 0)).getUTCDate();
const firstWeekday = new Date(Date.UTC(selectedYear, selectedMonthNumber - 1, 1)).getUTCDay();
const calendarCells = Array.from({ length: Math.ceil((firstWeekday + daysInMonth) / 7) * 7 }, (_, index) => {
  const day = index - firstWeekday + 1;
  const valid = day >= 1 && day <= daysInMonth;
  const key = valid ? `${selectedMonth}-${String(day).padStart(2, '0')}` : '';
  return { day, key, valid, rows: valid ? activeRows.filter((row) => dayKey(row.plannedPublishAt) === key) : [] };
});
const clientRows = rows.map((row) => {
  const child = rows.find((candidate) => candidate.sourceVersionId === row.versionId);
  const source = row.sourceVersionId ? rows.find((candidate) => candidate.versionId === row.sourceVersionId) : undefined;
  return {
    ...row, requiresPlanApproval:false,
    publicationState:publishingState(row),publicationLabel:publicationLabels[publishingState(row)],allowEmptyPublicationLink:mayKeepEmptyPublicationLink(row),
    plannedPublishAt: inputDateTime(row.plannedPublishAt),
    actualPublishAt: inputDateTime(row.actualPublishAt),
    projectDocUrl: row.projectDocUrl ?? '',
    revisionSummary: row.revisionSummary ?? '',
    delayLabel:publicationDelayLabel(row.plannedPublishAt,row.actualPublishAt),
    promotionLabel: promotionLabels[rowStatus(row)] ?? row.promotionStatus,
    completionLabel: isOverdue(row) ? '尚未登记' : completionLabels[completionStatus(row.plannedPublishAt,row.actualPublishAt,row.delayThresholdHours)] ?? '待发布',
    plannedDisplay: displayDateTime(row.plannedPublishAt),
    actualDisplay: row.actualPublishAt ? displayDateTime(row.actualPublishAt) : '—',
    sourceScheduleId: row.id,
    nextVersionNumber: Math.max(...rows.filter((candidate) => candidate.contentId === row.contentId).map((candidate) => candidate.versionNumber), row.versionNumber) + 1,
    childVersionNumber: child?.versionNumber ?? null,
    sourceVersionNumber: source?.versionNumber ?? null,
  };
});
const actorRole = Astro.locals.user?.role;
const requestedRow = Astro.url.searchParams.get('row') || Astro.url.hash.slice(1);
const queueView = ['overdue','approvals','reasons'].includes(selectedStatus ?? '');
const queueLabel = selectedStatus === 'overdue' ? '尚未登记' : selectedStatus === 'approvals' ? '待审批排期' : '待补延期理由';
const clientCategories=subjectCategoryMappings.map(mapping=>({subjectId:mapping.subjectId,id:mapping.categoryId,name:postCategories.find(c=>c.id===mapping.categoryId)!.name}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="管理新做帖、改帖版本和运营内容发布排期。" />
    <title>内容发布控制台 · 排期管理</title>
  <SiteIcons /><BusinessConsoleFonts /></head>
  <body>
    <BusinessConsoleFrame active="schedule" notifications={notifications}>
        <BusinessConsoleToolbar title="排期管理" subtitle={selectedView === 'promotion' ? '推广中视角' : queueView ? queueLabel : `${selectedMonth} 当月排期`}>
          {selectedView === 'schedule' && !queueView && <BusinessToolbarPeriodNav slot="center" previousHref={hrefFor({ month: previousMonth })} nextHref={hrefFor({ month: nextMonth })} label={`${selectedMonth.replace('-', ' 年 ')} 月`} todayHref={hrefFor({ month: currentMonth })} todayLabel="本月" monthPicker={monthPicker} />}
          <BusinessToolbarActions slot="end">
            <BusinessToolbarSegmented label="显示方式" items={[
              { label: '月历', href: hrefFor({ view: 'schedule', display: 'calendar', status: '', promotion: '' }), active: selectedDisplay === 'calendar' && selectedView === 'schedule' },
              { label: '台账', href: hrefFor({ display: 'ledger' }), active: selectedDisplay === 'ledger' || selectedView === 'promotion' },
            ]} />
            <button class="filter-button toolbar-action-secondary" type="button" disabled title="更多筛选将在数据维度确认后开放">筛选</button>
            <button class="primary-action" type="button" data-open-new data-surface-press="directional" disabled={!monthCanCreate} data-business-operation="schedule.create" hidden={permissions['schedule.create']==='disabled'}><span>新做帖</span><b aria-hidden="true">＋</b></button>
          </BusinessToolbarActions>
        </BusinessConsoleToolbar>

        <main class="workspace-main business-console-content">
{selectedStatus!=='approvals'&&<BusinessPendingChanges module="schedule"/>}
          {databaseError && <p class="notice notice--error" role="alert">{databaseError}</p>}

          {selectedView === 'schedule' && !queueView && <div class="mobile-period-nav">
            <BusinessToolbarPeriodNav previousHref={hrefFor({ month: previousMonth })} nextHref={hrefFor({ month: nextMonth })} label={`${selectedMonth.replace('-', ' 年 ')} 月`} todayHref={hrefFor({ month: currentMonth })} todayLabel="本月" monthPicker={monthPicker} />
          </div>}

          <nav class="status-strip" aria-label="排期状态视角">
            <a class:list={{ active: selectedView === 'schedule' && selectedStatus === 'all' }} href={hrefFor({ view: 'schedule', status: '', promotion: '', display: selectedDisplay })}>
              <span>本月内容</span><strong>{summary.total}</strong>
            </a>
            <a class:list={{ active: selectedView === 'schedule' && selectedStatus === 'pending' }} href={hrefFor({ view: 'schedule', status: 'pending', promotion: '', display: selectedDisplay })}>
              <span>待发布</span><strong>{summary.pending}</strong>
            </a>
            <a class:list={['promotion-summary', { active: selectedView === 'promotion' && selectedPromotion === 'all' }]} href={hrefFor({ view: 'promotion', status: '', promotion: '', display: selectedDisplay })}>
              <span>推广进行中</span><strong>{promotionRows.length}</strong>
            </a>
            <a class:list={['testing-summary', { active: selectedView === 'promotion' && selectedPromotion === 'testing' }]} href={hrefFor({ view: 'promotion', status: '', promotion: 'testing', display: 'ledger' })}>
              <span>测试中</span><strong>{summary.testing}</strong>
            </a>
            <a class:list={['scaling-summary', { active: selectedView === 'promotion' && selectedPromotion === 'scaling' }]} href={hrefFor({ view: 'promotion', status: '', promotion: 'scaling', display: 'ledger' })}>
              <span>放量中</span><strong>{summary.scaling}</strong>
            </a>
            <a class:list={['attention-summary', { active: selectedView === 'schedule' && selectedStatus === 'overdue' }]} href={hrefFor({ view: 'schedule', status: 'overdue', promotion: '', display: 'ledger' })}>
              <span>尚未登记</span><strong>{summary.overdue}</strong>
            </a>
            <a class:list={{ active: selectedView === 'schedule' && selectedStatus === 'published' }} href={hrefFor({ view: 'schedule', status: 'published', promotion: '', display: selectedDisplay })}>
              <span>已发布</span><strong>{summary.published}</strong>
            </a>
          </nav>
          <nav class="workflow-queue-nav" aria-label="排期待办队列">
            <a aria-current={selectedStatus==='reasons'?'page':undefined} href={hrefFor({view:'schedule',status:'reasons',display:'ledger'})}>待补延期理由 <b>{notifications?.missingReasons ?? '—'}</b></a>
            <a aria-current={selectedStatus==='approvals'?'page':undefined} href={hrefFor({view:'schedule',status:'approvals',display:'ledger'})}>{actorRole==='admin'?'排期待审':'我的申请'} <b>{notifications?.pendingApprovals ?? '—'}</b></a>
            {queueView&&<span>{queueLabel} · 跨月份显示</span>}
          </nav>

          {selectedStatus==='approvals'?<BusinessScheduleApprovals/>:<div class="content-layout" data-inspector-host>
            <section class="content-stage">
              <MonthlyArrangementPanel month={selectedMonth} state={arrangementState} active={selectedView==='schedule'}>
              {(selectedDisplay === 'ledger' || selectedView === 'promotion') && <div class="table-wrap">
          <table>
            <thead><tr><th>应发时间</th><th>版本</th><th>内容</th><th>推广阶段</th><th>发布状态</th><th>文档</th></tr></thead>
            <tbody>
              {activeRows.map((row, index) => {
                const newDay = index === 0 || dayKey(activeRows[index - 1].plannedPublishAt) !== dayKey(row.plannedPublishAt);
                const child = rows.find((candidate) => candidate.sourceVersionId === row.versionId);
                const source = row.sourceVersionId ? rows.find((candidate) => candidate.versionId === row.sourceVersionId) : undefined;
                return <>
                  {newDay && <tr class="day-divider"><th colspan="6"><span class="timeline-dot"></span><strong>{dayKey(row.plannedPublishAt)}</strong>{dayKey(row.plannedPublishAt) === dayKey(now) && <b>今天</b>}<small>{activeRows.filter((candidate) => dayKey(candidate.plannedPublishAt) === dayKey(row.plannedPublishAt)).length} 条</small></th></tr>}
                  <tr class:list={['schedule-row', { overdue: isOverdue(row) }]} data-inspect-id={row.id} tabindex="0">
                    <td class="time-cell"><strong>{displayDateTime(row.plannedPublishAt).split(' ')[1]}</strong><small>{row.actualPublishAt ? `实发 ${displayDateTime(row.actualPublishAt).split(' ')[1]}` : '尚未登记'}</small></td>
                    <td><span class="version-chip">V{row.versionNumber}</span><small>{row.workType === 'revision' ? '改帖' : '新做帖'}</small></td>
                    <td class="content-cell"><strong>{row.contentName}</strong><small>{row.subjectName}{row.categoryName ? ` / ${row.categoryName}` : ''}{row.syncToMoments ? ' · 同步朋友圈' : ''}{source ? ` · 来源 V${source.versionNumber}` : ''}{child ? ` · 已派生 V${child.versionNumber}` : ''}</small></td>
                    <td><span class:list={['promotion-identity',{promoted:row.isPromoted}]}>{row.isPromoted?'推广':'非推广'}</span>{row.isPromoted&&<small>{promotionLabels[rowStatus(row)] ?? row.promotionStatus}</small>}</td>
                    <td><span class={`completion publish-${isOverdue(row)?'missing':completionStatus(row.plannedPublishAt,row.actualPublishAt,row.delayThresholdHours)}`}>{isOverdue(row) ? '尚未登记' : completionLabels[completionStatus(row.plannedPublishAt,row.actualPublishAt,row.delayThresholdHours)]}</span></td>
                    <td>{row.projectDocUrl ? <a class="doc-link" href={row.projectDocUrl} target="_blank" rel="noreferrer" aria-label="打开项目文档">↗</a> : <span class="missing">待登记</span>}</td>
                  </tr>
                </>;
              })}
            </tbody>
          </table>
          {!databaseError && activeRows.length === 0 && <div class="empty"><strong>当前视角没有内容</strong><p>切换状态视角，或点击“新做帖”建立一条 V0 内容。</p></div>}
        </div>
              }

      <MonthlyCalendarPlan month={selectedMonth} plan={calendarMonthlyPlan} arrangement={arrangementState} calendar={selectedView==='schedule'&&selectedDisplay==='calendar'}/>
      {selectedView === 'schedule' && selectedDisplay === 'calendar' && <section class="calendar" aria-label={`${selectedMonth} 月历`}>
        <div class="calendar-legend" aria-label="月历颜色说明"><span class="publish-on_time">按时已发</span><span class="publish-delayed">延期已发</span><span class="publish-pending">待发布</span><span class="publish-missing">尚未登记</span><span class="promotion-identity promoted">推广</span></div>
        <div class="weekdays">{['日','一','二','三','四','五','六'].map((day) => <span>{day}</span>)}</div>
        <div class="calendar-grid">
          {calendarCells.map((cell) => <div data-calendar-day={cell.valid?cell.key:undefined} class:list={['calendar-day', { outside: !cell.valid, today: cell.key === dayKey(now) }]}>
            {cell.valid && <><button type="button" class="day-number calendar-new" disabled={!monthCanCreate} data-calendar-new={cell.key} aria-label={`${cell.key} 新建帖子`}><strong>{cell.day}</strong><span aria-hidden="true">＋</span></button><div class="calendar-items">
              {cell.rows.map((row) => <button type="button" data-inspect-id={row.id} class:list={['calendar-item', `publish-${isOverdue(row)?'missing':completionStatus(row.plannedPublishAt,row.actualPublishAt,row.delayThresholdHours)}`]}
                title={`V${row.versionNumber} ${row.contentName} · ${row.isPromoted?'推广':'非推广'} · 应发 ${displayDateTime(row.plannedPublishAt)} · ${isOverdue(row)?'尚未登记':completionLabels[completionStatus(row.plannedPublishAt,row.actualPublishAt,row.delayThresholdHours)]}`}
                aria-label={`V${row.versionNumber} ${row.contentName}，${row.isPromoted?'推广':'非推广'}，应发 ${displayDateTime(row.plannedPublishAt)}，${isOverdue(row)?'尚未登记':completionLabels[completionStatus(row.plannedPublishAt,row.actualPublishAt,row.delayThresholdHours)]}`}>
                <span class="calendar-item-meta"><span class:list={['promotion-identity',{promoted:row.isPromoted}]}>{row.isPromoted?'推广':'非推广'}</span><time>{displayDateTime(row.plannedPublishAt).split(' ')[1]}</time></span>
                <span class="calendar-item-name"><span>{row.contentName}</span><b>V{row.versionNumber}</b></span>
                {calendarMonthlyPlan?.items.filter(item=>item.schedule?.id===row.id).map(item=><small class="monthly-card-membership" title={'月计划 · Week '+item.week}>计划 W{item.week}{item.pending?' · 待审':''}</small>)}
              </button>)}
            </div></>}
          </div>)}
        </div>
      </section>}
              </MonthlyArrangementPanel>
            </section>


          </div>}
        </main>
    <BusinessSheet id="schedule-panel" labelledby="schedule-detail-title" data-schedule-panel data-dialog-cancel-managed>
            <BusinessInspector class="inspector" parameter="row" label="帖子详情" data-inspector-contained>
              <header><div><div class="inspector-header-meta"><span data-inspector-version>V0</span><small data-inspector-kind>新做帖</small></div><h2 id="schedule-detail-title" data-inspector-name></h2></div><button type="button" data-close-inspector aria-label="关闭详情">×</button></header>
              <div class="inspector-body">
                <section class="inspector-title"><p data-inspector-category></p></section>
                <dl class="detail-list">
                  <div><dt>推广状态</dt><dd data-inspector-promotion></dd></div>
                  <div><dt>应发时间</dt><dd data-inspector-planned></dd></div>
                  <div><dt>实发时间</dt><dd data-inspector-actual></dd></div>
                  <div data-inspector-completion-row><dt>发布状态</dt><dd data-inspector-completion></dd></div>
                </dl>
                <p class="inspector-delay-label" data-inspector-delay-label hidden></p>
                <section class="inspector-section schedule-workflow-panel" data-schedule-workflow aria-label="当前待处理" hidden></section>
                <BusinessResourceLinks dynamic name="当前帖子"/>
                <section class="non-plan-panel schedule-detail-section" data-review-plan-panel hidden aria-label="复盘计划">
                  <h3>运营类型与复盘计划</h3><p data-review-plan-summary></p>
                  <details data-business-operation="schedule.edit"><summary>管理复盘方式</summary><form class="business-form" data-review-plan-form><input type="hidden" name="action" value="reviewPlan"/><BusinessNonPromotionPlanFields prefix="inspector-review"/><output role="status"></output><button type="submit" class="business-action-primary">保存复盘计划</button></form></details>
                  <BusinessReviewDateAdd hidden/>
                  <div class="non-plan-nodes" data-review-node-list></div>
                </section>
                <section class="schedule-detail-section inspector-version">
                  <h3>版本与改帖</h3><div class="version-path" data-inspector-path aria-label="版本关系"></div>
                  <div class="inspector-revision" data-inspector-revision-section><h4>具体改动说明</h4><p data-inspector-revision-summary></p></div>
                </section>
                <section class="inspector-section schedule-workflow-history schedule-detail-section" data-schedule-workflow-history aria-label="历史记录" hidden></section>
                <section class="inspector-section" data-promotion-state-history hidden></section>
                <details class="inspector-danger business-form" data-business-operation="schedule.delete" hidden={Astro.locals.user?.role!=='admin'}><summary>更多操作</summary><label>取消排期原因<textarea data-inspector-cancel-reason rows="2" maxlength="2000"></textarea></label><button type="button" data-inspector-delete>取消这条排期</button><small role="alert" data-inspector-delete-error></small></details>
              </div>
              <footer class="inspector-actions business-inspector-actions"><button type="button" class="business-action-primary" data-inspector-publication data-business-operation="schedule.publish schedule.correctPublication" data-business-any hidden={permissions['schedule.publish']==='disabled'&&permissions['schedule.correctPublication']==='disabled'}>发布登记</button><div><button type="button" class="business-action-secondary" data-inspector-edit data-business-operation="schedule.edit schedule.reschedule schedule.overdueReschedule schedule.endPromotion" data-business-any hidden={['schedule.edit','schedule.reschedule','schedule.overdueReschedule','schedule.endPromotion'].every(key=>permissions[key as keyof typeof permissions]==='disabled')}>编辑排期</button><button type="button" class="business-action-secondary" data-inspector-revise data-business-operation="schedule.revise" hidden={permissions['schedule.revise']==='disabled'}>创建改帖</button></div><span data-inspector-derived hidden></span></footer>
            </BusinessInspector>
    <BusinessFormSheet embedded id="schedule-dialog" labelledby="dialog-title">
      <form class="business-form" id="schedule-form" action="/api/operations-content" method="post" novalidate>
        <header class="dialog-head">
          <div><span id="dialog-context" hidden>新建内容</span><h2 id="dialog-title">新做帖</h2></div>
          <div class="dialog-head-actions"><span class="dialog-version">V0</span><button type="button" class="close-button" data-close aria-label="关闭">×</button></div>
        </header>
        <input type="hidden" name="recordId" /><input type="hidden" name="expectedWriteVersion" /><input type="hidden" name="expectedPlanRevision" />
        <input type="hidden" name="sourceScheduleId" />
        <div class="sheet-body">
        <section class="source-preview" data-source-preview hidden></section><MonthlyScheduleFields/>
        <div class="form-grid">
          <div class="field field-wide"><label for="contentName">内容名称 <b>*</b></label><input id="contentName" name="contentName" maxlength="200" required /><small data-error="contentName"></small></div>
          <div class="field"><label for="subjectId">学科 <b>*</b></label><select id="subjectId" name="subjectId" required><option value="">请选择学科</option>{subjects.map((subject) => <option value={subject.id}>{subject.name}</option>)}</select><small data-error="subjectId"></small></div>
          <div class="field"><label for="categoryId">帖子分类 <b data-category-required>*</b></label><select id="categoryId" name="categoryId" required disabled><option value="">请先选择学科</option></select><small data-error="categoryId"></small><em data-category-help></em></div>

          <BusinessContentRoleFields/><BusinessOperationFields/>
          <fieldset class="revision-fields field-wide" data-revision-only hidden>
            <legend>本次改帖</legend>
            <div class="field revision-summary-field"><label for="revisionSummary">具体改动说明 <b>*</b></label><textarea id="revisionSummary" name="revisionSummary" rows="5" maxlength="1000"></textarea><small data-error="revisionSummary"></small>
              <div class="revision-example" aria-label="填写示例">
                <strong>填写示例</strong>
                <ol>
                  <li><b>本次修改的具体内容：</b>说明改动了封面、标题、正文或引导语等哪些部分。</li>
                  <li><b>改动原因及希望达到的效果：</b>说明为什么修改，以及希望改善的阅读、理解或咨询效果。</li>
                </ol>
              </div>
            </div>
          </fieldset>

          <BusinessDateTimeFields name="plannedPublishAt" dateName="plannedPublishDate" timeName="plannedPublishTime" dateLabel="应发日期" timeLabel="应发时间" label="应发时间" required><small data-error="plannedPublishAt"></small></BusinessDateTimeFields>
          <div class="field field-wide" data-plan-change-reason hidden><label for="planChangeReason">改期理由 <b>*</b></label><textarea id="planChangeReason" name="planChangeReason" rows="2" maxlength="500"></textarea><small data-error="planChangeReason"></small></div>
          <div class="field field-wide" data-schedule-change-reason><label for="scheduleChangeReason">本次安排／调整原因 <b>*</b></label><textarea id="scheduleChangeReason" name="changeReason" rows="2" maxlength="2000" placeholder="月会封存后的新增与调整必须填写原因"></textarea></div>
          <div class="field field-wide field-options" role="group" aria-label="发布选项">
            <div class="promotion-field"><label class="promotion-toggle" hidden><input type="checkbox" name="isPromoted"/>推广帖</label><input id="promotionStatus" name="promotionStatus" type="hidden" value="none"/><output class="promotion-preview" data-promotion-preview hidden>非推广</output></div>
            <label><input type="checkbox" name="syncToMoments"/>同步朋友圈</label>
            <small data-error="isPromoted"></small><em data-promotion-help></em>
          </div>
          <div class="field field-wide usage-change-field" hidden><label for="usageChangeReason">改为非推广的原因 <b>*</b></label><textarea id="usageChangeReason" name="usageChangeReason" rows="3" maxlength="500" placeholder="说明从何时起不再推广，以及本次用途调整原因"></textarea><small data-error="usageChangeReason"></small><em>已有 Campaign、阶段和日度事实会保留；仍开放的推广阶段将在确认后结束。</em></div>
          <div class="field field-wide"><label for="projectDocUrl">项目文档链接（选填）</label><input id="projectDocUrl" name="projectDocUrl" type="url" placeholder="可在实发登记时补充" /><small data-error="projectDocUrl"></small></div>
        </div>
        <p class="form-message" role="alert"></p>
        </div>
        <footer class="dialog-actions"><button type="button" class="secondary-action" data-close>取消</button><button type="submit" class="save-button">保存新做帖</button></footer>
      </form>
    </BusinessFormSheet>

    <script type="application/json" data-schedule-records set:html={JSON.stringify(clientRows).replace(/</g,'\\u003c')}/>
    <BusinessFormSheet embedded id="publication-dialog" labelledby="publication-title">
      <form class="business-form" id="publication-form" novalidate>
        <header class="dialog-head"><div><h2 id="publication-title">发布登记</h2></div><button type="button" class="close-button" data-close-publication aria-label="关闭">×</button></header>
        <input type="hidden" name="plannedPublishAt" />
        <div class="sheet-body">
        <div class="publication-context"><strong data-publication-name></strong><span data-publication-planned></span></div>
        <div class="form-grid">
          <input type="hidden" name="expectedPublicationRevision"/><input type="hidden" name="expectedWriteVersion"/>
          <BusinessDateTimeFields name="actualPublishAt" id="publicationActualPublishAt" dateName="actualPublishDate" timeName="actualPublishTime" dateLabel="发布日期" timeLabel="发布时间" label="发布时间" required><small data-publication-error="actualPublishAt"></small><div class="datetime-followup" data-correction-toggle hidden><label class="time-correction-toggle"><input type="checkbox" name="correctTime"/>更正已有实发时间</label></div></BusinessDateTimeFields>
          <div class="field field-wide publication-status-field"><label>完成情况</label><output class="status-preview" data-publication-status>待登记</output></div>
          <div class="field field-wide"><label for="publicationUrl">小红书帖子链接 <b data-publication-link-required>*</b></label><textarea id="publicationUrl" name="publicationUrl" rows="3" maxlength="4000" required placeholder="可直接粘贴小红书完整分享文案"></textarea><output data-publication-link-preview aria-live="polite"></output><small data-publication-error="publicationUrl"></small></div>
          <div class="field field-wide"><label for="publicationProjectDocUrl">项目文档链接 <b data-publication-doc-required>*</b></label><input id="publicationProjectDocUrl" name="projectDocUrl" type="url" placeholder="https://" required/></div>
          <div class="field field-wide" data-publication-review-plan><BusinessNonPromotionPlanFields prefix="publication-review"/></div>
          <div class="field field-wide" data-time-correction hidden><label for="publicationCorrectionReason">实发时间更正原因 <b>*</b></label><textarea id="publicationCorrectionReason" name="correctionReason" maxlength="500" disabled></textarea><small data-publication-error="correctionReason"></small></div>
          <section class="field field-wide delay-field" data-publication-delay><strong>逐日延期理由</strong><p data-publication-delay-status role="status"></p><div data-publication-delay-days></div><input type="hidden" name="dailyReasons" value="[]"/><input type="hidden" name="expectedPlanRevision"/></section>
          <fieldset class="field field-wide publication-moments" data-publication-moments hidden><legend>朋友圈同步确认 <b aria-hidden="true">*</b></legend><div class="checks"><label><input type="checkbox" name="momentsSentConfirmed"/>已发送朋友圈</label><label><input type="checkbox" name="momentsRequestSentConfirmed"/>已发送对应需求</label></div><small data-publication-moments-error role="alert"></small></fieldset>
        </div>
        <p class="form-message" data-publication-message role="alert"></p>
        </div>
        <footer class="dialog-actions"><button type="button" class="secondary-action" data-close-publication>取消</button><button type="submit" class="save-button">保存发布登记</button></footer>
      </form>
    </BusinessFormSheet>

    </BusinessSheet>
    </BusinessConsoleFrame>

    <script id="schedule-page-config" type="application/json" set:html={JSON.stringify({clientRows,clientCategories,actorRole,requestedRow,delayThresholdMs}).replace(/</g,'\\u003c')}/>
    <script>import '../../scripts/schedule-page.js';</script>

    <script>import '../../scripts/operations-workflow';</script>
<script>import '../../scripts/non-promotion-plan';
import '../../scripts/operation-setup';</script>
  </body>
</html>

<style is:global>
  :root{--paper:#f2f4ef;--ink:#17202a;--muted:#65717b;--line:#cbd1cf;--blue:#2454d3;--night:#10243e;--orange:#ff6a3d;--mint:#a9ddc8;--test:#d49a12;--test-soft:#fff1bf;--test-ink:#6a4a00;--scale:#3f9272;--scale-soft:#ddf2e8;--scale-ink:#205d48;--white:#fff}
  *{box-sizing:border-box}html{background:var(--paper)}body{margin:0;color:var(--ink);background:var(--paper);font-family:var(--console-font);line-height:1.5}button,input,select,textarea{font:inherit}button:active{transform:scale(.98);transition:transform 100ms ease-out}a{color:inherit}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--orange);outline-offset:2px}
  .topbar{position:sticky;top:0;z-index:10;height:58px;padding:0 clamp(20px,4vw,60px);display:flex;align-items:center;justify-content:space-between;color:#fff;background:#10243eee;backdrop-filter:blur(18px) saturate(140%);box-shadow:0 1px #ffffff24}.brand{font-weight:500;letter-spacing:.04em;text-decoration:none}.brand span,.access{color:#9eb8f8;font:500 var(--console-caption) var(--console-font);letter-spacing:.12em;font-variant-numeric:tabular-nums}
  .intro{display:flex;justify-content:space-between;align-items:end;gap:32px;padding-bottom:25px;border-bottom:2px solid var(--ink)}.eyebrow{margin:0 0 8px;color:var(--blue);font:500 var(--console-caption) var(--console-font);letter-spacing:.13em;font-variant-numeric:tabular-nums}.intro h1{margin:0;font-family:var(--console-font);font-size:clamp(2.6rem,5vw,5.4rem);line-height:.95;letter-spacing:-.045em}.intro p:last-child{max-width:680px;margin:18px 0 0;color:var(--muted)}.primary-action{border:0;padding:13px 18px;color:#fff;background:var(--blue);font-weight:500;cursor:pointer}.primary-action{min-width:150px;display:flex;align-items:center;justify-content:space-between;border-radius:12px;box-shadow:0 8px 24px #2454d329}.notice{padding:12px 16px;margin:20px 0 0;border-left:5px solid}.notice--error{background:#ffe4dc;border-color:var(--orange)}
  .context-bar{position:sticky;top:70px;z-index:8;display:grid;grid-template-columns:auto auto 1fr;align-items:center;gap:20px;margin:28px 0 0;padding:9px 12px;border:1px solid #ffffffb8;border-radius:16px;background:#f8faf6d9;backdrop-filter:blur(20px) saturate(150%);box-shadow:0 12px 40px #10243e14}.bar-title{display:grid;padding:0 10px}.bar-title span{color:var(--muted);font-size:var(--console-caption)}.bar-title strong{font-size:.82rem}.segmented{display:flex;padding:3px;border-radius:11px;background:#dfe4e2}.segmented a{display:flex;gap:10px;padding:8px 12px;border-radius:8px;text-decoration:none;font-size:.78rem;font-weight:500}.segmented a.active{color:#fff;background:var(--night);box-shadow:0 3px 10px #10243e38}.segmented span{font-family:var(--console-font);font-variant-numeric:tabular-nums}.context-bar>p{justify-self:end;margin:0;color:var(--muted);font-size:var(--console-caption);text-align:right}
  .month-controls{display:flex;justify-content:space-between;align-items:center;margin:24px 0 0}.month-nav,.display-switch{display:flex;align-items:center}.month-nav>a,.display-switch a{padding:8px 12px;text-decoration:none;border:1px solid var(--line);background:#fff}.month-nav strong{padding:8px 16px;font:500 1rem var(--console-font);font-variant-numeric:tabular-nums}.month-nav .today-link{margin-left:10px;border:0;background:transparent;color:var(--blue);font-size:.8rem;font-weight:500}.display-switch{padding:3px;border-radius:10px;background:#dfe4e2}.display-switch a{border:0;border-radius:7px;background:transparent}.display-switch a.active{color:#fff;background:var(--blue)}
  .summary{display:flex;margin:24px 0 34px;color:#fff;background:var(--night);border-radius:14px;overflow:hidden}.summary>div{flex:1;padding:18px 22px;border-right:1px solid #476078}.summary span{display:block;color:#b7c6d3;font-size:.75rem}.summary strong{font:500 2rem var(--console-font);font-variant-numeric:tabular-nums}.summary .attention strong{color:#ff9a7c}.summary .signal strong{color:var(--mint)}
  .promotion-board{display:grid;grid-template-columns:1fr 1fr;gap:28px}.promotion-lane{border-top:6px solid var(--test);background:#fff}.lane-scaling{border-color:var(--scale)}.promotion-lane>header{display:flex;align-items:end;justify-content:space-between;padding:20px 22px;border-bottom:1px solid var(--ink)}.promotion-lane header span{color:var(--muted);font:500 var(--console-caption) var(--console-font);letter-spacing:.14em;font-variant-numeric:tabular-nums}.promotion-lane h2{margin:3px 0 0}.promotion-lane header>strong{font:500 2.2rem var(--console-font);font-variant-numeric:tabular-nums}.lane-list article{display:grid;grid-template-columns:125px 1fr auto;gap:15px;padding:18px 20px;border-bottom:1px solid var(--line)}.time-mark span,.time-mark small{display:block;color:var(--muted);font-size:var(--console-caption)}.time-mark strong{display:block;font-size:.8rem}.content-mark h3{margin:4px 0 0;font-size:.95rem}.content-mark p{margin:3px 0;color:var(--muted);font-size:.75rem}.doc-mark{grid-column:2;font-size:.75rem}.doc-mark span,.missing{color:#aa4529;font-weight:500}.empty-lane{margin:0;padding:36px 20px;color:var(--muted);text-align:center}
  .version-line{display:flex;align-items:center;gap:6px;flex-wrap:wrap;color:var(--muted);font-size:var(--console-caption);font-weight:500}.version-chip{display:inline-block;padding:2px 6px;border-radius:999px;color:#fff;background:var(--blue);font:500 var(--console-caption) var(--console-font);font-variant-numeric:tabular-nums}.revision-note{color:#3853a1!important}.row-actions{display:flex;align-items:flex-start;gap:6px;flex-wrap:wrap}.edit-button,.revise-button{border:1px solid var(--ink);padding:6px 9px;background:transparent;font-size:var(--console-caption);font-weight:500;cursor:pointer}.revise-button{color:#fff;border-color:var(--blue);background:var(--blue)}.derived-label{padding:6px 4px;color:var(--muted);font-size:var(--console-caption);font-weight:500}
  .table-wrap{overflow-x:auto;border-top:2px solid var(--ink);background:#fff}.table-wrap table{width:100%;min-width:1120px;border-collapse:collapse;font-size:.8rem}.table-wrap thead th{padding:11px 12px;text-align:left;color:var(--muted);font-size:var(--console-caption);letter-spacing:.04em;border-bottom:1px solid var(--ink)}.table-wrap tbody td{padding:14px 12px;vertical-align:top;border-bottom:1px solid var(--line)}.table-wrap td strong,.table-wrap td small{display:block}
.table-wrap td small{margin-top:4px;color:var(--muted)}.day-divider th{padding:9px 12px;text-align:left;background:#e4e8e4;font:500 .75rem var(--console-font);font-variant-numeric:tabular-nums}.day-divider span{margin-left:9px;padding:2px 6px;color:#fff;background:var(--blue);font-family:var(--console-font)}.tag,.completion{display:inline-block;padding:3px 7px;font-weight:500;background:#e0e5e2}.promotion-testing{background:var(--test-soft);color:var(--test-ink)}.promotion-scaling{background:var(--scale-soft);color:var(--scale-ink)}.promotion-ended{background:#e1e2e2;color:#5c6264}.promotion-test_discarded,.promotion-formal_discarded{background:#efe1e1;color:#743838}.completion-overdue,.completion-delayed{color:#9e3718;background:#ffe0d6}.table-wrap tr.overdue td:first-child{box-shadow:inset 4px 0 var(--orange)}.empty{padding:52px 20px;text-align:center}.empty p{color:var(--muted)}
  .weekdays,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr)}.weekdays span{padding:8px 10px;color:var(--muted);font-size:.7rem;font-weight:500;border-bottom:1px solid var(--ink)}.calendar-grid{border-left:1px solid var(--line);border-top:1px solid var(--line)}.calendar-day{min-height:145px;padding:9px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.calendar-day.outside{background:#e8ebe8}.calendar-day.today{box-shadow:inset 0 4px var(--blue)}.day-number{display:block;margin-bottom:8px;font:850 .8rem var(--console-font);font-variant-numeric:tabular-nums}.calendar-items{display:grid;gap:5px}.calendar-item{width:100%;display:grid;grid-template-columns:auto 1fr;gap:6px;padding:6px;border:0;text-align:left;background:#e5e9e6;cursor:pointer}.calendar-item time{font:500 .64rem var(--console-font);font-variant-numeric:tabular-nums}.calendar-item span{overflow:hidden;font-size:.7rem;font-weight:750;white-space:nowrap;text-overflow:ellipsis}.calendar-item.promotion-testing{border-left:3px solid var(--test);background:var(--test-soft)}.calendar-item.promotion-scaling{border-left:3px solid var(--scale);background:var(--scale-soft)}.calendar-item.overdue{color:#8a3018;background:#ffe0d6}.delay-field{padding:13px;border-left:4px solid var(--orange);background:#ffe8e1}
  @media(max-width:900px){.context-bar{grid-template-columns:auto 1fr}.context-bar>p{display:none}.promotion-board{grid-template-columns:1fr}.calendar-day{min-height:110px}.calendar-item{display:block}.calendar-item time{display:block}.summary{flex-wrap:wrap}.summary>div{min-width:33%}}
  @media(max-width:650px){.access{display:none}.topbar{height:52px}.brand span{display:none}.intro{display:block}.intro h1{font-size:3rem}.primary-action{width:100%;margin-top:24px}.context-bar{top:60px;display:block;padding:8px}.bar-title{display:none}.segmented{width:100%}.segmented a{flex:1;justify-content:space-between}.month-controls{align-items:flex-start;gap:14px}.month-nav{flex-wrap:wrap}.summary>div{min-width:50%;padding:14px}.lane-list article{grid-template-columns:100px 1fr}.row-actions{grid-column:2}.doc-mark{grid-column:2}.weekdays{display:none}.calendar-grid{grid-template-columns:1fr}.calendar-day.outside{display:none}.calendar-day{min-height:auto}.calendar-item{display:grid}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}button:active{transform:none}}
  @media(prefers-reduced-transparency:reduce){.topbar,.context-bar{backdrop-filter:none}.topbar{background:var(--night)}.context-bar{background:var(--paper)}}

  /* 内容发布控制台：Apple Workspace 外壳 */
  html,body{min-height:100%;background:#e9ece8}
  body{overflow-x:hidden}


  .workspace{min-width:0}
  .toolbar{position:sticky;top:0;z-index:14;min-height:72px;display:grid;grid-template-columns:minmax(130px,1fr) auto minmax(320px,1fr);align-items:center;gap:18px;padding:10px 24px;border-bottom:1px solid #bac2bf99;background:#f5f7f3e8;backdrop-filter:blur(22px) saturate(145%)}
  .toolbar-title{display:grid}
  .toolbar-title span{font-size:.94rem;font-weight:500;letter-spacing:-.015em}
  .toolbar-title small{color:var(--muted);font-size:var(--console-caption)}
  .month-nav{justify-self:center;display:flex;align-items:center;padding:3px;border-radius:11px;background:#dde2df}
  .month-nav>a{display:grid;place-items:center;min-width:32px;height:31px;padding:0;border:0;border-radius:8px;background:transparent;text-decoration:none;font-weight:500}
