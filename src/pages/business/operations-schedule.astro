        record.actualPublishAt=asInput(data.schedule.actualPublishAt);record.reservationAt=asInput(data.publicationReservations[0]?.scheduledPublishAt);
        record.actualDisplay=data.schedule.actualPublishAt?new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(new Date(data.schedule.actualPublishAt)):'尚未实发';
