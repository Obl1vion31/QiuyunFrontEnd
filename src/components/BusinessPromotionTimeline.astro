---
import BusinessPromotionPendingRows from './BusinessPromotionPendingRows.astro';
import {isPendingPromotionRow} from '../db/promotion-pending';
import {desc,inArray} from 'drizzle-orm';
import {getDb} from '../db/client';
import {readPromotionTimeline} from '../db/promotion-timeline';
import {operationsPromotionTimelineAudit} from '../db/schema';
import {businessDateTime} from '../scripts/business-date';
import {shanghaiDateKey,previousDateKey} from '../db/promotion-rules.mjs';
import {promotionLabels} from '../db/promotion-state.mjs';
interface Props {rows?:Awaited<ReturnType<typeof readPromotionTimeline>>;history?:boolean;scheduleId?:string}
const {rows:given,history=false,scheduleId}=Astro.props;
const all=given??await readPromotionTimeline(getDb(),new Date(),scheduleId);
const today=shanghaiDateKey(new Date()),yesterday=previousDateKey(today),admin=Astro.locals.user?.role==='admin';
const visible=all.filter(row=>history||isPendingPromotionRow(row));
const audits=history&&visible.length?await getDb().select().from(operationsPromotionTimelineAudit).where(inArray(operationsPromotionTimelineAudit.scheduleId,visible.map(row=>row.scheduleId))).orderBy(desc(operationsPromotionTimelineAudit.createdAt)):[];
const actionLabels:Record<string,string>={wait:'待定（未开始推广）',plan:'安排下一步',start_testing:'开始测试',start_scaling:'直接放量',pause:'当日暂停',next:'安排下一步',legacy_defer:'迁移旧未推广确认',publication_reset:'发布时间更正',usage_change:'调整推广身份',metric_correction:'更正历史复盘决定'};
function snapshotSummary(value:Record<string,unknown>){
 const campaigns=value.campaigns as Array<{startedOn:string;initialStage:string}>|undefined;
 const plan=value.plan as {waitingThrough?:string;plannedOn?:string}|undefined;
 const schedule=value.schedule as {promotionStatus?:string}|undefined;
 if(!campaigns?.length&&!plan?.waitingThrough&&schedule?.promotionStatus&&schedule.promotionStatus!=='awaiting_promotion')return promotionLabels[schedule.promotionStatus]??schedule.promotionStatus;
 return [plan?.waitingThrough?`待定至 ${plan.waitingThrough}`:'',...(campaigns??[]).map(row=>`${row.startedOn} 开始${row.initialStage==='scaling'?'放量':'测试'}`),!campaigns?.length&&!plan?.waitingThrough?'尚未开始':''].filter(Boolean).join('；');
}
const auditRows=audits.map(audit=>{
 const before=audit.before.metrics as Array<{id:string;metricDate:string;spend:string;platformOpenCount:number;actualOpenCount:number;platformLeadCount:number;actualLeadCount:number}>|undefined;
 const after=audit.after.metrics as Array<{id:string}>|undefined;
 return {...audit,archived:(before??[]).filter(row=>!(after??[]).some(kept=>kept.id===row.id))};
});
const displayRows=visible.map(row=>{
  const range=row.ranges.filter(item=>item.startedOn<=yesterday&&!item.nextDecision).at(-1);
  const date=range?(range.endedOn<yesterday?range.endedOn:yesterday):history?(row.campaign?.startedOn??row.date):row.date;
  const waiting=!!range||row.canArrangeInitial&&!!row.waitingThrough&&!row.plan?.plannedOn;
  const end=range?.endedOn??row.waitingThrough;
  const nextDue=row.isPromoted&&waiting&&end&&end<=yesterday;
  const status=row.campaign?.currentStatus??row.promotionStatus;
  const label=['ended','test_discarded','formal_discarded'].includes(status)||!row.campaign&&!row.canArrangeInitial?(promotionLabels[status]??status):range?(range.stageType==='testing'?'测试待定':'推广暂停'):row.campaign?(row.plan?.plannedOn&&row.plan.plannedOn>yesterday?'次日推广已安排':'已开始推广'):row.plan?.plannedOn?`计划${row.plan.plannedStage==='scaling'?'放量':'测试'}`:waiting?'待定（未开始推广）':'首次安排待确认';
  const editable=row.isPromoted&&(!!row.campaign||row.canArrangeInitial)&&(admin||!row.hasMetrics);
  return {row,range,date,waiting,end,nextDue,label,editable};
});
if(!history)displayRows.sort((a,b)=>a.date.localeCompare(b.date));

---
{!history&&<BusinessPromotionPendingRows rows={visible}/>}
{history&&visible.length>0&&<section class="promotion-timeline" aria-label={history?'推广状态历史':'首次安排与待定'}>
 {history&&<h2>推广安排与状态历史</h2>}
 {displayRows.map(({row,range,date,waiting,end,nextDue,label,editable})=><article class:list={[{"timeline-daily-row":!history}]} data-timeline-row={row.scheduleId} data-promotion-status={row.campaign?.currentStatus??row.promotionStatus} data-promotion-label={row.campaign?promotionLabels[row.campaign.currentStatus==='waiting_action'?(row.campaign.currentStage==='testing'?'test_pending':'promotion_paused'):row.campaign.currentStatus]:promotionLabels[row.promotionStatus]??row.promotionStatus}>
   <header><div class="timeline-identity"><strong>{row.contentName}</strong><span>V{row.versionNumber} · {row.subjectName}</span></div><time>{date}</time><mark>{label}{waiting&&<small>至 {end}（含当天）</small>}</mark></header>
   {row.plan?.plannedOn&&!row.campaign&&<p>{row.plan.plannedOn} 计划{row.plan.plannedStage==='scaling'?'放量':'测试'}，请确认当天实际状态。</p>}
   {editable&&(history||waiting||row.campaign)&&<details open={!waiting&&!row.campaign&&!history}>
    <summary>{history?(waiting||row.campaign?'更正当日状态':'选择首次安排'):'修改当日状态'}</summary>
    <form class="business-form timeline-state-form" data-timeline-form data-fingerprint={row.fingerprint}>
     <input type="hidden" name="scheduleId" value={row.scheduleId}/>
     <input type="hidden" name="target" value={range?'day':'initial'}/>
     <label>业务日期<input type="date" name="reviewDate" value={date} min={row.publishedOn} max={today} required/></label>
     <label>当日状态<select name="action" required><option value="">请选择</option>{!row.campaign&&<option value="wait" selected={waiting}>待定（未开始推广）</option>}<option value="start_testing">{row.campaign?'测试／恢复测试':'开始测试'}</option><option value="start_scaling">{row.campaign?'放量／恢复推广':'直接放量'}</option></select></label>
     {!row.campaign&&<label data-timeline-through>待定至（含当天）<input type="date" name="waitingThrough" value={end??date} min={row.publishedOn}/></label>}
     <label class="timeline-reason">{history||row.campaign?'更正原因':'原因（选填）'}<textarea name="reason" maxlength="2000" rows="2" required={history||!!row.campaign}/></label>
     <button type="submit" class="business-action-primary">保存当日安排</button><output role="alert"/>
    </form>
   </details>}
   {nextDue&&<form class="business-form timeline-next-form" data-timeline-form data-fingerprint={row.fingerprint}>
    <input type="hidden" name="scheduleId" value={row.scheduleId}/><input type="hidden" name="reviewDate" value={end!}/><input type="hidden" name="action" value={range?'next':'plan'}/>{range&&<input type="hidden" name="rangeId" value={range.id}/>}
    <label>{end} 的下一步<select name="nextDecision" required><option value="">请选择</option>{!range?<><option value="start_testing">开始测试</option><option value="start_scaling">直接放量</option></>:range.stageType==='testing'?<><option value="test_continue">恢复测试</option><option value="start_scaling">开始放量</option><option value="test_discarded">测试淘汰</option></>:<><option value="scaling_continue">恢复推广</option><option value="formal_discarded">放量淘汰</option><option value="ended">推广结束</option></>}</select></label>
    <button type="submit" class="business-action-primary">保存下一步</button><output role="alert"/>
   </form>}
   {waiting&&editable&&<details><summary>调整待定截止日</summary><form class="business-form timeline-next-form" data-timeline-form data-fingerprint={row.fingerprint}>
    <input type="hidden" name="scheduleId" value={row.scheduleId}/><input type="hidden" name="reviewDate" value={range?end!:row.publishedOn}/><input type="hidden" name="action" value={range?'next':'wait'}/>{range&&<><input type="hidden" name="rangeId" value={range.id}/><input type="hidden" name="nextDecision" value="wait_continue"/></>}
    <label>待定至（含当天）<input type="date" name="waitingThrough" value={end!} min={range?.startedOn??row.publishedOn} required/></label><label>调整原因<input name="reason" maxlength="500" required/></label><button type="submit" class="business-action-primary">保存截止日</button><output role="alert"/>
   </form></details>}
   {history&&<details><summary>状态变更记录</summary>{auditRows.filter(audit=>audit.scheduleId===row.scheduleId).map(audit=><details><summary>{audit.businessDate} · {actionLabels[audit.action]??'状态更正'}</summary><p>{audit.reason}<small>{audit.changedByLabel} · {businessDateTime(audit.createdAt)}</small></p>{audit.action!=='legacy_defer'&&<><p>更正前：{snapshotSummary(audit.before)}</p><p>更正后：{snapshotSummary(audit.after)}</p></>}{audit.archived.length>0&&<div class="timeline-archive"><p>已归档的原始指标</p><table><thead><tr>{['日期','消耗','平台开口','实际开口','平台留资','实际留资'].map(label=><th>{label}</th>)}</tr></thead><tbody>{audit.archived.map(metric=><tr><td>{metric.metricDate}</td><td>{metric.spend}</td><td>{metric.platformOpenCount}</td><td>{metric.actualOpenCount}</td><td>{metric.platformLeadCount}</td><td>{metric.actualLeadCount}</td></tr>)}</tbody></table></div>}</details>)}</details>}
  </article>)}
</section>}
<script>import '../scripts/promotion-timeline';</script>
<style is:global>
.promotion-timeline{display:grid;gap:10px;margin:12px 0}.daily-section>.promotion-timeline{margin:12px 10px}.promotion-timeline>h2{font-size:16px;margin:8px 0}.promotion-timeline article{min-width:0;padding:14px 16px;border:1px solid var(--console-line);border-radius:10px;background:var(--console-surface);font:400 13px/20px var(--console-font)}.promotion-timeline header{display:flex;gap:6px 12px;align-items:center;flex-wrap:wrap}.promotion-timeline header span,.promotion-timeline small{color:var(--console-muted);font-size:12px}.promotion-timeline time{font-variant-numeric:tabular-nums}.promotion-timeline mark{padding:2px 6px;border-radius:5px;background:#f3e6c8;color:#73551d}.promotion-timeline details{margin-top:10px}.promotion-timeline summary{cursor:pointer;font-weight:600}.promotion-timeline small{display:block}.timeline-state-form,.timeline-next-form{display:flex;align-items:end;flex-wrap:wrap;gap:12px;margin-top:12px}.timeline-state-form>label,.timeline-next-form>label{min-width:140px;flex:1}.timeline-state-form .timeline-reason{flex-basis:100%}.promotion-timeline output:not(:empty){flex-basis:100%;color:#913c35}.promotion-timeline [hidden]{display:none!important}@media(max-width:600px){.timeline-state-form>label,.timeline-next-form>label{flex-basis:100%}.promotion-timeline button{width:100%}}
</style>
<style is:global>
.timeline-archive{overflow:auto}.timeline-archive table{border-collapse:collapse;font-size:12px}.timeline-archive th,.timeline-archive td{padding:6px 9px;border-bottom:1px solid var(--console-line);white-space:nowrap;text-align:left;font-variant-numeric:tabular-nums}
</style>
<style is:global>
.timeline-identity{min-width:0;display:grid;gap:2px}.timeline-identity strong{overflow-wrap:anywhere}.promotion-timeline mark small{color:inherit;font-size:12px}
</style>
