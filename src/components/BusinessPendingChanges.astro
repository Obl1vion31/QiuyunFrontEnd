---
import {readTaxonomy} from '../db/taxonomy-store';
import {and,desc,eq} from 'drizzle-orm';
import {getDb} from '../db/client';
import {operationsChangeProposal as proposals} from '../db/schema';
import {proposalDiff,proposalTitle} from '../db/proposal-diff';
import {businessDateTime} from '../scripts/business-date';
interface Props{module:'annual'|'schedule';all?:boolean}
const {module,all=false}=Astro.props;
const user=Astro.locals.user!;
const rows=await getDb().select().from(proposals).where(and(eq(proposals.module,module),all?undefined:eq(proposals.requestedById,user.id))).orderBy(desc(proposals.createdAt)).limit(all?100:10);
const labels={pending:'待审核',approved:'已通过',rejected:'已驳回',obsolete:'已失效'};
const taxonomy=await readTaxonomy(getDb());
---
{rows.length>0&&<details class="business-pending-changes" open={all}><summary><h2>{all?(module==='annual'?'总周期规划变更':'排期变更'):'我的变更申请'}</h2><span>待审核</span><b>{rows.filter(row=>row.status==='pending').length}</b></summary>{rows.map(row=><details data-proposal-id={row.id}><summary><strong>{proposalTitle(row.operations)}</strong><span>{labels[row.status]}</span><time>{businessDateTime(row.createdAt)}</time></summary><p>{row.requestedByLabel}{row.decisionReason?` · ${row.decisionReason}`:''}</p><div class="proposal-diff-scroll"><table><thead><tr><th>字段</th><th>修改前</th><th>修改后</th></tr></thead><tbody>{proposalDiff(row.before,row.after,taxonomy).map(change=><tr><th>{change.label}</th><td>{change.before}</td><td>{change.after}</td></tr>)}</tbody></table></div>{all&&row.status==='pending'&&<form class="business-form" data-decide-proposal={row.id}><label>审核说明<textarea name="reason" maxlength="500"/></label><div class="business-action-group"><button type="submit" class="business-action-primary" name="action" value="approve">同意修改</button><button type="submit" class="business-action-secondary" name="action" value="reject">驳回</button></div><output role="alert"/></form>}</details>)}</details>}
<style is:global>
.business-pending-changes{margin:16px 0;border:1px solid var(--console-line);border-radius:12px;background:var(--console-surface);padding:16px}.business-pending-changes h2{font-size:14px;margin:0 0 8px}.business-pending-changes details{padding:10px 0;border-top:1px solid var(--console-line)}.business-pending-changes summary{display:flex;align-items:center;flex-wrap:wrap;gap:8px 16px;cursor:pointer}.business-pending-changes time{color:var(--console-muted);font-size:12px}.business-pending-changes p{margin:8px 0}.proposal-diff-scroll{overflow:auto}.business-pending-changes table{width:100%;border-collapse:collapse;text-align:left;font-size:13px}.business-pending-changes th,.business-pending-changes td{padding:8px;border-bottom:1px solid var(--console-line);white-space:pre-wrap;overflow-wrap:anywhere}.business-pending-changes td{min-width:100px;max-width:400px}.business-pending-changes form{display:grid;gap:12px;margin-top:12px}
</style>
