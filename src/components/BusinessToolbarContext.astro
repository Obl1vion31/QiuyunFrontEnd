---
interface Props { text: string }
const { text } = Astro.props;
---

<strong class="toolbar-context-text">{text}</strong>

<style>
  .toolbar-context-text{display:block;overflow:hidden;max-width:320px;color:#58645e;font:600 var(--console-caption)/34px var(--console-font);text-overflow:ellipsis;white-space:nowrap}
</style>
