---
interface Props { text: string }
const { text } = Astro.props;
---

<strong class="toolbar-context-text">{text}</strong>

<style>
  .toolbar-context-text{display:block;overflow:hidden;max-width:320px;color:#58645e;font:750 11px/34px system-ui,"PingFang SC","Microsoft YaHei",sans-serif;text-overflow:ellipsis;white-space:nowrap}
</style>
