---
interface Props { label: string; value: string | number; detail?: string; compact?: boolean }
const { label, value, detail, compact = false } = Astro.props;
---

<div class:list={['toolbar-summary-block', { compact }]}>
  <span>{label}</span><strong>{value}</strong>{detail && <small>{detail}</small>}
</div>

<style>
  .toolbar-summary-block,.toolbar-summary-block *{box-sizing:border-box}.toolbar-summary-block{height:34px;display:grid;grid-template-columns:auto auto;align-content:center;align-items:baseline;gap:0 7px;color:#17211c;font-family:var(--console-font);white-space:nowrap}.toolbar-summary-block span,.toolbar-summary-block small{color:#68736d;font-size:var(--console-caption);line-height:14px;font-weight:500}.toolbar-summary-block strong{font:600 20px/20px var(--console-font);font-variant-numeric:tabular-nums}.toolbar-summary-block small{grid-column:1/-1}.toolbar-summary-block.compact{height:auto;display:flex;gap:5px}.toolbar-summary-block.compact strong{font-size:13px;line-height:16px;font-weight:600}
</style>
