---
interface Props { skipped?: boolean }
const {skipped=false}=Astro.props;
---
<div class="review-row table-head" role="row"><span role="columnheader" aria-sort="descending"><button type="button" data-sort="date">实验日期 <i aria-hidden="true">↓</i></button></span><span role="columnheader">帖子</span><span role="columnheader">轮次</span>{skipped?<span role="columnheader" class="review-reason-head">不复盘原因</span>:<><span role="columnheader" aria-sort="none"><button type="button" data-sort="click">点击率 <i aria-hidden="true">↕</i></button></span><span role="columnheader" aria-sort="none"><button type="button" data-sort="read" aria-label="按 3 秒阅读率排序"><span class="sort-read-full">3 秒阅读率</span><span class="sort-read-short">阅读率</span> <i aria-hidden="true">↕</i></button></span></>}<span role="columnheader" class="review-action-head">操作</span></div>
