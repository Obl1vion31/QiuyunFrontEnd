---
import type {MonthlyCalendarView} from '../db/monthly-plan-links';
interface Props {month:string;calendar?:boolean;plan?:MonthlyCalendarView|null}
import {monthWeeks} from '../db/monthly-plan-types';
import {businessDateTime} from '../scripts/business-date';
import '../styles/monthly-calendar.css';
const {month,calendar=true,plan=null}=Astro.props;
const canManage=Astro.locals.businessPermissions?.['schedule.edit']!=='disabled';
const linked=(item:NonNullable<typeof plan>['items'][number])=>item.linked;
const groups=plan?.linkGroups??[],openGroups=groups.filter(g=>g.remaining>0||g.pending),doneGroups=groups.filter(g=>!g.remaining&&!g.pending);
const fixed=plan?.items.filter(i=>i.kind!=='new'||i.scheduleId)??[];
---
{calendar&&plan?.firstFinalizedAt&&<section class="monthly-calendar-plan" data-monthly-plan-pool data-can-manage={canManage?'true':'false'} aria-label="月计划关联">
 <header class="monthly-calendar-heading"><h2>月计划</h2><span data-monthly-overall>{plan.items.filter(linked).length}/{plan.items.length} 已关联</span></header>
 <ol style={"--monthly-week-count:"+monthWeeks(month).length} class="monthly-calendar-weeks" aria-label="每周计划进度">{monthWeeks(month).map(({week})=><li data-monthly-week={week}><strong>Week {week}</strong><span>计划 <b data-week-total>{plan.items.filter(i=>i.week===week).length}</b></span><span>已关联 <b data-week-linked>{plan.items.filter(i=>i.week===week&&linked(i)).length}</b></span><span class="monthly-pending" data-week-pending hidden={!plan.items.some(i=>i.week===week&&i.pending)}>待审 <b>{plan.items.filter(i=>i.week===week&&i.pending).length}</b></span></li>)}</ol>
 <div class="monthly-calendar-sources" data-monthly-open-section hidden={!openGroups.length}><span class="monthly-pool-label">待安排</span><div class="monthly-calendar-groups" data-monthly-open-groups>{openGroups.map(group=><button type="button" class="monthly-calendar-group" data-monthly-link-group={group.key} aria-pressed="false" disabled={!canManage||!!group.pending}><strong data-group-name>{group.name}</strong><span data-group-count>×{group.remaining}</span><small data-group-state>Week {group.week}{group.addition?' · 追加':''}{group.pending?' · 待审':group.overdue?' · 超过48h未提交':''}</small></button>)}</div></div>
 <details class="monthly-calendar-completed" data-monthly-completed hidden={!doneGroups.length}><summary>已关联计划 (<span data-monthly-completed-count>{doneGroups.length}</span>)</summary><div class="monthly-calendar-groups" data-monthly-done-groups>{doneGroups.map(group=><button type="button" class="monthly-calendar-group" data-monthly-link-group={group.key} aria-pressed="false" disabled={!canManage}><strong data-group-name>{group.name}</strong><span data-group-count>×{group.quantity}</span><small data-group-state>Week {group.week} · 更正关联</small></button>)}</div></details>
 {fixed.length>0&&<details class="monthly-calendar-fixed"><summary>指定排期与遗留 ({fixed.length})</summary><div class="monthly-fixed-items business-form">{fixed.map(item=><div data-plan-item={item.id}><strong>{item.schedule?.name??item.group.name}</strong><span>Week {item.week} · {item.kind==='carry'?'遗留':'指定排期'} · {item.pending?'待审':item.status==='scheduled'?'已安排':'待安排'}</span>{item.deadline&&<small>截止 {businessDateTime(item.deadline)}</small>}{item.status==='unassigned'||item.status==='rejected'?<button type="button" class="business-action-secondary" data-monthly-pick={item.id}>安排原帖</button>:item.schedule&&<a href={`?month=${month}&display=ledger&row=${item.schedule.id}`}>查看排期</a>}</div>)}</div></details>}
 <div class="monthly-link-actions business-form" data-monthly-link-actions>
  <p data-monthly-link-status aria-live="polite">{canManage?'点击计划，在月历中勾选已有帖子。':'当前账号可查看计划，关联需排期编辑权限。'}</p>
  <label data-monthly-link-reason-field hidden><span class="sr-only">跨Week或更正原因</span><input type="text" maxlength="2000" data-monthly-link-reason placeholder="跨Week／更正原因"/></label>
  <button type="button" class="business-action-secondary" data-monthly-link-clear-hidden hidden>取消未显示的勾选</button>
  <button type="button" class="business-action-primary" data-monthly-link-save hidden>保存关联</button>
  <button type="button" class="business-action-secondary" data-monthly-link-cancel hidden>取消</button>
 </div>
 <output class="monthly-link-message" role="status" data-monthly-link-message hidden></output>
 <p data-monthly-selection hidden></p><button type="button" data-monthly-cancel hidden>取消选择</button>
</section>}
<script is:inline type="application/json" data-monthly-calendar-plan set:html={JSON.stringify(plan).replace(/</g,'\\u003c')}/>
<script>import '../scripts/monthly-calendar';import '../scripts/monthly-calendar-links';</script>
