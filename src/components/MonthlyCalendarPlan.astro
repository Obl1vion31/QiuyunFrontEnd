---
import type {MonthlyCalendarView} from '../db/monthly-plan-links';
import type {readArrangement} from '../db/monthly-arrangement';
interface Props {month:string;calendar?:boolean;plan?:MonthlyCalendarView|null;arrangement?:Awaited<ReturnType<typeof readArrangement>>}
import {monthWeeks,weekOf,compactPlanItems} from '../db/monthly-plan-types';
import {businessDate,businessDateTime} from '../scripts/business-date';
import '../styles/monthly-calendar.css';
const {month,calendar=true,plan=null,arrangement}=Astro.props;
const canManage=Astro.locals.businessPermissions?.['schedule.edit']!=='disabled'&&plan?.arrangementStatus!=='confirmed'&&(plan?.arrangementStatus!=='review_pending'||Astro.locals.user?.role==='admin');
const rows=arrangement?.rows??[],items=plan?.items??[];
const separate=new Set(items.filter(i=>i.kind!=='new'||i.submittedAt||i.pending||i.schedule||i.history.length).map(i=>i.id));
const weeks=monthWeeks(month).map(week=>({...week,items:items.filter(i=>i.week===week.week)}));
---
{calendar&&plan?.firstFinalizedAt&&<section class="monthly-calendar-plan" data-monthly-plan-pool data-can-manage={canManage?'true':'false'} aria-label={plan.arrangementStatus==='confirmed'?'定稿计划对照':'预排期对照'}>
 <div class="monthly-calendar-weeks" aria-label="每周计划与安排">{weeks.map(({week,from,through,items:weekItems})=><section class="monthly-calendar-week" data-monthly-plan-week={week}>
  <header><div><h3>Week {week}</h3><p><span>计划 <b>{weekItems.length}</b></span><span>已排 <b data-arrangement-week-count={week}>{rows.filter(r=>weekOf(businessDate(r.plannedAt))===week).length}</b></span></p></div><time>{businessDate(from)} 至 {businessDate(through)}</time></header>
  {weekItems.length>0&&<div class="monthly-calendar-groups">{compactPlanItems(weekItems,separate).map(chunk=>{
   const first=items.find(i=>i.id===chunk[0].id)!,groupPending=plan.linkGroups.some(g=>g.groupId===first.groupId&&g.week===first.week&&g.pending>0);
   const available=chunk.map(i=>items.find(p=>p.id===i.id)!).find(i=>!i.pending&&!i.linked&&(i.status==='unassigned'||i.status==='rejected'));
   const enabled=canManage&&!!available&&!groupPending,selected=available??first;
   return <button type="button" class="monthly-calendar-group" data-monthly-plan-source={selected.id} data-monthly-source-kind={first.kind} data-monthly-source-week={week} data-monthly-source-state={first.pending||groupPending?'pending':first.linked?'scheduled':'unassigned'} draggable={enabled} aria-pressed="false" disabled={!enabled}>
    <span class="monthly-source-name"><span class="monthly-source-kind" data-kind={first.kind}>{first.kind==='carry'?'遗留':first.kind==='existing'?'指定':'新'}</span><strong>{first.schedule?.name??first.group.name}</strong></span>{chunk.length>1&&<b>×{chunk.length}</b>}
    {(first.pending||groupPending||first.linked||first.kind!=='new')&&<small>{first.pending||groupPending?'待审':first.linked?'已安排':first.schedule?'当前 '+businessDateTime(first.schedule.plannedAt):'待安排'}</small>}
   </button>;
  })}</div>}
 </section>)}</div>
 <div class="monthly-calendar-selection" hidden={!canManage}><p class="monthly-caption monthly-calendar-instruction">可将计划拖到日期建立帖子，或选择计划后点击日期。</p><p data-monthly-selection hidden></p><button type="button" class="business-action-secondary" data-monthly-cancel hidden>取消选择</button></div>
</section>}
<script is:inline type="application/json" data-monthly-calendar-plan set:html={JSON.stringify(plan).replace(/</g,'\u003c')}/>
<script>import '../scripts/monthly-calendar';</script>
