---
import type {MonthlyCalendarView} from '../db/monthly-plan-links';
import type {readArrangement} from '../db/monthly-arrangement';
interface Props {month:string;calendar?:boolean;plan?:MonthlyCalendarView|null;arrangement?:Awaited<ReturnType<typeof readArrangement>>}
import {monthWeeks,weekOf} from '../db/monthly-plan-types';
import {businessDate,businessDateTime} from '../scripts/business-date';
import '../styles/monthly-calendar.css';
const {month,calendar=true,plan=null,arrangement}=Astro.props;
const canManage=Astro.locals.businessPermissions?.['schedule.edit']!=='disabled'&&plan?.arrangementStatus!=='confirmed'&&(plan?.arrangementStatus!=='review_pending'||Astro.locals.user?.role==='admin');
const rows=arrangement?.rows??[];
const groups=[...new Set(plan?.items.filter(i=>i.kind==='new').map(i=>JSON.stringify([i.groupId,i.week]))??[])].map(key=>{
 const [groupId,week]=JSON.parse(key),items=plan!.items.filter(i=>i.groupId===groupId&&i.week===week&&i.kind==='new');
 return {key,week,name:items[0].group.name,quantity:items.length,item:items.find(i=>!i.schedule)??items[0]};
});
const fixed=plan?.items.filter(i=>i.kind!=='new')??[];
---
{calendar&&plan?.firstFinalizedAt&&<section class="monthly-calendar-plan" data-monthly-plan-pool data-can-manage={canManage?'true':'false'} aria-label="预排期对照">
 <header class="monthly-calendar-heading"><h2>{plan.arrangementStatus==='confirmed'?'封存计划':'预排期'}</h2><span>计划 {plan.items.length} 篇 · 当前安排 {rows.length} 篇</span></header>
 <ol style={"--monthly-week-count:"+monthWeeks(month).length} class="monthly-calendar-weeks" aria-label="每周计划与安排">{monthWeeks(month).map(({week})=><li><strong>Week {week}</strong><span>计划 <b>{plan.items.filter(i=>i.week===week).length}</b></span><span>已安排 <b>{rows.filter(r=>weekOf(businessDate(r.plannedAt))===week).length}</b></span></li>)}</ol>
 <div class="monthly-calendar-groups">{groups.map(group=><button type="button" class="monthly-calendar-group" data-monthly-plan-source={group.item.id} draggable={canManage} aria-pressed="false" disabled={!canManage}><strong>{group.name}</strong><span>×{group.quantity}</span><small>Week {group.week}</small></button>)}</div>
 {canManage&&<p class="monthly-caption" style="margin:10px 0 0">可将计划拖到日期建立帖子，或拖动已有卡片调整日期；单帖保存后，整月再提交核对。</p>}
 {fixed.length>0&&<details class="monthly-calendar-fixed"><summary>遗留与指定帖子 ({fixed.length})</summary><div class="monthly-fixed-items business-form">{fixed.map(item=><div><strong>{item.schedule?.name??item.group.name}</strong><span>Week {item.week} · {item.kind==='carry'?'遗留':'指定帖子'}</span>{item.schedule&&<small>当前 {businessDateTime(item.schedule.plannedAt)}</small>}{canManage&&<button type="button" class="business-action-secondary" data-monthly-pick={item.id}>安排原帖</button>}</div>)}</div></details>}
 <p data-monthly-selection hidden></p><button type="button" class="business-action-secondary" data-monthly-cancel hidden>取消选择</button>
</section>}
<script is:inline type="application/json" data-monthly-calendar-plan set:html={JSON.stringify(plan).replace(/</g,'\\u003c')}/>
<script>import '../scripts/monthly-calendar';</script>
