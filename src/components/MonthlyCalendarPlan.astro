---
import {readMonthlyPlan} from '../db/monthly-plans';
import {getDb} from '../db/client';
import '../styles/monthly-meeting.css';
import {businessDateTime} from '../scripts/business-date';
const {month,calendar=true}=Astro.props;const plan=await readMonthlyPlan(getDb(),month);
---
{calendar&&plan?.firstFinalizedAt&&<details class="monthly-section monthly-calendar-plan" data-monthly-plan-pool><summary><strong>待安排月计划</strong><span>　{plan.items.filter(i=>i.status==='unassigned'||i.status==='rejected').length} 项待落实 · {plan.items.filter(i=>i.pending).length} 项待审</span></summary><p class="monthly-caption">选择名额后点击日历日期；标题、运营类型和具体时间在原表单填写。</p><p data-monthly-selection class="monthly-plan-alert" hidden></p><button type="button" data-monthly-cancel hidden>取消选择</button><div class="monthly-pool-items">{plan.items.map(item=><article class="monthly-plan-item" data-plan-item={item.id}><strong>{item.group.name} · {item.ordinal}</strong><p>Week {item.week} · {item.addition?'追加':item.kind==='carry'?'原计划 · 遗留':'原计划'}</p><p class:list={['monthly-status',{warning:item.overdue}]}>{item.status==='pending'?'已提交待审':item.status==='scheduled'?'已排期':item.status==='rejected'?`${item.timely?'已按时提交':'超时提交'}／驳回待处理`:item.overdue?'超过48h未提交':'待安排'}</p>{item.deadline&&<p class="monthly-caption">截止 {businessDateTime(item.deadline)}</p>}{item.status==='unassigned'||item.status==='rejected'?<button type="button" data-monthly-pick={item.id}>选择并安排</button>:item.schedule&&<a href={`?month=${month}&display=ledger&row=${item.schedule.id}`}>查看排期 ↗</a>}</article>)}</div></details>}
<script type="application/json" data-monthly-calendar-plan set:html={JSON.stringify(plan).replace(/</g,'\\u003c')}/>
<script>import '../scripts/monthly-calendar';</script>
<style>.monthly-calendar-plan{margin:16px 0}.monthly-calendar-plan>summary{display:flex;flex-wrap:wrap;align-items:center;gap:8px;cursor:pointer;min-height:28px;font-size:14px}.monthly-calendar-plan>summary>span{font-size:12px;color:var(--console-muted)}[data-monthly-cancel][hidden]{display:none!important}.monthly-plan-item:has([aria-pressed=true]){border-color:var(--console-blue);background:#f2f5ff}.monthly-pool-items{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px}.monthly-pool-items .monthly-plan-item{margin:0}@media(max-width:650px){.monthly-pool-items{grid-template-columns:1fr}.monthly-calendar-plan>summary>span{display:block}}</style>
