---
interface Props { title: string; description?: string; headingId?: string; contained?: boolean }
const { title, description, headingId, contained = false } = Astro.props;
---

<header class:list={["business-page-header", { "business-page-header--contained": contained }]}>
  <div class="business-page-header__copy">
    <h1 id={headingId}>{title}</h1>
    {description && <p>{description}</p>}
  </div>
  {Astro.slots.has('meta') && <div class="business-page-header__meta"><slot name="meta" /></div>}
</header>

<style>
  .business-page-header{display:flex;align-items:end;justify-content:space-between;gap:28px}.business-page-header--contained{padding:18px 20px;border-bottom:1px solid var(--console-line)}.business-page-header__copy{min-width:0}.business-page-header h1{margin:0;font:600 22px/28px var(--console-font);letter-spacing:-.02em}.business-page-header p{max-width:780px;margin:6px 0 0;color:var(--console-muted);font-size:var(--console-text);line-height:var(--console-text-leading)}.business-page-header__meta{flex:none;text-align:right}.business-page-header__meta :global(p){margin:0;color:var(--console-muted);font:500 var(--console-caption)/var(--console-caption-leading) var(--console-font)}
  @media(max-width:700px){.business-page-header{display:block}.business-page-header__meta{margin-top:12px;text-align:left}}
</style>
