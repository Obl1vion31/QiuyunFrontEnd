---
interface Props {value:string|null;editable?:boolean}
const {value,editable=false}=Astro.props;
---
<section class="business-note-identity" data-note-identity aria-label="笔记 ID">
  <div class="business-note-heading"><span>笔记 ID</span><div class="business-note-actions">
    {value&&<button type="button" data-copy-id={value}>复制</button>}
    {editable&&<button type="button" data-note-edit aria-expanded="false">更正</button>}
  </div></div>
  <code data-current-note-id>{value??'未填写'}</code>
  <slot/>
</section>
<script>import '../scripts/inline-note-identity';</script>
<style is:global>
.business-note-identity{min-width:0;margin:12px 0 14px}
.business-note-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;color:var(--console-muted);font:400 13px/22px var(--console-font)}
.business-note-actions{display:flex;align-items:center;gap:14px}
.business-note-actions button{border:0;padding:2px 0;min-height:28px;background:transparent;color:var(--console-blue);font:400 13px/22px var(--console-font);cursor:pointer}
.business-note-actions button:hover{text-decoration:underline;text-underline-offset:3px}
.business-note-actions button:focus-visible{outline:2px solid var(--console-blue);outline-offset:3px;border-radius:3px}
.business-note-identity>code{display:block;margin-top:3px;color:var(--console-ink);font:400 12px/22px ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere}
.business-note-identity form.business-form{display:grid;gap:12px;margin-top:12px;padding:12px 0 0;border-top:1px solid var(--console-line)}
.business-note-identity form[hidden]{display:none!important}
.business-note-identity form p{margin:0;color:var(--console-muted);font:400 13px/21px var(--console-font)}
.business-note-identity .note-id-scope{display:grid;gap:8px;margin:0;padding:0;border:0;min-width:0}
.business-note-identity .note-id-scope legend{margin-bottom:6px;color:var(--console-muted);font:400 13px/21px var(--console-font)}
.business-note-identity .note-id-scope label{display:flex;align-items:start;gap:8px;line-height:22px}
.business-note-identity .note-id-scope input{width:16px!important;height:16px!important;flex:none;margin:3px 0 0}
.business-note-form-actions{display:flex;align-items:center;gap:10px}
.business-note-form-actions button{flex:1}
.business-note-identity output:not(:empty){display:block;color:var(--console-muted);font:400 13px/21px var(--console-font)}
</style>
