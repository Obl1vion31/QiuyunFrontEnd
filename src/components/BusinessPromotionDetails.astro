---
import BusinessResourceLinks from './BusinessResourceLinks.astro';
import {businessDateTime} from '../scripts/business-date';
import {noteIdOn} from '../db/note-identity-rules';
import BusinessPromotionMetric from './BusinessPromotionMetric.astro';
import BusinessPromotionTimeline from './BusinessPromotionTimeline.astro';
import BusinessPromotionWaitRanges from './BusinessPromotionWaitRanges.astro';
import type {PromotionOverview,PromotionFact} from '../db/promotion-overview';
import type {readPromotionContext} from '../db/promotion-pauses';
import type {operationsPromotionTimelineAudit} from '../db/schema';
interface Props {entry:PromotionOverview;context:Awaited<ReturnType<typeof readPromotionContext>>;audits:(typeof operationsPromotionTimelineAudit.$inferSelect)[];closeHref:string;metric?:PromotionFact}
const {entry,context,audits,closeHref,metric}=Astro.props;
const selectedNoteId=metric?noteIdOn(entry.post.noteIdPeriods,metric.metricDate):entry.post.platformNoteId;
const ranges=context.waitRanges.filter(r=>entry.campaigns.some(c=>c.id===r.campaignId)&&(!metric||r.startedOn<=metric.metricDate&&r.endedOn>=metric.metricDate));
const holds=context.holds.filter(r=>entry.campaigns.some(c=>c.id===r.campaignId));
---
<header><div><h2 data-inspector-title>{entry.post.contentName}</h2><p>V{entry.post.versionNumber} · {entry.post.subjectName}</p><span class="promotion-inspector-status" data-stage={entry.status}>当前 · {entry.statusLabel}</span></div><a href={closeHref} data-close-inspector aria-label="关闭生命周期详情">×</a></header>
<div class="promotion-detail" data-collaboration-resource={`schedule:${entry.scheduleId}`} data-collaboration-label={entry.post.contentName}>
 <BusinessResourceLinks documentUrl={entry.post.projectDocUrl} postUrl={entry.post.publicationUrl} name={entry.post.contentName}/>
 <details class="surface-resource-meta"><summary>发布时间与笔记 ID</summary><dl class="promotion-detail-meta promotion-references"><div><dt>应发时间</dt><dd>{entry.post.plannedPublishAt?businessDateTime(entry.post.plannedPublishAt):'—'}</dd></div><div><dt>实发时间</dt><dd>{entry.post.actualPublishAt?businessDateTime(entry.post.actualPublishAt):'—'}</dd></div><div class="promotion-detail-id"><dt>笔记 ID</dt><dd class="promotion-note-id">{selectedNoteId??'待补'}</dd></div></dl></details>
 {metric&&<BusinessPromotionMetric metric={metric} entry={entry}/>}
 {(ranges.length>0||holds.length>0||!entry.closed&&entry.latest)&&<details class="promotion-detail-extra"><summary>待定与暂停记录</summary><BusinessPromotionWaitRanges campaigns={entry.campaigns.map(c=>({...c,contentName:entry.post.contentName,versionNumber:entry.post.versionNumber}))} ranges={ranges} context={context} historical readOnly={!!metric}/>{holds.map(hold=><p>{hold.stageType==='testing'?'测试待定':'推广暂停'}：{hold.startedOn} 至 {hold.endedOn??'尚未恢复'}</p>)}</details>}
 {metric&&<a class="promotion-all-business" data-inspector-key={entry.key} href={`?${new URLSearchParams({...Object.fromEntries(Astro.url.searchParams),campaign:entry.key})}`}>查看整篇推广安排与业务历史</a>}
 <BusinessPromotionTimeline history embedded rows={[entry.post]} audits={audits} businessDate={metric?.metricDate}/>
 {metric&&<details class="note-id-correction promotion-detail-extra"><summary>更正笔记 ID</summary>
  <form class="business-form" data-note-identity-form data-schedule-id={entry.scheduleId} data-version-number={entry.post.versionNumber} action={`/api/operations-content/${entry.post.contentId}/platform-note-id`}>
   <p>V{entry.post.versionNumber} · {metric.metricDate}</p>
   <label>当日笔记 ID<output data-current-note-id>{selectedNoteId??'未填写'}</output></label>
   <input type="hidden" name="versionId" value={entry.post.versionId}/><input type="hidden" name="effectiveOn" value={metric.metricDate}/><input type="hidden" name="expectedFingerprint" value={entry.post.noteIdFingerprint}/>
   <label>新笔记 ID<input name="platformNoteId" pattern="[0-9A-Fa-f]{24}" maxlength="24" required autocomplete="off" placeholder="24 位十六进制 ID"/></label>
   <fieldset class="note-id-scope"><legend>生效范围</legend><label><input type="radio" name="scope" value="from_date" checked/>从 {metric.metricDate} 起（包含当天）</label><label><input type="radio" name="scope" value="version"/>本版本的全部阶段</label></fieldset>
   <button type="submit" class="business-action-secondary">保存更正</button><output data-note-identity-message role="status"/>
  </form>
 </details>}
</div>
