---
/**
 * 文件：MetricCell.astro
 * 【实现需求】统一展示真实百分比、相对基准差值与同类统计。
 * 【组件职责】展示主指标和 pp 差值，并通过 tooltip 保留同类均值与样本量。
 * 【安全边界】颜色只辅助表达状态；主数值始终保持深色并使用等宽数字。
 */
interface Props { value:number|null; benchmark:number|null; delta:number|null; sampleSize:number; state:'positive'|'neutral'|'negative'; round?:string; comparable?:boolean }
const { value, benchmark, delta, sampleSize, state, round,comparable=true } = Astro.props;
const formatRate=(number:number|null)=>number==null?'—':`${number.toFixed(2)}%`;
const formatDelta=(number:number|null)=>number==null?'':`${number>0?'+':''}${number.toFixed(2)}pp`;
const title=comparable?`${round??''}${benchmark==null?`同类样本 n=${sampleSize} 篇，暂无法计算均值`:`同类均值 ${formatRate(benchmark)} · n=${sampleSize} 篇`}`:undefined;
---
<span class:list={['metric-cell',state,{'has-value':value!=null}]} title={title} data-result-metric={value!=null||undefined}>
  <span class="metric-primary"><strong>{formatRate(value)}</strong>{comparable&&<small hidden={value==null||delta==null}>{formatDelta(delta)}</small>}</span>
  <span class="result-track" aria-hidden="true" hidden={value==null}><i data-result-track style={`width:${value??0}%`}></i></span>
  {round && comparable && <em hidden={value==null||benchmark==null}><span class="metric-reference-label">同类均值 </span><span>{formatRate(benchmark)} </span><span>· {sampleSize} 篇</span></em>}
</span>
<style>
.metric-cell{grid-template-rows:minmax(26px,auto) 4px auto;align-content:start}.metric-primary{grid-row:1}.result-track{grid-row:2}.metric-cell em{grid-row:3}
.metric-cell,.metric-cell *{box-sizing:border-box}.metric-cell{min-width:0;display:grid;justify-items:center;gap:7px;font-family:var(--console-font);font-variant-numeric:tabular-nums;text-align:center}.metric-primary{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:center;gap:2px 7px}.metric-cell strong{color:var(--console-ink);font-size:20px;line-height:26px;font-weight:500}.metric-cell em{display:flex;flex-wrap:wrap;justify-content:center;gap:0 3px;color:var(--console-muted);font-size:var(--console-caption);line-height:var(--console-caption-leading);font-style:normal;font-weight:400}.metric-cell small{white-space:nowrap;color:var(--console-muted);font-size:13px;line-height:20px;font-weight:500}.metric-cell.positive small{color:#4f7d68}.metric-cell.negative small{color:#a35f59}
.metric-cell:not(.has-value) strong{font-weight:400;color:var(--console-muted)}
@media(max-width:700px){.metric-cell{grid-template-rows:minmax(24px,auto) 4px auto}.metric-cell strong{font-size:18px;line-height:24px}.metric-cell em{white-space:normal}}
</style>
