---
import { needs, stages } from '../sales-trial/model';
interface Props { prefix: string; defaultStage?: 'new' | 'following' }
const { prefix, defaultStage = 'new' } = Astro.props;
---
<div class="field"><label for={prefix + '-stage'}>跟进进度</label><select id={prefix + '-stage'} name="stage">
  {Object.entries(stages).map(([value, label]) => <option value={value} selected={value === defaultStage}>{label}</option>)}
</select></div>
<div class="field"><label for={prefix + '-need'}>咨询类别</label><select id={prefix + '-need'} name="need">
  <option value="">待确认</option>{needs.map(need => <option>{need}</option>)}
</select></div>
<div class="field"><label for={prefix + '-subject'}>科目</label><input id={prefix + '-subject'} name="subject" maxlength="40" placeholder="选填" /></div>
<div class="field"><label for={prefix + '-interest'}>意向产品</label><input id={prefix + '-interest'} name="interest" maxlength="70" placeholder="选填，例如小班课" /></div>
