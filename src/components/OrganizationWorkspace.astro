---
import BusinessFormSheet from './BusinessFormSheet.astro';
import BusinessSectionHeader from './BusinessSectionHeader.astro';
import BusinessToolbarActions from './BusinessToolbarActions.astro';
import OrganizationMemberRow from './OrganizationMemberRow.astro';
import { positionKeys, positionNames, type OrganizationWorkspace } from '../data/organization';
interface Props { workspace: OrganizationWorkspace; view: 'roles' | 'people'; editable: boolean }
const { workspace, view, editable } = Astro.props;
const supervisor = workspace.positions.find(row => row.key === 'supervisor');
const managers = workspace.members.filter(member => member.enabled && member.positions.includes('supervisor')).map(member => member.name);
const owners = (key: string) => workspace.members.filter(member => member.positions.includes(key as typeof positionKeys[number]));
---
<div class="organization-workspace" data-organization data-view={view}>
  <script is:inline type="application/json" data-organization-data set:html={JSON.stringify(workspace).replace(/</g, '\\u003c')} />
  <section data-org-panel="roles" hidden={view !== 'roles'} aria-label="岗位与协作">
    {supervisor && <section class="organization-panel org-supervisors" aria-labelledby="org-supervisor-heading">
      <div class="org-supervisor-heading"><h2 id="org-supervisor-heading">主管</h2><span>共同管理团队</span></div>
      <div class="org-supervisor-owners" data-org-assignees="supervisor">{owners('supervisor').map(member => <span>{member.name}{!member.enabled && <small>账号已停用</small>}</span>)}</div>
      <div class="org-supervisor-copy"><p data-position-field="supervisor:responsibilities">{supervisor.responsibilities}</p><p class="org-secondary" data-position-field="supervisor:deliverables">{supervisor.deliverables}</p>
        <details class="org-position-details"><summary>协作与资料</summary><div><p data-position-field="supervisor:collaboration">{supervisor.collaboration}</p><ul data-position-references="supervisor">{supervisor.references.map(reference => <li><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.label}</a></li>)}</ul></div></details>
      </div>
      {editable && <BusinessToolbarActions variant="section"><button type="button" data-edit-position="supervisor">编辑职责</button></BusinessToolbarActions>}
    </section>}
    <section class="organization-panel org-position-panel" aria-labelledby="org-positions-heading">
      <div class="org-section-header"><BusinessSectionHeader title="岗位分工" headingId="org-positions-heading" description="同一人可以兼任多个岗位"/></div>
      <div class="org-table-scroll"><table class="org-position-table"><colgroup><col class="org-position-col"/><col class="org-owner-col"/><col/><col class="org-delivery-col"/></colgroup><thead><tr><th scope="col">岗位</th><th scope="col">当前负责人</th><th scope="col">核心职责与协作</th><th scope="col">主要交付</th></tr></thead><tbody>
        {workspace.positions.filter(position => position.key !== 'supervisor').map(position => <tr>
          <th scope="row"><strong>{position.name}</strong>{editable && <BusinessToolbarActions variant="section"><button type="button" data-edit-position={position.key}>编辑职责</button></BusinessToolbarActions>}</th>
          <td><div class="org-owners" data-org-assignees={position.key}>{owners(position.key).length ? owners(position.key).map(member => <span>{member.name}{!member.enabled && <small>账号已停用</small>}</span>) : <span class="org-unassigned">待安排</span>}</div></td>
          <td><p data-position-field={`${position.key}:responsibilities`}>{position.responsibilities}</p><details class="org-position-details"><summary>协作与资料</summary><div><p data-position-field={`${position.key}:collaboration`}>{position.collaboration}</p><ul data-position-references={position.key}>{position.references.map(reference => <li><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.label}</a></li>)}</ul></div></details></td>
          <td><p data-position-field={`${position.key}:deliverables`}>{position.deliverables}</p></td>
        </tr>)}
      </tbody></table></div>
    </section>
    <section class="organization-panel org-flow" aria-labelledby="org-flow-heading">
      <div class="org-section-header"><BusinessSectionHeader title="内容协作流程" headingId="org-flow-heading"/></div>
      <ol class="org-workflow">
        {[
          ['主管', '规划与方向'], ['新媒体运营', '项目文档与任务'], ['视觉设计', '设计交付'], ['新媒体运营', '审查与发布'], ['用户触点运营', '用户承接'],
        ].map(([position, task]) => <li><span>{position}</span><strong>{task}</strong></li>)}
      </ol>
      <div class="org-feedback-loop"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 11V6h5M4 6l4 4a7 7 0 1 1-1 8"/></svg><p>用户反馈回流至新媒体运营，推动内容调整；客户来源与销售核对，作为成本核算依据。</p></div>
    </section>
    <nav class="org-business-links" aria-label="相关业务"><span>相关业务</span><a href="/business/annual-plan">总周期规划</a><a href="/business/operations-schedule">排期与交付</a><a href="/business/monthly-operations">月度运营</a><a href="/business/meeting-review">例会复盘</a></nav>
  </section>
  <section data-org-panel="people" hidden={view !== 'people'} aria-labelledby="org-people-heading">
    <section class="organization-panel">
      <div class="org-section-header"><BusinessSectionHeader title="团队成员" headingId="org-people-heading" description="按人员查看岗位与主管关系"><span slot="heading-end" data-org-member-count>({workspace.members.length})</span>{editable && <BusinessToolbarActions slot="end" variant="section"><a href="/business/settings?view=accounts">账号管理</a></BusinessToolbarActions>}</BusinessSectionHeader></div>
      <div class="org-table-scroll"><table class="org-people-table"><thead><tr><th scope="col">姓名</th><th scope="col">登录账号</th><th scope="col">担任岗位</th><th scope="col">主管</th>{editable && <th scope="col">操作</th>}</tr></thead><tbody data-org-members>{workspace.members.map(member => <OrganizationMemberRow member={member} managers={managers} editable={editable}/>)}</tbody></table></div>
      <p class="org-empty" data-org-no-members hidden={workspace.members.length > 0}>暂无人员账号。</p>
    </section>
    <p class="org-account-note">岗位用于安排工作分工，系统权限沿用账号现有授权。</p>
  </section>
  <template data-org-member-template><OrganizationMemberRow editable={editable}/></template>
  {editable && <BusinessFormSheet id="organization-editor" labelledby="organization-editor-title"><form class="business-form" data-organization-form>
    <header class="dialog-head"><h2 id="organization-editor-title">编辑岗位职责</h2><button type="button" class="close-button" data-org-close aria-label="关闭编辑">×</button></header>
    <div class="sheet-body">
      <p class="org-editor-identity" data-org-editor-identity></p>
      <fieldset data-org-position-fields>
        <div class="field"><label for="org-responsibilities">核心职责</label><textarea id="org-responsibilities" name="responsibilities" required maxlength="1800" rows="5"></textarea></div>
        <div class="field"><label for="org-deliverables">主要交付</label><textarea id="org-deliverables" name="deliverables" required maxlength="1000" rows="3"></textarea></div>
        <div class="field"><label for="org-collaboration">协作关系</label><textarea id="org-collaboration" name="collaboration" required maxlength="1000" rows="4"></textarea></div>
        <div class="org-reference-editor"><header><h3>相关资料</h3><button type="button" class="business-action-secondary" data-org-add-reference>添加资料</button></header><div data-org-reference-rows></div></div>
      </fieldset>
      <fieldset data-org-member-fields hidden disabled><legend>担任岗位</legend><div class="org-position-choices">{positionKeys.map(key => <label><input type="checkbox" name="positions" value={key}/><span>{positionNames[key]}</span></label>)}</div><p class="org-secondary">可同时选择多个岗位；岗位调整不改变账号权限。</p></fieldset>
    </div>
    <footer class="dialog-actions"><output data-org-editor-message role="alert"></output><button type="button" data-org-close>取消</button><button type="submit" class="save-button" disabled>保存</button></footer>
  </form></BusinessFormSheet>}
  <template data-org-reference-template><div class="org-reference-row"><label>资料名称<input data-reference-label maxlength="60" required autocomplete="off"/></label><label>链接<input data-reference-url type="url" required autocomplete="off" placeholder="https://"/></label><button type="button" class="business-action-secondary" data-org-remove-reference>移除</button></div></template>
</div>
<script>import '../scripts/organization';</script>
