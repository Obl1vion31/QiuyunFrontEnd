---
import '../styles/business-view-switch.css';
interface Props {
  label: string;
  name: string;
  value: string;
  items: Array<{ label: string; value: string; disabled?: boolean; title?: string }>;
  [key: string]: unknown;
}
const { label, name, value, items, ...attributes } = Astro.props;
---
<fieldset {...attributes} class="business-view-switch">
  <legend>{label}</legend>
  {items.map(item => <label title={item.title}><input disabled={item.disabled} type="radio" name={name} value={item.value} checked={item.value===value}/><span>{item.label}</span></label>)}
</fieldset>
