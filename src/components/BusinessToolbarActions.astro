---
interface Props {variant?:'toolbar'|'section'}
const {variant='toolbar'}=Astro.props;
---
<div class:list={['toolbar-action-group',{'toolbar-action-group--section':variant==='section'}]}><slot /></div>

<style>
  .toolbar-action-group{height:36px;display:flex;align-items:center;justify-content:flex-end;gap:8px;font-family:var(--console-font);white-space:nowrap}.toolbar-action-group>:global(button),.toolbar-action-group>:global(a){box-sizing:border-box;width:auto;min-width:0;max-width:none;height:36px;display:inline-flex;align-items:center;justify-content:center;gap:8px;margin:0;border:1px solid #aeb8b3;border-radius:9px;padding:0 13px;color:#35423b;background:#fff;font:500 12px/1 var(--console-font);text-decoration:none;box-shadow:none;cursor:pointer}.toolbar-action-group>:global(button:hover),.toolbar-action-group>:global(a:hover){background:#f0f3f1}.toolbar-action-group>:global(button:active),.toolbar-action-group>:global(a:active){transform:scale(.98)}.toolbar-action-group>:global(button:focus-visible),.toolbar-action-group>:global(a:focus-visible){outline:2px solid #315fd6;outline-offset:2px}.toolbar-action-group>:global(.primary-action){border-color:#315fd6;color:#fff;background:#315fd6}.toolbar-action-group>:global(.primary-action:hover){background:#274eb8}.toolbar-action-group>:global(button:disabled){opacity:.48;cursor:not-allowed}
  @media(max-width:620px){.toolbar-action-group:not(.toolbar-action-group--section)>:global(.toolbar-action-secondary){display:none}.toolbar-action-group>:global(button),.toolbar-action-group>:global(a){padding:0 11px}}
  .toolbar-action-group--section{height:auto;min-height:36px;flex-wrap:wrap;gap:12px}.toolbar-action-group--section>:global(button),.toolbar-action-group--section>:global(a){height:36px;border:0;border-radius:6px;padding:0;color:var(--console-blue);background:transparent;font:400 13px/20px var(--console-font);gap:4px}.toolbar-action-group--section>:global(button:hover),.toolbar-action-group--section>:global(a:hover){background:#f0f3f9}.toolbar-action-group--section>:global(.primary-action){padding:0 12px;border:1px solid #244fc8;color:#fff;background:linear-gradient(#4272e3,#315fd6);font-weight:500;box-shadow:0 1px 2px #2449a328,inset 0 1px #ffffff30}.toolbar-action-group--section>:global(.primary-action:hover){background:#274eb8}
</style>
