---
import { businessDateTime } from '../scripts/business-date';
import type { StageSnapshot } from '../db/promotion-stage-reviews';
interface Props { snapshot: StageSnapshot; versionNumber?: number }
const { snapshot, versionNumber } = Astro.props;
const money = (n: number | null) => n == null ? '—' : `¥${n.toFixed(2)}`;
---
<article class="promotion-snapshot" data-promotion-snapshot>
  <header><div><h3>{snapshot.name}</h3><p>{snapshot.periodStart}—{snapshot.periodEnd}{versionNumber != null ? ` · V${versionNumber}` : ' · 预览'}</p></div><span>测试按截止日归属 · 放量按所选时间段</span></header>
  <div class="table-scroll"><table><thead><tr><th>帖子 / 阶段</th><th>统计区间</th><th>消耗</th><th>实际开口</th><th>开口成本</th><th>实际留资</th><th>留资成本</th><th>数据情况</th></tr></thead><tbody>
    {snapshot.rows.map(row => <tr><th><span class:list={['stage', row.stageType]}>{row.stageType === 'testing' ? '测试' : '放量'}</span> {row.projectDocUrl ? <a href={row.projectDocUrl} target="_blank" rel="noopener noreferrer">{row.contentName}</a> : row.contentName} <small>V{row.versionNumber} · {row.subjectName} / {row.categoryName ?? '临时帖'}</small></th><td>{row.startedOn}<br/>{row.endedOn}</td><td>{money(row.spend)}</td><td>{row.actualOpenCount ?? '—'}</td><td>{money(row.actualOpenCost)}</td><td>{row.actualLeadCount ?? '—'}</td><td>{money(row.actualLeadCost)}</td><td>{row.missingDates.length ? <strong class="missing" title={row.missingDates.join('、')}>缺 {row.missingDates.length} 天</strong> : '完整'}<details><summary>来源 {row.facts.length} 天</summary><p>平台开口 {row.platformOpenCount ?? '—'} · 平台留资 {row.platformLeadCount ?? '—'}</p>{row.facts.map(f => <p>{f.metricDate} · {money(Number(f.spend))} · 开口 {f.actualOpenCount} · 留资 {f.actualLeadCount}</p>)}{row.missingDates.length > 0 && <p>待补：{row.missingDates.join('、')}</p>}</details></td></tr>)}
  </tbody></table></div>
  {!snapshot.rows.length && <p class="empty">所选时间段没有符合条件的测试或放量数据。</p>}
  <footer>生成于 {businessDateTime(snapshot.generatedAt)} · 待定与暂停不计入投放天数 · 成本按总量计算</footer>
</article>
<style>
.promotion-snapshot{min-width:0;overflow:hidden;border:1px solid #c9d1cc;border-radius:12px;background:white;color:#17211c}.promotion-snapshot header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;padding:18px 20px;border-bottom:1px solid #c9d1cc}.promotion-snapshot h3{margin:0;font-size:.95rem}.promotion-snapshot header p{margin:6px 0 0;font-size:var(--console-caption);color:#68736d}.promotion-snapshot header>span{font-size:var(--console-caption);color:#68736d}.table-scroll{overflow:auto}.promotion-snapshot table{width:100%;border-collapse:collapse;font-size:var(--console-text)}.promotion-snapshot th,.promotion-snapshot td{padding:12px 10px;border-bottom:1px solid #dce1de;text-align:right;vertical-align:top;font-variant-numeric:tabular-nums;line-height:1.5}.promotion-snapshot thead th{background:#f2f5f2;color:#68736d;font-size:var(--console-caption);white-space:nowrap}.promotion-snapshot th:first-child{text-align:left;min-width:180px}.promotion-snapshot td:nth-child(2){white-space:nowrap;font-size:var(--console-caption);color:#68736d}.promotion-snapshot th small{display:block;font-size:var(--console-caption);color:#68736d;font-weight:400}.promotion-snapshot a{color:inherit}.stage{padding:3px 5px;border-radius:4px;font-size:var(--console-caption)}.testing{color:#6a4a00;background:#fff1bf}.scaling{color:#205d48;background:#ddf2e8}.missing{color:#924b2a}.promotion-snapshot details{min-width:85px;font-size:var(--console-caption);color:#68736d}.promotion-snapshot summary{cursor:pointer}.promotion-snapshot footer{padding:12px 20px;font-size:var(--console-caption);color:#68736d}.empty{padding:30px;text-align:center;color:#68736d;font-size:.75rem}
</style>
