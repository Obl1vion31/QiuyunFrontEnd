---
interface Props {saved?:boolean}
const {saved=false}=Astro.props;
---
<div class="juguang-source-note" data-juguang-feedback>
  <div data-business-popover data-popover-kind="reference">
    <button type="button" class="juguang-source-trigger" data-popover-trigger aria-expanded="false" aria-label="查看聚光数据来源">聚光</button>
    <div popover="auto" data-popover-panel role="region" aria-label="聚光数据来源">
      <p>聚光数据来源</p>
      <div class="juguang-read-state"><p data-juguang-message role="status">{saved?'已保存来源':'待读取聚光'}</p><button type="button" data-retry-juguang>重新读取</button><small>实际人数与推广安排由人填写</small><small>点击率＝点击量 ÷ 曝光量 × 100%</small></div>
    </div>
  </div>
  <span data-juguang-summary role="status">{saved?'已保存':'待读取'}</span>
</div>
<script>import '../scripts/business-popover';</script>
