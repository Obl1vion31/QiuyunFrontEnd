---
import { businessDateTime } from '../scripts/business-date';
import BusinessPromotionSnapshot from './BusinessPromotionSnapshot.astro';
interface Props { snapshot: Record<string, any> }
const { snapshot } = Astro.props;
const { generated = {}, draft = {}, meeting = {} } = snapshot;
const text = (value: unknown) => typeof value === 'string' && value.trim() ? value : '尚未填写';
const money = (n: number | null) => n == null ? '—' : `¥${Number(n).toFixed(2)}`;
---
<article class="meeting-snapshot" data-meeting-snapshot>
  <h2>{meeting.name}</h2><p>{meeting.periodStart}—{meeting.periodEnd} · 已定稿快照</p>
  <section><h3>本周动向</h3>{generated.activity?.map((row: any) => <p>{row.contentName} V{row.versionNumber} · 测试 {row.testingDays} 天 · 放量 {row.scalingDays} 天 · 消耗 {money(row.total.spend)} · 开口 {row.total.actualOpenCount} · 留资 {row.total.actualLeadCount}</p>)}{generated.alignment?.map((r: any) => <p>{r.contentName} V{r.versionNumber} · {businessDateTime(r.plannedPublishAt)} · {r.status === 'unpublished' ? '待发布' : r.status === 'delayed' ? '延期发布' : '已发布'}</p>)}<h4>整体情况</h4><p class="writing">{text(draft.situation)}</p><h4>策略</h4><p class="writing">{text(draft.strategy)}</p></section>
  <section><h3>推广阶段复盘快照</h3>{generated.promotionSnapshots?.map((ref: any) => <BusinessPromotionSnapshot snapshot={ref.snapshot} versionNumber={ref.versionNumber}/>)}{generated.promotions?.map((r: any) => <p>{r.contentName} V{r.versionNumber} · 消耗 {money(r.total?.spend)} · 开口 {r.total?.actualOpenCount ?? '—'} · 留资 {r.total?.actualLeadCount ?? '—'}</p>)}{Object.entries(draft.promotionInputs ?? {}).map(([id, input]: [string, any]) => <p>{generated.activity?.find((r: any) => r.campaignId === id)?.contentName ?? generated.promotions?.find((r: any) => r.campaignId === id)?.contentName ?? '推广帖'} · 手动点击率 {input.clickRate == null ? '待补' : `${input.clickRate}%`} · {input.currentSituation} {input.activeAction}</p>)}</section>
  <section><h3>非推广复盘快照</h3>{generated.nonPromotions?.map((r: any) => <article><strong>{r.contentName} · {r.checkpointType === 'day_15' || r.checkpoint === 15 ? '二轮' : '首轮'}</strong><p>{r.review ? `点击率 ${r.review.clickRateSnapshot}% · 3 秒阅读率 ${r.review.threeSecondReadRateSnapshot}%` : '指标待补'}</p>{r.review && <><p class="writing">{r.review.conclusion || '结论未填写'}</p><details><summary>保存时同类基准</summary><p>点击率均值 {(r.review.cohortSnapshot as any)?.clickRate?.mean ?? '—'} · 3 秒阅读率均值 {(r.review.cohortSnapshot as any)?.threeSecondReadRate?.mean ?? '—'}</p></details></>}</article>)}</section>
  <section><h3>临时事项快照</h3><p class="writing">{text(draft.temporaryNotes)}</p>{draft.temporaryLinks?.map((link: any) => <p><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label || link.url}</a></p>)}<div class="images">{generated.attachments?.map((image: any) => <figure><a href={`/api/meeting-attachments/${image.id}`} target="_blank"><img src={`/api/meeting-attachments/${image.id}`} alt={image.name} loading="lazy"/></a><figcaption>{image.name}</figcaption></figure>)}</div></section>
  <section><h3>本周结论与事项进展</h3><p class="writing">{text(draft.coreConclusion)}</p><h4>下一步</h4><p class="writing">{text(draft.nextAction)}</p>{draft.issues?.map((issue: any) => <p class="writing"><strong>{issue.problem}</strong> · {{pending:'待处理',validating:'验证中',resolved:'已解决',paused:'暂缓'}[issue.status as string]}<br/>{issue.conclusion || '本周暂无新进展'}</p>)}</section>
</article>
<style>.meeting-snapshot{display:grid;gap:16px;padding:24px;border:1px solid #c9d1cc;border-radius:12px;background:white;color:#17211c}.meeting-snapshot h2,.meeting-snapshot h3,.meeting-snapshot h4,.meeting-snapshot p{margin:4px 0}.meeting-snapshot h2{font-size:1.2rem}.meeting-snapshot h3{font-size:.95rem;margin-bottom:14px}.meeting-snapshot h4{font-size:.75rem;margin-top:14px}.meeting-snapshot p,.meeting-snapshot summary{font-size:var(--console-text);line-height:var(--console-text-leading)}.meeting-snapshot section{min-width:0;padding-top:16px;border-top:1px solid #d5dcd7}.meeting-snapshot section>article{padding:12px 0;font-size:.8rem}.writing{white-space:pre-wrap}.images{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}.images figure{margin:0}.images img{max-width:100%;max-height:400px;object-fit:contain}.images figcaption{font-size:var(--console-caption);color:#68736d}@media(max-width:600px){.meeting-snapshot{padding:16px}.images{grid-template-columns:1fr}}</style>
