---
interface Props{account?:{id:string;username:string;name:string;role:string;enabled:boolean;updatedAt:Date}}
const {account}=Astro.props;
---
<tr data-account-id={account?.id??''} data-account-username={account?.username??''} data-account-updated={account?.updatedAt.toISOString()??''} data-collaboration-resource={account?`account:${account.id}`:undefined} data-collaboration-label={account?.name}>
 <th data-account-login>{account?.username}</th><td data-account-name>{account?.name}</td><td data-account-role>{account?.role==='admin'?'管理员':'员工'}</td><td data-account-status>{account?.enabled?'已启用':'已停用'}</td>
 <td><div class="account-actions"><button type="button" class="business-action-secondary" data-account-action="rename">修改用户名</button><button type="button" class="business-action-secondary" data-account-action="updateUsername">修改账号</button><button type="button" class="business-action-secondary" data-account-action="resetPassword">重置密码</button><button type="button" class="business-action-secondary" data-account-action="revokeSessions">撤销登录</button><button type="button" class="business-action-secondary" data-account-action="status" data-enabled={account?.enabled??true} disabled={account?.id===Astro.locals.user?.id}>{account?.enabled===false?'恢复':'停用'}</button></div><output role="status"/></td>
</tr>
