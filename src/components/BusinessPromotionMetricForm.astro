---
import type {PromotionTimelineRow} from '../db/promotion-pending';
import type {ReviewDay} from '../db/promotion-review-days';
import {promotionActualLabels,promotionNextOptions,promotionSuccessorOptions,nextActualPromotionState} from '../db/promotion-successors.mjs';
interface Props {row:PromotionTimelineRow;day:ReviewDay}
const {row,day}=Astro.props;
const actualStatus=day.actualStatus??(day.stage==='scaling'?'scaling':'testing');
const defaultZero=day.defaultZero??['test_paused','test_pending','scaling_paused'].includes(actualStatus);
const options=promotionNextOptions(actualStatus);
const statusEditOptions=day.statusEditOptions??promotionSuccessorOptions(actualStatus);
const metrics=[['spend','消耗（元）','0.01'],['platformOpenCount','平台开口（人）','1'],['actualOpenCount','实际开口（人）','1'],['platformLeadCount','平台留资（人）','1'],['actualLeadCount','实际留资（人）','1']];
const tone=actualStatus.includes('paused')||['test_discarded','formal_discarded','ended'].includes(actualStatus)?'paused':actualStatus==='test_pending'?'pending':day.stage;
---
<form class:list={['business-form','metric-form','review-metric-row','review-entry-grid',tone]} data-metric-form data-pending-record={`${day.campaignId??row.campaign!.id}:${day.date}`} data-current-stage={day.stage} data-actual-status={actualStatus} data-status-edit-options={JSON.stringify(statusEditOptions)} data-content-id={row.contentId} data-note-id={row.platformNoteId??''} data-schedule-id={row.scheduleId} data-fingerprint={row.fingerprint} data-default-zero={String(defaultZero)}>
 <input type="hidden" name="campaignId" value={day.campaignId??row.campaign!.id}/><input type="hidden" name="metricDate" value={day.date}/><input type="hidden" name="dailyStatus" value={['testing','scaling'].includes(actualStatus)?'active':'waiting_action'}/><input type="hidden" name="stageTypeSnapshot" value={day.stage}/><input type="hidden" name="actualStatusSnapshot" value={actualStatus}/><input type="hidden" name="recordKind" value="regular"/>
 <time class="review-date-block" datetime={day.date} title={day.date}>{Number(day.date.slice(5,7))}月{Number(day.date.slice(8,10))}日</time>
 <div class="review-entry-identity"><a class="review-post-link" href={`?view=daily&campaign=review:${row.scheduleId}:${day.campaignId??row.campaign!.id}:${day.date}`} data-pending-inspector={row.scheduleId} data-review-key={`${day.campaignId??row.campaign!.id}:${day.date}`}><strong title={row.contentName}>{row.contentName}</strong></a><div class="review-version-line"><small>V{row.versionNumber} · {row.subjectName}</small><button type="button" class="review-note-trigger" data-note-id-trigger aria-label={row.platformNoteId?'查看笔记 ID':'补填笔记 ID'} title={row.platformNoteId??'待补 ID'}>{row.platformNoteId?'ⓘ':'补 ID'}</button></div></div>
 <button type="button" class="review-day-state" data-toggle-day-state aria-expanded="false" disabled={!statusEditOptions.length} aria-label={`修改 ${day.date} 当日状态`}><strong data-day-status data-default-label={promotionActualLabels[actualStatus]??day.status}>{promotionActualLabels[actualStatus]??day.status}</strong>{statusEditOptions.length>0&&<span data-state-caption>修改</span>}</button>
 {metrics.map(([name,label,step])=><label class="review-number"><span class="review-field-label">{label}</span><input aria-label={label} name={name} type="number" inputmode={name==='spend'?'decimal':'numeric'} min="0" step={step} value={defaultZero?'0':undefined} required/></label>)}
 <div class="review-calculated" aria-label="自动计算结果"><div><span>开口成本</span><output data-open-cost aria-label="实际开口成本">—</output></div><div><span>留资成本</span><output data-lead-cost aria-label="实际留资成本">—</output></div></div>
 <div class="review-decision"><span class="review-field-label">次日安排</span>{day.meetingDecision?<><input type="hidden" name="reviewDecision" value={day.meetingNext??''}/><select aria-label="次日安排" disabled><option>{options.find(o=>o.value===day.meetingNext)?.label??day.meetingDecision.targetStatus}</option></select><small>（例会决定）<a href={`/business/meeting-review?meeting=${day.meetingDecision.meetingId}&version=${day.meetingDecision.versionNumber}`}>V{day.meetingDecision.versionNumber}</a></small><details data-meeting-change data-decision-id={day.meetingDecision.id} data-expected-target={day.meetingDecision.targetStatus} data-expected-version={day.meetingDecision.versionNumber} data-schedule={row.scheduleId}><summary>修改安排</summary><label>新安排<select data-meeting-target><option value="">请选择</option>{options.map(o=><option value={nextActualPromotionState(actualStatus,o.value)}>{o.label}</option>)}</select></label><label>修改理由<textarea data-meeting-reason rows="2"/></label><button type="button" class="business-action-secondary" data-save-meeting-change>确认修改</button><output role="status"/></details></>:options.length?<select data-review-decision aria-label="次日安排" name="reviewDecision" required><option value="">请选择</option>{options.map(({value,label})=><option value={value} selected={actualStatus==='test_pending'&&value==='wait_continue'}>{label}</option>)}</select>:<><input type="hidden" name="reviewDecision" value={actualStatus}/><span class="review-no-next">无需后续动作</span></>}</div>
 <button type="submit" class="business-action-primary review-submit">完成复盘</button>
 <input type="hidden" name="platformNoteId" value={row.platformNoteId??''} data-note-id-required={!row.platformNoteId}/>
 <p role="status" data-form-message></p>
</form>

<script>import '../scripts/meeting-decision';</script>
<style>.review-decision small{font-size:12px;color:var(--console-muted)}.review-decision small a{color:var(--console-blue);margin-left:4px}.review-decision>select:disabled{background:#f5f7f9;border-style:dashed;opacity:1}.review-decision details{font-size:12px}.review-decision details[open]{position:absolute;z-index:20;background:#fff;padding:16px;border:1px solid var(--console-line);border-radius:8px;box-shadow:0 8px 28px #21314b20;width:280px;right:0}.review-decision details label{display:grid;gap:6px;margin-top:8px}.review-decision details textarea{width:100%;font:400 14px/22px var(--console-font)}</style>