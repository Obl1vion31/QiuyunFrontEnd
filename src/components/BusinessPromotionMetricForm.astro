---
import type {PromotionTimelineRow} from '../db/promotion-pending';
import type {ReviewDay} from '../db/promotion-review-days';
import {promotionActualLabels,promotionNextOptions} from '../db/promotion-successors.mjs';
interface Props {row:PromotionTimelineRow;day:ReviewDay}
const {row,day}=Astro.props;
const actualStatus=day.actualStatus??(day.stage==='scaling'?'scaling':'testing');
const defaultZero=day.defaultZero??['test_paused','test_pending','scaling_paused'].includes(actualStatus);
const options=promotionNextOptions(actualStatus);
const metrics=[['spend','消耗（元）','0.01'],['platformOpenCount','平台开口（人）','1'],['actualOpenCount','实际开口（人）','1'],['platformLeadCount','平台留资（人）','1'],['actualLeadCount','实际留资（人）','1']];
const tone=actualStatus.includes('paused')||['test_discarded','formal_discarded','ended'].includes(actualStatus)?'paused':actualStatus==='test_pending'?'pending':day.stage;
---
<form class:list={['business-form','metric-form','review-metric-row','review-entry-grid',tone]} data-metric-form data-pending-record={`${day.campaignId??row.campaign!.id}:${day.date}`} data-current-stage={day.stage} data-actual-status={actualStatus} data-schedule-id={row.scheduleId} data-fingerprint={row.fingerprint} data-default-zero={String(defaultZero)}>
 <input type="hidden" name="campaignId" value={day.campaignId??row.campaign!.id}/><input type="hidden" name="metricDate" value={day.date}/><input type="hidden" name="dailyStatus" value={['testing','scaling'].includes(actualStatus)?'active':'waiting_action'}/><input type="hidden" name="stageTypeSnapshot" value={day.stage}/><input type="hidden" name="actualStatusSnapshot" value={actualStatus}/><input type="hidden" name="recordKind" value="regular"/>
 <time class="review-date-block" datetime={day.date} title={day.date}>{Number(day.date.slice(5,7))}月{Number(day.date.slice(8,10))}日</time>
 <div class="review-entry-identity"><a class="review-post-link" href={`?view=daily&campaign=review:${row.scheduleId}:${day.campaignId??row.campaign!.id}:${day.date}`} data-pending-inspector={row.scheduleId} data-review-key={`${day.campaignId??row.campaign!.id}:${day.date}`}><strong title={row.contentName}>{row.contentName}</strong></a><small>V{row.versionNumber} · {row.subjectName}</small></div>
 <button type="button" class="review-day-state" data-toggle-day-state aria-expanded="false" disabled={!options.length} aria-label={`修改 ${day.date} 当日状态`}><strong data-day-status data-default-label={promotionActualLabels[actualStatus]??day.status}>{promotionActualLabels[actualStatus]??day.status}</strong>{options.length&&<span data-state-caption>修改</span>}</button>
 {metrics.map(([name,label,step])=><label class="review-number"><span class="review-field-label">{label}</span><input aria-label={label} name={name} type="number" inputmode={name==='spend'?'decimal':'numeric'} min="0" step={step} value={defaultZero?'0':undefined} required/></label>)}
 <div class="review-calculated" aria-label="自动计算结果"><div><span>开口成本</span><output data-open-cost aria-label="实际开口成本">—</output></div><div><span>留资成本</span><output data-lead-cost aria-label="实际留资成本">—</output></div></div>
 <label class="review-decision"><span class="review-field-label">次日安排</span>{options.length?<select data-review-decision aria-label="次日安排" name="reviewDecision" required><option value="">请选择</option>{options.map(({value,label})=><option value={value}>{label}</option>)}</select>:<><input type="hidden" name="reviewDecision" value={actualStatus}/><span class="review-no-next">无需后续动作</span></>}</label>
 <button type="submit" class="business-action-primary review-submit">完成复盘</button>
 {!row.platformNoteId&&<label class="review-note-field">笔记 ID<input aria-label="笔记 ID" name="platformNoteId" data-note-id-required pattern="[0-9A-Fa-f]{24}" maxlength="24" placeholder="24 位笔记 ID"/></label>}
 <p role="status" data-form-message></p>
</form>
