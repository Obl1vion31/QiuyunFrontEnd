<section class="source-preview monthly-schedule-fields" data-monthly-schedule-fields hidden>
 <div class="field field-wide"><label>月计划来源<select data-monthly-source><option value="">请选择</option></select></label></div>
 <p data-monthly-source-description class="monthly-caption"></p>
 <div class="field field-wide"><label>追加／跨Week原因<textarea name="monthlyPlanReason" rows="2" maxlength="2000"></textarea></label></div>
 <input type="hidden" name="monthlyPlanId"/><input type="hidden" name="monthlyPlanItemId"/><input type="hidden" name="monthlyRequestId"/><input type="hidden" name="monthlyExpectedRevision"/>
 <p class="monthly-caption" data-monthly-occupancy></p>
 <button type="button" data-monthly-source-refresh>刷新计划来源</button>
</section>
<style>.monthly-schedule-fields{display:grid!important;gap:10px}.monthly-schedule-fields[hidden]{display:none!important}.monthly-schedule-fields p{margin:0}.monthly-schedule-fields p:empty{display:none}.monthly-schedule-fields [data-monthly-source-refresh]{justify-self:start;width:auto;height:36px;min-height:36px;padding:0;border:0;color:var(--console-blue);background:transparent;font:500 13px/20px var(--console-font);cursor:pointer}.monthly-schedule-fields select{width:100%}</style>
