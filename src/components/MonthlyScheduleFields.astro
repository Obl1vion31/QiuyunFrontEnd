</section>
<style>.monthly-schedule-fields{display:grid!important;gap:10px}.monthly-schedule-fields[hidden],.monthly-schedule-fields [hidden]{display:none!important}.monthly-schedule-fields p{margin:0}.monthly-schedule-fields p:empty{display:none}.monthly-schedule-fields [data-monthly-source-retry]{justify-self:start}.monthly-schedule-fields select{width:100%}</style>
