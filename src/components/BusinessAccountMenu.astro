---
interface Props { placement?: 'sidebar' | 'toolbar' }
const { placement = 'sidebar' } = Astro.props;
const user = Astro.locals.user;
const panelId = `business-account-${placement}`;
---
{user && <div class:list={['business-account', `business-account--${placement}`]} data-business-account>
  <button type="button" class="business-account__trigger" popovertarget={panelId} data-account-trigger aria-label={`当前账号：${user.username}，${user.role === 'admin' ? '管理员' : '员工'}`}>
    <span aria-hidden="true">◉</span><span class="business-account__name">{user.username}</span><span class="business-account__role">{user.role === 'admin' ? '管理员' : '员工'}</span>
  </button>
  <div id={panelId} popover="auto" class="business-account__panel">
    <strong>{user.username}</strong><small>{user.role === 'admin' ? '管理员' : '员工'}</small>
    <button type="button" data-sign-out>退出登录</button><p role="alert" data-account-error hidden></p>
  </div>
</div>}
<script>
  import { signOut } from '../auth/client';
  const placePanels = () => {
    document.querySelectorAll<HTMLElement>('.business-account__panel:not([data-account-ready])').forEach(panel => {
      panel.dataset.accountReady = 'true';
      panel.addEventListener('toggle', () => {
        if (!panel.matches(':popover-open')) return;
        const trigger = document.querySelector<HTMLElement>(`[popovertarget="${panel.id}"]`);
        if (!trigger) return;
        const box = trigger.getBoundingClientRect();
        panel.style.left = `${Math.max(8, Math.min(box.left, innerWidth - panel.offsetWidth - 8))}px`;
        panel.style.top = `${box.bottom + panel.offsetHeight + 8 < innerHeight ? box.bottom + 6 : Math.max(8, box.top - panel.offsetHeight - 6)}px`;
      });
    });
  };
  placePanels();
  document.addEventListener('astro:page-load', placePanels);
  document.addEventListener('click', async event => {
    const target = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-sign-out]') : null;
    if (!target || target.dataset.signingOut) return;
    if (document.documentElement.dataset.unsaved === 'true' && !window.confirm('有尚未保存的修改，确定退出登录吗？')) return;
    const message = target.parentElement?.querySelector<HTMLElement>('[data-account-error]');
    if (message) message.hidden = true;
    target.dataset.signingOut = 'true'; target.disabled = true; target.textContent = '正在退出…'; target.dataset.loadingLabel = '正在退出登录…';
    try {
      await signOut();
      for (const key of Object.keys(sessionStorage)) if (key.startsWith('business-console:')) sessionStorage.removeItem(key);
      window.location.replace('/login');
    } catch {
      if (message) { message.textContent = '退出失败，请重试。'; message.hidden = false; }
      delete target.dataset.signingOut; target.disabled = false; target.textContent = '退出登录';
    }
  });
</script>
<style>
  .business-account,.business-account *{box-sizing:border-box}.business-account{position:relative;margin:2px 0 5px;font:13px/1.3 var(--console-font);color:#17211c}.business-account--toolbar{display:none}.business-account__trigger{display:flex;align-items:center;gap:8px;min-height:38px;width:100%;padding:8px 10px;border:0;border-radius:8px;background:transparent;color:inherit;font:inherit;cursor:pointer}.business-account__trigger:hover{background:#dce3de}.business-account__trigger:focus-visible,.business-account__panel button:focus-visible{outline:2px solid #315fd6;outline-offset:2px}.business-account__name{overflow:hidden;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.business-account__role{margin-left:auto;color:#68736d;font-size:var(--console-caption);white-space:nowrap}.business-account__panel{position:fixed;inset:auto;margin:0;width:220px;padding:16px;border:1px solid #c9d1cc;border-radius:10px;color:#17211c;background:#f7f8f5;box-shadow:0 8px 24px #17211c20;font:13px/1.4 var(--console-font)}.business-account__panel:popover-open{display:grid;gap:8px}.business-account__panel small{color:#68736d}.business-account__panel button{min-height:38px;border:1px solid #c9d1cc;border-radius:6px;background:#fff;color:#17211c;font:inherit;cursor:pointer}.business-account__panel button:disabled{opacity:.65;cursor:wait}.business-account__panel p{margin:0;color:#a63b32;font-size:12px}[hidden]{display:none!important}
  @media(max-width:900px){.business-account--sidebar{display:none}.business-account--toolbar{display:block;flex:none;margin:0}.business-account__trigger{min-height:30px;width:30px;justify-content:center;padding:4px;border:1px solid #c9d1cc;background:#f7f8f5}.business-account__name,.business-account__role{display:none}}
</style>
