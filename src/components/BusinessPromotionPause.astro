---
import type { pauseSummary } from '../db/promotion-pauses';
import { previousDateKey, shanghaiDateKey } from '../db/promotion-rules.mjs';
interface Props { summary: Awaited<ReturnType<typeof pauseSummary>> }
const { summary } = Astro.props;
const active = summary.active;
const today = shanghaiDateKey(new Date());
const endsOn = active ? previousDateKey(shanghaiDateKey(active.endsAt)) : today;
---
<div class="promotion-pause-inline" data-promotion-pause data-pause-state={`${active?.id ?? ''}:${active?.revision ?? ''}`}>
  <form class="business-filter" data-pause-form data-pause-id={active?.id} aria-label="节假日暂停">
    {active && <><input type="hidden" name="expectedRevision" value={active.revision}/><span>已暂停 {summary.affected} 篇</span></>}
    <label>暂停至<input type="date" name="endsOn" value={endsOn} min={today} max="2099-12-31" required/></label>
    {active ? <><button type="submit" name="action" value="extend">调整截止日</button><button class="resume" type="submit" name="action" value="resume">提前恢复</button></> : <button type="submit" title={`测试 ${summary.testing} 篇，推广 ${summary.scaling} 篇`}>一键暂停 {summary.affected} 篇</button>}
    <output role="status" aria-live="polite"></output>
  </form>
</div>
<script src="../scripts/promotion-pauses.ts"></script>
<style>
.promotion-pause-inline{margin-left:auto;min-width:0;color:#17211c;font:var(--console-caption)/var(--console-caption-leading) var(--console-font)}form,label{display:flex;align-items:center;flex-wrap:wrap;gap:8px}form{justify-content:flex-end}label{color:#68736d}input{box-sizing:border-box;min-width:0;width:132px;height:32px;padding:4px 7px;border:1px solid #b9c3bd;border-radius:6px;color:#17211c;background:#fff;font:var(--console-caption) var(--console-font)}button{height:32px;border:0;border-radius:6px;padding:0 10px;background:#315fd6;color:#fff;font:600 var(--console-caption) var(--console-font);cursor:pointer}.resume{background:#e3e8e5;color:#42534a}output{flex-basis:100%;color:#9a3f36}output:empty{display:none}button:focus-visible,input:focus-visible{outline:2px solid #315fd6;outline-offset:2px}@media(max-width:900px){.promotion-pause-inline{margin-left:0;width:100%}form{justify-content:flex-start}}
</style>
<style>
.promotion-pause-inline .business-filter{--form-control-width:148px;align-items:center}.promotion-pause-inline .business-filter label{display:flex;align-items:center;gap:8px}.promotion-pause-inline .business-filter input{width:148px}.promotion-pause-inline .business-filter button{height:var(--console-control-compact)}
</style>
