---
import type {SidebarCounts} from '../db/business-notifications';
interface Props {initial?:SidebarCounts}
const {initial}=Astro.props;
const reminders=Astro.locals.user?.role==='admin'
 ? [{key:'pendingApprovals',label:'排期待审',unit:'项',href:'/business/operations-schedule?status=approvals&display=ledger'}] as const
 : [
  {key:'promotionPending',label:'推广待复盘',unit:'项',href:'/business/daily-promotion-review?view=daily#daily-table'},
  {key:'overdue',label:'尚未登记',unit:'篇',href:'/business/operations-schedule?status=overdue&display=ledger'},
  {key:'nonPromotionDue',label:'非推广到期',unit:'篇',href:'/business/non-promotion-review?view=pending'},
 ] as const;
const ready=reminders.every(({key})=>initial?.[key]!==undefined);
---
<div class="schedule-notifications" aria-label="工作台待办提醒" data-schedule-notifications aria-busy={ready?'false':'true'}>
  {reminders.map(({key,label,unit,href},index)=><a href={href} aria-label={`${label} ${initial?.[key]===undefined?'数量待读取':initial[key]+' '+unit}`}>
    <span>{label}{index===0&&<small data-schedule-notification-error hidden> · 暂不可用</small>}</span>
    <b data-schedule-count={key} data-notice-label={label} data-notice-unit={unit}>{initial?.[key]??'—'}</b>
  </a>)}
  <small data-schedule-notification-status role="status" aria-live="polite">{ready?'':'正在读取提醒…'}</small>
</div>
<script>
  import '../scripts/schedule-notifications';
</script>
<style>
  .schedule-notifications{display:grid;gap:2px;margin:-8px 0 16px;padding:8px 10px;border:1px solid #c9d1cc;border-radius:9px;background:#f7f8f5}
  .schedule-notifications a{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:4px 0;color:#53615a;font-size:12px;line-height:18px;white-space:nowrap;text-decoration:none}
  .schedule-notifications a:hover span{text-decoration:underline}
  .schedule-notifications a:focus-visible{outline:2px solid #315fd6;outline-offset:2px}
  .schedule-notifications b{min-width:22px;padding:2px 5px;border-radius:5px;color:#8d4c31;background:#f5e4dc;text-align:center;font:500 12px/16px var(--console-font);font-variant-numeric:tabular-nums}
  .schedule-notifications [data-schedule-count=overdue]{color:#73551d;background:#fff1bf}
  .schedule-notifications [data-schedule-notification-status]{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .schedule-notifications [data-schedule-notification-error]{color:#8d4c31;font-size:inherit}
  @media(max-width:900px){.schedule-notifications{display:none}}
</style>
