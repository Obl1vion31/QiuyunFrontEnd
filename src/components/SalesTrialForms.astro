---
import BusinessDateTimeFields from './BusinessDateTimeFields.astro';
import SalesTrialDirections from './SalesTrialDirections.astro';
import SalesTrialContactFields from './SalesTrialContactFields.astro';
import SalesTrialSheet from './SalesTrialSheet.astro';
import { salesToday, stages, type Role } from '../sales-trial/model';
interface Props { role: Role }
const { role } = Astro.props;
---
{role === 'seller' && <>
  <SalesTrialSheet kind="create" title="登记微信" save="保存登记" compact>
    <div class="form-grid">
      <SalesTrialContactFields prefix="registration" />
      <div class="field-wide"><BusinessDateTimeFields name="added" dateName="addedDay" timeName="addedTime" dateLabel="添加日期" timeLabel="添加时间" value={salesToday() + 'T'} required /></div>
      <SalesTrialDirections />
    </div>
  </SalesTrialSheet>
  <SalesTrialSheet kind="contact" title="编辑微信信息" compact>
    <div class="form-grid"><SalesTrialContactFields prefix="contact" /></div>
  </SalesTrialSheet>
  <SalesTrialSheet kind="follow" title="更新跟进" save="保存跟进" compact>
    <div class="form-grid">
      <div class="field"><label for="follow-stage">跟进进度</label><select id="follow-stage" name="stage">
        {Object.entries(stages).map(([value, label]) => <option value={value}>{label}</option>)}
      </select></div>
      <SalesTrialDirections />
    </div>
  </SalesTrialSheet>
  <SalesTrialSheet kind="deal" title="登记成交" compact>
    <div class="form-grid sales-deal-fields">
      <div class="field"><label for="deal-day">付款日期<b> *</b></label><input id="deal-day" type="date" name="dealDay" max={salesToday()} /></div>
      <div class="field"><label for="deal-product">成交产品</label><input id="deal-product" name="product" maxlength="70" placeholder="选填" /></div>
    </div>
    <button class="sales-text-action sales-revoke-deal" type="submit" data-sales-revoke hidden>撤销成交</button>
  </SalesTrialSheet>
  <SalesTrialSheet kind="merge" title="核对重复登记" save="确认合并" compact>
    <div class="form-grid"><div class="field field-wide"><label for="merge-id">将下列登记合并到当前档案<b> *</b></label><select id="merge-id" name="duplicateId" required></select>
      <p class="sales-field-note">请先确认是同一位客户。合并会保留最早添加时间、跟进和付款记录。</p></div></div>
  </SalesTrialSheet>
</>}
{role === 'operator' && <>
  <SalesTrialSheet kind="source" title="核对来源" save="保存来源">
    <div class="form-grid">
      <div class="field field-wide"><label for="source-status">核对结果</label><select id="source-status" name="sourceStatus">
        <option value="confirmed">已确认来源帖</option>
        <option value="unknown">无法确认来源帖</option>
        <option value="other">其他来源</option>
      </select></div>
      <section class="field-wide sales-source-picker" data-post-picker>
        <div class="field"><label for="source-query">查找来源帖子（试用样例）</label><div class="sales-joined-control">
          <input id="source-query" name="postQuery" placeholder="粘贴分享链接、笔记 ID 或输入标题" autocomplete="off" />
          <button type="button" class="sales-control-button" data-find-post>查找</button>
        </div></div>
        <p data-post-feedback class="sales-field-note" role="status"></p>
        <fieldset data-post-results class="sales-post-results" hidden><legend>请选择来源帖子</legend><div data-post-choices></div></fieldset>
        <section data-selected-post class="sales-selected-post" aria-label="已选来源帖子" hidden>
          <div class="sales-source-title"><strong></strong><span data-post-type class="sales-status"></span></div>
          <dl class="sales-post-facts">
            <div><dt>实发时间</dt><dd data-post-published></dd></div>
            <div><dt>科目</dt><dd data-post-subject></dd></div>
            <div><dt>发布版本</dt><dd data-post-versions></dd></div>
            <div data-post-promotion-row hidden><dt>推广记录</dt><dd data-post-promotion></dd></div>
          </dl>
          <a class="sales-text-action" target="_blank" rel="noopener" data-open-original>查看样例发布资料</a>
        </section>
        <input type="hidden" name="postId" />
      </section>
      <div class="field field-wide" data-unknown-source hidden>
        <label for="source-unknown-note">核对说明</label>
        <textarea id="source-unknown-note" name="unknownNote" maxlength="700" placeholder="选填" disabled></textarea>
      </div>
      <div class="field-wide form-grid sales-other-source" data-other-source hidden>
        <div class="field field-wide"><label for="source-other-entry">入口<b> *</b></label>
          <input id="source-other-entry" name="otherEntry" maxlength="80" placeholder="例如微信转介绍" required disabled /></div>
        <div class="field field-wide"><label for="source-other-fact">具体来源<b> *</b></label>
          <textarea id="source-other-fact" name="otherSource" maxlength="700" placeholder="例如哪位客户转介绍，或具体的群、活动、链接" required disabled></textarea></div>
      </div>
      <details class="field-wide sales-source-extra" data-source-extra hidden>
        <summary>补充入口、版本或核对说明</summary>
        <div data-source-options class="form-grid" hidden>
          <div class="field"><label for="source-entry">确认到哪一步</label><select id="source-entry" name="entry"><option>仅确认帖子</option><option>开口</option><option>留资</option></select></div>
          <div class="field"><label for="source-version">确认版本</label><select id="source-version" name="version"><option value="">仅确认原帖</option></select></div>
        </div>
        <div class="field"><label for="source-evidence">核对说明</label><textarea id="source-evidence" name="evidence" maxlength="700" placeholder="确认到入口或版本时，请写明依据"></textarea></div>
      </details>
    </div>
  </SalesTrialSheet>
</>}
