---
import BusinessSheet from './BusinessSheet.astro';
---
<BusinessSheet id="business-post-lookup" labelledby="post-lookup-title" data-post-lookup>
 <header class="dialog-head assistant-head"><div class="assistant-heading"><h2 id="post-lookup-title"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5ZM20 2v4m-2-2h4"/></svg>工作台助手</h2><p>查找内容，处理日常工作</p></div><div class="lookup-head-actions business-filter"><button type="button" class="business-action-secondary lookup-back" data-lookup-back hidden>← 返回结果</button><button type="button" class="sheet-close" data-lookup-close aria-label="关闭工作台助手">×</button></div></header>
 <div class="sheet-body lookup-body"><h3 class="assistant-greeting" data-assistant-home>想找哪篇帖子？</h3><form class="business-form lookup-search"><label>查找帖子<input type="search" name="q" placeholder="输入帖子名称或完整笔记 ID" autocomplete="off" maxlength="120"/></label><button class="business-action-primary" type="submit">查找</button></form>
 <output role="status" data-lookup-message></output><div data-lookup-results></div><div class="business-form lookup-more"><button type="button" class="business-action-secondary" data-lookup-more hidden>继续加载</button></div><section class="business-form" data-lookup-detail hidden></section>
 <section class="assistant-capabilities" data-assistant-home aria-labelledby="assistant-capabilities-title"><h3 id="assistant-capabilities-title">更多能力</h3><button type="button" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zm10 0h6v6h-6zM4 14h6v6H4zm10 0h6v6h-6z"/></svg><span>找功能</span><small>未开放</small></button><button type="button" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z"/></svg><span>AI 录入</span><small>未开放</small></button><button type="button" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/></svg><span>数据导出</span><small>未开放</small></button></section>
 </div>
</BusinessSheet>
<script>import '../scripts/post-lookup';</script>
<style is:global>
dialog[data-post-lookup]{background:var(--console-surface)}
dialog[data-post-lookup]>.assistant-head{background:#0b2031;color:#fff;gap:12px;min-height:88px}
.assistant-heading{min-width:0}.assistant-heading h2{display:flex;align-items:center;gap:8px;white-space:nowrap}.assistant-heading h2 svg{width:18px;height:18px;flex:none}.assistant-heading p{margin:4px 0 0;color:#c5d5df;font:400 12px/18px var(--console-font)}
dialog[data-post-lookup] .sheet-close{width:44px;height:44px;border-radius:8px;color:#fff}dialog[data-post-lookup] .sheet-close:hover{background:#ffffff18}dialog[data-post-lookup] .sheet-close:focus-visible{outline:2px solid #c5d5df;outline-offset:0}
.assistant-greeting{margin:4px 0 24px;font:600 18px/26px var(--console-font)}
.assistant-capabilities{margin-top:28px;padding-top:20px;border-top:1px solid var(--console-line)}.assistant-capabilities h3{margin:0 0 10px;color:var(--console-muted);font:400 12px/18px var(--console-font)}
.assistant-capabilities button{display:flex;align-items:center;gap:12px;width:100%;min-height:48px;margin:0;padding:10px 0;border:0;background:transparent;color:var(--console-muted);font:400 14px/22px var(--console-font);text-align:left;cursor:default}.assistant-capabilities svg{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.assistant-capabilities small{margin-left:auto;font:400 12px/18px var(--console-font)}
@media(max-width:900px){dialog[data-post-lookup] .lookup-head-actions{gap:8px}dialog[data-post-lookup] .lookup-search input{font-size:16px}dialog[data-post-lookup] .lookup-back{padding:0 8px}}
@media(max-width:360px){dialog[data-post-lookup]>.assistant-head{flex-wrap:wrap}dialog[data-post-lookup] .assistant-heading{flex:1}dialog[data-post-lookup] .lookup-head-actions{margin-left:auto}dialog[data-post-lookup]:has([data-lookup-back]:not([hidden])) .assistant-heading p{display:none}}
</style>
<style is:global>.lookup-search{display:flex;align-items:end;gap:12px;margin:0 0 16px}.lookup-search label{flex:1}.lookup-search input{width:100%}.lookup-head-actions{display:flex;align-items:center;gap:12px}.lookup-search label{min-width:0}.lookup-search button{flex:none}.lookup-body{min-height:0}.lookup-body output{font:400 13px/20px var(--console-font);color:var(--console-muted)}[data-lookup-results]{display:grid;gap:8px}.lookup-result{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 16px;width:100%;padding:14px 16px;border:1px solid var(--console-line);border-radius:8px;background:var(--console-surface);text-align:left;color:var(--console-ink);font:400 14px/22px var(--console-font);cursor:pointer}.lookup-result strong{font-weight:500;overflow-wrap:anywhere}.lookup-result small{grid-column:1/-1;font:400 13px/20px var(--console-font);color:var(--console-muted)}[data-lookup-more]{margin-top:14px}.lookup-detail-section{padding:18px 0;border-bottom:1px solid var(--console-line)}.lookup-detail-section h3{margin:0 0 12px;font:600 18px/26px var(--console-font)}.lookup-detail-section p{margin:8px 0;font:400 14px/22px var(--console-font);white-space:pre-wrap;overflow-wrap:anywhere}.lookup-detail-section a{display:inline-block;margin:4px 16px 4px 0;color:var(--console-blue);font:400 14px/22px var(--console-font)}.lookup-daily{display:flex;flex-wrap:wrap;gap:4px 12px}.lookup-daily span{white-space:nowrap}.lookup-back{margin:0;white-space:nowrap}.lookup-detail-section:last-child{border-bottom:0;padding-bottom:8px}.lookup-detail-section button{height:auto!important;min-height:40px;justify-content:flex-start!important;text-align:left;padding:8px 12px!important;white-space:normal;margin:4px 8px 4px 0}.lookup-version-time{display:flex;flex-wrap:wrap;gap:4px 12px}.lookup-version-time span{white-space:nowrap}.lookup-body [hidden]{display:none!important}</style>
