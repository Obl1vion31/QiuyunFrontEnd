---
import BusinessFormDialog from './BusinessFormDialog.astro';
---
<BusinessFormDialog labelledby="post-lookup-title" width={960} data-post-lookup>
 <header class="dialog-head"><h2 id="post-lookup-title">查找帖子</h2><button type="button" data-lookup-close aria-label="关闭查帖">×</button></header>
 <div class="form-dialog-body lookup-body"><form class="business-form lookup-search"><label>名称或笔记 ID<input type="search" name="q" placeholder="输入帖子名称或完整笔记 ID" autocomplete="off" maxlength="120"/></label><button class="business-action-primary" type="submit">查找</button></form>
 <output role="status" data-lookup-message></output><div data-lookup-results></div><button type="button" class="business-action-secondary" data-lookup-more hidden>继续加载</button><section class="business-form" data-lookup-detail hidden></section></div>
</BusinessFormDialog>
<script>import '../scripts/post-lookup';</script>
<style is:global>.lookup-search{display:flex;align-items:end;gap:12px;margin:0 0 16px}.lookup-search label{flex:1}.lookup-search input{width:100%}.lookup-body{min-height:240px}.lookup-body output{font:400 13px/20px var(--console-font);color:var(--console-muted)}[data-lookup-results]{display:grid;gap:8px}.lookup-result{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 16px;width:100%;padding:14px 16px;border:1px solid var(--console-line);border-radius:8px;background:var(--console-surface);text-align:left;color:var(--console-ink);font:400 14px/22px var(--console-font);cursor:pointer}.lookup-result strong{font-weight:500;overflow-wrap:anywhere}.lookup-result small{grid-column:1/-1;font:400 13px/20px var(--console-font);color:var(--console-muted)}[data-lookup-more]{margin-top:14px}.lookup-detail-section{padding:18px 0;border-bottom:1px solid var(--console-line)}.lookup-detail-section h3{margin:0 0 12px;font:600 18px/26px var(--console-font)}.lookup-detail-section p{margin:8px 0;font:400 14px/22px var(--console-font);white-space:pre-wrap;overflow-wrap:anywhere}.lookup-detail-section a{display:inline-block;margin:4px 16px 4px 0;color:var(--console-blue);font:400 14px/22px var(--console-font)}.lookup-back{margin-bottom:12px}.lookup-body [hidden]{display:none!important}</style>
