
digraph ER {
  graph [
    rankdir=LR,
    splines=polyline,
    nodesep=0.45,
    ranksep=0.95,
    pad=0.2,
    bgcolor="white",
    fontname="Noto Sans CJK SC",
    labelloc="t",
    label="数据库实体关系图（ER Diagram）\n主链路：Content → Version → Schedule → Campaign → Stage / Daily Metric",
    fontsize=20,
    dpi=180
  ];
  node [shape=plain, fontname="Noto Sans CJK SC"];
  edge [fontname="Noto Sans CJK SC", fontsize=9, arrowsize=0.7, color="#4A5568"];

  subgraph cluster_dict {
    label="基础字典";
    fontname="Noto Sans CJK SC";
    fontsize=15;
    color="#AAB4C3";
    style="rounded";
    subject [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_subject</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">学科稳定 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">学科名称</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">sort_order</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">显示顺序</FONT></TD></TR></TABLE>>];
    category [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_category</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">帖子分类稳定 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">分类名称</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">sort_order</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">显示顺序</FONT></TD></TR></TABLE>>];
    subject_category [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_subject_category</B></TD></TR><TR><TD BGCOLOR="#F6F8FB" COLSPAN="3"><FONT POINT-SIZE="9">学科与分类的多对多中间表</FONT></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">subject_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ subject.id · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">category_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ category.id · RESTRICT</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_plan {
    label="年度规划";
    fontname="Noto Sans CJK SC";
    fontsize=15;
    color="#AAB4C3";
    style="rounded";
    annual_plan_year [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_annual_plan_year</B></TD></TR><TR><TD BGCOLOR="#F6F8FB" COLSPAN="3"><FONT POINT-SIZE="9">与 annual_plan.year 仅应用层关联，无数据库 FK</FONT></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">year</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">年度</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">instructions</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">年度说明</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">created_at / updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">审计时间</FONT></TD></TR></TABLE>>];
    annual_plan [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_annual_plan</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">规划行 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">year</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">年度；应用层关联</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">section_key / row_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">分区与规划项目</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">subject_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ subject.id · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">category_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ category.id · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">复合 FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">subject_id + category_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ subject_category · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">is_active</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">是否启用</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">counts_toward_promotion</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">是否计入推广周期</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">current_version_number</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">当前版本号</FONT></TD></TR></TABLE>>];
    annual_plan_block [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_annual_plan_block</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">时间块 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ annual_plan.id · CASCADE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">start_month / end_month</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">月份范围</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">rule_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">flexible / fixed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">monthly_frequency</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">弹性月频次</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">quantity_parts</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">固定数量组合</FONT></TD></TR></TABLE>>];
    annual_plan_link [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_annual_plan_link</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">链接 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ annual_plan.id · CASCADE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">label / url</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">链接名称与地址</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">sort_order</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">显示顺序</FONT></TD></TR></TABLE>>];
    annual_plan_version [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_annual_plan_version</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">历史版本 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">plan_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ annual_plan.id · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">version_number</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">V0、V1…</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">snapshot</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">规划完整快照</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">change_summary / diff_summary</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">调整说明与差异</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">changed_by_label</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">修改人标识</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_content {
    label="内容与推广主链路";
    fontname="Noto Sans CJK SC";
    fontsize=15;
    color="#7C8FA8";
    penwidth=1.8;
    style="rounded";
    content [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_content</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">跨版本稳定的帖子身份</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">created_at / updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">审计时间</FONT></TD></TR></TABLE>>];
    content_version [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_content_version</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">内容版本 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">content_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ content.id · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">version_number</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">V0、V1、V2…</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">自 FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">source_version_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ 本表 id · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">work_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">new / revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">content_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">帖子名称</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">subject_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ subject.id · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">category_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ category.id · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">复合 FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">subject_id + category_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ subject_category · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">revision_summary</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">改帖说明</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">project_doc_name / url</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">项目文档</FONT></TD></TR></TABLE>>];
    schedule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_content_schedule</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">排期 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">content_version_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ content_version.id · RESTRICT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">is_promoted</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">是否为付费推广帖</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">promotion_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">none / pending / awaiting…</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">promotion_deferred_through</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">当日未推广确认截止日</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">planned_publish_at / actual_publish_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">应发 / 实发时间</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">completion_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">pending / on_time / delayed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">delay_reason</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">延期原因</FONT></TD></TR></TABLE>>];
    campaign [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_promotion_campaign</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">一轮推广活动 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">schedule_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ schedule.id · CASCADE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">started_on / ended_on</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">活动起止日</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">current_stage</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">当前开放阶段或 NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">current_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">当前或最终状态</FONT></TD></TR></TABLE>>];
    stage [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_promotion_stage</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">推广阶段 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">campaign_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ campaign.id · CASCADE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">stage_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">testing / scaling</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">started_on / ended_on</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">阶段起止日</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">outcome</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">阶段关闭结果</FONT></TD></TR></TABLE>>];
    daily [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D7E2F0" COLSPAN="3"><B>operations_promotion_daily_metric</B></TD></TR><TR><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>标记</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>字段</B></FONT></TD><TD BGCOLOR="#E9EEF5"><FONT POINT-SIZE="9"><B>说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">日度事实 ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">campaign_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">→ campaign.id · CASCADE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">metric_date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">指标日期</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">stage_type_snapshot</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">testing / scaling 快照</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">spend</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">当日消耗</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">platform/actual_open_count</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">平台 / 实际开口数</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">platform/actual_lead_count</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">平台 / 实际留资数</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">review_decision</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">当天复盘决定</FONT></TD></TR></TABLE>>];
  }

  subject -> subject_category [label="1:N  RESTRICT"];
  category -> subject_category [label="1:N  RESTRICT"];

  subject -> annual_plan [label="1:N  RESTRICT"];
  category -> annual_plan [label="1:N  RESTRICT"];
  subject_category -> annual_plan [label="复合 FK  1:N  RESTRICT"];

  annual_plan -> annual_plan_block [label="1:N  CASCADE", penwidth=1.5];
  annual_plan -> annual_plan_link [label="1:N  CASCADE", penwidth=1.5];
  annual_plan -> annual_plan_version [label="1:N  RESTRICT"];

  subject -> content_version [label="1:N  RESTRICT"];
  category -> content_version [label="1:N  RESTRICT"];
  subject_category -> content_version [label="复合 FK  1:N  RESTRICT"];

  content -> content_version [label="1:N  RESTRICT", penwidth=2.2, color="#2F5D8A"];
  content_version -> schedule [label="1:N（数据库硬约束）  RESTRICT", penwidth=2.2, color="#2F5D8A"];
  schedule -> campaign [label="1:N  CASCADE", penwidth=2.2, color="#2F5D8A"];
  campaign -> stage [label="1:N  CASCADE", penwidth=2.2, color="#2F5D8A"];
  campaign -> daily [label="1:N  CASCADE", penwidth=2.2, color="#2F5D8A"];

  content_version -> content_version [
    label="source_version_id\n版本来源链 · RESTRICT",
    style=dashed,
    constraint=false,
    color="#6B7280"
  ];

  annual_plan_year -> annual_plan [
    label="应用层按 year 对应\n无数据库 FK",
    style=dashed,
    arrowhead=none,
    color="#8A94A3",
    constraint=false
  ];

  annual_plan -> content_version [
    label="仅业务维度对应\nsubject_id + category_id\n无直接 FK",
