{
  "name": "qiuyun-frontend-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.mjs tests/*.test.ts",
    "test:retest": "node --import tsx tests/settings-taxonomy-retest.browser.ts",
    "test:browser": "node --import tsx tests/auth.browser.ts",
    "test:home": "node tests/home.browser.mjs",
    "test:timeline": "node --import tsx tests/promotion-timeline.browser.ts",
    "test:reviews": "node --import tsx tests/review-intervals.browser.ts",
    "test:pauses": "node --import tsx tests/promotion-pauses.browser.ts",
    "test:workflows": "node --import tsx tests/schedule-workflow.browser.ts && node --import tsx tests/latest-delay.browser.ts",
    "test:annual-plan": "node --import tsx tests/annual-plan.browser.ts",
    "account:create": "node --import tsx scripts/create-account.ts",
    "start": "node ./dist/server/entry.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:backup": "node --import tsx scripts/backup-database.ts",
    "test:ui": "node --import tsx tests/business-ui.browser.ts",
    "test:publication": "node --import tsx tests/publication.browser.ts",
    "test:registration": "node --import tsx tests/registration-deadline.browser.ts",
    "test:interaction": "node --import tsx tests/interaction-consistency.browser.ts",
    "test:inspector-loading": "node --import tsx tests/schedule-inspector-loading.browser.ts",
    "test:pending": "node --import tsx tests/promotion-pending.browser.ts",
    "test:motion": "node --import tsx tests/panel-motion.browser.ts",
    "test:overview": "node --import tsx tests/promotion-overview.browser.ts",
    "test:cards": "node --import tsx tests/promotion-card.browser.ts",
    "test:review-workbench": "node --import tsx tests/review-workbench.browser.ts",
    "test:status-correction": "node --import tsx tests/promotion-status-correction.browser.ts",
    "test:weekly": "node --import tsx tests/meeting-create.browser.ts && node --import tsx tests/workspace-upgrade.browser.ts && node --import tsx tests/meeting-discussion.browser.ts",
    "test:non-promotion": "node --import tsx tests/non-promotion-inspector.browser.ts",
    "test:meeting-discussion": "node --import tsx tests/meeting-discussion.browser.ts",
    "test:data-ui": "node --import tsx tests/initial-arrangement.browser.ts && node --import tsx tests/data-interface.browser.ts",
    "test:workspace": "node --import tsx tests/workspace-upgrade.browser.ts",
    "test:meeting-ledger": "node --import tsx tests/meeting-ledger.browser.ts",
    "test:collaboration-lookup": "node --import tsx tests/collaboration-lookup.browser.ts",
    "test:accounts": "node --import tsx tests/account-identifiers.browser.ts",
    "test:assistant": "node --import tsx tests/workspace-assistant.browser.ts",
    "test:moments": "node --import tsx tests/publication-moments.browser.ts"
  },
  "dependencies": {
    "@astrojs/node": "9.5.5",
    "@astrojs/react": "4.4.2",
    "@astrojs/vercel": "8.2.11",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@sparticuz/chromium": "153.0.0",
    "astro": "5.18.2",
    "better-auth": "1.7.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "postgres": "^3.4.9",
    "puppeteer-core": "25.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "22.19.15",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
  }
}
